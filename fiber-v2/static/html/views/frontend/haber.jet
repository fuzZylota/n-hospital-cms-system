<div class="compact-page-header">
    <div class="container">
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
                        <li><a href="/haberler">Haberler</a></li>
                        <li><span class="current">{{ Haber.Title }}</span></li>
        </ul>
    </div>
</div>

<section class="blog-details-page section-space">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="blog-details">
                    <div class="blog-card-four wow fadeInUp" data-wow-duration="1500ms">
                        <div class="blog-card-four__image">
                            {{ if Haber.CoverPath != "" }}
                                <img src="{{ PathOnStart }}{{ Haber.CoverPath }}" alt="{{ Haber.CoverAltText != "" ? Haber.CoverAltText : Haber.Title }}">
                            {{ else }}
                                <img src="{{ PathOnStart }}assets/images/blog/blog-d-1-1.jpg" alt="{{ Haber.Title }}">
                            {{ end }}
                        </div><!-- /.blog-card-four__image -->
                        <div class="blog-card-four__content">
                            <ul class="list-unstyled blog-card-four__meta">
                                <li><span class="blog-card-four__meta__icon">
                                        <i class="icon-user"></i>
                                    </span><!-- /.blog-card-four__meta__icon -->
                                    {{ Haber.Author != "" ? Haber.Author : "Yazar" }}
                                </li>
                                <li><span class="blog-card-four__meta__icon">
                                        <i class="icon-calendar"></i>
                                    </span><!-- /.blog-card-four__meta__icon -->
                                    {{ ctdf(Haber.PublishDate) }}
                                </li>
                                <li><span class="blog-card-four__meta__icon">
                                        <i class="icon-eye"></i>
                                    </span><!-- /.blog-card-four__meta__icon -->
                                    {{ Haber.ViewsCount }} görüntülenme
                                </li>
                                {{ if Haber.Category != "" }}
                                <li><span class="blog-card-four__meta__icon">
                                        <i class="icon-tag"></i>
                                    </span>
                                    <a href="/haberler?category={{ Haber.Category }}&page=1">{{ Haber.Category }}</a>
                                </li>
                                {{ end }}
                                {{ if ShowUpdated }}
                                <li><span class="blog-card-four__meta__icon">
                                        <i class="icon-calendar"></i>
                                    </span>
                                    Son Güncelleme: {{ UpdatedDate }}
                                </li>
                                {{ end }}
                            </ul><!-- /.list-unstyled blog-card-four__meta -->
                            <h1 class="blog-card-four__title">{{ Haber.Title }}</h1>
                            <!-- /.blog-card-four__title -->
                            <div class="blog-card-four__content__inner">
                                {{ if Haber.Summary != "" }}
                                    <p class="blog-card-four__text">{{ Haber.Summary }}</p>
                                {{ end }}
                                {{ if Haber.Content != "" }}
                                    <p class="blog-card-four__text">{{ Haber.Content }}</p>
                                {{ end }}
                            </div><!-- /.blog-card-four__content__inner -->
                        </div><!-- /.blog-card-four__content -->
                    </div><!-- /.blog-card-four -->

                    <div class="blog-details__meta wow fadeInUp" data-wow-duration="1500ms">
                        <div class="blog-details__tags">
                            <h2 class="blog-details__meta__title">Etiketler:</h2><!-- /.blog-details__meta__title -->
                            <div class="blog-details__tags__box">
                                {{ if len(Haber.Tags) > 0 }}
                                    {{ range index, t := Haber.Tags }}
                                        <a href="/haberler?text={{ t }}&page=1">{{ t }}</a>{{ if index < (len(Haber.Tags) - 1) }}<span>,</span>{{ end }}
                                    {{ end }}
                                {{ else }}
                                    <span>Etiket yok</span>
                                {{ end }}
                            </div><!-- /.blog-details__tag__box-->
                        </div><!-- /.blog-details__tags -->
                    </div><!-- /.blog-details__meta -->
                </div><!-- /.blog-details -->
            </div><!-- /.col-lg-8 -->
        </div><!-- /.row -->
    </div><!-- /.container -->
</section><!-- /.blog-details-page section-space -->