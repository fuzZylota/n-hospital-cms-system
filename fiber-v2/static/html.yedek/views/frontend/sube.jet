<div class="compact-page-header">
    <div class="container">
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
            <li><a href="/merkezlerimiz">Merkezlerimiz</a></li>
            <li><span class="current">{{ Sube.Name }}</span></li>
        </ul>
    </div>
</div>

<link rel="stylesheet" href="{{ PathOnStart }}css/frontend/sube.css?v=20260311k">

<!-- HERO -->
<section class="sube-hero">
    <div class="sube-hero__bg">
        {{ if Sube.SubeMediaPath }}
        <img src="{{ PathOnStart }}{{ Sube.SubeMediaPath }}" alt="{{ Sube.Name }}" class="sube-hero__bg-img">
        {{ else }}
        <img src="{{ PathOnStart }}files/defaults/sube/sube-default.png" alt="{{ Sube.Name }}" class="sube-hero__bg-img">
        {{ end }}
        <div class="sube-hero__overlay"></div>
    </div>
    <div class="container">
        <div class="sube-hero__inner">
            <div class="sube-hero__photo-wrap">
                {{ if Sube.SubeMediaPath }}
                <img src="{{ PathOnStart }}{{ Sube.SubeMediaPath }}" alt="{{ Sube.Name }}" class="sube-hero__photo">
                {{ else }}
                <img src="{{ PathOnStart }}files/defaults/sube/sube-default.png" alt="{{ Sube.Name }}" class="sube-hero__photo">
                {{ end }}
                {{ if Sube.Latitude != 0 && Sube.Longitude != 0 }}
                <a href="https://www.google.com/maps/dir/Current+Location/{{ Sube.Latitude }},{{ Sube.Longitude }}" target="_blank" rel="noopener" class="sube-hero__directions">
                    <i class="fas fa-route"></i> Yol Tarifi
                </a>
                {{ end }}
            </div>
            <div class="sube-hero__meta">
                <div class="sube-hero__info">
                    <h1 class="sube-hero__name">{{ Sube.Name }}</h1>
                    {{ if Sube.City != "" }}
                    <p class="sube-hero__location">
                        <i class="fas fa-map-marker-alt"></i>
                        {{ Sube.City }}{{ if Sube.District != "" }}, {{ Sube.District }}{{ end }}
                    </p>
                    {{ end }}
                </div>
                <div class="sube-hero__actions">
                    <a href="/randevu" class="sube-hero__randevu-btn">
                        <i class="fas fa-calendar-check"></i> Randevu Al
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAIN CONTENT -->
<section class="sube-main section-space">
    <div class="container">
        <div class="sube-layout">

            <!-- SOL: Dikey Tab Menü -->
            <aside class="sube-sidebar">
                <button class="sube-tabs-arrow sube-tabs-arrow--left" id="subeTabsArrowLeft" type="button" aria-label="Sola kaydır"><i class="fas fa-chevron-left"></i></button>
                <nav class="sube-tabs-vertical" id="subeTabs">
                    <button class="sube-tab active" data-tab="tanitim">GENEL TANITIM</button>
                    <button class="sube-tab" data-tab="doktorlar">DOKTORLARIMIZ</button>
                    <button class="sube-tab" data-tab="fotogaleri">FOTO GALERİ</button>
                    <button class="sube-tab" data-tab="ulasim">ULAŞIM</button>
                    <button class="sube-tab" data-tab="iletisim">İLETİŞİM</button>
                </nav>
                <button class="sube-tabs-arrow sube-tabs-arrow--right" id="subeTabsArrowRight" type="button" aria-label="Sağa kaydır"><i class="fas fa-chevron-right"></i></button>
            </aside>

            <!-- SAĞ: İçerik -->
            <div class="sube-content-area">

                <!-- GENEL TANITIM -->
                <div class="sube-panel active" id="tab-tanitim">
                    <div class="sube-card">
                        <h3 class="sube-card__title">Genel Tanıtım</h3>
                        {{ if Sube.Description != "" }}
                        <div class="sube-description">{{ Sube.Description }}</div>
                        {{ end }}
                        {{ if Sube.TransportationInfoHtml != "" }}
                        <div class="sube-html-content">{{ Sube.TransportationInfoHtml | raw }}</div>
                        {{ end }}
                        {{ if Sube.Description == "" && Sube.TransportationInfoHtml == "" }}
                        <p class="sube-empty-text">Merkez tanıtım bilgisi henüz eklenmemiş.</p>
                        {{ end }}
                    </div>
                </div>

                <!-- DOKTORLAR -->
                <div class="sube-panel" id="tab-doktorlar">
                    <div class="sube-card">
                        <h3 class="sube-card__title">Doktorlarımız</h3>
                        {{ if len(SubeDoktorlar) > 0 }}
                        <div class="sube-doktor-grid">
                            {{ range SubeDoktorlar }}
                            <div class="sube-doktor-kart">
                                <div class="sube-doktor-kart__foto">
                                    {{ if .PhotoPath != "" }}
                                    <img src="{{ PathOnStart }}{{ .PhotoPath }}" alt="{{ .PhotoAltText }}" title="{{ .PhotoTitle }}">
                                    {{ else }}
                                    <div class="sube-doktor-kart__foto-placeholder">
                                        <i class="fas fa-user-md"></i>
                                    </div>
                                    {{ end }}
                                </div>
                                <div class="sube-doktor-kart__info">
                                    <p class="sube-doktor-kart__brans">{{ .BransName }}</p>
                                    <h4 class="sube-doktor-kart__isim">{{ .Title }} {{ .FirstName }} {{ .LastName }}</h4>
                                </div>
                                <div class="sube-doktor-kart__butonlar">
                                    <a href="/randevu?doktor={{ .UrlName }}" class="sube-doktor-btn sube-doktor-btn--randevu">
                                        <i class="fas fa-calendar-alt"></i> Randevu Al
                                    </a>
                                    <a href="/doktorlarimiz/{{ .UrlName }}" class="sube-doktor-btn sube-doktor-btn--profil">
                                        <i class="fas fa-user"></i> Profili Gör
                                    </a>
                                </div>
                            </div>
                            {{ end }}
                        </div>
                        {{ else }}
                        <div class="sube-empty-state">
                            <i class="fas fa-user-md"></i>
                            <p>Bu merkeze ait doktor bilgisi henüz eklenmemiş.</p>
                        </div>
                        {{ end }}
                    </div>
                </div>


                <!-- FOTO GALERİ -->
                <div class="sube-panel" id="tab-fotogaleri">
                    <div class="sube-card">
                        <h3 class="sube-card__title">Foto Galeri</h3>
                        {{ if len(SubeGaleri) > 0 }}
                        <div class="foto-galeri-grid">
                            {{ range SubeGaleri }}
                            <div class="foto-galeri-item" onclick="openLightbox('{{ PathOnStart }}{{ .FilePath }}', '{{ .Caption }}')">
                                <img src="{{ PathOnStart }}{{ .FilePath }}" alt="{{ .AltText }}" title="{{ .Title }}" loading="lazy">
                                {{ if .Caption != "" }}
                                <div class="foto-galeri-caption">{{ .Caption }}</div>
                                {{ end }}
                            </div>
                            {{ end }}
                        </div>
                        {{ else }}
                        <p class="sube-empty-text">Henüz fotoğraf eklenmemiş.</p>
                        {{ end }}
                    </div>
                </div>

                <!-- ULAŞIM -->
                <div class="sube-panel" id="tab-ulasim">
                    <div class="sube-card">
                        <h3 class="sube-card__title">Ulaşım</h3>
                        {{ if Sube.Address != "" }}
                        <div class="ulasim-item">
                            <div class="ulasim-item__icon"><i class="fas fa-map-marker-alt"></i></div>
                            <div class="ulasim-item__content">
                                <span class="ulasim-item__label">Adres</span>
                                <span class="ulasim-item__value">{{ Sube.Address }}{{ if Sube.City != "" }}, {{ Sube.City }}{{ end }}{{ if Sube.District != "" }}, {{ Sube.District }}{{ end }}</span>
                            </div>
                        </div>
                        {{ end }}
                        {{ if Sube.TransportationInfo != "" }}
                        <div class="ulasim-item">
                            <div class="ulasim-item__icon ulasim-item__icon--blue"><i class="fas fa-bus"></i></div>
                            <div class="ulasim-item__content">
                                <span class="ulasim-item__label">Toplu Taşıma</span>
                                <span class="ulasim-item__value">{{ Sube.TransportationInfo }}</span>
                            </div>
                        </div>
                        {{ end }}
                        {{ if Sube.GoogleMapIframe != "" }}
                        <div class="map-container">{{ Sube.GoogleMapIframe | raw }}</div>
                        {{ end }}
                        {{ if Sube.Latitude != 0 && Sube.Longitude != 0 }}
                        <a href="https://www.google.com/maps/dir/Current+Location/{{ Sube.Latitude }},{{ Sube.Longitude }}" target="_blank" rel="noopener" class="sube-btn sube-btn--primary" style="margin-top:16px;">
                            <i class="fas fa-route"></i> Yol Tarifi Al
                        </a>
                        {{ end }}
                        {{ if Sube.Address == "" && Sube.TransportationInfo == "" && Sube.GoogleMapIframe == "" }}
                        <p class="sube-empty-text">Ulaşım bilgisi henüz eklenmemiş.</p>
                        {{ end }}
                    </div>
                </div>

                <!-- İLETİŞİM -->
                <div class="sube-panel" id="tab-iletisim">
                    <div class="sube-card">
                        <h3 class="sube-card__title">İletişim</h3>
                        <div class="iletisim-grid">
                            {{ if Sube.Phone != "" }}
                            <a href="tel:{{ Sube.Phone }}" class="iletisim-card">
                                <div class="iletisim-card__icon"><i class="fas fa-phone"></i></div>
                                <div class="iletisim-card__content">
                                    <span class="iletisim-card__label">Telefon</span>
                                    <span class="iletisim-card__value">{{ Sube.Phone }}</span>
                                </div>
                            </a>
                            {{ end }}
                            {{ if Sube.Email != "" }}
                            <a href="mailto:{{ Sube.Email }}" class="iletisim-card">
                                <div class="iletisim-card__icon iletisim-card__icon--red"><i class="fas fa-envelope"></i></div>
                                <div class="iletisim-card__content">
                                    <span class="iletisim-card__label">E-posta</span>
                                    <span class="iletisim-card__value">{{ Sube.Email }}</span>
                                </div>
                            </a>
                            {{ end }}
                            {{ if Sube.Fax != "" }}
                            <div class="iletisim-card">
                                <div class="iletisim-card__icon iletisim-card__icon--purple"><i class="fas fa-fax"></i></div>
                                <div class="iletisim-card__content">
                                    <span class="iletisim-card__label">Faks</span>
                                    <span class="iletisim-card__value">{{ Sube.Fax }}</span>
                                </div>
                            </div>
                            {{ end }}
                            {{ if Sube.Address != "" }}
                            <div class="iletisim-card">
                                <div class="iletisim-card__icon iletisim-card__icon--green"><i class="fas fa-map-marker-alt"></i></div>
                                <div class="iletisim-card__content">
                                    <span class="iletisim-card__label">Adres</span>
                                    <span class="iletisim-card__value">{{ Sube.Address }}{{ if Sube.City != "" }}, {{ Sube.City }}{{ end }}</span>
                                </div>
                            </div>
                            {{ end }}
                        </div>
                        {{ if Sube.Phone == "" && Sube.Email == "" && Sube.Address == "" }}
                        <p class="sube-empty-text">İletişim bilgisi henüz eklenmemiş.</p>
                        {{ end }}
                    </div>
                </div>

            </div><!-- /.sube-content-area -->
        </div><!-- /.sube-layout -->

        <!-- MERKEZ ÖZELLİKLERİ (Anlaşmalı Kurumlar) -->
        {{ if len(AnlasmaliKurumlar) > 0 }}
        <div class="merkez-ozellikler">
            <h2 class="merkez-ozellikler__title">Anlaşmalı Kurumlar</h2>
            <div class="merkez-ozellikler__divider"></div>
            <div class="merkez-ozellikler__grid">
                {{ range AnlasmaliKurumlar }}
                <div class="ozellik-kart">
                    <div class="ozellik-kart__icon">
                        {{ if .Type == "sigorta" }}<i class="fas fa-shield-alt"></i>
                        {{ else if .Type == "kurumsal" }}<i class="fas fa-building"></i>
                        {{ else if .Type == "universite" }}<i class="fas fa-graduation-cap"></i>
                        {{ else if .Type == "devlet" }}<i class="fas fa-landmark"></i>
                        {{ else }}<i class="fas fa-handshake"></i>{{ end }}
                    </div>
                    <span class="ozellik-kart__name">{{ .Name }}</span>
                </div>
                {{ end }}
            </div>
        </div>
        {{ end }}

    </div>
</section>

<script>
window.subeUrlName = '{{ Sube.UrlName }}';
</script>
<script src="{{ PathOnStart }}js/frontend/sube.js?v=20260311e"></script>
