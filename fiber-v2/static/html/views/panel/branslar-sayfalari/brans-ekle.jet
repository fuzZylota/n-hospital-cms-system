<link rel="stylesheet" href="{{ PathOnStart }}css/panel/brans-ekle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="icon-building"></i>
                    Yeni Bölüm Ekle
                </h1>
                <p class="page-subtitle">Hastane bölümü için yeni bir departman oluşturun</p>
            </div>
            <div class="page-actions">
                <a href="/panel/branslar" class="btn btn-secondary">
                    <i class="icon-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <form id="bransForm" class="brans-form" novalidate action="/backend/add-branch" method="post" enctype="multipart/form-data">
            <!-- Basic Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-info-circle"></i>
                        Temel Bilgiler
                    </h2>
                    <p class="section-description">Bölümün temel bilgilerini girin</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name" class="form-label required">Bölüm Adı</label>
                            <input type="text" id="name" name="name" class="form-input" 
                                   placeholder="örn: Kardiyoloji, Nöroloji, Ortopedi" required>
                            <div class="form-help">Bölümün görüntülenecek adı</div>
                        </div>
                        <div class="form-group">
                            <label for="url_name" class="form-label">URL Adı</label>
                            <input type="text" id="url_name" name="url_name" class="form-input" 
                                   placeholder="kardiyoloji, noroloji, ortopedi">
                            <div class="form-help">Boş bırakılırsa otomatik oluşturulur</div>
                        </div>
                        <div class="form-group">
                            <label for="sid" class="form-label">Şube</label>
                            <select id="sid" name="sid" class="form-select">
                                <option value="">Şube Seçin</option>
                                {{ range Subeler }}
                                <option value="{{ .Sid }}">{{ .Name }}</option>
                                {{ end }}
                            </select>
                            <div class="form-help">Bölüm'e bir şube bağlayabilirsiniz. Eğer bağlamazsanız, sistem bölüm'ün bütün hastanelerde var olduğunu varsayacaktır. Karışıklıkların önlenmesi için, aynı isimdeki bölümleri ya bir şube'ye atayarak, ya da şubesiz olarak, bütün hastanelerde görünecek şekilde ayarlayın.</div>
                        </div>
                        <div class="form-group">
                            <label for="head_drid" class="form-label">Başhekim</label>
                            <select id="head_drid" name="head_drid" class="form-select">
                                <option value="">Başhekim Seçin</option>
                                {{ range HeadDoctors }}
                                <option value="{{ .Drid }}">{{ .Title }} {{ .FirstName }} {{ .LastName }}</option>
                                {{ end }}
                            </select>
                            <div class="form-help">Bu bölümün başhekimi</div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="is_active" class="form-label">Aktif Durumu</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="is_active" name="is_active" checked>
                                <label for="is_active" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Aktif</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="description" class="form-label">Açıklama</label>
                        <textarea id="description" name="description" class="form-textarea" 
                                  rows="3" placeholder="Bölüm hakkında detaylı açıklama yazın..."></textarea>
                    </div>
                    <div class="form-group">
                        <label for="short_description" class="form-label">Kısa Açıklama</label>
                        <textarea id="short_description" name="short_description" class="form-textarea" 
                                  rows="2" placeholder="Bölüm hakkında kısa açıklama..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Services Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-list"></i>
                        Hizmetler
                    </h2>
                    <p class="section-description">Bu bölümün sunduğu hizmetler</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="services_input" class="form-label">Hizmet Listesi</label>
                        <textarea id="services_input" class="form-textarea" 
                                  rows="4" placeholder="Her satıra bir hizmet yazın..."></textarea>
                        <div class="form-help">Her satıra bir hizmet yazın, örn: EKG, Ekokardiyografi, Stres Testi</div>
                        <!-- Hidden input for processed JSON data -->
                        <input type="hidden" id="services" name="services" value="[]">
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-phone"></i>
                        İletişim Bilgileri
                    </h2>
                    <p class="section-description">Bölümün iletişim detayları</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="phone" class="form-label">Telefon</label>
                            <input type="tel" id="phone" name="phone" class="form-input" 
                                   placeholder="+90 212 555 00 00">
                        </div>
                        <div class="form-group">
                            <label for="email" class="form-label">E-posta</label>
                            <input type="email" id="email" name="email" class="form-input" 
                                   placeholder="bolum@hastane.com">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Branch Image Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-image"></i>
                        Bölüm Görseli
                    </h2>
                    <p class="section-description">Bölümün görseli veya temsili fotoğrafı</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="mid" class="form-label">Bölüm Fotoğrafı</label>
                        <div class="file-upload-area" data-target="mid">
                            <div class="file-upload-content">
                                <i class="icon-upload"></i>
                                <p class="file-upload-text">Bölüm fotoğrafını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                            </div>
                            <input type="file" id="mid" name="mid" 
                                   class="file-input" accept="image/*">
                            <div class="file-preview" style="display: none;">
                                <img class="preview-image" src="" alt="Preview">
                                <button type="button" class="file-remove">
                                    <i class="icon-x"></i>
                                </button>
                            </div>
                        </div>
                        <div class="file-meta-inputs">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="brans_media_alt_text" class="form-label">Görsel Alt Metni</label>
                                    <input type="text" id="brans_media_alt_text" name="brans_media_alt_text" 
                                           class="form-input" placeholder="Bölüm fotoğrafı için alternatif metin">
                                </div>
                                <div class="form-group">
                                    <label for="brans_media_title" class="form-label">Görsel Başlığı</label>
                                    <input type="text" id="brans_media_title" name="brans_media_title" 
                                           class="form-input" placeholder="Bölüm fotoğrafı için başlık metni">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                    <i class="icon-x"></i>
                    İptal
                </button>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="icon-check"></i>
                    <span class="btn-text">Bölümü Kaydet</span>
                    <div class="btn-loader" style="display: none;">
                        <div class="spinner"></div>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="icon-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message">Bölüm başarıyla oluşturuldu.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script src="{{ PathOnStart }}js/panel/brans-ekle.js"></script>