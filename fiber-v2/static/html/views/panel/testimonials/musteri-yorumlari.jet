<link rel="stylesheet" href="{{ PathOnStart }}css/panel/musteri-yorumlari.css">

<div class="page-container">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-comment-dots"></i>
                    Müşteri Yorumları
                </h1>
                <p class="page-subtitle">Ziyaretçi yorumlarını yönetin</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-secondary" id="refreshBtn">
                    <i class="fas fa-sync-alt"></i>
                    Yenile
                </button>
            </div>
        </div>
    </div>

    <div class="filters-section">
        <div class="filters-content">
            <div class="search-group">
                <form class="search-form" onsubmit="return false;">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="searchInput" class="search-input" 
                               placeholder="İsim, başlık veya içerik ile ara..."
                               autocomplete="off" spellcheck="false">
                        <button class="search-clear" id="searchClear" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </form>
                <button class="search-filter-btn" id="filterBtn" title="Filtrele">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div class="filter-group">
                <select id="statusFilter" class="filter-select">
                    <option value="all">Tüm Durumlar</option>
                    <option value="active">Aktif</option>
                    <option value="inactive">Pasif</option>
                </select>
                <select id="sortBy" class="filter-select">
                    <option value="first_name">Ad</option>
                    <option value="last_name">Soyad</option>
                    <option value="occupation">Meslek</option>
                    <option value="content">İçerik</option>
                </select>
                <select id="sortOrder" class="filter-select">
                    <option value="ASC">Artan</option>
                    <option value="DESC">Azalan</option>
                </select>
            </div>
        </div>
    </div>

    <div class="page-content">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">Yorumlar Listesi</h3>
                <div class="table-actions">
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="table">
                            <i class="fas fa-list"></i>
                        </button>
                        <button class="view-btn" data-view="grid">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="table-wrapper" id="tableView">
                <table class="data-table" id="testimonialsTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-column="name">
                                <span>Ad Soyad</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="occupation">
                                <span>Meslek</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="rating">
                                <span>Puan</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th>
                                <span>İçerik</span>
                            </th>
                            <th class="sortable" data-column="is_active">
                                <span>Durum</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="created_at">
                                <span>Oluşturma</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="actions-column">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{if len(Testimonials) > 0}}
                            {{range Testimonials}}
                            <tr data-id="{{ .Tid }}">
                                <td>
                                    <div class="cell-content">
                                        <div class="user-info">
                                            <div class="user-avatar">
                                                {{ if .CustomerPicturePath != "" }}
                                                <img src="{{ PathOnStart }}{{ .CustomerPicturePath }}" alt="{{ .CustomerPictureAltText ? .CustomerPictureAltText : "Müşteri Fotoğrafı" }}">
                                                {{ else }}
                                                <i class="fas fa-user"></i>
                                                {{ end }}
                                            </div>
                                            <div class="user-details">
                                                <div class="primary-text">{{ .FirstName }} {{ .LastName }}</div>
                                                <div class="secondary-text">ID: {{ .Tid }}</div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .Occupation }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .Rating }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="secondary-text">{{ .Content }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .IsActive }}
                                        <span class="status-badge active">
                                            <i class="fas fa-check-circle"></i>
                                            Aktif
                                        </span>
                                        {{else}}
                                        <span class="status-badge inactive">
                                            <i class="fas fa-pause-circle"></i>
                                            Pasif
                                        </span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ mthr(.CreatedAt, User.Timezone) }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="actions-wrapper">
                                        <button class="action-trigger" data-id="{{ .Tid }}">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <div class="action-dropdown">
                                            <a class="action-item view" href="/panel/musteri-yorumu/{{ .Tid }}">
                                                <i class="fas fa-eye"></i>
                                                <span>Görüntüle</span>
                                            </a>
                                            <a class="action-item edit" href="/panel/musteri-yorumu/{{ .Tid }}/duzenle">
                                                <i class="fas fa-edit"></i>
                                                <span>Düzenle</span>
                                            </a>
                                            <button class="action-item delete" data-id="{{ .Tid }}" data-name="{{ .FirstName }} {{ .LastName }}">
                                                <i class="fas fa-trash"></i>
                                                <span>Sil</span>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        {{else}}
                            <tr class="empty-row">
                                <td colspan="6">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-comment-dots"></i>
                                        </div>
                                        <div class="empty-title">Henüz yorum bulunmuyor</div>
                                        <div class="empty-description">Yorum eklendiğinde burada görünecek.</div>
                                    </div>
                                </td>
                            </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>

            <div class="grid-wrapper" id="gridView" style="display: none;">
                <div class="users-grid">
                    {{if len(Testimonials) > 0}}
                        {{range Testimonials}}
                        <div class="user-card" data-id="{{ .Tid }}">
                            <div class="card-header">
                                <div class="user-avatar">
                                    {{ if .CustomerPicturePath != "" }}
                                        <img src="{{ PathOnStart }}{{ .CustomerPicturePath }}" alt="{{ .FirstName }} {{ .LastName }}">
                                    {{ else }}
                                        <i class="fas fa-user"></i>
                                    {{ end }}
                                </div>
                                <div class="card-title">{{ .FirstName }} {{ .LastName }}</div>
                                <div class="card-actions">
                                    <button class="action-trigger" data-id="{{ .Tid }}">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="action-dropdown">
                                            <a class="action-item view" href="/panel/musteri-yorumu/{{ .Tid }}">
                                                <i class="fas fa-eye"></i>
                                                <span>Görüntüle</span>
                                            </a>
                                            <a class="action-item edit" href="/panel/musteri-yorumu/{{ .Tid }}/duzenle">
                                                <i class="fas fa-edit"></i>
                                                <span>Düzenle</span>
                                            </a>
                                        <button class="action-item delete" data-id="{{ .Tid }}" data-name="{{ .FirstName }} {{ .LastName }}">
                                            <i class="fas fa-trash"></i>
                                            <span>Sil</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-field">
                                    <div class="field-label">Meslek</div>
                                    <div class="field-value">{{ .Occupation }}</div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">Puan</div>
                                    <div class="field-value">{{ .Rating }}</div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">İçerik</div>
                                    <div class="field-value">{{ .Content }}</div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="card-status">
                                    {{if .IsActive }}
                                    <span class="status-badge active">
                                        <i class="fas fa-check-circle"></i>
                                        Aktif
                                    </span>
                                    {{else}}
                                    <span class="status-badge inactive">
                                        <i class="fas fa-pause-circle"></i>
                                        Pasif
                                    </span>
                                    {{end}}
                                </div>
                                <div class="card-date">{{ mthr(.CreatedAt, User.Timezone) }}</div>
                            </div>
                        </div>
                        {{end}}
                    {{else}}
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-comment-dots"></i>
                            </div>
                            <div class="empty-title">Henüz yorum bulunmuyor</div>
                            <div class="empty-description">Yorum eklendiğinde burada görünecek.</div>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>

    {{if Count > 0}}
    <div class="pagination-section">
        <div class="pagination-info">
            <span>Toplam {{Count}} kayıt gösteriliyor</span>
        </div>
        <div class="pagination-wrapper">
            <nav class="pagination" id="pagination"></nav>
        </div>
        <div class="pagination-controls">
            <select id="perPage" class="per-page-select">
                <option value="10">10 / sayfa</option>
                <option value="25">25 / sayfa</option>
                <option value="50">50 / sayfa</option>
                <option value="100">100 / sayfa</option>
            </select>
        </div>
    </div>
    {{end}}
</div>

<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="fas fa-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="fas fa-times"></i>
    </button>
    </div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="fas fa-exclamation-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<script>
    function decodeHtmlEntities(encoded) {
        const txt = document.createElement('textarea');
        txt.innerHTML = encoded;
        return txt.value;
    }

    const escaped = '{{stj(Testimonials)}}';
    const decoded = decodeHtmlEntities(escaped);
    const data = decoded ? JSON.parse(decoded) : [];
    window.pageData = {
        testimonials: data,
        count: parseInt("{{ Count ? Count : 0 }}"),
        currentPage: parseInt("{{ Page ? Page : 1 }}"),
        perPage: parseInt("{{ 10 }}")
    };
    
    // Filter functionality
    document.addEventListener('DOMContentLoaded', function() {
        const filterBtn = document.getElementById('filterBtn');
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const sortBy = document.getElementById('sortBy');
        const sortOrder = document.getElementById('sortOrder');
        
        filterBtn.addEventListener('click', function() {
            const query = searchInput.value.trim();
            const status = statusFilter.value;
            const sortByValue = sortBy.value;
            const sortOrderValue = sortOrder.value;
            
            // Build query parameters
            const params = new URLSearchParams();
            
            if (query) {
                params.append('query', query);
            }
            if (status && status !== 'all') {
                params.append('status', status);
            }
            if (sortByValue) {
                params.append('sort_by', sortByValue);
            }
            if (sortOrderValue) {
                params.append('sort_order', sortOrderValue);
            }
            
            // Redirect to same page with query parameters
            const currentUrl = window.location.pathname;
            const queryString = params.toString();
            const newUrl = queryString ? `${currentUrl}?${queryString}` : currentUrl;
            
            window.location.href = newUrl;
        });
        
        // Prevent form submission on Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                filterBtn.click();
            }
        });
        
        // Prevent any automatic form submission
        searchInput.addEventListener('submit', function(e) {
            e.preventDefault();
        });
        
        // Ensure no automatic submission
        searchInput.setAttribute('autocomplete', 'off');
        searchInput.setAttribute('spellcheck', 'false');
    });
</script>
<script src="{{ PathOnStart }}js/panel/musteri-yorumlari.js"></script>

