<section class="hizli-randevu-strip">
    <div class="container">
        <div class="hizli-randevu-strip__inner">
            <div class="hizli-randevu-strip__form-box">
                <div class="hizli-randevu-strip__form-title">
                    <i class="fas fa-calendar-check"></i>
                    Hızlı Randevu Al
                </div>
                <form id="stripRandevuForm" class="hizli-randevu-strip__form-grid" novalidate>
                    <input type="text" name="patient_first_name" id="stripFirstName" aria-label="Adınız" placeholder="Adınız*" class="hizli-randevu-strip__input" required>
                    <input type="text" name="patient_last_name" id="stripLastName" aria-label="Soyadınız" placeholder="Soyadınız*" class="hizli-randevu-strip__input" required>
                    <input type="tel" name="patient_phone" id="stripPhone" aria-label="Telefon numaranız" placeholder="Telefon Numaranız*" class="hizli-randevu-strip__input" required>
                    <select name="sid" id="stripBranch" aria-label="Merkez seçiniz" class="hizli-randevu-strip__input hizli-randevu-strip__select">
                        <option value="">Merkez Seçiniz</option>
                        {{ range index2, Sube := AllSubeler }}
                            <option value="{{ Sube.Sid }}">{{ Sube.Name }}</option>
                        {{ end }}
                    </select>
                    <div class="hizli-randevu-strip__kvkk">
                        <label for="stripKVKK" class="checkbox-label">
                            <input type="checkbox" id="stripKVKK" required>
                            <span><a href="/kurumsal/kvkk" target="_blank" rel="noopener">KVKK aydınlatma metnini</a> okudum ve onaylıyorum.</span>
                        </label>
                    </div>
                    <div style="transform:scale(0.82);transform-origin:left center;margin-bottom:-8px;">
                        <div id="stripRecaptchaWidget"></div>
                        <input type="hidden" id="stripRecaptchaToken">
                    </div>
                    <button type="submit" class="hizli-randevu-strip__btn">
                        Gönder <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
                <div class="hizli-randevu-strip__feedback" id="stripFeedback"></div>
            </div>
            <div class="hizli-randevu-strip__cards">
                <a href="/kurumsal/anlasmali-kurumlar" class="hizli-randevu-strip__card">
                    <div class="hizli-randevu-strip__card-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <div class="hizli-randevu-strip__card-content">
                        <span class="hizli-randevu-strip__card-label">Kurumsal</span>
                        <span class="hizli-randevu-strip__card-value">Anlaşmalı Kurumlar</span>
                    </div>
                    <i class="fas fa-chevron-right hizli-randevu-strip__card-arrow"></i>
                </a>
                <a href="/ulasim" class="hizli-randevu-strip__card">
                    <div class="hizli-randevu-strip__card-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="hizli-randevu-strip__card-content">
                        <span class="hizli-randevu-strip__card-label">Bize Ulaşın</span>
                        <span class="hizli-randevu-strip__card-value">Ulaşım</span>
                    </div>
                    <i class="fas fa-chevron-right hizli-randevu-strip__card-arrow"></i>
                </a>
            </div>
        </div>
    </div>
</section>
{{ if Options.Options.RecaptchaSiteKey != "" }}
<script>
/* Bu form, banner altinda dogrudan gorunur - hizli randevu panelinin
 * aksine kullanici etkilesimine kadar ertelenemez (bkz. fast-randevu.jet
 * / dd38219: recaptcha/api.js artik panel acilana kadar yuklenmiyor).
 * Bu strip formu o script'in yan etkisine (grecaptcha global'inin
 * zaten var olmasi) sessizce bagimliydi; panel hic acilmazsa grecaptcha
 * hicbir zaman tanimlanmiyor ve asagidaki polling sonsuza kadar bekliyordu.
 * window.fastRecaptchaScriptInjected bayragini fast-randevu.jet ile
 * paylasarak script'in iki kez yuklenmesini onluyoruz. */
(function(){
    if (window.fastRecaptchaScriptInjected) return;
    var s = document.createElement('script');
    s.src = 'https://www.google.com/recaptcha/api.js';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
    window.fastRecaptchaScriptInjected = true;
})();
</script>
{{ end }}
<script>
var stripRecaptchaToken = '';
window.onStripRecaptchaVerified = function(token) {
    stripRecaptchaToken = token;
};
window.onStripRecaptchaExpired = function() {
    stripRecaptchaToken = '';
};
function renderStripRecaptcha() {
    var widget = document.getElementById('stripRecaptchaWidget');
    if (!widget || widget.childElementCount > 0) return;
    try {
        grecaptcha.render('stripRecaptchaWidget', {
            sitekey: '{{ Options.Options.RecaptchaSiteKey }}',
            callback: 'onStripRecaptchaVerified',
            'expired-callback': 'onStripRecaptchaExpired'
        });
    } catch(e) {}
}
document.addEventListener('DOMContentLoaded', function() {
    var checkInterval = setInterval(function() {
        if (typeof grecaptcha !== 'undefined' && typeof grecaptcha.render !== 'undefined') {
            clearInterval(checkInterval);
            setTimeout(renderStripRecaptcha, 300);
        }
    }, 200);

    var form = document.getElementById('stripRandevuForm');
    if (!form) return;
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        var firstName = document.getElementById('stripFirstName').value.trim();
        var lastName = document.getElementById('stripLastName').value.trim();
        var phone = document.getElementById('stripPhone').value.trim();
        var sid = document.getElementById('stripBranch').value;
        var kvkk = document.getElementById('stripKVKK').checked;
        var feedback = document.getElementById('stripFeedback');
        if (!firstName || !lastName || !phone) {
            feedback.innerHTML = '<span style="color:#ef4444">Lütfen zorunlu alanları doldurunuz.</span>';
            return;
        }
        if (!kvkk) {
            feedback.innerHTML = '<span style="color:#ef4444">Lütfen KVKK metnini onaylayınız.</span>';
            return;
        }
        if (!stripRecaptchaToken) {
            feedback.innerHTML = '<span style="color:#ef4444">Lütfen güvenlik doğrulamasını tamamlayınız.</span>';
            return;
        }
        var btn = form.querySelector('.hizli-randevu-strip__btn');
        btn.disabled = true;
        btn.innerHTML = 'Gönderiliyor...';
        fetch('/backend/add-randevu-request', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                patient_first_name: firstName,
                patient_last_name: lastName,
                patient_phone: phone,
                sid: sid,
                message: '',
                recaptcha_token: stripRecaptchaToken
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.status === 200 || data.status === 201) {
                feedback.innerHTML = '<span style="color:#16a34a">✓ Talebiniz alındı, en kısa sürede sizi arayacağız.</span>';
                form.reset();
                stripRecaptchaToken = '';
                setTimeout(function() { feedback.innerHTML = ''; }, 5000);

            } else {
                feedback.innerHTML = '<span style="color:#ef4444">' + (data.message || 'Bir hata oluştu, lütfen tekrar deneyiniz.') + '</span>';
            }
            btn.disabled = false;
            btn.innerHTML = 'Gönder <i class="fas fa-arrow-right"></i>';
        })
        .catch(function() {
            feedback.innerHTML = '<span style="color:#ef4444">Bir hata oluştu, lütfen tekrar deneyiniz.</span>';
            btn.disabled = false;
            btn.innerHTML = 'Gönder <i class="fas fa-arrow-right"></i>';
        });
    });
});
</script>
