<link rel="stylesheet" href="{{ PathOnStart }}css/panel/haber.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/haberler" class="breadcrumb-link">
                        <i class="fas fa-newspaper"></i>
                        Haberler
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">{{ Haber.Title }}</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">{{ Haber.Title }}</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-calendar"></i>
                                {{ mthr(Haber.CreatedAt, User.Timezone) }}
                            </span>
                            <span class="meta-item">
                                <i class="fas fa-clock"></i>
                                Son güncelleme: {{ mthr(Haber.UpdatedAt, User.Timezone) }}
                            </span>
                        </div>
                    </div>
                </h1>
                {{if Haber.Summary}}
                <p class="page-subtitle">{{ Haber.Summary }}</p>
                {{end}}
            </div>
            <div class="page-actions">
                <div class="status-indicator">
                    {{if Haber.IsFeatured}}
                    <span class="status-badge featured">
                        <i class="fas fa-star"></i>
                        Öne Çıkan
                    </span>
                    {{end}}
                    {{if Haber.IsPublished}}
                    <span class="status-badge published">
                        <i class="fas fa-check-circle"></i>
                        Yayınlanmış
                    </span>
                    {{else}}
                    <span class="status-badge draft">
                        <i class="fas fa-edit"></i>
                        Taslak
                    </span>
                    {{end}}
                </div>
                <div class="action-buttons">
                    <a href="/panel/haberler/{{ Haber.Hid }}/duzenle" class="btn btn-primary">
                        <i class="fas fa-edit"></i>
                        Düzenle
                    </a>
                    <button class="btn btn-danger" id="deleteHaberBtn" data-id="{{ Haber.Hid }}" data-name="{{ Haber.Title }}">
                        <i class="fas fa-trash"></i>
                        <span class="btn-text">Sil</span>
                        <div class="btn-loader" style="display: none;">
                            <div class="spinner"></div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Sections -->
    <div class="content-grid">
        <!-- Basic Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <h3 class="card-title">Temel Bilgiler</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item">
                        <label class="info-label">Haber Başlığı</label>
                        <div class="info-value">{{ Haber.Title }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">URL Adı</label>
                        <div class="info-value">{{ Haber.UrlName }}</div>
                    </div>
                    {{if Haber.Summary}}
                    <div class="info-item full-width">
                        <label class="info-label">Özet</label>
                        <div class="info-value">{{ Haber.Summary }}</div>
                    </div>
                    {{end}}
                    {{if Haber.CoverPath}}
                    <div class="info-item">
                        <label class="info-label">Haber Görseli</label>
                        <div class="info-value">
                            <div class="image-preview" data-media-id="{{ Haber.CoverMid }}">
                                <img src="{{ PathOnStart }}{{ Haber.CoverPath }}" alt="{{ Haber.CoverAltText }}" title="{{ Haber.CoverTitle }}" class="preview-image zoomable">
                                <div class="image-overlay">
                                    <i class="icon-maximize"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{end}}
                    <div class="info-item">
                        <label class="info-label">Durum</label>
                        <div class="info-value">
                            {{if Haber.IsPublished}}
                            <span class="status-badge published">
                                <i class="fas fa-check-circle"></i>
                                Yayınlanmış
                            </span>
                            {{else}}
                            <span class="status-badge draft">
                                <i class="fas fa-edit"></i>
                                Taslak
                            </span>
                            {{end}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-file-alt"></i>
                </div>
                <h3 class="card-title">İçerik Bilgileri</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item full-width">
                        <label class="info-label">İçerik</label>
                        <div class="info-value">
                            <div class="content-preview">{{ Haber.Content }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Publication Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <h3 class="card-title">Yayın Bilgileri</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item">
                        <label class="info-label">Kategori</label>
                        <div class="info-value">{{ Haber.Category }}</div>
                    </div>
                    {{if Haber.Author}}
                    <div class="info-item">
                        <label class="info-label">Yazar</label>
                        <div class="info-value">{{ Haber.Author }}</div>
                    </div>
                    {{end}}
                    <div class="info-item">
                        <label class="info-label">Yayın Tarihi</label>
                        <div class="info-value">{{ mthr(Haber.PublishDate, User.Timezone) }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Görüntülenme</label>
                        <div class="info-value">{{ Haber.ViewsCount }}</div>
                    </div>
                    {{if len(Haber.Tags) > 0}}
                    <div class="info-item full-width">
                        <label class="info-label">Etiketler</label>
                        <div class="info-value">
                            <div class="tags-container">
                                {{range Haber.Tags}}
                                <span class="tag">{{ . }}</span>
                                {{end}}
                            </div>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>

        <!-- SEO Information Section -->
        {{if Haber.SeoTitle || Haber.SeoDescription || Haber.SeoKeywords}}
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3 class="card-title">SEO Bilgileri</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    {{if Haber.SeoTitle}}
                    <div class="info-item">
                        <label class="info-label">SEO Başlığı</label>
                        <div class="info-value">{{ Haber.SeoTitle }}</div>
                    </div>
                    {{end}}
                    {{if Haber.SeoDescription}}
                    <div class="info-item full-width">
                        <label class="info-label">SEO Açıklaması</label>
                        <div class="info-value">{{ Haber.SeoDescription }}</div>
                    </div>
                    {{end}}
                    {{if Haber.SeoKeywords}}
                    <div class="info-item full-width">
                        <label class="info-label">SEO Anahtar Kelimeler</label>
                        <div class="info-value">{{ Haber.SeoKeywords }}</div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
        {{end}}
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Haberi Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı haberi silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz ve tüm ilişkili veriler silinecektir.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="icon-trash-2"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="imageZoomModal" class="modal image-modal" style="display: none;">
    <div class="modal-content image-content">
        <button class="modal-close" onclick="closeImageModal()">
            <i class="icon-x"></i>
        </button>
        <div class="image-container">
            <img id="zoomedImage" src="" alt="Zoomed Image">
        </div>
        <div class="image-info">
            <span id="imageTitle">Görsel</span>
            <div class="image-actions">
                <button class="btn btn-sm btn-secondary" onclick="downloadImage()">
                    <i class="icon-download"></i>
                    İndir
                </button>
                <button class="btn btn-sm btn-secondary" onclick="openImageInNewTab()">
                    <i class="icon-external-link"></i>
                    Yeni Sekmede Aç
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="icon-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="icon-alert-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<script>
    // Pass data to JavaScript
    window.haberData = {
        id: "{{ Haber.Hid }}",
        title: "{{ Haber.Title }}"
    };
</script>
<script src="{{ PathOnStart }}js/panel/haber.js"></script>