<link rel="stylesheet" href="{{ PathOnStart }}css/panel/musteri-yorumu-duzenle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-edit"></i>
                    Müşteri Yorumunu Düzenle
                </h1>
                <p class="page-subtitle">{{ Testimonial.FirstName }} {{ Testimonial.LastName }} müşteri yorumunu düzenleyin</p>
            </div>
            <div class="page-actions">
                <a href="/panel/musteri-yorumu/{{ Testimonial.Tid }}" class="btn btn-secondary">
                    <i class="fas fa-eye"></i>
                    Görüntüle
                </a>
                <a href="/panel/musteri-yorumlari" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="forms-container">
            <!-- General Information Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-user-edit"></i>
                        Genel Bilgiler
                    </h2>
                    <p class="section-description">Müşteri yorumunun genel bilgilerini düzenleyin</p>
                </div>
                <div class="section-content">
                    <form id="generalForm" class="general-form" novalidate>
                        <!-- Hidden inputs for old values -->
                        <input type="hidden" name="old_first_name" value="{{ Testimonial.FirstName }}">
                        <input type="hidden" name="old_last_name" value="{{ Testimonial.LastName }}">
                        <input type="hidden" name="old_occupation" value="{{ Testimonial.Occupation }}">
                        <input type="hidden" name="old_content" value="{{ Testimonial.Content }}">
                        <input type="hidden" name="old_rating" value="{{ Testimonial.Rating }}">
                        <input type="hidden" name="old_is_active" value="{{ Testimonial.IsActive }}">

                        <!-- Customer Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">Müşteri Bilgileri</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="first_name" class="form-label required">Ad</label>
                                    <input type="text" id="first_name" name="first_name" class="form-input" 
                                           value="{{ Testimonial.FirstName }}" required>
                                </div>
                                <div class="form-group">
                                    <label for="last_name" class="form-label required">Soyad</label>
                                    <input type="text" id="last_name" name="last_name" class="form-input" 
                                           value="{{ Testimonial.LastName }}" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="occupation" class="form-label required">Meslek</label>
                                <input type="text" id="occupation" name="occupation" class="form-input" 
                                       value="{{ Testimonial.Occupation }}" required>
                            </div>
                        </div>

                        <!-- Testimonial Content -->
                        <div class="form-group-section">
                            <h3 class="group-title">Yorum İçeriği</h3>
                            <div class="form-group">
                                <label for="content" class="form-label required">Yorum Metni</label>
                                <textarea id="content" name="content" class="form-textarea" 
                                          rows="6" required maxlength="1000">{{ Testimonial.Content }}</textarea>
                                <div class="character-counter">
                                    <span id="contentCounter">{{ len(Testimonial.Content) }}</span>/1000
                                </div>
                            </div>
                        </div>

                        <!-- Rating and Status -->
                        <div class="form-group-section">
                            <h3 class="group-title">Değerlendirme ve Durum</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="rating" class="form-label required">Puan (1-5)</label>
                                    <div class="rating-input-group">
                                        <input type="number" id="rating" name="rating" class="form-input rating-input" 
                                               value="{{ Testimonial.Rating }}" min="0" max="5" step="0.1" required>
                                        <div class="star-display" id="starDisplay">
                                            <!-- Stars will be populated by JavaScript -->
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="is_active" class="form-label">Aktif Durumu</label>
                                    <div class="toggle-switch">
                                        <input type="checkbox" id="is_active" name="is_active" {{ if Testimonial.IsActive }}checked{{ end }}>
                                        <label for="is_active" class="toggle-label">
                                            <span class="toggle-slider"></span>
                                            <span class="toggle-text">{{ if Testimonial.IsActive }}Aktif{{ else }}Pasif{{ end }}</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" id="generalSubmitBtn">
                                <i class="fas fa-save"></i>
                                <span class="btn-text">Genel Bilgileri Kaydet</span>
                                <div class="btn-loader" style="display: none;">
                                    <div class="spinner"></div>
                                </div>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Customer Picture Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-image"></i>
                        Müşteri Fotoğrafı
                    </h2>
                    <p class="section-description">Müşteri fotoğrafını yönetin</p>
                </div>
                <div class="section-content">
                    <!-- Current Picture Display -->
                    <div class="current-media-section">
                        <h3 class="group-title">Mevcut Fotoğraf</h3>
                        <div class="media-grid">
                            <div class="media-item">
                                <div class="media-header">
                                    <h4 class="media-title">Müşteri Fotoğrafı</h4>
                                    {{ if Testimonial.CustomerPicturePath }}
                                    <button type="button" class="btn-delete-media" data-type="customer_picture" data-tid="{{ Testimonial.Tid }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    {{ end }}
                                </div>
                                <div class="media-preview">
                                    {{ if Testimonial.CustomerPicturePath }}
                                    <img src="{{ PathOnStart }}{{ Testimonial.CustomerPicturePath }}" alt="{{ Testimonial.CustomerPictureAltText }}" 
                                         title="{{ Testimonial.CustomerPictureTitle }}" class="preview-image">
                                    <div class="media-info">
                                        <div class="info-item">
                                            <strong>Alt Text:</strong> {{ Testimonial.CustomerPictureAltText }}
                                        </div>
                                        <div class="info-item">
                                            <strong>Title:</strong> {{ Testimonial.CustomerPictureTitle }}
                                        </div>
                                    </div>
                                    {{ else }}
                                    <div class="no-media">
                                        <i class="fas fa-user-circle"></i>
                                        <span>Fotoğraf yüklenmemiş</span>
                                    </div>
                                    {{ end }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Picture Upload Form -->
                    <div class="media-upload-section">
                        <h3 class="group-title">Fotoğrafı Güncelle</h3>
                        <form id="pictureForm" class="picture-form" enctype="multipart/form-data" novalidate>
                            <input type="hidden" name="old_customer_picture_alt_text" value="{{ Testimonial.CustomerPictureAltText }}">
                            <input type="hidden" name="old_customer_picture_title" value="{{ Testimonial.CustomerPictureTitle }}">
                            
                            <div class="form-group">
                                <label for="customer_picture_path" class="form-label">Müşteri Fotoğrafı</label>
                                <div class="file-upload-area" data-target="customer_picture_path">
                                    <div class="file-upload-content">
                                        <i class="fas fa-upload"></i>
                                        <p class="file-upload-text">Fotoğraf dosyasını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                        <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                                    </div>
                                    <input type="file" id="customer_picture_path" name="customer_picture_path" 
                                           class="file-input" accept="image/*">
                                    <div class="file-preview" style="display: none;">
                                        <img class="preview-image" src="" alt="Preview">
                                        <button type="button" class="file-remove">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="file-meta-inputs">
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="customer_picture_alt_text" class="form-label">Fotoğraf Alt Metni</label>
                                            <input type="text" id="customer_picture_alt_text" name="customer_picture_alt_text" 
                                                   class="form-input" value="{{ Testimonial.CustomerPictureAltText }}">
                                        </div>
                                        <div class="form-group">
                                            <label for="customer_picture_title" class="form-label">Fotoğraf Başlığı</label>
                                            <input type="text" id="customer_picture_title" name="customer_picture_title" 
                                                   class="form-input" value="{{ Testimonial.CustomerPictureTitle }}">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" id="pictureSubmitBtn">
                                    <i class="fas fa-upload"></i>
                                    <span class="btn-text">Fotoğrafı Güncelle</span>
                                    <div class="btn-loader" style="display: none;">
                                        <div class="spinner"></div>
                                    </div>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">İşlem başarıyla tamamlandı.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deletePictureModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Fotoğrafı Sil</h3>
        <p class="modal-message">Bu fotoğrafı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeModal('deletePictureModal')">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeletePictureBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<script>
    // Pass data to JavaScript
    window.pageData = {
        tid: parseInt("{{ Testimonial.Tid }}"),
        currentRating: parseFloat("{{ Testimonial.Rating }}")
    };
</script>
<script src="{{ PathOnStart }}js/panel/musteri-yorumu-duzenle.js"></script>
