<div class="compact-page-header">
    <div class="container">
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
            <li><a href="/doktorlarimiz">Doktorlarımız</a></li>
            <li><span class="current">{{ (Doktor.Title != "" ? Doktor.Title + " " : "") + Doktor.FirstName + " " + Doktor.LastName }}</span></li>
        </ul>
    </div>
</div>

<link rel="stylesheet" href="{{ PathOnStart }}css/frontend/doktor.css">


<section class="dr-hero">
    <div class="dr-hero__bg">
        <img src="{{ Doktor.PhotoPath != "" ? PathOnStart + Doktor.PhotoPath : PathOnStart + "files/defaults/doktorlar/default-doctor-pic.png" }}" alt="{{ Doktor.FirstName + " " + Doktor.LastName }}" class="dr-hero__bg-img">
        <div class="dr-hero__overlay"></div>
    </div>
    <div class="container">
        <div class="dr-hero__inner">
            <div class="dr-hero__photo-wrap">
                <img class="dr-hero__photo"
                    src="{{ Doktor.PhotoPath != "" ? PathOnStart + Doktor.PhotoPath : PathOnStart + "files/defaults/doktorlar/default-doctor-pic.png" }}"
                    alt="{{ Doktor.FirstName + " " + Doktor.LastName }}">
            </div>
            <div class="dr-hero__meta">
                <div class="dr-hero__info">
                    <h1 class="dr-hero__name">{{ (Doktor.Title != "" ? Doktor.Title + " " : "") + Doktor.FirstName + " " + Doktor.LastName }}</h1>
                    {{ if Doktor.BranchName != "" }}<p class="dr-hero__branch"><i class="fas fa-stethoscope"></i> {{ Doktor.BranchName }}</p>{{ end }}
                    <div class="dr-hero__location">
                        <i class="fas fa-map-marker-alt"></i>
                        {{ if Doktor.CalistigiSubelerText != "" }}{{ Doktor.CalistigiSubelerText }}{{ else }}{{ Doktor.SubeName }}{{ end }}
                    </div>
                </div>
                <div class="dr-hero__actions">
                    <a href="/randevu" class="dr-hero__randevu-btn">
                        <i class="fas fa-calendar-alt"></i> Randevu Al
                    </a>
                    {{ if Options.Options.ShowDoctorSocialMedia }}
                    <div class="dr-hero__social">
                        {{ if Doktor.FacebookUrl != "" }}<a href="{{ Doktor.FacebookUrl }}" target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f" aria-hidden="true"></i></a>{{ end }}
                        {{ if Doktor.InstagramUrl != "" }}<a href="{{ Doktor.InstagramUrl }}" target="_blank" aria-label="Instagram"><i class="fab fa-instagram" aria-hidden="true"></i></a>{{ end }}
                        {{ if Doktor.XUrl != "" }}<a href="{{ Doktor.XUrl }}" target="_blank" aria-label="Twitter"><i class="fab fa-twitter" aria-hidden="true"></i></a>{{ end }}
                        {{ if Doktor.LinkedinUrl != "" }}<a href="{{ Doktor.LinkedinUrl }}" target="_blank" aria-label="Linkedin"><i class="fab fa-linkedin-in" aria-hidden="true"></i></a>{{ end }}
                        {{ if Doktor.PersonalUrl != "" }}<a href="{{ Doktor.PersonalUrl }}" target="_blank" aria-label="Website"><i class="fa fa-globe" aria-hidden="true"></i></a>{{ end }}
                    </div>
                    {{ end }}
                </div>
            </div>
        </div>
    </div>
</section>

<hr class="dr-divider">

<section class="dr-tabs-section">
    <div class="container">
        <div class="dr-tabs">
            <button class="dr-tab active" onclick="drTab(this, 'hakkinda')">Hakkında</button>
            {{ if len(Doktor.Expertises) > 0 }}
            <button class="dr-tab" onclick="drTab(this, 'uzmanlik')">Uzmanlıklar</button>
            {{ end }}
        </div>

        <div id="dr-hakkinda" class="dr-tab-content active">
            {{ if Doktor.DoctorInfosHtml != "" }}
                <style>{{ Doktor.DoctorInfosCss | raw }}</style>
                {{ Doktor.DoctorInfosHtml | raw }}
                <script>{{ Doktor.DoctorInfosJs | raw }}</script>
            {{ else }}
                <p class="dr-about-text">{{ Doktor.Biography != "" ? Doktor.Biography : "Doktor hakkında yakında detaylı bilgiler eklenecektir." }}</p>
                <div class="dr-info-grid">
                    {{ if Doktor.ExperienceYears != 0 }}
                    <div class="dr-info-item">
                        <div class="dr-info-item__label">Deneyim</div>
                        <div class="dr-info-item__value">{{ Doktor.ExperienceYears }} Yıl</div>
                    </div>
                    {{ end }}
                    {{ if Options.Options.ShowDoctorAppointmentFee && Doktor.AppointmentFee != 0.0 }}
                    <div class="dr-info-item">
                        <div class="dr-info-item__label">Muayene Ücreti</div>
                        <div class="dr-info-item__value">{{ Doktor.AppointmentFee }} TL</div>
                    </div>
                    {{ end }}
                </div>
            {{ end }}
        </div>

        {{ if len(Doktor.Expertises) > 0 }}
        <div id="dr-uzmanlik" class="dr-tab-content">
            <div class="dr-expertise-list">
                {{ range index, Uz := Doktor.Expertises }}
                <div class="dr-expertise-item">
                    <div class="dr-expertise-item__name">
                        {{ Uz.UzmanlikName }}
                        {{ if Uz.IsPrimary }}<span class="dr-primary-badge">Birincil</span>{{ end }}
                    </div>
                    {{ if Uz.CertificationInstitution != "" }}
                    <div class="dr-expertise-item__inst"><i class="fas fa-university" style="color:#e53935;margin-right:4px;"></i>{{ Uz.CertificationInstitution }}</div>
                    {{ end }}
                    {{ if Uz.UzmanlikDescription != "" }}
                    <div class="dr-expertise-item__desc">{{ Uz.UzmanlikDescription }}</div>
                    {{ end }}
                </div>
                {{ end }}
            </div>
        </div>
        {{ end }}

    </div>
</section>

<script>
function drTab(btn, id) {
    document.querySelectorAll(".dr-tab").forEach(function(t) { t.classList.remove("active"); });
    document.querySelectorAll(".dr-tab-content").forEach(function(c) { c.classList.remove("active"); });
    btn.classList.add("active");
    document.getElementById("dr-" + id).classList.add("active");
}
</script>

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Physician",
    "name": "{{ (Doktor.Title != "" ? Doktor.Title + " " : "") + Doktor.FirstName + " " + Doktor.LastName }}",
    "url": "https://nivgoz.com/doktorlarimiz/{{ Doktor.UrlName }}",
    {{ if Doktor.PhotoPath != "" }}
    "image": "https://nivgoz.com/{{ Doktor.PhotoPath }}",
    {{ end }}
    "medicalSpecialty": "Ophthalmology",
    "memberOf": {
        "@type": "MedicalOrganization",
        "name": "Nivgöz Göz Sağlığı Merkezi",
        "url": "https://nivgoz.com"
    }
}
</script>
