<link rel="stylesheet" href="{{ PathOnStart }}css/panel/job-applications.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-briefcase"></i>
                    İş Başvuruları
                </h1>
                <p class="page-subtitle">İş başvurularını ve aday bilgilerini yönetin</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-secondary" id="refreshBtn">
                    <i class="fas fa-sync-alt"></i>
                    Yenile
                </button>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="filters-section">
        <div class="filters-content">
            <div class="search-group">
                <form class="search-form" onsubmit="return false;">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="searchInput" class="search-input" 
                               placeholder="Ad, soyad, pozisyon veya e-posta ile ara..." 
                               autocomplete="off" spellcheck="false" value="{{ Query }}">
                        <button class="search-clear" id="searchClear" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </form>
                <button class="search-filter-btn" id="filterBtn" title="Filtrele">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div class="filter-group">
                <select id="statusFilter" class="filter-select">
                    <option value="all"{{if Status == "all" || Status == ""}} selected{{end}}>Tüm Durumlar</option>
                    <option value="yeni"{{if Status == "yeni"}} selected{{end}}>Yeni</option>
                    <option value="inceleniyor"{{if Status == "inceleniyor"}} selected{{end}}>İnceleniyor</option>
                    <option value="mulakat"{{if Status == "mulakat"}} selected{{end}}>Mülakat</option>
                    <option value="kabul"{{if Status == "kabul"}} selected{{end}}>Kabul</option>
                    <option value="red"{{if Status == "red"}} selected{{end}}>Red</option>
                    <option value="beklemede"{{if Status == "beklemede"}} selected{{end}}>Beklemede</option>
                </select>
                <select id="sortBy" class="filter-select">
                    <option value="first_name"{{if SortBy == "first_name" || SortBy == ""}} selected{{end}}>Ad</option>
                    <option value="last_name"{{if SortBy == "last_name"}} selected{{end}}>Soyad</option>
                    <option value="email"{{if SortBy == "email"}} selected{{end}}>E-posta</option>
                    <option value="phone"{{if SortBy == "phone"}} selected{{end}}>Telefon</option>
                    <option value="skills"{{if SortBy == "skills"}} selected{{end}}>Yetenekler</option>
                    <option value="cover_letter"{{if SortBy == "cover_letter"}} selected{{end}}>Ön Yazı</option>
                    <option value="work_references"{{if SortBy == "work_references"}} selected{{end}}>Referanslar</option>
                    <option value="notes"{{if SortBy == "notes"}} selected{{end}}>Notlar</option>
                    <option value="interview_date"{{if SortBy == "interview_date"}} selected{{end}}>Mülakat Tarihi</option>
                    <option value="interview_notes"{{if SortBy == "interview_notes"}} selected{{end}}>Mülakat Notları</option>
                    <option value="rejection_reason"{{if SortBy == "rejection_reason"}} selected{{end}}>Red Nedeni</option>
                </select>
                <select id="sortOrder" class="filter-select">
                    <option value="ASC"{{if SortOrder == "ASC" || SortOrder == ""}} selected{{end}}>Artan</option>
                    <option value="DESC"{{if SortOrder == "DESC"}} selected{{end}}>Azalan</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-briefcase"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number">{{Count}}</div>
                    <div class="stat-label">Toplam Başvuru</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon new">
                    <i class="fas fa-plus-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="newCount">-</div>
                    <div class="stat-label">Yeni Başvurular</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon interview">
                    <i class="fas fa-user-tie"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="interviewCount">-</div>
                    <div class="stat-label">Mülakat Aşaması</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon accepted">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="acceptedCount">-</div>
                    <div class="stat-label">Kabul Edilen</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">İş Başvuruları Listesi</h3>
                <div class="table-actions">
                    <button class="btn btn-sm btn-secondary" id="exportBtn">
                        <i class="fas fa-download"></i>
                        Dışa Aktar
                    </button>
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="table">
                            <i class="fas fa-list"></i>
                        </button>
                        <button class="view-btn" data-view="grid">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Table View -->
            <div class="table-wrapper" id="tableView">
                <table class="data-table" id="jobApplicationsTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-column="first_name">
                                <span>Ad Soyad</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="position_applied">
                                <span>Pozisyon</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th>
                                <span>İletişim</span>
                            </th>
                            <th class="sortable" data-column="experience_years">
                                <span>Deneyim</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="status">
                                <span>Durum</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="is_read">
                                <span>Okuma</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="created_at">
                                <span>Başvuru Tarihi</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="actions-column">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{if len(JobApplications) > 0}}
                            {{range JobApplications}}
                            <tr data-id="{{ .Jaid }}">
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .FirstName }} {{ .LastName }}</div>
                                        {{if .City}}
                                        <div class="secondary-text">{{ .City }}</div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .PositionApplied }}</div>
                                        {{if .Department}}
                                        <div class="secondary-text">{{ .Department }}</div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .Email}}
                                        <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                        {{else}}
                                        <span class="text-muted">-</span>
                                        {{end}}
                                        {{if .Phone}}
                                        <div class="secondary-text">
                                            <a href="tel:{{ .Phone }}" class="phone-link">{{ .Phone }}</a>
                                        </div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .ExperienceYears }} yıl</div>
                                        {{if .University}}
                                        <div class="secondary-text">{{ .University }}</div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .Status == "yeni"}}
                                        <span class="status-badge new">
                                            <i class="fas fa-plus-circle"></i>
                                            Yeni
                                        </span>
                                        {{else if .Status == "inceleniyor"}}
                                        <span class="status-badge reviewing">
                                            <i class="fas fa-eye"></i>
                                            İnceleniyor
                                        </span>
                                        {{else if .Status == "mulakat"}}
                                        <span class="status-badge interview">
                                            <i class="fas fa-user-tie"></i>
                                            Mülakat
                                        </span>
                                        {{else if .Status == "kabul"}}
                                        <span class="status-badge accepted">
                                            <i class="fas fa-check-circle"></i>
                                            Kabul
                                        </span>
                                        {{else if .Status == "red"}}
                                        <span class="status-badge rejected">
                                            <i class="fas fa-times-circle"></i>
                                            Red
                                        </span>
                                        {{else}}
                                        <span class="status-badge beklemede">
                                            <i class="fas fa-clock"></i>
                                            Beklemede
                                        </span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .IsRead}}
                                        <span class="read-badge read">
                                            <i class="fas fa-check"></i>
                                            Okundu
                                        </span>
                                        {{else}}
                                        <span class="read-badge unread">
                                            <i class="fas fa-envelope"></i>
                                            Okunmamış
                                        </span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ mthr(.CreatedAt, User.Timezone) }}</div>
                                        {{if .InterviewDate}}
                                        <div class="secondary-text">Mülakat: {{ mthr(.InterviewDate, User.Timezone) }}</div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="actions-wrapper">
                                        <button class="action-trigger" data-id="{{ .Jaid }}">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <div class="action-dropdown">
                                            <a href="/panel/is-basvurulari/{{ .Jaid }}" class="action-item view">
                                                <i class="fas fa-eye"></i>
                                                <span>Görüntüle</span>
                                            </a>
                                            <a href="/panel/is-basvurusu-cevapla?jaid={{ .Jaid }}" class="action-item respond">
                                                <i class="fas fa-reply"></i>
                                                <span>Cevapla</span>
                                            </a>
                                            {{if not .IsRead}}
                                            <button class="action-item mark-read" data-id="{{ .Jaid }}">
                                                <i class="fas fa-check"></i>
                                                <span>Okundu Olarak İşaretle</span>
                                            </button>
                                            {{else}}
                                            <button class="action-item mark-unread" data-id="{{ .Jaid }}">
                                                <i class="fas fa-envelope"></i>
                                                <span>Okunmamış Olarak İşaretle</span>
                                            </button>
                                            {{end}}
                                            <div class="action-divider"></div>
                                            <button class="action-item delete" data-id="{{ .Jaid }}" data-name="{{ .FirstName }} {{ .LastName }}">
                                                <i class="fas fa-trash"></i>
                                                <span>Sil</span>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        {{else}}
                            <tr class="empty-row">
                                <td colspan="8">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-briefcase"></i>
                                        </div>
                                        <div class="empty-title">Henüz iş başvurusu bulunmuyor</div>
                                        <div class="empty-description">Websiteden gelen iş başvuruları burada görünecek.</div>
                                    </div>
                                </td>
                            </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>

            <!-- Grid View -->
            <div class="grid-wrapper" id="gridView" style="display: none;">
                <div class="job-applications-grid">
                    {{if len(JobApplications) > 0}}
                        {{range JobApplications}}
                        <div class="job-application-card" data-id="{{ .Jaid }}">
                            <div class="card-header">
                                <div class="card-title">{{ .FirstName }} {{ .LastName }}</div>
                                <div class="card-actions">
                                    <button class="action-trigger" data-id="{{ .Jaid }}">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="action-dropdown">
                                        <a href="/panel/is-basvurulari/{{ .Jaid }}" class="action-item view">
                                            <i class="fas fa-eye"></i>
                                            <span>Görüntüle</span>
                                        </a>
                                        <a href="/panel/is-basvurusu-cevapla?jaid={{ .Jaid }}" class="action-item respond">
                                            <i class="fas fa-reply"></i>
                                            <span>Cevapla</span>
                                        </a>
                                        {{if not .IsRead}}
                                        <button class="action-item mark-read" data-id="{{ .Jaid }}">
                                            <i class="fas fa-check"></i>
                                            <span>Okundu Olarak İşaretle</span>
                                        </button>
                                        {{else}}
                                        <button class="action-item mark-unread" data-id="{{ .Jaid }}">
                                            <i class="fas fa-envelope"></i>
                                            <span>Okunmamış Olarak İşaretle</span>
                                        </button>
                                        {{end}}
                                        <div class="action-divider"></div>
                                        <button class="action-item delete" data-id="{{ .Jaid }}" data-name="{{ .FirstName }} {{ .LastName }}">
                                            <i class="fas fa-trash"></i>
                                            <span>Sil</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-field">
                                    <div class="field-label">Pozisyon</div>
                                    <div class="field-value">{{ .PositionApplied }}</div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">İletişim</div>
                                    <div class="field-value">
                                        {{if .Email}}
                                        <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                        {{else}}
                                        <span class="text-muted">E-posta yok</span>
                                        {{end}}
                                    </div>
                                </div>
                                {{if .Phone}}
                                <div class="card-field">
                                    <div class="field-label">Telefon</div>
                                    <div class="field-value">
                                        <a href="tel:{{ .Phone }}" class="phone-link">{{ .Phone }}</a>
                                    </div>
                                </div>
                                {{end}}
                                <div class="card-field">
                                    <div class="field-label">Deneyim</div>
                                    <div class="field-value">{{ .ExperienceYears }} yıl</div>
                                </div>
                                {{if .University}}
                                <div class="card-field">
                                    <div class="field-label">Üniversite</div>
                                    <div class="field-value">{{ .University }}</div>
                                </div>
                                {{end}}
                            </div>
                            <div class="card-footer">
                                <div class="card-status">
                                    {{if .Status == "yeni"}}
                                    <span class="status-badge new">
                                        <i class="fas fa-plus-circle"></i>
                                        Yeni
                                    </span>
                                    {{else if .Status == "inceleniyor"}}
                                    <span class="status-badge reviewing">
                                        <i class="fas fa-eye"></i>
                                        İnceleniyor
                                    </span>
                                    {{else if .Status == "mulakat"}}
                                    <span class="status-badge interview">
                                        <i class="fas fa-user-tie"></i>
                                        Mülakat
                                    </span>
                                    {{else if .Status == "kabul"}}
                                    <span class="status-badge accepted">
                                        <i class="fas fa-check-circle"></i>
                                        Kabul
                                    </span>
                                    {{else if .Status == "red"}}
                                    <span class="status-badge rejected">
                                        <i class="fas fa-times-circle"></i>
                                        Red
                                    </span>
                                    {{else}}
                                    <span class="status-badge beklemede">
                                        <i class="fas fa-clock"></i>
                                        Beklemede
                                    </span>
                                    {{end}}
                                    {{if .IsRead}}
                                    <span class="read-badge read">
                                        <i class="fas fa-check"></i>
                                        Okundu
                                    </span>
                                    {{else}}
                                    <span class="read-badge unread">
                                        <i class="fas fa-envelope"></i>
                                        Okunmamış
                                    </span>
                                    {{end}}
                                </div>
                                <div class="card-date">{{ mthr(.CreatedAt, User.Timezone) }}</div>
                            </div>
                        </div>
                        {{end}}
                    {{else}}
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-briefcase"></i>
                            </div>
                            <div class="empty-title">Henüz iş başvurusu bulunmuyor</div>
                            <div class="empty-description">Websiteden gelen iş başvuruları burada görünecek.</div>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    {{if Count > 0}}
    <div class="pagination-section">
        <div class="pagination-info">
            <span>Toplam {{Count}} kayıt gösteriliyor</span>
        </div>
        <div class="pagination-wrapper">
            <nav class="pagination" id="pagination">
                <!-- Pagination will be generated by JavaScript -->
            </nav>
        </div>
        <div class="pagination-controls">
            <select id="perPage" class="per-page-select">
                <option value="10">10 / sayfa</option>
                <option value="25">25 / sayfa</option>
                <option value="50">50 / sayfa</option>
                <option value="100">100 / sayfa</option>
            </select>
        </div>
    </div>
    {{end}}
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">İş Başvurusunu Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı iş başvurusunu silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="fas fa-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="fas fa-exclamation-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<script>
    function decodeHtmlEntities(encoded) {
        const txt = document.createElement('textarea');
        txt.innerHTML = encoded;
        return txt.value;
    }

    const escaped = '{{stj(JobApplications)}}';
    const decoded = decodeHtmlEntities(escaped);
    const data = decoded ? JSON.parse(decoded) : [];
    window.pageData = {
        jobApplications: data,
        count: parseInt("{{ Count ? Count : 0 }}"),
        currentPage: parseInt("{{ Page ? Page : 1 }}"),
        perPage: parseInt("{{ 10 }}")
    };
    
    // Filter functionality
    document.addEventListener('DOMContentLoaded', function() {
        const filterBtn = document.getElementById('filterBtn');
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const sortBy = document.getElementById('sortBy');
        const sortOrder = document.getElementById('sortOrder');
        
        filterBtn.addEventListener('click', function() {
            const query = searchInput.value.trim();
            const status = statusFilter.value;
            const sortByValue = sortBy.value;
            const sortOrderValue = sortOrder.value;
            
            // Build query parameters
            const params = new URLSearchParams();
            
            if (query) {
                params.append('query', query);
            }
            if (status && status !== 'all') {
                params.append('is_active', status);
            }
            if (sortByValue) {
                params.append('sort_by', sortByValue);
            }
            if (sortOrderValue) {
                params.append('sort_order', sortOrderValue);
            }
            
            // Redirect to same page with query parameters
            const currentUrl = window.location.pathname;
            const queryString = params.toString();
            const newUrl = queryString ? `${currentUrl}?${queryString}` : currentUrl;
            
            window.location.href = newUrl;
        });
        
        // Prevent form submission on Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                filterBtn.click();
            }
        });
        
        // Prevent any automatic form submission
        searchInput.addEventListener('submit', function(e) {
            e.preventDefault();
        });
        
        // Ensure no automatic submission
        searchInput.setAttribute('autocomplete', 'off');
        searchInput.setAttribute('spellcheck', 'false');
    });
</script>
<script src="{{ PathOnStart }}js/panel/job-applications.js"></script>