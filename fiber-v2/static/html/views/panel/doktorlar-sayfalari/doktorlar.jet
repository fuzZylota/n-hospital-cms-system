<link rel="stylesheet" href="{{ PathOnStart }}css/panel/doktorlar.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-user-md"></i>
                    Doktorlar
                </h1>
                <p class="page-subtitle">Hastane doktorlarını ve bilgilerini yönetin</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-secondary" id="refreshBtn">
                    <i class="fas fa-sync-alt"></i>
                    Yenile
                </button>
                <a href="/panel/doktorlar/doktor-ekle" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Yeni Doktor
                </a>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="filters-section">
        <div class="filters-content">
            <div class="search-group">
                <form class="search-form" onsubmit="return false;">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="searchInput" class="search-input" 
                               placeholder="Doktor adı, bölüm veya şube ile ara..."
                               autocomplete="off" spellcheck="false" value="{{ Query }}">
                        <button class="search-clear" id="searchClear" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </form>
                <button class="search-filter-btn" id="filterBtn" title="Filtrele">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div class="filter-group">
                <select id="statusFilter" class="filter-select">
                    <option value="all"{{if Status == "all" || Status == ""}} selected{{end}}>Tüm Durumlar</option>
                    <option value="active"{{if Status == "active"}} selected{{end}}>Aktif</option>
                    <option value="inactive"{{if Status == "inactive"}} selected{{end}}>Pasif</option>
                </select>
                <select id="branchFilter" name="brans" class="filter-select">
                    <option value="all"{{if Brans == "all" || Brans == ""}} selected{{end}}>Tüm Bölümler</option>
                    {{range Branslar}}
                    <option value="{{ .Brid }}"{{if Brans == .Brid}} selected{{end}}>{{ .Name }}</option>
                    {{end}}
                </select>
                <select id="subeFilter" name="sube" class="filter-select">
                    <option value="all"{{if Sube == "all" || Sube == ""}} selected{{end}}>Tüm Şubeler</option>
                    {{range Subeler}}
                    <option value="{{ .Sid }}"{{if Sube == .Sid}} selected{{end}}>{{ .Name }}</option>
                    {{end}}
                </select>
                <select id="sortBy" class="filter-select">
                    <option value="first_name"{{if SortBy == "first_name" || SortBy == ""}} selected{{end}}>Ad</option>
                    <option value="last_name"{{if SortBy == "last_name"}} selected{{end}}>Soyad</option>
                    <option value="email"{{if SortBy == "email"}} selected{{end}}>E-posta</option>
                    <option value="phone"{{if SortBy == "phone"}} selected{{end}}>Telefon</option>
                    <option value="education"{{if SortBy == "education"}} selected{{end}}>Eğitim</option>
                    <option value="languages"{{if SortBy == "languages"}} selected{{end}}>Diller</option>
                    <option value="title"{{if SortBy == "title"}} selected{{end}}>Unvan</option>
                    <option value="gender"{{if SortBy == "gender"}} selected{{end}}>Cinsiyet</option>
                </select>
                <select id="sortOrder" class="filter-select">
                    <option value="ASC"{{if SortOrder == "ASC" || SortOrder == ""}} selected{{end}}>Artan</option>
                    <option value="DESC"{{if SortOrder == "DESC"}} selected{{end}}>Azalan</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-user-md"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number">{{Count}}</div>
                    <div class="stat-label">Toplam Doktor</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon active">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="activeCount">-</div>
                    <div class="stat-label">Aktif Doktorlar</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon inactive">
                    <i class="fas fa-pause-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="inactiveCount">-</div>
                    <div class="stat-label">Pasif Doktorlar</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon appointment">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="appointmentCount">-</div>
                    <div class="stat-label">Randevu Kabul Eden</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">Doktorlar Listesi</h3>
                <div class="table-actions">
                    <button class="btn btn-sm btn-secondary" id="exportBtn">
                        <i class="fas fa-download"></i>
                        Dışa Aktar
                    </button>
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="table">
                            <i class="fas fa-list"></i>
                        </button>
                        <button class="view-btn" data-view="grid">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Table View -->
            <div class="table-wrapper" id="tableView">
                <table class="data-table" id="doktorlarTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-column="first_name">
                                <span>Doktor Adı</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="branch_name">
                                <span>Bölüm</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="sube_name">
                                <span>Şube</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="phone">
                                <span>Telefon</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="is_active">
                                <span>Durum</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="updated_at">
                                <span>Son Güncelleme</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="actions-column">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{if len(Doktorlar) > 0}}
                            {{range Doktorlar}}
                            <tr data-id="{{ .Drid }}">
                                <td>
                                    <div class="cell-content">
                                        <div class="doctor-info">
                                            {{if .PhotoPath}}
                                            <div class="doctor-avatar">
                                                <img src="{{ PathOnStart }}{{ .PhotoPath }}" alt="{{ .PhotoAltText }}" class="avatar-image">
                                            </div>
                                            {{else}}
                                            <div class="doctor-avatar">
                                                <div class="avatar-placeholder">
                                                    <i class="fas fa-user-md"></i>
                                                </div>
                                            </div>
                                            {{end}}
                                            <div class="doctor-details">
                                                <div class="primary-text">{{ .Title }} {{ .FirstName }} {{ .LastName }}</div>
                                                {{if .Biography}}
                                                <div class="secondary-text truncate">{{ .Biography }}</div>
                                                {{end}}
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .BranchName}}
                                        <div class="primary-text">{{ .BranchName }}</div>
                                        {{else}}
                                        <span class="text-muted">Bölüm atanmamış</span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .SubeName}}
                                        <div class="primary-text">{{ .SubeName }}</div>
                                        {{if .SubeCity}}
                                        <div class="secondary-text">{{ .SubeCity }}</div>
                                        {{end}}
                                        {{else}}
                                        <span class="text-muted">Şube atanmamış</span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .Phone}}
                                        <a href="tel:{{ .Phone }}" class="phone-link">{{ .Phone }}</a>
                                        {{else}}
                                        <span class="text-muted">-</span>
                                        {{end}}
                                        {{if .Email}}
                                        <div class="secondary-text">
                                            <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                        </div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .IsActive}}
                                        <span class="status-badge active">
                                            <i class="fas fa-check-circle"></i>
                                            Aktif
                                        </span>
                                        {{else}}
                                        <span class="status-badge inactive">
                                            <i class="fas fa-pause-circle"></i>
                                            Pasif
                                        </span>
                                        {{end}}
                                        {{if .OnlineAppointment}}
                                        <div class="secondary-text">
                                            <span class="appointment-badge">
                                                <i class="fas fa-calendar-check"></i>
                                                Randevu Kabul Ediyor
                                            </span>
                                        </div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ mthr(.UpdatedAt, User.Timezone) }}</div>
                                        <div class="secondary-text">{{ mthr(.CreatedAt, User.Timezone) }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="actions-wrapper">
                                        <button class="action-trigger" data-id="{{ .Drid }}">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <div class="action-dropdown">
                                            <a href="/panel/doktorlar/{{ .Drid }}" class="action-item view">
                                                <i class="fas fa-eye"></i>
                                                <span>Görüntüle</span>
                                            </a>
                                            <a href="/panel/doktorlar/{{ .Drid }}/duzenle" class="action-item edit">
                                                <i class="fas fa-edit"></i>
                                                <span>Düzenle</span>
                                            </a>
                                            <div class="action-divider"></div>
                                            <button class="action-item delete" data-id="{{ .Drid }}" data-name="{{ .Title }} {{ .FirstName }} {{ .LastName }}">
                                                <i class="fas fa-trash"></i>
                                                <span>Sil</span>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        {{else}}
                            <tr class="empty-row">
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-user-md"></i>
                                        </div>
                                        <div class="empty-title">Henüz doktor bulunmuyor</div>
                                        <div class="empty-description">İlk doktorunuzu eklemek için "Yeni Doktor" butonuna tıklayın.</div>
                                        <a href="/panel/doktorlar/doktor-ekle" class="btn btn-primary">
                                            <i class="fas fa-plus"></i>
                                            Yeni Doktor Ekle
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>

            <!-- Grid View -->
            <div class="grid-wrapper" id="gridView" style="display: none;">
                <div class="doktorlar-grid">
                    {{if len(Doktorlar) > 0}}
                        {{range Doktorlar}}
                        <div class="doktor-card" data-id="{{ .Drid }}">
                            <div class="card-header">
                                <div class="doctor-info">
                                    {{if .PhotoPath}}
                                    <div class="doctor-avatar">
                                        <img src="{{ PathOnStart }}{{ .PhotoPath }}" alt="{{ .PhotoAltText }}" class="avatar-image">
                                    </div>
                                    {{else}}
                                    <div class="doctor-avatar">
                                        <div class="avatar-placeholder">
                                            <i class="fas fa-user-md"></i>
                                        </div>
                                    </div>
                                    {{end}}
                                    <div class="doctor-details">
                                        <div class="card-title">{{ .Title }} {{ .FirstName }} {{ .LastName }}</div>
                                        {{if .BranchName}}
                                        <div class="card-subtitle">{{ .BranchName }}</div>
                                        {{end}}
                                    </div>
                                </div>
                                <div class="card-actions">
                                    <button class="action-trigger" data-id="{{ .Drid }}">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="action-dropdown">
                                        <a href="/panel/doktorlar/{{ .Drid }}" class="action-item view">
                                            <i class="fas fa-eye"></i>
                                            <span>Görüntüle</span>
                                        </a>
                                        <a href="/panel/doktorlar/{{ .Drid }}/duzenle" class="action-item edit">
                                            <i class="fas fa-edit"></i>
                                            <span>Düzenle</span>
                                        </a>
                                        <div class="action-divider"></div>
                                        <button class="action-item delete" data-id="{{ .Drid }}" data-name="{{ .Title }} {{ .FirstName }} {{ .LastName }}">
                                            <i class="fas fa-trash"></i>
                                            <span>Sil</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-field">
                                    <div class="field-label">Şube</div>
                                    <div class="field-value">
                                        {{if .SubeName}}
                                        {{ .SubeName }}{{if .SubeCity}}, {{ .SubeCity }}{{end}}
                                        {{else}}
                                        <span class="text-muted">Şube atanmamış</span>
                                        {{end}}
                                    </div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">İletişim</div>
                                    <div class="field-value">
                                        {{if .Phone}}
                                        <a href="tel:{{ .Phone }}" class="phone-link">{{ .Phone }}</a>
                                        {{else}}
                                        <span class="text-muted">Telefon yok</span>
                                        {{end}}
                                    </div>
                                </div>
                                {{if .Email}}
                                <div class="card-field">
                                    <div class="field-label">E-posta</div>
                                    <div class="field-value">
                                        <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                    </div>
                                </div>
                                {{end}}
                                {{if .ExperienceYears}}
                                <div class="card-field">
                                    <div class="field-label">Deneyim</div>
                                    <div class="field-value">{{ .ExperienceYears }} yıl</div>
                                </div>
                                {{end}}
                            </div>
                            <div class="card-footer">
                                <div class="card-status">
                                    {{if .IsActive}}
                                    <span class="status-badge active">
                                        <i class="fas fa-check-circle"></i>
                                        Aktif
                                    </span>
                                    {{else}}
                                    <span class="status-badge inactive">
                                        <i class="fas fa-pause-circle"></i>
                                        Pasif
                                    </span>
                                    {{end}}
                                    {{if .OnlineAppointment}}
                                    <span class="appointment-badge">
                                        <i class="fas fa-calendar-check"></i>
                                        Randevu
                                    </span>
                                    {{end}}
                                </div>
                                <div class="card-date">{{ mthr(.UpdatedAt, User.Timezone) }}</div>
                            </div>
                        </div>
                        {{end}}
                    {{else}}
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-user-md"></i>
                            </div>
                            <div class="empty-title">Henüz doktor bulunmuyor</div>
                            <div class="empty-description">İlk doktorunuzu eklemek için "Yeni Doktor" butonuna tıklayın.</div>
                            <a href="/panel/doktorlar/doktor-ekle" class="btn btn-primary">
                                <i class="fas fa-plus"></i>
                                Yeni Doktor Ekle
                            </a>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    {{if Count > 0}}
    <div class="pagination-section">
        <div class="pagination-info">
            <span>Toplam {{Count}} kayıt gösteriliyor</span>
        </div>
        <div class="pagination-wrapper">
            <nav class="pagination" id="pagination">
                <!-- Pagination will be generated by JavaScript -->
            </nav>
        </div>
        <div class="pagination-controls">
            <select id="perPage" class="per-page-select">
                <option value="10">10 / sayfa</option>
                <option value="25">25 / sayfa</option>
                <option value="50">50 / sayfa</option>
                <option value="100">100 / sayfa</option>
            </select>
        </div>
    </div>
    {{end}}
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Doktoru Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı doktoru silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="fas fa-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="fas fa-exclamation-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<script>
    function decodeHtmlEntities(encoded) {
        const txt = document.createElement('textarea');
        txt.innerHTML = encoded;
        return txt.value;
    }

    const escaped = '{{stj(Doktorlar)}}';
    const decoded = decodeHtmlEntities(escaped);
    const data = decoded ? JSON.parse(decoded) : [];
    window.pageData = {
        doktorlar: data,
        count: parseInt("{{ Count ? Count : 0 }}"),
        currentPage: parseInt("{{ Page ? Page : 1 }}"),
        perPage: parseInt("{{ 10 }}")
    };
    
    // Filter functionality
    document.addEventListener('DOMContentLoaded', function() {
        const filterBtn = document.getElementById('filterBtn');
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const branchFilter = document.getElementById('branchFilter');
        const subeFilter = document.getElementById('subeFilter');
        const sortBy = document.getElementById('sortBy');
        const sortOrder = document.getElementById('sortOrder');
        
        filterBtn.addEventListener('click', function() {
            const query = searchInput.value.trim();
            const status = statusFilter.value;
            const brans = branchFilter.value;
            const sube = subeFilter.value;
            const sortByValue = sortBy.value;
            const sortOrderValue = sortOrder.value;
            
            // Build query parameters
            const params = new URLSearchParams();
            
            if (query) {
                params.append('query', query);
            }
            if (status && status !== 'all') {
                params.append('status', status);
            }
            if (brans && brans !== 'all') {
                params.append('brans', brans);
            }
            if (sube && sube !== 'all') {
                params.append('sube', sube);
            }
            if (sortByValue) {
                params.append('sort_by', sortByValue);
            }
            if (sortOrderValue) {
                params.append('sort_order', sortOrderValue);
            }
            
            // Redirect to same page with query parameters
            const currentUrl = window.location.pathname;
            const queryString = params.toString();
            const newUrl = queryString ? `${currentUrl}?${queryString}` : currentUrl;
            
            window.location.href = newUrl;
        });
        
        // Prevent form submission on Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                filterBtn.click();
            }
        });
        
        // Prevent any automatic form submission
        searchInput.addEventListener('submit', function(e) {
            e.preventDefault();
        });
        
        // Ensure no automatic submission
        searchInput.setAttribute('autocomplete', 'off');
        searchInput.setAttribute('spellcheck', 'false');
    });
</script>
<script src="{{ PathOnStart }}js/panel/doktorlar.js"></script>
