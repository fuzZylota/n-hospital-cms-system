<section class="page-header" style="margin-top: 200px;">
    <div class="container-fluid">
        <div class="page-header__inner">
            <div class="page-header__bg" style="background-image: url({{ PathOnStart }}{{ Options.Options.DefaultPageMediaPath != "" ? Options.Options.DefaultPageMediaPath : "assets/images/backgrounds/institutional-default.jpg" }});"></div><!-- /.page-header__bg -->
            <div class="container">
                <div class="page-header__content">
                    <h2 class="page-header__title">Merkezlerimiz</h2>
                    <ul class="mediox-breadcrumb list-unstyled">
                        <li>
                            <span class="mediox-breadcrumb__icon"><i class="icon-home"></i></span>
                            <a href="/">Anasayfa</a>
                        </li>
                        <li><span>Merkezlerimiz</span></li>
                    </ul><!-- /.mediox-breadcrumb list-unstyled -->
                </div><!-- /.page-header__content -->
            </div><!-- /.container -->
        </div><!-- /.page-header__inner -->
    </div><!-- /.container-fluid -->
</section><!-- /.page-header -->

<section class="portfolio-page section-space">
    <link rel="stylesheet" href="{{ PathOnStart }}css/frontend/subeler.css">
    <div class="container">
        <div class="row gutter-y-30">
            {{ if len(Subeler) > 0 }}
                {{ range Subeler }}
                <div class="col-xl-4 col-md-6 wow fadeInUp" data-wow-duration="1500ms">
                    <div class="sube-card">
                        <a href="/subelerimiz/{{ .UrlName }}" class="sube-card__image">
                            {{ if .MediaPath }}
                                <img src="{{ .MediaPath }}" alt="{{ .MediaAltText }}" class="sube-card__img">
                            {{ else }}
                                <img src="{{ PathOnStart }}files/defaults/sube/sube-default.png" alt="{{ .Name }}" class="sube-card__img">
                            {{ end }}
                        </a>
                        <div class="sube-card__header">
                            <h4 class="sube-card__title">{{ .Name }}</h4>
                        </div>
                        <div class="sube-card__content">
                            <div class="sube-card__info">
                                {{ if .City != "" }}
                                    <div class="sube-card__info-item">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>{{ .City }}, {{ .District }}</span>
                                    </div>
                                {{ end }}
                                {{ if .Phone != "" }}
                                    <div class="sube-card__info-item">
                                        <i class="fas fa-phone"></i>
                                        <a href="tel:{{ .Phone }}">{{ .Phone }}</a>
                                    </div>
                                {{ end }}
                                {{ if .Email != "" }}
                                    <div class="sube-card__info-item">
                                        <i class="fas fa-envelope"></i>
                                        <a href="mailto:{{ .Email }}">{{ .Email }}</a>
                                    </div>
                                {{ end }}
                                {{ if .TransportationInfo != "" }}
                                    <div class="sube-card__info-item">
                                        <i class="fas fa-bus"></i>
                                        <span>{{ .TransportationInfo }}</span>
                                    </div>
                                {{ end }}
                            </div>
                            <div class="d-flex" style="gap:10px;">
                                <a href="/subelerimiz/{{ .UrlName }}" class="mediox-btn mediox-btn--normal"><span>Bilgiler</span></a>
                                <a href="/subelerimiz/{{ .UrlName }}/doktorlar" class="mediox-btn mediox-btn--normal"><span>Doktorlar</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                {{ end }}
            {{ else }}
                <div class="col-12">
                    <div class="alert alert-info">Şube bulunamadı.</div>
                </div>
            {{ end }}
        </div><!-- /.row -->
    </div><!-- /.container -->
</section><!-- /.portfolio-page section-space -->