
<style>
    /* Popup Overlay */
    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        visibility: hidden;
        transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        backdrop-filter: blur(0px);
        -webkit-backdrop-filter: blur(0px);
    }

    .popup-overlay.popup-active {
        opacity: 1;
        visibility: visible;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    /* Popup Container */
    .popup-container {
        background: white;
        border-radius: 24px;
        max-width: 35vw;
        width: 90%;
        max-height: 90vh;
        overflow: hidden;
        box-shadow: 0 25px 100px rgba(0, 0, 0, 0.4);
        transform: scale(0.8) translateY(-50px);
        opacity: 0;
        transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        position: relative;
        pointer-events: none;
    }

    .popup-overlay.popup-active .popup-container {
        transform: scale(1) translateY(0);
        opacity: 1;
        background: #ffffff;
        display: block;
        visibility: visible;
        pointer-events: auto;
    }

    /* (Moved popup-header/icon/title/subtitle styles to the extra style block below) */

    /* (Moved popup-body/content/footer/button styles to the extra style block below) */

    /* Close Button */
    .popup-close-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 20px;
        transition: all 0.3s ease;
        z-index: 10;
        animation: popup-rotate-in 0.5s ease-out 0.5s backwards;
    }

    @keyframes popup-rotate-in {
        from {
            transform: rotate(-180deg) scale(0);
            opacity: 0;
        }
        to {
            transform: rotate(0) scale(1);
            opacity: 1;
        }
    }

    .popup-close-btn:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: rotate(90deg);
    }

    /* Responsive */
    @media (max-width: 600px) {
        .popup-container {
            width: 95%;
            border-radius: 16px;
        }

        .popup-header {
            padding: 24px 16px;
        }

        .popup-icon {
            width: 64px;
            height: 64px;
            font-size: 28px;
        }

        .popup-title {
            font-size: 24px;
        }

        .popup-subtitle {
            font-size: 14px;
        }
    }
</style>
    

<!-- Popup Structure -->
<div class="popup-overlay" id="popupOverlay">
    <div class="popup-container">
        <button class="popup-close-btn" id="closePopupBtn">
            <span>×</span>
        </button>

        {{ range index1, Content := AllHomepageContents }}
            {{ if Content.ContentType == "popup" }}
                <div class="css-eval">
                    {{ Content.ContentCss }}
                </div>
                <div class="html-eval">
                    {{ Content.ContentHtml }}
                </div>
                <div class="js-eval">
                    {{ Content.ContentJavascript }}
                </div>
            {{ end }}
        {{ end }}
        
