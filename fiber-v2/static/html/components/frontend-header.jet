<div class="main-header nv-hdr">
    <div class="nv-hdr__inner">
        <a class="nv-hdr__logo" href="/">
            {{ if Options.Medias[0].FilePath != "" }}
                <img src="{{ PathOnStart }}{{ Options.Medias[0].FilePath }}" alt="{{ Options.Medias[0].AltText ? Options.Medias[0].AltText : Options.Options.SiteName + " ana sayfa" }}" width="1000" height="405" />
            {{ else }}
                <img src="{{ PathOnStart }}files/defaults/logo/n-hospital-logo.png" alt="{{ Options.Options.SiteName }} ana sayfa" width="2001" height="667" />
            {{ end }}
        </a>

        <nav class="nv-nav" aria-label="Ana menü">
            <ul class="nv-nav__list">
                {{ range index1, HeaderButtons := Options.HeaderButtons }}
                    {{ if HeaderButtons.ButtonType == "kurumsal" && HeaderButtons.ParentId == "" }}
                        <li class="nv-nav__item">
                            <button type="button" class="nv-nav__toggle" aria-expanded="false" aria-controls="nvNavSub{{ index1 }}">
                                <span>{{ HeaderButtons.Title }}</span>
                                <svg class="nv-icon nv-icon--chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                            </button>
                            <ul class="nv-nav__sub" id="nvNavSub{{ index1 }}" hidden>
                                {{ if HeaderButtons.Url != "" && HeaderButtons.Url != "#" }}
                                    <li><a href="{{ HeaderButtons.Url }}" target="{{ HeaderButtons.Target }}">{{ HeaderButtons.Title }}</a></li>
                                {{ end }}
                                {{ range index2, HeaderButtonsAgain := Options.HeaderButtons }}
                                    {{ if HeaderButtonsAgain.ButtonType == "kurumsal" && HeaderButtonsAgain.Hbid == HeaderButtons.ParentId && HeaderButtonsAgain.ParentId != "" }}
                                        <li><a href="{{ HeaderButtonsAgain.Url }}" target="{{ HeaderButtonsAgain.Target }}">{{ HeaderButtonsAgain.Title }}</a></li>
                                    {{ end }}
                                {{ end }}
                            </ul>
                        </li>
                    {{ end }}

                    {{ if HeaderButtons.ButtonType == "subeler" && HeaderButtons.ParentId == "" }}
                        <li class="nv-nav__item">
                            <button type="button" class="nv-nav__toggle" aria-expanded="false" aria-controls="nvNavSub{{ index1 }}">
                                <span>{{ HeaderButtons.Title }}</span>
                                <svg class="nv-icon nv-icon--chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                            </button>
                            <ul class="nv-nav__sub" id="nvNavSub{{ index1 }}" hidden>
                                <li class="nv-nav__all"><a href="{{ HeaderButtons.Url != "" && HeaderButtons.Url != "#" ? HeaderButtons.Url : "/merkezlerimiz" }}">Tüm {{ HeaderButtons.Title }}</a></li>
                                {{ range index2, SubeLink := Options.SubelerLinks }}
                                    <li><a href="/merkezlerimiz/{{ SubeLink.UrlName }}">{{ SubeLink.Name }}</a></li>
                                {{ end }}
                            </ul>
                        </li>
                    {{ end }}

                    {{ if HeaderButtons.ButtonType == "tibbi_birimler" && HeaderButtons.ParentId == "" }}
                        <li class="nv-nav__item">
                            <button type="button" class="nv-nav__toggle" aria-expanded="false" aria-controls="nvNavSub{{ index1 }}">
                                <span>{{ HeaderButtons.Title }}</span>
                                <svg class="nv-icon nv-icon--chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                            </button>
                            <ul class="nv-nav__sub" id="nvNavSub{{ index1 }}" hidden>
                                <li class="nv-nav__all"><a href="/tibbi-birimler">Tüm {{ HeaderButtons.Title }}</a></li>
                                {{ range index2, TibbiBirimLink := Options.TibbiBirimlerLinks }}
                                    <li><a href="/tibbi-birimler/{{ TibbiBirimLink.UrlName }}">{{ TibbiBirimLink.Name }}</a></li>
                                {{ end }}
                            </ul>
                        </li>
                    {{ end }}

                    {{ if HeaderButtons.ButtonType == "tedkikler" && HeaderButtons.ParentId == "" }}
                        <li class="nv-nav__item">
                            <button type="button" class="nv-nav__toggle" aria-expanded="false" aria-controls="nvNavSub{{ index1 }}">
                                <span>{{ HeaderButtons.Title }}</span>
                                <svg class="nv-icon nv-icon--chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                            </button>
                            <ul class="nv-nav__sub" id="nvNavSub{{ index1 }}" hidden>
                                <li class="nv-nav__all"><a href="/tetkikler">Tüm {{ HeaderButtons.Title }}</a></li>
                                {{ range index2, TedkikLink := Options.TedkiklerLinks }}
                                    <li><a href="/tetkikler/{{ TedkikLink.UrlName }}">{{ TedkikLink.Name }}</a></li>
                                {{ end }}
                            </ul>
                        </li>
                    {{ end }}

                    {{ if HeaderButtons.ButtonType == "diger" && HeaderButtons.ParentId == "" }}
                        <li class="nv-nav__item"><a class="nv-nav__link" href="{{ HeaderButtons.Url }}" target="{{ HeaderButtons.Target }}">{{ HeaderButtons.Title }}</a></li>
                    {{ end }}
                {{ end }}
            </ul>
        </nav>

        <div class="nv-hdr__actions">
            <button type="button" class="nv-hdr-btn" id="nvMobileSearchBtn" aria-label="Arama" aria-expanded="false" aria-controls="nvMobileSearchBar">
                <i class="icon-search" aria-hidden="true"></i>
                <span class="nv-hdr-btn__label" aria-hidden="true">Arama</span>
            </button>
            <a href="/randevu" class="nv-btn nv-btn--primary nv-hdr__cta">Randevu Talebi Oluştur</a>
            <button type="button" class="mobile-nav__btn mobile-nav__toggler" aria-label="Menüyü aç" aria-expanded="false" aria-controls="nvMobileNav">
                <svg class="nv-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                <span class="nv-hdr-btn__label" aria-hidden="true">Menü</span>
            </button>
        </div>
    </div>
</div>

<div class="nv-mnav" id="nvMobileNav" hidden role="dialog" aria-modal="true" aria-labelledby="nvMobileNavTitle">
    <div class="nv-mnav__head">
        <p class="nv-mnav__title" id="nvMobileNavTitle">Menü</p>
        <button type="button" class="nv-mnav__close mobile-nav__toggler" aria-label="Menüyü kapat">
            <svg class="nv-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
            <span aria-hidden="true">Kapat</span>
        </button>
    </div>

    <div class="mobile-nav__container nv-mnav__body">
        <div class="nv-mnav__ctas">
            <a href="/randevu" class="nv-btn nv-btn--primary nv-btn--lg nv-btn--block">Randevu Talebi Oluştur</a>
            {{ if Options.Options.ContactPhone != "" }}
            <a href="tel:{{ Options.Options.ContactPhone }}" class="nv-btn nv-btn--secondary nv-btn--lg nv-btn--block">
                <svg class="nv-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
                <span>Hemen Ara: <span class="nv-nowrap">{{ Options.Options.ContactPhone }}</span></span>
            </a>
            {{ end }}
        </div>

        <nav class="nv-mnav__nav" aria-label="Ana menü">
            <ul class="nv-mnav__list">
                <li><a class="nv-mnav__link" href="/">Ana Sayfa</a></li>
                {{ range index1, HeaderButtons := Options.HeaderButtons }}
                    {{ if HeaderButtons.ButtonType == "kurumsal" && HeaderButtons.ParentId == "" }}
                        <li>
                            <button type="button" class="nv-mnav__toggle" aria-expanded="false" aria-controls="nvMSub{{ index1 }}">
                                <span>{{ HeaderButtons.Title }}</span>
                                <svg class="nv-icon nv-icon--chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                            </button>
                            <ul class="nv-mnav__sub" id="nvMSub{{ index1 }}" hidden>
                                {{ if HeaderButtons.Url != "" && HeaderButtons.Url != "#" }}
                                    <li><a href="{{ HeaderButtons.Url }}" target="{{ HeaderButtons.Target }}">{{ HeaderButtons.Title }}</a></li>
                                {{ end }}
                                {{ range index2, HeaderButtonsAgain := Options.HeaderButtons }}
                                    {{ if HeaderButtonsAgain.ButtonType == "kurumsal" && HeaderButtonsAgain.Hbid == HeaderButtons.ParentId && HeaderButtonsAgain.ParentId != "" }}
                                        <li><a href="{{ HeaderButtonsAgain.Url }}" target="{{ HeaderButtonsAgain.Target }}">{{ HeaderButtonsAgain.Title }}</a></li>
                                    {{ end }}
                                {{ end }}
                            </ul>
                        </li>
                    {{ end }}
                    {{ if HeaderButtons.ButtonType == "subeler" && HeaderButtons.ParentId == "" }}
                        <li>
                            <button type="button" class="nv-mnav__toggle" aria-expanded="false" aria-controls="nvMSub{{ index1 }}">
                                <span>{{ HeaderButtons.Title }}</span>
                                <svg class="nv-icon nv-icon--chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                            </button>
                            <ul class="nv-mnav__sub" id="nvMSub{{ index1 }}" hidden>
                                <li><a href="{{ HeaderButtons.Url != "" && HeaderButtons.Url != "#" ? HeaderButtons.Url : "/merkezlerimiz" }}">Tüm {{ HeaderButtons.Title }}</a></li>
                                {{ range index2, SubeLink := Options.SubelerLinks }}
                                    <li><a href="/merkezlerimiz/{{ SubeLink.UrlName }}">{{ SubeLink.Name }}</a></li>
                                {{ end }}
                            </ul>
                        </li>
                    {{ end }}
                    {{ if HeaderButtons.ButtonType == "tibbi_birimler" && HeaderButtons.ParentId == "" }}
                        <li>
                            <button type="button" class="nv-mnav__toggle" aria-expanded="false" aria-controls="nvMSub{{ index1 }}">
                                <span>{{ HeaderButtons.Title }}</span>
                                <svg class="nv-icon nv-icon--chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                            </button>
                            <ul class="nv-mnav__sub" id="nvMSub{{ index1 }}" hidden>
                                <li><a href="/tibbi-birimler">Tüm {{ HeaderButtons.Title }}</a></li>
                                {{ range index2, TibbiBirimLink := Options.TibbiBirimlerLinks }}
                                    <li><a href="/tibbi-birimler/{{ TibbiBirimLink.UrlName }}">{{ TibbiBirimLink.Name }}</a></li>
                                {{ end }}
                            </ul>
                        </li>
                    {{ end }}
                    {{ if HeaderButtons.ButtonType == "tedkikler" && HeaderButtons.ParentId == "" }}
                        <li>
                            <button type="button" class="nv-mnav__toggle" aria-expanded="false" aria-controls="nvMSub{{ index1 }}">
                                <span>{{ HeaderButtons.Title }}</span>
                                <svg class="nv-icon nv-icon--chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                            </button>
                            <ul class="nv-mnav__sub" id="nvMSub{{ index1 }}" hidden>
                                <li><a href="/tetkikler">Tüm {{ HeaderButtons.Title }}</a></li>
                                {{ range index2, TedkikLink := Options.TedkiklerLinks }}
                                    <li><a href="/tetkikler/{{ TedkikLink.UrlName }}">{{ TedkikLink.Name }}</a></li>
                                {{ end }}
                            </ul>
                        </li>
                    {{ end }}
                    {{ if HeaderButtons.ButtonType == "diger" && HeaderButtons.ParentId == "" }}
                        <li><a class="nv-mnav__link" href="{{ HeaderButtons.Url }}" target="{{ HeaderButtons.Target }}">{{ HeaderButtons.Title }}</a></li>
                    {{ end }}
                {{ end }}
            </ul>
        </nav>

        {{ if Options.Options.ContactEmail != "" }}
        <p class="nv-mnav__contact">
            <a href="mailto:{{ Options.Options.ContactEmail }}">{{ Options.Options.ContactEmail }}</a>
        </p>
        {{ end }}
    </div>
</div>

<div id="nvMobileSearchBar" class="nv-search" hidden>
    <form action="/arama" method="get" class="nv-search__form" role="search">
        <label class="nv-search__label" for="nvMobileSearchInput">Sitede arayın</label>
        <div class="nv-search__row">
            <input id="nvMobileSearchInput" class="nv-input nv-search__input" type="search" name="q" autocomplete="off" placeholder="Örneğin: katarakt, doktor adı">
            <button type="submit" aria-label="Ara" class="nv-btn nv-btn--secondary nv-search__submit">Ara</button>
        </div>
    </form>
</div>
{{ if Route != "/" }}
    {{ include "../../components/frontend-header-init" }}
{{ end }}
