<section class="page-header" style="margin-top: 200px;">
    <div class="container-fluid">
        <div class="page-header__inner">
            <div class="page-header__bg" style="background-image: url({{ PathOnStart }}{{ Options.Options.DefaultPageMediaPath != "" ? Options.Options.DefaultPageMediaPath : "assets/images/backgrounds/institutional-default.jpg" }});"></div><!-- /.page-header__bg -->
            <div class="container">
                <div class="page-header__content">
                    <h2 class="page-header__title">{{ Sube.Name }}</h2>
                    <ul class="mediox-breadcrumb list-unstyled">
                        <li>
                            <span class="mediox-breadcrumb__icon"><i class="icon-home"></i></span>
                            <a href="/">Anasayfa</a>
                        </li>
                        <li><a href="/subelerimiz">Şubeler</a></li>
                        <li><span>{{ Sube.Name }}</span></li>
                    </ul><!-- /.mediox-breadcrumb list-unstyled -->
                </div><!-- /.page-header__content -->
            </div><!-- /.container -->
        </div><!-- /.page-header__inner -->
    </div><!-- /.container-fluid -->
</section><!-- /.page-header -->

<section class="portfolio-details section-space">
    <div class="container">
        <div class="row gutter-y-50">
            <div class="col-xl-8 col-lg-7">
                <div class="portfolio-details__content">
                    <div class="portfolio-details__image wow fadeInUp" data-wow-delay="00ms" data-wow-duration="1500ms">
                        {{ if Sube.SubeMediaPath }}
                            <img src="{{ Sube.SubeMediaPath }}" alt="{{ Sube.SubeMediaAltText }}" title="{{ Sube.SubeMediaTitle }}">
                        {{ else }}
                            <img src="{{ PathOnStart }}files/defaults/sube/sube-default.png" alt="{{ Sube.Name }}" title="{{ Sube.Name }}">
                        {{ end }}
                    </div><!-- /.portfolio-details__image -->
                    <h3 class="portfolio-details__title">{{ Sube.Name }}</h3><!-- /.portfolio-details__title -->
                    <div class="portfolio-details__content__inner">
                        {{ if Sube.Description }}
                        <div class="sube-description" style="margin-bottom: 24px;">
                            <p class="portfolio-details__text">{{ Sube.Description }}</p>
                        </div>
                        {{ end }}
                        
                        <div class="sube-contact-info" style="background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%); padding: 20px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
                            <h4 style="color: var(--theme-primary-color); margin-bottom: 16px; font-size: 18px; font-weight: 700; text-align: center; text-transform: uppercase; letter-spacing: 1px;">📞 İletişim Bilgileri</h4>
                            <div class="contact-list">
                                {{ if Sube.Address }}
                                <div class="contact-row" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-left: 4px solid #10b981; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; box-shadow: 0 2px 4px rgba(16, 185, 129, 0.1);">
                                    <i class="fas fa-map-marker-alt" style="color: #10b981; margin-right: 8px; font-size: 14px;"></i>
                                    <span class="contact-label" style="color: #065f46; font-weight: 700; font-size: 10px; text-transform: uppercase; margin-right: 6px;">📍 Adres:</span>
                                    <span class="contact-value" style="color: #047857; font-weight: 500; font-size: 11px;">{{ Sube.Address }}{{ if Sube.City }}, {{ Sube.City }}{{ end }}{{ if Sube.District }}, {{ Sube.District }}{{ end }}{{ if Sube.PostalCode }} {{ Sube.PostalCode }}{{ end }}</span>
                                </div>
                                {{ end }}
                                
                                {{ if Sube.Phone }}
                                <div class="contact-row" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-left: 4px solid #3b82f6; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; box-shadow: 0 2px 4px rgba(59, 130, 246, 0.1);">
                                    <i class="fas fa-phone" style="color: #3b82f6; margin-right: 8px; font-size: 14px;"></i>
                                    <span class="contact-label" style="color: #1e40af; font-weight: 700; font-size: 10px; text-transform: uppercase; margin-right: 6px;">📞 Telefon:</span>
                                    <a href="tel:{{ Sube.Phone }}" class="contact-value" style="color: #1d4ed8; font-weight: 600; font-size: 11px; text-decoration: none;">{{ Sube.Phone }}</a>
                                </div>
                                {{ end }}
                                
                                {{ if Sube.Fax }}
                                <div class="contact-row" style="background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%); border-left: 4px solid #8b5cf6; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; box-shadow: 0 2px 4px rgba(139, 92, 246, 0.1);">
                                    <i class="fas fa-fax" style="color: #8b5cf6; margin-right: 8px; font-size: 14px;"></i>
                                    <span class="contact-label" style="color: #6b21a8; font-weight: 700; font-size: 10px; text-transform: uppercase; margin-right: 6px;">📠 Faks:</span>
                                    <span class="contact-value" style="color: #7c3aed; font-weight: 500; font-size: 11px;">{{ Sube.Fax }}</span>
                                </div>
                                {{ end }}
                                
                                {{ if Sube.Email }}
                                <div class="contact-row" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border-left: 4px solid #f59e0b; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; box-shadow: 0 2px 4px rgba(245, 158, 11, 0.1);">
                                    <i class="fas fa-envelope" style="color: #f59e0b; margin-right: 8px; font-size: 14px;"></i>
                                    <span class="contact-label" style="color: #92400e; font-weight: 700; font-size: 10px; text-transform: uppercase; margin-right: 6px;">📧 E-posta:</span>
                                    <a href="mailto:{{ Sube.Email }}" class="contact-value" style="color: #d97706; font-weight: 600; font-size: 11px; text-decoration: none;">{{ Sube.Email }}</a>
                                </div>
                                {{ end }}
                                
                                {{ if Sube.Website }}
                                <div class="contact-row" style="background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border-left: 4px solid #ef4444; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; box-shadow: 0 2px 4px rgba(239, 68, 68, 0.1);">
                                    <i class="fas fa-globe" style="color: #ef4444; margin-right: 8px; font-size: 14px;"></i>
                                    <span class="contact-label" style="color: #991b1b; font-weight: 700; font-size: 10px; text-transform: uppercase; margin-right: 6px;">🌐 Website:</span>
                                    <a href="{{ Sube.Website }}" target="_blank" rel="noopener" class="contact-value" style="color: #dc2626; font-weight: 600; font-size: 11px; text-decoration: none;">{{ Sube.Website }}</a>
                                </div>
                                {{ end }}
                                
                                {{ if Sube.WorkingHours }}
                                <div class="contact-row" style="background: linear-gradient(135deg, #ecfeff 0%, #cffafe 100%); border-left: 4px solid #06b6d4; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; box-shadow: 0 2px 4px rgba(6, 182, 212, 0.1);">
                                    <i class="fas fa-clock" style="color: #06b6d4; margin-right: 8px; font-size: 14px;"></i>
                                    <span class="contact-label" style="color: #155e75; font-weight: 700; font-size: 10px; text-transform: uppercase; margin-right: 6px;">🕒 Çalışma Saatleri:</span>
                                    <span class="contact-value working-hours-content" data-raw-hours="{{ Sube.WorkingHours }}" style="color: #0891b2; font-weight: 500; font-size: 11px;">{{ Sube.WorkingHours }}</span>
                                </div>
                                {{ end }}
                                
                                {{ if Sube.TransportationInfo }}
                                <div class="contact-row" style="background: linear-gradient(135deg, #f7fee7 0%, #ecfccb 100%); border-left: 4px solid #84cc16; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; box-shadow: 0 2px 4px rgba(132, 204, 22, 0.1);">
                                    <i class="fas fa-bus" style="color: #84cc16; margin-right: 8px; font-size: 14px;"></i>
                                    <span class="contact-label" style="color: #365314; font-weight: 700; font-size: 10px; text-transform: uppercase; margin-right: 6px;">🚌 Ulaşım:</span>
                                    <span class="contact-value" style="color: #65a30d; font-weight: 500; font-size: 11px;">{{ Sube.TransportationInfo }}</span>
                                </div>
                                {{ end }}
                            </div>
                        </div>
                        
                        <div class="d-flex" style="gap: 10px; margin-top: 24px;">
                            <a href="/subelerimiz/{{ Sube.UrlName }}" class="mediox-btn mediox-btn--normal"><span>Şube Bilgileri</span></a>
                            <a href="/subelerimiz/{{ Sube.UrlName }}/doktorlar" class="mediox-btn mediox-btn--normal"><span>Doktorları Gör</span></a>
                        </div>
                    </div><!-- /.portfolio-details__content__inner -->
                </div><!-- /.portfolio-details__content -->
                
            </div><!-- /.col-xl-8 col-lg-7 -->
            <div class="col-xl-4 col-lg-5">
                <aside class="portfolio-sidebar">
                    <div class="portfolio-sidebar__item wow fadeInRight" data-wow-duration="1500ms" data-wow-delay="00ms">
                        <div class="portfolio-sidebar__info">
                            <div class="portfolio-sidebar__info__top">
                                <h3 class="portfolio-sidebar__title">Şube Bilgileri</h3>
                                <!-- /.portfolio-sidebar__title -->
                            </div><!-- /.portfolio-sidebar__info__top -->
                            <ul class="portfolio-sidebar__info__list">
                                {{ if Sube.IsMain }}
                                <li>
                                    <span class="portfolio-sidebar__info__title">Durum:</span>
                                    <span class="portfolio-sidebar__info__text" style="color: var(--theme-primary-color); font-weight: 600;">Ana Şube</span>
                                </li>
                                {{ end }}
                                
                                {{ if Sube.City }}
                                <li>
                                    <span class="portfolio-sidebar__info__title">Konum:</span>
                                    <span class="portfolio-sidebar__info__text">{{ Sube.City }}{{ if Sube.District }}, {{ Sube.District }}{{ end }}</span>
                                </li>
                                {{ end }}
                                
                                {{ if Sube.WorkingHours }}
                                <li>
                                    <span class="portfolio-sidebar__info__title">Çalışma Saatleri:</span>
                                    <span class="portfolio-sidebar__info__text working-hours-sidebar">{{ Sube.WorkingHours }}</span>
                                </li>
                                {{ end }}
                                
                                {{ if BranchCount }}
                                <li>
                                    <span class="portfolio-sidebar__info__title">Branşlar:</span>
                                    <span class="portfolio-sidebar__info__text">{{ len(BranchCount) }} branş</span>
                                </li>
                                {{ end }}
                                
                                <li>
                                    <span class="portfolio-sidebar__info__title">Doktorlar:</span>
                                    <span class="portfolio-sidebar__info__text">{{ DoctorCount }} doktor</span>
                                </li>
                                
                                {{ if Sube.Latitude != 0 && Sube.Longitude != 0 }}
                                <li>
                                    <span class="portfolio-sidebar__info__title">Koordinatlar:</span>
                                    <span class="portfolio-sidebar__info__text">{{ Sube.Latitude }}, {{ Sube.Longitude }}</span>
                                </li>
                                {{ end }}
                                
                                {{ if Sube.PostalCode }}
                                <li>
                                    <span class="portfolio-sidebar__info__title">Posta Kodu:</span>
                                    <span class="portfolio-sidebar__info__text">{{ Sube.PostalCode }}</span>
                                </li>
                                {{ end }}
                                
                                {{ if len(AnlasmaliKurumlar) > 0 }}
                                <li>
                                    <span class="portfolio-sidebar__info__title">Anlaşmalı Kurumlar:</span>
                                    <span class="portfolio-sidebar__info__text">{{ len(AnlasmaliKurumlar) }} kurum</span>
                                </li>
                                {{ end }}
                            </ul><!-- /.portfolio-sidebar__info__list -->
                        </div><!-- /.portfolio-sidebar__info -->
                    </div><!-- /.portfolio-sidebar__item -->
                    
                    <!-- Anlaşmalı Kurumlar Section -->
                    {{ if len(AnlasmaliKurumlar) > 0 }}
                    <div class="portfolio-sidebar__item wow fadeInRight" data-wow-duration="1500ms" data-wow-delay="300ms">
                        <div class="portfolio-sidebar__info">
                            <div class="portfolio-sidebar__info__top">
                                <h3 class="portfolio-sidebar__title">🤝 Anlaşmalı Kurumlar</h3>
                            </div>
                            <div class="anlasmali-kurumlar-list" style="margin-top: 16px;">
                                {{ range AnlasmaliKurumlar }}
                                <div class="anlasmali-kurum-item" style="background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%); border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin-bottom: 8px; transition: all 0.3s ease;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div class="kurum-icon" style="width: 32px; height: 32px; background: var(--theme-primary-color); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: white; font-size: 14px; flex-shrink: 0;">
                                            {{ if .Type == "sigorta" }}
                                                <i class="fas fa-shield-alt"></i>
                                            {{ else if .Type == "kurumsal" }}
                                                <i class="fas fa-building"></i>
                                            {{ else if .Type == "universite" }}
                                                <i class="fas fa-graduation-cap"></i>
                                            {{ else if .Type == "devlet" }}
                                                <i class="fas fa-landmark"></i>
                                            {{ else if .Type == "ozel" }}
                                                <i class="fas fa-user-tie"></i>
                                            {{ else }}
                                                <i class="fas fa-handshake"></i>
                                            {{ end }}
                                        </div>
                                        <div style="flex: 1; min-width: 0;">
                                            <div style="font-size: 12px; font-weight: 600; color: #1f2937; margin-bottom: 2px; word-break: break-word;">{{ .Name }}</div>
                                            <div style="font-size: 10px; color: #6b7280; margin-bottom: 4px;">
                                                {{ if .Type == "sigorta" }}
                                                    Sigorta
                                                {{ else if .Type == "kurumsal" }}
                                                    Kurumsal
                                                {{ else if .Type == "universite" }}
                                                    Üniversite
                                                {{ else if .Type == "devlet" }}
                                                    Devlet
                                                {{ else if .Type == "ozel" }}
                                                    Özel
                                                {{ end }}
                                            </div>
                                            {{ if .ContactPerson }}
                                            <div style="font-size: 10px; color: #6b7280;">
                                                <i class="fas fa-user" style="margin-right: 4px;"></i>
                                                {{ .ContactPerson }}
                                            </div>
                                            {{ end }}
                                            {{ if .Phone }}
                                            <div style="font-size: 10px; color: #6b7280;">
                                                <i class="fas fa-phone" style="margin-right: 4px;"></i>
                                                <a href="tel:{{ .Phone }}" style="color: #3b82f6; text-decoration: none;">{{ .Phone }}</a>
                                            </div>
                                            {{ end }}
                                        </div>
                                        <div style="display: flex; align-items: center;">
                                            {{ if .IsActive }}
                                            <span style="background: #10b981; color: white; padding: 2px 6px; border-radius: 4px; font-size: 9px; font-weight: 500;">
                                                <i class="fas fa-check-circle" style="margin-right: 2px;"></i>
                                                Aktif
                                            </span>
                                            {{ else }}
                                            <span style="background: #6b7280; color: white; padding: 2px 6px; border-radius: 4px; font-size: 9px; font-weight: 500;">
                                                <i class="fas fa-pause-circle" style="margin-right: 2px;"></i>
                                                Pasif
                                            </span>
                                            {{ end }}
                                        </div>
                                    </div>
                                </div>
                                {{ end }}
                            </div>
                        </div>
                    </div>
                    {{ end }}
                    
                    <!-- Şube Dokümanları Section -->
                    {{ if len(SubeDocuments) > 0 }}
                    <div class="portfolio-sidebar__item wow fadeInRight" data-wow-duration="1500ms" data-wow-delay="200ms">
                        <div class="portfolio-sidebar__info">
                            <div class="portfolio-sidebar__info__top">
                                <h3 class="portfolio-sidebar__title">📄 Şube Dokümanları</h3>
                            </div>
                            <div class="documents-list" style="margin-top: 16px;">
                                {{ range SubeDocuments }}
                                <div class="document-item" style="background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%); border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin-bottom: 8px; transition: all 0.3s ease; cursor: pointer;" onclick="previewDocument('{{ .FilePath }}', '{{ .MimeType }}', '{{ .FileName }}')">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div class="document-icon" style="width: 32px; height: 32px; background: var(--theme-primary-color); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: white; font-size: 14px; flex-shrink: 0;">
                                            {{ if contains(.MimeType, "image/") }}
                                                <i class="fas fa-image"></i>
                                            {{ else if contains(.MimeType, "video/") }}
                                                <i class="fas fa-video"></i>
                                            {{ else if contains(.MimeType, "audio/") }}
                                                <i class="fas fa-music"></i>
                                            {{ else if contains(.MimeType, "application/pdf") }}
                                                <i class="fas fa-file-pdf"></i>
                                            {{ else if contains(.MimeType, "application/msword") }}
                                                <i class="fas fa-file-word"></i>
                                            {{ else if contains(.MimeType, "application/vnd.openxmlformats-officedocument.wordprocessingml.document") }}
                                                <i class="fas fa-file-word"></i>
                                            {{ else if contains(.MimeType, "application/vnd.ms-excel") }}
                                                <i class="fas fa-file-excel"></i>
                                            {{ else if contains(.MimeType, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet") }}
                                                <i class="fas fa-file-excel"></i>
                                            {{ else if contains(.MimeType, "application/vnd.ms-powerpoint") }}
                                                <i class="fas fa-file-powerpoint"></i>
                                            {{ else if contains(.MimeType, "application/vnd.openxmlformats-officedocument.presentationml.presentation") }}
                                                <i class="fas fa-file-powerpoint"></i>
                                            {{ else if contains(.MimeType, "text/") }}
                                                <i class="fas fa-file-alt"></i>
                                            {{ else if contains(.MimeType, "application/zip") }}
                                                <i class="fas fa-file-archive"></i>
                                            {{ else }}
                                                <i class="fas fa-file"></i>
                                            {{ end }}
                                        </div>
                                        <div style="flex: 1; min-width: 0;">
                                            {{ if .Data }}
                                                <div style="font-size: 12px; font-weight: 600; color: #1f2937; margin-bottom: 2px; word-break: break-word;">{{ .Data }}</div>
                                            {{ else }}
                                                <div style="font-size: 12px; font-weight: 600; color: #1f2937; margin-bottom: 2px; word-break: break-word;">{{ .FileName }}</div>
                                            {{ end }}
                                            
                                             <div class="file-size" data-size="{{ .FileSize }}" style="font-size: 10px; color: #6b7280;">{{ .FileSize }} bytes</div>

                                        </div>
                                        <div style="display: flex; gap: 4px;">
                                            <button onclick="event.stopPropagation(); downloadDocument('{{ .FilePath }}', '{{ .FileName }}')" style="background: #3b82f6; color: white; border: none; border-radius: 4px; padding: 4px 8px; font-size: 10px; cursor: pointer; transition: background 0.2s;">
                                                <i class="fas fa-download"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                {{ end }}
                            </div>
                        </div>
                    </div>
                    {{ end }}
                </aside><!-- /.portfolio-sidebar -->
            </div><!-- /.col-xl-4 col-lg-5 -->
        </div><!-- /.row gutter-y-50 -->
    </div><!-- /.container -->
</section><!-- /.portfolio-details section-space -->

<script>
    // Pass working hours data to JavaScript
    window.workingHoursData = '{{ stj(Sube.WorkingHours) }}';
</script>
<script src="{{ PathOnStart }}js/frontend/sube.js"></script>