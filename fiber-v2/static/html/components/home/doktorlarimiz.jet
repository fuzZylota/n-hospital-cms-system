{* P3-3 — Anasayfa doktorlar. Yalnız DB'deki aktif doktorlar; puan/sayı yok.
   Otomatik kayan carousel kaldırıldı: statik ızgara, ilk 6 doktor (sıra
   controller'da unvana göre). Fotoğrafın alt'ı boş: ad hemen yanındaki h3'te,
   ekran okuyucu adı iki kez okumasın. Doktor yoksa bölüm hiç basılmaz. *}
{{ if len(Doctors) > 0 }}
<section class="nv-home-sec" aria-labelledby="nvHomeDoctorsTitle">
    <div class="nv-home__container">
        <div class="nv-home-sec__head">
            <h2 class="nv-home-sec__title" id="nvHomeDoctorsTitle">Doktorlarımız</h2>
            <a class="nv-home-sec__more" href="/doktorlarimiz">Tüm doktorlarımız</a>
        </div>
        <ul class="nv-home-grid nv-home-grid--people" role="list">
            {{ range index2, Doctor := Doctors }}{{ if index2 < 6 }}
            {{ doctorName := Doctor.Title + " " + Doctor.FirstName + " " + Doctor.LastName }}
            {{ doctorCenter := Doctor.CalistigiSubelerText != "" ? Doctor.CalistigiSubelerText : Doctor.SubeName }}
            <li class="nv-card nv-doc-card">
                {{ if Doctor.PhotoPath != "" }}
                <img class="nv-doc-card__photo" src="{{ Doctor.PhotoPath }}" alt="" width="400" height="480" loading="lazy" decoding="async">
                {{ else }}
                <span class="nv-doc-card__photo nv-doc-card__photo--empty" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path fill="currentColor" d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zm0 2c-4.4 0-8 2.5-8 5.5V21h16v-1.5c0-3-3.6-5.5-8-5.5z"/></svg>
                </span>
                {{ end }}
                <div class="nv-card__body">
                    <h3 class="nv-card__title"><a class="nv-card__link" href="/doktorlarimiz/{{ Doctor.UrlName }}">{{ doctorName }}</a></h3>
                    {{ if Doctor.BransName != "" }}<p class="nv-card__meta">{{ Doctor.BransName }}</p>{{ end }}
                    {{ if doctorCenter != "" }}
                    <p class="nv-card__meta nv-home-meta">
                        <svg class="nv-home-meta__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                        <span><span class="sr-only">Merkez: </span>{{ doctorCenter }}</span>
                    </p>
                    {{ end }}
                    <div class="nv-card__actions">
                        <a class="nv-btn nv-btn--secondary nv-btn--block" href="/randevu">Randevu talebi<span class="sr-only">: {{ doctorName }}</span></a>
                    </div>
                </div>
            </li>
            {{ end }}{{ end }}
        </ul>
    </div>
</section>
{{ end }}
