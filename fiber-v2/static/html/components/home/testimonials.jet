{* P3-3 — Hasta yorumları: statik ızgara, otomatik geçiş/carousel yok.
   Metin, ad ve meslek DB'den (testimonials). Sabit 5 yıldız kaldırıldı:
   DB puanından bağımsız basılıyordu (uydurma puan). Fotoğraf dekoratif
   (ad hemen altında), alt="" . Panelden kapatılabilir (EnableTestimonials). *}
{{ if Options.Options.EnableTestimonials && len(Testimonials) > 0 }}
<section class="nv-home-sec nv-home-sec--alt" aria-labelledby="nvHomeReviewsTitle">
    <div class="nv-home__container">
        <div class="nv-home-sec__head">
            <h2 class="nv-home-sec__title" id="nvHomeReviewsTitle">Hasta yorumları</h2>
        </div>
        <ul class="nv-home-grid nv-home-grid--reviews" role="list">
            {{ range index2, Testimonial := Testimonials }}
            <li class="nv-review">
                <figure class="nv-review__figure">
                    <blockquote class="nv-review__quote">
                        <p>{{ Testimonial.Content }}</p>
                    </blockquote>
                    <figcaption class="nv-review__by">
                        {{ if Testimonial.CustomerPicturePath != "" }}
                        <img class="nv-review__photo" src="{{ Testimonial.CustomerPicturePath }}" alt="" width="56" height="56" loading="lazy" decoding="async">
                        {{ end }}
                        <span>
                            <span class="nv-review__name">{{ Testimonial.FirstName }} {{ Testimonial.LastName }}</span>
                            {{ if Testimonial.Occupation != "" }}<span class="nv-review__role">{{ Testimonial.Occupation }}</span>{{ end }}
                        </span>
                    </figcaption>
                </figure>
            </li>
            {{ end }}
        </ul>
    </div>
</section>
{{ end }}
