<aside class="sidebar-one">
    <div class="sidebar-one__overlay sidebar-btn__toggler"></div><!-- /.siderbar-ovarlay -->
    <div class="sidebar-one__content">
        <span class="sidebar-one__close sidebar-btn__toggler"><i class="icon-close"></i></span>
        <div class="sidebar-one__logo sidebar-one__item logo-retina">
            <a href="/" aria-label="logo image"><img src="{{ PathOnStart }}{{ Options.Medias[0].FilePath != "" ? Options.Medias[0].FilePath : "files/defaults/logo/n-hospital-logo.png" }}" alt="{{ Options.Medias[0].AltText ? Options.Medias[0].AltText : "N-Hospital, Hastaneler için yüksek hız ve özelleştirme için geliştirilmiş bir yönetim sistemi" }}" title="{{ Options.Medias[0].Title ? Options.Medias[0].Title : "N-Hospital Logosu" }}" />
            </a>
        </div><!-- /.sidebar-one__logo -->
        <div class="sidebar-one__about sidebar-one__item">
            <p class="sidebar-one__about__text">{{ Options.Options.SiteDescription }}</p>
        </div><!-- /.sidebar-one__about -->
        <div class="sidebar-one__info sidebar-one__item">
            <h4 class="sidebar-one__title">İletişim</h4>
            <ul class="sidebar-one__info__list">
                {{ if Options.Options.ContactEmail != "" }}
                    <li>
                        <span class="sidebar-one__info__icon">
                            <i class="icon-paper-plane"></i>
                        </span>
                        <a href="mailto:{{ Options.Options.ContactEmail }}">{{ Options.Options.ContactEmail }}</a>
                    </li>
                {{ end }}
                {{ if Options.Options.ContactPhone != "" }}
                    <li>
                        <span class="sidebar-one__info__icon">
                            <i class="icon-telephone"></i>
                        </span>
                        <a href="tel:+{{ Options.Options.ContactPhone }}">{{ Options.Options.ContactPhone }}</a>
                    </li>
                {{ end }}
            </ul><!-- /.sidebar-one__info__list -->
        </div><!-- /.sidebar-one__info -->
        <div class="social-links sidebar-one__item">
            {{ if Options.Options.FacebookUrl != "" && Options.Options.FacebookUrl != "#" }}
                <a href="{{ Options.Options.FacebookUrl }}" aria-label="Facebook">
                    <i class="fab fa-facebook-f" aria-hidden="true"></i>
                    <span class="sr-only">Facebook</span>
                </a>
            {{ end }}
            {{ if Options.Options.TwitterUrl != "" && Options.Options.TwitterUrl != "#" }}
                <a href="{{ Options.Options.TwitterUrl }}" aria-label="Twitter">
                    <i class="fab fa-twitter" aria-hidden="true"></i>
                    <span class="sr-only">Twitter</span>
                </a>
            {{ end }}
            {{ if Options.Options.InstagramUrl != "" && Options.Options.InstagramUrl != "#" }}
                <a href="{{ Options.Options.InstagramUrl }}" aria-label="Instagram">
                    <i class="fab fa-instagram" aria-hidden="true"></i>
                    <span class="sr-only">Instagram</span>
                </a>
            {{ end }}
            {{ if Options.Options.LinkedinUrl != "" && Options.Options.LinkedinUrl != "#" }}
                <a href="{{ Options.Options.LinkedinUrl }}" aria-label="Youtube">
                    <i class="fab fa-youtube" aria-hidden="true"></i>
                    <span class="sr-only">Youtube</span>
                </a>
            {{ end }}
        </div><!-- /sidebar-one__social -->
    </div><!-- /.sidebar__content -->
</aside><!-- /.sidebar-one -->