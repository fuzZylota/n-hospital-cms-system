<link rel="stylesheet" href="{{ PathOnStart }}css/panel/brans-duzenle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-edit"></i>
                    Branş Bilgilerini Düzenle
                </h1>
                <p class="page-subtitle">{{ Brans.Name }} branşının bilgilerini düzenleyin</p>
            </div>
            <div class="page-actions">
                <a href="/panel/branslar/{{ Brans.Brid }}" class="btn btn-secondary">
                    <i class="fas fa-eye"></i>
                    Görüntüle
                </a>
                <a href="/panel/branslar" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="forms-container">
            <!-- General Information Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Genel Bilgiler
                    </h2>
                    <p class="section-description">Branşın temel bilgilerini düzenleyin</p>
                </div>
                <div class="section-content">
                    <form id="generalForm" class="general-form" novalidate>
                        <!-- Hidden inputs for old values -->
                        <input type="hidden" name="old_name" value="{{ Brans.Name }}">
                        <input type="hidden" name="old_url_name" value="{{ Brans.UrlName }}">
                        <input type="hidden" name="old_description" value="{{ Brans.Description }}">
                        <input type="hidden" name="old_short_description" value="{{ Brans.ShortDescription }}">
                        <input type="hidden" name="old_services" value="{{ stj(Brans.Services) }}">
                        <input type="hidden" name="old_icon" value="{{ Brans.Icon }}">
                        <input type="hidden" name="old_sid" value="{{ Brans.Sid }}">
                        <input type="hidden" name="old_head_drid" value="{{ Brans.HeadDrid }}">
                        <input type="hidden" name="old_phone" value="{{ Brans.Phone }}">
                        <input type="hidden" name="old_email" value="{{ Brans.Email }}">
                        <input type="hidden" name="old_is_active" value="{{ Brans.IsActive }}">

                        <!-- Basic Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">Temel Bilgiler</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="name" class="form-label required">Branş Adı</label>
                                    <input type="text" id="name" name="name" class="form-input" 
                                           value="{{ Brans.Name }}" required>
                                </div>
                                <div class="form-group">
                                    <label for="url_name" class="form-label">URL Adı</label>
                                    <input type="text" id="url_name" name="url_name" class="form-input" 
                                           value="{{ Brans.UrlName }}">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="description" class="form-label">Açıklama</label>
                                <textarea id="description" name="description" class="form-textarea" 
                                          rows="3">{{ Brans.Description }}</textarea>
                            </div>
                            <div class="form-group">
                                <label for="short_description" class="form-label">Kısa Açıklama</label>
                                <textarea id="short_description" name="short_description" class="form-textarea" 
                                          rows="2">{{ Brans.ShortDescription }}</textarea>
                            </div>
                            <div class="form-group">
                                <label for="services_input" class="form-label">Hizmetler</label>
                                <textarea id="services_input" name="services_input" rows="5" class="form-textarea" placeholder="Her satıra bir hizmet yazın">{{ range Brans.Services }}{{ . }}{{ "\n" }}{{ end }}</textarea>
                                <div class="form-help">Her satıra bir hizmet yazın, örn: EKG, Ekokardiyografi, Stres Testi</div>
                                <!-- Hidden input for processed JSON data -->
                                <input type="hidden" id="services" name="services" value="{{ stj(Brans.Services) }}">
                            </div>
                            <div class="form-group">
                                <label for="icon" class="form-label">İkon</label>
                                <input type="text" id="icon" name="icon" class="form-input" 
                                       value="{{ Brans.Icon }}" placeholder="fas fa-heart">
                            </div>
                            <div class="form-group">
                                <label for="is_active" class="form-label">Aktif Durumu</label>
                                <div class="toggle-switch">
                                    <input type="checkbox" id="is_active" name="is_active" {{ if Brans.IsActive }}checked{{ end }}>
                                    <label for="is_active" class="toggle-label">
                                        <span class="toggle-slider"></span>
                                        <span class="toggle-text">{{ if Brans.IsActive }}Aktif{{ else }}Pasif{{ end }}</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Branch and Head Doctor Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">Şube Bilgileri</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="sid" class="form-label">Bağlı Şube</label>
                                    <select id="sid" name="sid" class="form-select">
                                        <option value="">Şube Seçin</option>
                                        {{ range Subeler }}
                                        <option value="{{ .Sid }}" {{ if .Sid == Brans.Sid }}selected{{ end }}>{{ .Name }} - {{ .City }}</option>
                                        {{ end }}
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Contact Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">İletişim Bilgileri</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="phone" class="form-label">Telefon</label>
                                    <input type="tel" id="phone" name="phone" class="form-input" 
                                           value="{{ Brans.Phone }}">
                                </div>
                                <div class="form-group">
                                    <label for="email" class="form-label">E-posta</label>
                                    <input type="email" id="email" name="email" class="form-input" 
                                           value="{{ Brans.Email }}">
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" id="generalSubmitBtn">
                                <i class="fas fa-save"></i>
                                <span class="btn-text">Bilgileri Güncelle</span>
                                <div class="btn-loader" style="display: none;">
                                    <div class="spinner"></div>
                                </div>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Picture Management Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-image"></i>
                        Branş Görseli
                    </h2>
                    <p class="section-description">Branş görselini yönetin</p>
                </div>
                <div class="section-content">
                    <!-- Current Picture Display -->
                    <div class="current-media-section">
                        <h3 class="group-title">Mevcut Görsel</h3>
                        <div class="media-grid">
                            <div class="media-item">
                                <div class="media-header">
                                    <h4 class="media-title">Branş Görseli</h4>
                                    {{ if Brans.BransMediaPath }}
                                    <button type="button" class="btn-delete-media" data-brid="{{ Brans.Brid }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    {{ end }}
                                </div>
                                <div class="media-preview">
                                    {{ if Brans.BransMediaPath }}
                                    <img src="{{ PathOnStart }}{{ Brans.BransMediaPath }}" alt="{{ Brans.BransMediaAltText }}" 
                                         title="{{ Brans.BransMediaTitle }}" class="preview-image">
                                    <div class="media-info">
                                        <div class="info-item">
                                            <strong>Alt Text:</strong> {{ Brans.BransMediaAltText }}
                                        </div>
                                        <div class="info-item">
                                            <strong>Title:</strong> {{ Brans.BransMediaTitle }}
                                        </div>
                                    </div>
                                    {{ else }}
                                    <div class="no-media">
                                        <i class="fas fa-image"></i>
                                        <span>Branş görseli yüklenmemiş</span>
                                    </div>
                                    {{ end }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Picture Upload Form -->
                    <div class="media-upload-section">
                        <h3 class="group-title">Görseli Güncelle</h3>
                        <form id="pictureForm" class="picture-form" enctype="multipart/form-data" novalidate>
                            <input type="hidden" name="old_brans_media_alt_text" value="{{ Brans.BransMediaAltText }}">
                            <input type="hidden" name="old_brans_media_title" value="{{ Brans.BransMediaTitle }}">
                            
                            <div class="form-group">
                                <label for="brans_media_path" class="form-label">Branş Görseli</label>
                                <div class="file-upload-area" data-target="brans_media_path">
                                    <div class="file-upload-content">
                                        <i class="fas fa-upload"></i>
                                        <p class="file-upload-text">Görsel dosyasını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                        <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                                    </div>
                                    <input type="file" id="brans_media_path" name="brans_media_path" 
                                           class="file-input" accept="image/*">
                                    <div class="file-preview" style="display: none;">
                                        <img class="preview-image" src="" alt="Preview">
                                        <button type="button" class="file-remove">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="file-meta-inputs">
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="brans_media_alt_text" class="form-label">Görsel Alt Metni</label>
                                            <input type="text" id="brans_media_alt_text" name="brans_media_alt_text" 
                                                   class="form-input" value="{{ Brans.BransMediaAltText }}">
                                        </div>
                                        <div class="form-group">
                                            <label for="brans_media_title" class="form-label">Görsel Başlığı</label>
                                            <input type="text" id="brans_media_title" name="brans_media_title" 
                                                   class="form-input" value="{{ Brans.BransMediaTitle }}">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" id="pictureSubmitBtn">
                                    <i class="fas fa-upload"></i>
                                    <span class="btn-text">Görseli Güncelle</span>
                                    <div class="btn-loader" style="display: none;">
                                        <div class="spinner"></div>
                                    </div>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">İşlem başarıyla tamamlandı.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deletePictureModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Görseli Sil</h3>
        <p class="modal-message">Bu görseli silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeModal('deletePictureModal')">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeletePictureBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<script>
    // Pass data to JavaScript
    window.pageData = {
        brid: "{{ Brans.Brid }}"
    };
</script>
<script src="{{ PathOnStart }}js/panel/brans-duzenle.js"></script>
