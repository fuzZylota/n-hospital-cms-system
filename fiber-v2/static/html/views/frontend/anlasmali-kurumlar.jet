<section class="page-header" style="margin-top: 200px;">
    <div class="container-fluid">
        <div class="page-header__inner">
            <div class="page-header__bg" style="background-image: url({{ PathOnStart }}{{ Options.Options.DefaultPageMediaPath != "" ? Options.Options.DefaultPageMediaPath : "assets/images/backgrounds/institutional-default.jpg" }});"></div><!-- /.page-header__bg -->
            <div class="container">
                <div class="page-header__content">
                    <h2 class="page-header__title">Anlaşmalı Kurumlar</h2>
                    <ul class="mediox-breadcrumb list-unstyled">
                        <li>
                            <span class="mediox-breadcrumb__icon"><i class="icon-home"></i></span>
                            <a href="/">Anasayfa</a>
                        </li>
                        <li><span>Kurumsal</span></li>
                        <li><span>Anlaşmalı Kurumlar</span></li>
                    </ul><!-- /.mediox-breadcrumb list-unstyled -->
                </div><!-- /.page-header__content -->
            </div><!-- /.container -->
        </div><!-- /.page-header__inner -->
    </div><!-- /.container-fluid -->
</section><!-- /.page-header -->

<section class="service-details section-space">
    <div class="container">
        <div class="row gutter-y-50">
            <div class="col-md-12 col-lg-4">
                <div class="service-sidebar">
                    <div class="service-sidebar__info service-sidebar__single">
                        <ul class="list-unstyled service-sidebar__nav wow fadeInLeft" data-wow-duration="1500ms">
                            {{ range index1, HeaderButtons := Options.HeaderButtons }}
                                {{ if HeaderButtons.ButtonType == "kurumsal" && HeaderButtons.ParentId != "" }}
                                    <li><a href="{{ HeaderButtons.Url }}" target="{{ HeaderButtons.Target }}">{{ HeaderButtons.Title }}</a></li>
                                {{ end }}
                            {{ end }}
                        </ul><!-- /.list-unstyled service-sidebar__nav -->
                        <div class="service-sidebar__contact wow fadeInLeft" data-wow-duration="1500ms" data-wow-delay="100ms" style="background-image: url('{{ PathOnStart }}{{ Options.Medias[3].FilePath != "" ? Options.Medias[3].FilePath : "assets/images/backgrounds/institutional-default.jpg" }}'); background-size: contain; background-position: center;">
                            <div class="service-sidebar__contact__bg">
                                <div class="service-sidebar__contact__bg__inner" style="background-image: url('{{ PathOnStart }}{{ Options.Medias[3].FilePath != "" ? Options.Medias[3].FilePath : "assets/images/backgrounds/institutional-default.jpg" }}'); background-size: contain; background-position: center;"></div><!-- /.service-sidebar__contact__bg__inner -->
                            </div><!-- /.service-sidebar__contact__bg -->
                            <div class="service-sidebar__contact__inner">
                                <div class="service-sidebar__contact__icon">
                                    <i class="icon-telephone"></i>
                                </div><!-- /.service-sidebar__contact__icon -->
                                <div class="service-sidebar__contact__content">
                                    <h4 class="service-sidebar__contact__number">
                                        <a href="tel:+{{ Options.Options.ContactPhone }}">{{ Options.Options.ContactPhone }}</a>
                                    </h4><!-- /.service-sidebar__contact__number -->
                                </div><!-- /.service-sidebar__contact__content -->
                            </div><!-- /.service-sidebar__contact__inner -->
                        </div><!-- /.service-sidebar__contact -->
                    </div><!-- /.service-sidebar__info service-sidebar__single -->
                </div><!-- /.sidebar -->
            </div><!-- /.col-md-12 col-lg-4 -->
            <div class="col-md-12 col-lg-8">
                <div class="service-details__content">
                    <div class="service-details__inner">
                        <div class="service-details__content__box wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="00ms">
                            <h3 class="service-details__title">Anlaşmalı Kurumlar</h3><!-- /.service-details__title -->
                            <p class="service-details__text">Merkezlerimiz, kaliteli sağlık hizmetlerini daha geniş kitlelere ulaştırmak amacıyla çeşitli kurum ve kuruluşlarla anlaşmalar yapmaktadır. Aşağıda anlaşmalı kurumlarımızın listesini bulabilirsiniz.</p><!-- /.service-details__text -->
                        </div><!-- /.service-details__content__box -->
                    </div><!-- /.service-details__inner -->
                    
                    {{ if len(AnlasmaliKurumlar) > 0 }}
                        <div class="row gutter-y-30" id="anlasmaliKurumlarContainer">
                            {{ range index, Kurum := AnlasmaliKurumlar }}
                                <div class="col-xl-6 col-lg-12 col-md-6 wow fadeInUp anlasmali-kurum-item" data-wow-duration="1500ms" data-wow-delay="{{ index * 100 }}ms">
                                    <div class="anlasmali-kurum-card">
                                        {{ if Options.Options.ShowAnlasmaliKurumPictures }}
                                        <div class="anlasmali-kurum-card-header">
                                            {{ if Kurum.LogoPath != "" }}
                                                <img src="{{ PathOnStart }}{{ Kurum.LogoPath }}" alt="{{ Kurum.LogoAltText != "" ? Kurum.LogoAltText : Kurum.Name }}" title="{{ Kurum.LogoTitle != "" ? Kurum.LogoTitle : Kurum.Name }}" class="anlasmali-kurum-logo">
                                            {{ else }}
                                                <img src="{{ PathOnStart }}files/defaults/anlasmali-kurumlar/anlasmali-kurumlar-default.png" alt="{{ Kurum.Name }}" title="{{ Kurum.Name }}" class="anlasmali-kurum-logo">
                                            {{ end }}
                                        </div>
                                        {{ end }}
                                        <div class="anlasmali-kurum-card-content">
                                            <h3 class="anlasmali-kurum-name">{{ Kurum.Name }}</h3>
                                            {{ if Kurum.SubeName != "" }}
                                            <p class="anlasmali-kurum-sube">
                                                <i class="fas fa-building"></i>
                                                {{ Kurum.SubeName }}
                                            </p>
                                            {{ end }}
                                            {{ if Kurum.DiscountRate > 0 }}
                                            <p class="anlasmali-kurum-discount">İndirim Oranı: %{{ Kurum.DiscountRate }}</p>
                                            {{ end }}
                                            {{ if Kurum.Address != "" }}
                                            <p class="anlasmali-kurum-address">{{ Kurum.Address }}</p>
                                            {{ end }}
                                        </div>
                                    </div>
                                </div><!-- /.col-xl-6 col-lg-12 col-md-6 -->
                            {{ end }}
                        </div><!-- /.row gutter-y-30 -->
                        <div class="text-center" style="margin-top: 40px;" id="anlasmaliKurumlarLoadMoreContainer">
                            <button type="button" class="mediox-btn" id="anlasmaliKurumlarLoadMoreBtn">
                                <span>Devamını Getir</span>
                                <span class="mediox-btn__icon"><i class="icon-up-right-arrow"></i></span>
                            </button>
                        </div>
                    {{ else }}
                        <div class="service-details__inner-two wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="00ms">
                            <h3 class="service-details__sub-title">Anlaşmalı Kurum Bulunmuyor</h3><!-- /.service-details__sub-title -->
                            <p class="service-details__text">Şu anda anlaşmalı kurum bulunmamaktadır. Güncel bilgiler için lütfen daha sonra tekrar ziyaret ediniz.</p><!-- /.service-details__text -->
                        </div><!-- /.service-details__inner-two -->
                    {{ end }}
                </div><!-- /.service-details__content -->
            </div><!-- /.col-md-12 col-lg-8 -->
        </div><!-- /.row -->
    </div><!-- /.container -->
</section><!-- /.service-details section-space -->

<script src="{{ PathOnStart }}js/frontend/anlasmali-kurumlar.js"></script>