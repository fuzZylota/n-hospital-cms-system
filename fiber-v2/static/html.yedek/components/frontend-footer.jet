<footer class="main-footer nv-footer section-space-top">
    <div class="container">
        <section class="nv-footer__cta" aria-label="İletişim">
            <h2 class="nv-footer__cta-title">
                Yardım ister misiniz?
                <a href="/iletisim">Bizimle iletişime geçin.</a>
            </h2>

            <div class="nv-footer__connect">
                <a href="tel:{{ Options.Options.ContactPhone }}" class="nv-footer__phone">
                    <i class="fas fa-phone-alt" aria-hidden="true"></i>
                    <span>{{ Options.Options.ContactPhone }}</span>
                </a>

                <div class="nv-footer__social" aria-label="Sosyal medya">
                    <a href="https://facebook.com/nivgoz" target="_blank" rel="noopener" aria-label="Facebook">
                        <i class="fab fa-facebook-f" aria-hidden="true"></i>
                    </a>
                    <a href="https://instagram.com/nivgozmerkezi" target="_blank" rel="noopener" aria-label="Instagram">
                        <i class="fab fa-instagram" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>

        <div class="nv-footer__main">
            <nav class="nv-footer__nav" aria-label="Footer menüsü">
                <div class="nv-footer__group">
                    <h3>Kurumsal</h3>
                    <ul>
                        <li><a href="/kurumsal/hakkimizda">Hakkımızda</a></li>
                        <li><a href="/kurumsal/misyon-vizyon">Misyon &amp; Vizyon</a></li>
                        <li><a href="/kurumsal/organizasyon-semasi">Organizasyon Şeması</a></li>
                        <li><a href="/kurumsal/insan-kaynaklari">İnsan Kaynakları</a></li>
                        <li><a href="/haberler">Güncel Haberler</a></li>
                    </ul>
                </div>

                <div class="nv-footer__group">
                    <h3>Sağlık Hizmetleri</h3>
                    <ul>
                        <li><a href="/doktorlarimiz">Doktorlarımız</a></li>
                        <li><a href="/tibbi-birimler">Tıbbi Birimler</a></li>
                        <li><a href="/tetkikler">Tetkikler</a></li>
                        <li><a href="/kurumsal/anlasmali-kurumlar">Anlaşmalı Kurumlar</a></li>
                        <li><a href="/randevu">Online Randevu</a></li>
                    </ul>
                </div>

                <div class="nv-footer__group">
                    <h3>Öne Çıkan Tetkikler</h3>
                    <ul class="nv-footer__test-list">
                        {{ range index, TedkikLink := Options.TedkiklerLinks }}
                            <li><a href="/tetkikler/{{ TedkikLink.UrlName }}">{{ TedkikLink.Name }}</a></li>
                        {{ end }}
                        <li class="nv-footer__all-link"><a href="/tetkikler">Tüm Tetkikleri Gör <span aria-hidden="true">→</span></a></li>
                    </ul>
                </div>

                <div class="nv-footer__group">
                    <h3>Nivgöz</h3>
                    <ul>
                        <li><a href="/merkezlerimiz">Merkezlerimiz</a></li>
                        <li><a href="/ulasim">Ulaşım</a></li>
                        <li><a href="/foto-galeri">Foto Galeri</a></li>
                        <li><a href="/video-galeri">Video Galeri</a></li>
                        <li><a href="/iletisim">İletişim</a></li>
                    </ul>
                </div>
            </nav>

            <aside class="nv-footer__actions" aria-label="Hızlı işlemler">
                <a href="/randevu" class="nv-footer__action nv-footer__action--primary">
                    <i class="far fa-calendar-check" aria-hidden="true"></i>
                    <span>Randevu Al</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/doktorlarimiz" class="nv-footer__action">
                    <i class="fas fa-user-md" aria-hidden="true"></i>
                    <span>Doktor Bul</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/merkezlerimiz" class="nv-footer__action">
                    <i class="far fa-hospital" aria-hidden="true"></i>
                    <span>Merkezlerimiz</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a href="/iletisim" class="nv-footer__action">
                    <i class="far fa-comments" aria-hidden="true"></i>
                    <span>Bize Ulaşın</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </aside>
        </div>

        <div class="nv-footer__brand-row">
            <a href="/" class="nv-footer__logo logo-retina" aria-label="{{ Options.Options.SiteName }} ana sayfa">
                {{ if Options.Medias[1].FilePath != "" }}
                    <img src="/{{ PathOnStart }}{{ Options.Medias[1].FilePath }}" alt="{{ Options.Medias[1].AltText ? Options.Medias[1].AltText : "Nivgöz" }}" title="{{ Options.Medias[1].Title ? Options.Medias[1].Title : "Nivgöz" }}" />
                {{ else }}
                    {{ if Options.Medias[0].FilePath != "" }}
                        <img src="/{{ PathOnStart }}{{ Options.Medias[0].FilePath }}" alt="{{ Options.Medias[0].AltText ? Options.Medias[0].AltText : "Nivgöz" }}" title="{{ Options.Medias[0].Title ? Options.Medias[0].Title : "Nivgöz" }}" />
                    {{ else }}
                        <img src="/{{ PathOnStart }}files/defaults/logo/n-hospital-logo-white.png" alt="Nivgöz" title="Nivgöz" />
                    {{ end }}
                {{ end }}
            </a>
            <p>Gözünüz, Yaşamınızdır.</p>
        </div>

        <div class="nv-footer__bottom">
            <ul class="nv-footer__legal">
                <li><a href="/kurumsal/kvkk">Kişisel Verilerin Korunması</a></li>
                <li><a href="/cerez-politikasi">Çerez Politikası</a></li>
            </ul>
            <div class="nv-footer__copyright">
                <p>&copy; <span class="dynamic-year"></span> {{ Options.Options.SiteName }}. Tüm hakları saklıdır.</p>
                <p>Web tasarım: <a href="https://www.instagram.com/pixmadedigital" target="_blank" rel="noopener">Pixmade Digital</a></p>
            </div>
        </div>
    </div>
</footer>

