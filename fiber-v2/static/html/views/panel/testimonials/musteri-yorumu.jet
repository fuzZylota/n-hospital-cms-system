<link rel="stylesheet" href="{{ PathOnStart }}css/panel/musteri-yorumu.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/musteri-yorumlari" class="breadcrumb-link">
                        <i class="fas fa-comments"></i>
                        Müşteri Yorumları
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">{{ Testimonial.FirstName }} {{ Testimonial.LastName }}</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">{{ Testimonial.FirstName }} {{ Testimonial.LastName }}</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-calendar"></i>
                                {{ mthr(Testimonial.CreatedAt, User.Timezone) }}
                            </span>
                            <span class="meta-item">
                                <i class="fas fa-clock"></i>
                                Son güncelleme: {{ mthr(Testimonial.UpdatedAt, User.Timezone) }}
                            </span>
                        </div>
                    </div>
                </h1>
                {{if Testimonial.Occupation}}
                <p class="page-subtitle">{{ Testimonial.Occupation }}</p>
                {{end}}
            </div>
            <div class="page-actions">
                <div class="status-indicator">
                    {{if Testimonial.IsActive}}
                    <span class="status-badge active">
                        <i class="fas fa-check-circle"></i>
                        Aktif
                    </span>
                    {{else}}
                    <span class="status-badge inactive">
                        <i class="fas fa-pause-circle"></i>
                        Pasif
                    </span>
                    {{end}}
                </div>
                <div class="action-buttons">
                    <a href="/panel/musteri-yorumu/{{ Testimonial.Tid }}/duzenle" class="btn btn-primary">
                        <i class="fas fa-edit"></i>
                        Düzenle
                    </a>
                    <button class="btn btn-danger" id="deleteTestimonialBtn" data-id="{{ Testimonial.Tid }}" data-name="{{ Testimonial.FirstName }} {{ Testimonial.LastName }}">
                        <i class="fas fa-trash"></i>
                        <span class="btn-text">Sil</span>
                        <div class="btn-loader" style="display: none;">
                            <div class="spinner"></div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Sections -->
    <div class="content-grid">
        <!-- Customer Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-user"></i>
                </div>
                <h3 class="card-title">Müşteri Bilgileri</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item">
                        <label class="info-label">Ad</label>
                        <div class="info-value">{{ Testimonial.FirstName }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Soyad</label>
                        <div class="info-value">{{ Testimonial.LastName }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Meslek</label>
                        <div class="info-value">{{ Testimonial.Occupation }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Değerlendirme</label>
                        <div class="info-value">
                            <div class="rating-display">
                                <div class="stars">
                                    {{ s := slice(1, 2, 3, 4, 5) }}
                                    {{ range i := s }}
                                        {{ if i <= Testimonial.Rating }}
                                            <i class="fas fa-star filled"></i>
                                        {{else}}
                                            <i class="far fa-star"></i>
                                        {{end}}
                                    {{end}}
                                </div>
                                <span class="rating-value">{{ Testimonial.Rating }}/5</span>
                            </div>
                        </div>
                    </div>
                    {{if Testimonial.CustomerPicturePath}}
                    <div class="info-item">
                        <label class="info-label">Müşteri Fotoğrafı</label>
                        <div class="info-value">
                            <div class="image-preview" data-media-id="{{ Testimonial.CustomerPictureMid }}">
                                <img src="{{ PathOnStart }}{{ Testimonial.CustomerPicturePath }}" alt="{{ Testimonial.CustomerPictureAltText }}" title="{{ Testimonial.CustomerPictureTitle }}" class="preview-image zoomable">
                                <div class="image-overlay">
                                    <i class="icon-maximize"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>

        <!-- Testimonial Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-quote-left"></i>
                </div>
                <h3 class="card-title">Yorum İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="testimonial-content">
                    <div class="content-text">{{ Testimonial.Content }}</div>
                    <div class="content-meta">
                        <div class="content-stats">
                            <span class="stat-item">
                                <i class="fas fa-align-left"></i>
                                {{ len(Testimonial.Content) }} karakter
                            </span>
                            <span class="stat-item">
                                <i class="fas fa-clock"></i>
                                Yaklaşık {{ (len(Testimonial.Content) / 200) + 1 }} dakika okuma
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Activity Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3 class="card-title">Aktivite Bilgileri</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item">
                        <label class="info-label">Durum</label>
                        <div class="info-value">
                            <span class="toggle-indicator {{if Testimonial.IsActive}}active{{else}}inactive{{end}}">
                                {{if Testimonial.IsActive}}
                                <i class="icon-chevron-right"></i>
                                Aktif
                                {{else}}
                                <i class="icon-chevron-left"></i>
                                Pasif
                                {{end}}
                            </span>
                        </div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Oluşturulma Tarihi</label>
                        <div class="info-value">{{ mthr(Testimonial.CreatedAt, User.Timezone) }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Son Güncelleme</label>
                        <div class="info-value">{{ mthr(Testimonial.UpdatedAt, User.Timezone) }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Testimonial ID</label>
                        <div class="info-value">
                            <span class="id-badge">#{{ Testimonial.Tid }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Müşteri Yorumunu Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı müşteri yorumunu silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz ve tüm ilişkili veriler silinecektir.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="icon-trash-2"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="imageZoomModal" class="modal image-modal" style="display: none;">
    <div class="modal-content image-content">
        <button class="modal-close" onclick="closeImageModal()">
            <i class="icon-x"></i>
        </button>
        <div class="image-container">
            <img id="zoomedImage" src="" alt="Zoomed Image">
        </div>
        <div class="image-info">
            <span id="imageTitle">Görsel</span>
            <div class="image-actions">
                <button class="btn btn-sm btn-secondary" onclick="downloadImage()">
                    <i class="icon-download"></i>
                    İndir
                </button>
                <button class="btn btn-sm btn-secondary" onclick="openImageInNewTab()">
                    <i class="icon-external-link"></i>
                    Yeni Sekmede Aç
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="icon-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="icon-alert-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<script>
    // Pass data to JavaScript
    window.testimonialData = {
        id: "{{ Testimonial.Tid }}",
        name: "{{ Testimonial.FirstName }} {{ Testimonial.LastName }}"
    };
</script>
<script src="{{ PathOnStart }}js/panel/musteri-yorumu.js"></script>
