        <path d="m236 126c0-22.054688-17.945312-40-40-40s-40 17.945312-40 40 17.945312 40 40 40 40-17.945312 40-40zm-60 0c0-11.027344 8.972656-20 20-20s20 8.972656 20 20-8.972656 20-20 20-20-8.972656-20-20zm0 0"></path>
        <path d="m306 346c0 22.054688 17.945312 40 40 40s40-17.945312 40-40-17.945312-40-40-40-40 17.945312-40 40zm60 0c0 11.027344-8.972656 20-20 20s-20-8.972656-20-20 8.972656-20 20-20 20 8.972656 20 20zm0 0"></path>
        <path d="m236 306c16.542969 0 30-13.457031 30-30s-13.457031-30-30-30-30 13.457031-30 30 13.457031 30 30 30zm0-40c5.515625 0 10 4.484375 10 10s-4.484375 10-10 10-10-4.484375-10-10 4.484375-10 10-10zm0 0"></path>
