<link rel="stylesheet" href="{{ PathOnStart }}css/panel/uzmanlik-duzenle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-edit"></i>
                    Uzmanlık Bilgilerini Düzenle
                </h1>
                <p class="page-subtitle">{{ Uzmanlik.Name }} uzmanlık alanının bilgilerini düzenleyin</p>
            </div>
            <div class="page-actions">
                <a href="/panel/uzmanliklar/{{ Uzmanlik.Uzid }}" class="btn btn-secondary">
                    <i class="fas fa-eye"></i>
                    Görüntüle
                </a>
                <a href="/panel/uzmanliklar" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="forms-container">
            <!-- General Information Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Genel Bilgiler
                    </h2>
                    <p class="section-description">Uzmanlık alanının temel bilgilerini düzenleyin</p>
                </div>
                <div class="section-content">
                    <form id="generalForm" class="general-form" novalidate>
                        <!-- Hidden inputs for old values -->
                        <input type="hidden" name="old_name" value="{{ Uzmanlik.Name }}">
                        <input type="hidden" name="old_url_name" value="{{ Uzmanlik.UrlName }}">
                        <input type="hidden" name="old_description" value="{{ Uzmanlik.Description }}">
                        <input type="hidden" name="old_icon" value="{{ Uzmanlik.Icon }}">
                        <input type="hidden" name="old_is_active" value="{{ Uzmanlik.IsActive }}">

                        <!-- Basic Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">Temel Bilgiler</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="name" class="form-label required">Uzmanlık Adı</label>
                                    <input type="text" id="name" name="name" class="form-input" 
                                           value="{{ Uzmanlik.Name }}" required>
                                </div>
                                <div class="form-group">
                                    <label for="url_name" class="form-label required">URL Adı</label>
                                    <input type="text" id="url_name" name="url_name" class="form-input" 
                                           value="{{ Uzmanlik.UrlName }}" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="description" class="form-label">Açıklama</label>
                                <textarea id="description" name="description" class="form-textarea" 
                                          rows="3">{{ Uzmanlik.Description }}</textarea>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="icon" class="form-label">İkon</label>
                                    <input type="text" id="icon" name="icon" class="form-input" 
                                           value="{{ Uzmanlik.Icon }}" placeholder="fas fa-stethoscope">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="is_active" class="form-label">Aktif Durumu</label>
                                <div class="toggle-switch">
                                    <input type="checkbox" id="is_active" name="is_active" {{ if Uzmanlik.IsActive }}checked{{ end }}>
                                    <label for="is_active" class="toggle-label">
                                        <span class="toggle-slider"></span>
                                        <span class="toggle-text">{{ if Uzmanlik.IsActive }}Aktif{{ else }}Pasif{{ end }}</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" id="generalSubmitBtn">
                                <i class="fas fa-save"></i>
                                <span class="btn-text">Bilgileri Güncelle</span>
                                <div class="btn-loader" style="display: none;">
                                    <div class="spinner"></div>
                                </div>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">İşlem başarıyla tamamlandı.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script>
    // Pass data to JavaScript
    window.pageData = {
        uzid: "{{ Uzmanlik.Uzid }}"
    };
</script>
<script src="{{ PathOnStart }}js/panel/uzmanlik-duzenle.js"></script>