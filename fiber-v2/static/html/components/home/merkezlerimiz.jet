{* P3-3 — Anasayfa merkezler: kart başına ad (merkez sayfasına bağlantı),
   il/ilçe ve telefon. Adres controller'dan gelmiyor (HomeSubeler sorgusu
   adres seçmiyor) → basılmaz, merkez sayfasında. Telefon yalnız DB'de
   varsa basılır. Görsel alt'ı DB'deki medya alt metni, yoksa boş. *}
{{ if len(Subeler) > 0 }}
<section class="nv-home-sec" aria-labelledby="nvHomeCentersTitle">
    <div class="nv-home__container">
        <div class="nv-home-sec__head">
            <h2 class="nv-home-sec__title" id="nvHomeCentersTitle">Merkezlerimiz</h2>
            <a class="nv-home-sec__more" href="/merkezlerimiz">Tüm merkezlerimiz</a>
        </div>
        <ul class="nv-home-grid nv-home-grid--centers" role="list">
            {{ range index3, Sube := Subeler }}
            <li class="nv-card nv-center-card">
                {{ if Sube.MediaPath != "" }}
                <img class="nv-center-card__img" src="{{ Sube.MediaPath }}" alt="{{ Sube.MediaAltText }}" width="400" height="300" loading="lazy" decoding="async">
                {{ else }}
                <span class="nv-center-card__img nv-center-card__img--empty" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 21V8l8-5 8 5v13M9 21v-6h6v6M12 7v4M10 9h4"/></svg>
                </span>
                {{ end }}
                <div class="nv-card__body">
                    <h3 class="nv-card__title"><a class="nv-card__link" href="/merkezlerimiz/{{ Sube.UrlName }}">{{ Sube.Name }}</a></h3>
                    {{ if Sube.City != "" }}
                    <p class="nv-card__meta nv-home-meta">
                        <svg class="nv-home-meta__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                        <span>{{ if Sube.District != "" }}{{ Sube.District }}, {{ end }}{{ Sube.City }}</span>
                    </p>
                    {{ end }}
                    <div class="nv-card__actions">
                        {{ if Sube.Phone != "" }}
                        <a class="nv-btn nv-btn--secondary nv-center-card__phone" href="tel:{{ Sube.Phone }}">
                            <svg class="nv-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
                            <span><span class="sr-only">{{ Sube.Name }} telefonu: </span>{{ Sube.Phone }}</span>
                        </a>
                        {{ end }}
                        <a class="nv-btn nv-btn--ghost" href="/merkezlerimiz/{{ Sube.UrlName }}/doktorlar">Bu merkezin doktorları<span class="sr-only"> ({{ Sube.Name }})</span></a>
                    </div>
                </div>
            </li>
            {{ end }}
        </ul>
    </div>
</section>
{{ end }}
