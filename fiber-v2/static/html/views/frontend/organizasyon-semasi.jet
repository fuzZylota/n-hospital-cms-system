<div class="compact-page-header">
    <div class="container">
        <h1 class="sr-only">Organizasyon Şeması</h1>
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
            <li><span class="current">Organizasyon Şeması</span></li>
        </ul>
    </div>
</div>

<style>
  .page-header .page-header__inner.organizasyon-semasi-header {
      position: relative !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      min-height: 220px !important;
  }
  .page-header .page-header__inner.organizasyon-semasi-header > .container {
      width: 100% !important;
      margin: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
  }
  .page-header .page-header__inner.organizasyon-semasi-header .page-header__content {
      margin: 0 !important;
      padding: 0 !important;
      text-align: center !important;
  }
  .page-header .page-header__bg {
      position: absolute;
      inset: 0;
  }
  .org-docs-section {
      padding: 40px 0 60px;
  }
  .org-docs-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 20px;
  }
  .org-doc-card {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #fff;
      border: 1px solid #e8e8e8;
      border-radius: 12px;
      padding: 18px 22px;
      width: calc(33.333% - 14px);
      box-shadow: 0 4px 16px rgba(0,0,0,0.06);
      text-decoration: none;
      color: inherit;
      transition: box-shadow 0.2s, transform 0.2s;
  }
  .org-doc-card:hover {
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      transform: translateY(-2px);
      color: inherit;
      text-decoration: none;
  }
  .org-doc-icon {
      flex-shrink: 0;
      width: 48px;
      height: 48px;
      background: #fff0f0;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
  }
  .org-doc-icon i {
      font-size: 26px;
      color: #e53935;
  }
  .org-doc-info {
      flex: 1;
      min-width: 0;
  }
  .org-doc-sube {
      font-size: 16px;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
  }
  .org-doc-name {
      font-size: 16px;
      font-weight: 600;
      color: #222;
      word-break: break-word;
  }
  .org-docs-empty {
      text-align: center;
      padding: 60px 20px;
      color: #aaa;
      font-size: 16px;
  }
  @media (max-width: 768px) {
      .org-doc-card { width: calc(50% - 10px); }
  }
  @media (max-width: 480px) {
      .org-doc-card { width: 100%; }
  }
</style>

<section class="org-docs-section">
    <div class="container">
        {{ if OrgDocs }}
        <div class="org-docs-grid">
            {{ range OrgDocs }}
            <a href="{{ PathOnStart }}{{ .FilePath }}" target="_blank" class="org-doc-card">
                <div class="org-doc-icon">
                    <i class="fas fa-file-pdf"></i>
                </div>
                <div class="org-doc-info">
                    <div class="org-doc-sube">{{ .SubeName }}</div>
                    <div class="org-doc-name">Organizasyon Şeması</div>
                </div>
            </a>
            {{ end }}
        </div>
        {{ else }}
        <div class="org-docs-empty">
            <i class="fas fa-file-alt" style="font-size:40px; display:block; margin-bottom:12px;"></i>
            Henüz organizasyon şeması dokümanı eklenmemiş.
        </div>
        {{ end }}
    </div>
</section>