<link rel="stylesheet" href="{{ PathOnStart }}css/panel/respond-to-job-application.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/job-applications" class="breadcrumb-link">
                        <i class="fas fa-briefcase"></i>
                        İş Başvuruları
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">Başvuru Cevapla</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-reply"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">İş Başvurusuna Cevap Ver</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-info-circle"></i>
                                Başvuru sahibine otomatik e-posta gönderilir
                            </span>
                        </div>
                    </div>
                </h1>
            </div>
        </div>
    </div>

    <!-- Content Section -->
    <div class="content-section">
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-edit"></i>
                </div>
                <h3 class="card-title">Cevap Formu</h3>
            </div>
            <div class="card-content">
                <form id="respondToJobApplicationForm" class="respond-form" novalidate>
                    <!-- Job Application Selection -->
                    <div class="form-group">
                        <label for="job_application_select" class="form-label required">
                            <i class="fas fa-briefcase"></i>
                            İş Başvurusu Seçin
                        </label>
                        <select id="job_application_select" name="jaid" required>
                            <option value="">İş başvurusu seçin...</option>
                            {{range JobApplications}}
                            <option value="{{ .Jaid }}" data-name="{{ .FirstName }} {{ .LastName }}" data-position="{{ .PositionApplied }}" data-status="{{ .Status }}">
                                {{ .FirstName }} {{ .LastName }} - {{ .PositionApplied }}
                                {{if .Status == "kabul"}}
                                <span class="replied-indicator">(Kabul Edilmiş)</span>
                                {{else if .Status == "red" }}
                                <span class="replied-indicator">(Reddedilmiş)</span>
                                {{else}}
                                <span class="replied-indicator">(Beklemede)</span>
                                {{end}}
                            </option>
                            {{end}}
                        </select>
                        <div class="form-help">
                            Kabul edilmiş veya reddedilmiş başvurular tekrar cevaplanabilir
                        </div>
                    </div>

                    <!-- Response Title -->
                    <div class="form-group">
                        <label for="response_title" class="form-label required">
                            <i class="fas fa-heading"></i>
                            Cevap Başlığı
                        </label>
                        <input type="text" id="response_title" name="title" required placeholder="Cevap başlığını girin">
                        <div class="form-help">
                            Başvuru sahibine gönderilecek e-postanın başlığı
                        </div>
                    </div>

                    <!-- Responder Name -->
                    <div class="form-group">
                        <label for="responder_name" class="form-label">
                            <i class="fas fa-user"></i>
                            Cevap Veren Kişi
                        </label>
                        <input type="text" id="responder_name" name="responder_name" placeholder="Adınızı girin (opsiyonel)">
                        <div class="form-help">
                            Cevabı kimin verdiğini belirtin (opsiyonel)
                        </div>
                    </div>

                    <!-- Response Text -->
                    <div class="form-group">
                        <label for="response_text" class="form-label required">
                            <i class="fas fa-comment-dots"></i>
                            Cevap Metni
                        </label>
                        <textarea id="response_text" name="response_text" rows="8" required placeholder="Başvuru sahibine gönderilecek cevap metnini yazın..."></textarea>
                        <div class="form-help">
                            Bu metin başvuru sahibine e-posta olarak gönderilecektir
                        </div>
                    </div>

                    <!-- Selected Job Application Info -->
                    <div id="selectedApplicationInfo" class="selected-application-info" style="display: none;">
                        <div class="info-header">
                            <i class="fas fa-info-circle"></i>
                            <span>Seçilen Başvuru Bilgileri</span>
                        </div>
                        <div class="info-content">
                            <div class="info-item">
                                <span class="info-label">Başvuru Sahibi:</span>
                                <span class="info-value" id="selectedName">-</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Pozisyon:</span>
                                <span class="info-value" id="selectedPosition">-</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Durum:</span>
                                <span class="info-value" id="selectedStatus">-</span>
                            </div>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                            <i class="fas fa-arrow-left"></i>
                            Geri Dön
                        </button>
                        <button type="submit" class="btn btn-primary" id="submitResponseBtn">
                            <i class="fas fa-paper-plane"></i>
                            <span class="btn-text">Cevabı Gönder</span>
                            <div class="btn-loader" style="display: none;">
                                <div class="spinner"></div>
                            </div>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="icon-check-circle"></i>
    <span class="alert-text">Cevap başarıyla gönderildi.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="icon-alert-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<script>
    // Pass data to JavaScript
    window.respondData = {
        jobApplications: [
            {{range JobApplications}}
            {
                jaid: "{{ .Jaid }}",
                name: "{{ .FirstName }} {{ .LastName }}",
                position: "{{ .PositionApplied }}",
                status: "{{ .Status }}"
            },
            {{end}}
        ]
    };
</script>
<script src="{{ PathOnStart }}js/panel/respond-to-job-application.js"></script>

