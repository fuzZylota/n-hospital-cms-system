<link rel="stylesheet" href="{{ PathOnStart }}css/panel/tedkik-duzenle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-edit"></i>
                    Tedkik Bilgilerini Düzenle
                </h1>
                <p class="page-subtitle">{{ Tedkik.Name }} tedkikinin bilgilerini düzenleyin</p>
            </div>
            <div class="page-actions">
                <a href="/panel/tedkikler/{{ Tedkik.Tid }}" class="btn btn-secondary">
                    <i class="fas fa-eye"></i>
                    Görüntüle
                </a>
                <a href="/panel/tedkikler" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="forms-container">
            <!-- General Information Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Genel Bilgiler
                    </h2>
                    <p class="section-description">Tedkikin temel bilgilerini düzenleyin</p>
                </div>
                <div class="section-content">
                    <form id="generalForm" class="general-form" novalidate>
                        <!-- Hidden inputs for old values -->
                        <input type="hidden" name="old_name" value="{{ Tedkik.Name }}">
                        <input type="hidden" name="old_url_name" value="{{ Tedkik.UrlName }}">
                        <input type="hidden" name="old_description" value="{{ Tedkik.Description }}">
                        <input type="hidden" name="old_is_active" value="{{ Tedkik.IsActive }}">

                        <!-- Basic Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">Temel Bilgiler</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="name" class="form-label required">Tedkik Adı</label>
                                    <input type="text" id="name" name="name" class="form-input" 
                                           value="{{ Tedkik.Name }}" required>
                                </div>
                                <div class="form-group">
                                    <label for="url_name" class="form-label">URL Adı</label>
                                    <input type="text" id="url_name" name="url_name" class="form-input" 
                                           value="{{ Tedkik.UrlName }}">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="description" class="form-label">Açıklama</label>
                                <textarea id="description" name="description" class="form-textarea" 
                                          rows="3">{{ Tedkik.Description }}</textarea>
                            </div>
                            <div class="form-group">
                                <label for="is_active" class="form-label">Aktif Durumu</label>
                                <div class="toggle-switch">
                                    <input type="checkbox" id="is_active" name="is_active" {{ if Tedkik.IsActive }}checked{{ end }}>
                                    <label for="is_active" class="toggle-label">
                                        <span class="toggle-slider"></span>
                                        <span class="toggle-text">{{ if Tedkik.IsActive }}Aktif{{ else }}Pasif{{ end }}</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" id="generalSubmitBtn">
                                <i class="fas fa-save"></i>
                                <span class="btn-text">Bilgileri Güncelle</span>
                                <div class="btn-loader" style="display: none;">
                                    <div class="spinner"></div>
                                </div>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Picture Management Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-image"></i>
                        Tedkik Görseli
                    </h2>
                    <p class="section-description">Tedkik görselini yönetin</p>
                </div>
                <div class="section-content">
                    <!-- Current Picture Display -->
                    <div class="current-media-section">
                        <h3 class="group-title">Mevcut Görsel</h3>
                        <div class="media-grid">
                            <div class="media-item">
                                <div class="media-header">
                                    <h4 class="media-title">Tedkik Görseli</h4>
                                    {{ if Tedkik.CoverPath }}
                                    <button type="button" class="btn-delete-media" data-tid="{{ Tedkik.Tid }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    {{ end }}
                                </div>
                                <div class="media-preview">
                                    {{ if Tedkik.CoverPath }}
                                    <img src="{{ PathOnStart }}{{ Tedkik.CoverPath }}" alt="{{ Tedkik.CoverAltText }}" 
                                         title="{{ Tedkik.CoverTitle }}" class="preview-image">
                                    <div class="media-info">
                                        <div class="info-item">
                                            <strong>Alt Text:</strong> {{ Tedkik.CoverAltText }}
                                        </div>
                                        <div class="info-item">
                                            <strong>Title:</strong> {{ Tedkik.CoverTitle }}
                                        </div>
                                    </div>
                                    {{ else }}
                                    <div class="no-media">
                                        <i class="fas fa-image"></i>
                                        <span>Tedkik görseli yüklenmemiş</span>
                                    </div>
                                    {{ end }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Picture Upload Form -->
                    <div class="media-upload-section">
                        <h3 class="group-title">Görseli Güncelle</h3>
                        <form id="pictureForm" class="picture-form" enctype="multipart/form-data" novalidate>
                            <input type="hidden" name="old_cover_alt_text" value="{{ Tedkik.CoverAltText }}">
                            <input type="hidden" name="old_cover_title" value="{{ Tedkik.CoverTitle }}">
                            
                            <div class="form-group">
                                <label for="cover_mid" class="form-label">Tedkik Görseli</label>
                                <div class="file-upload-area" data-target="cover_mid">
                                    <div class="file-upload-content">
                                        <i class="fas fa-upload"></i>
                                        <p class="file-upload-text">Görsel dosyasını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                        <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                                    </div>
                                    <input type="file" id="cover_mid" name="cover_mid" 
                                           class="file-input" accept="image/*">
                                    <div class="file-preview" style="display: none;">
                                        <img class="preview-image" src="" alt="Preview">
                                        <button type="button" class="file-remove">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="file-meta-inputs">
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="cover_alt_text" class="form-label">Görsel Alt Metni</label>
                                            <input type="text" id="cover_alt_text" name="cover_alt_text" 
                                                   class="form-input" value="{{ Tedkik.CoverAltText }}">
                                        </div>
                                        <div class="form-group">
                                            <label for="cover_title" class="form-label">Görsel Başlığı</label>
                                            <input type="text" id="cover_title" name="cover_title" 
                                                   class="form-input" value="{{ Tedkik.CoverTitle }}">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" id="pictureSubmitBtn">
                                    <i class="fas fa-upload"></i>
                                    <span class="btn-text">Görseli Güncelle</span>
                                    <div class="btn-loader" style="display: none;">
                                        <div class="spinner"></div>
                                    </div>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">İşlem başarıyla tamamlandı.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deletePictureModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Görseli Sil</h3>
        <p class="modal-message">Bu görseli silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeModal('deletePictureModal')">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeletePictureBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<script>
    // Pass data to JavaScript
    window.pageData = {
        tid: "{{ Tedkik.Tid }}"
    };
</script>
<script src="{{ PathOnStart }}js/panel/tedkik-duzenle.js"></script>