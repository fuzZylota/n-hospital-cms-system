<div class="compact-page-header">
    <div class="container">
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
                        <li><a href="/tetkikler">Tetkikler</a>
                        </li>
                        <li><span class="current">{{ Tedkik.Name != "" ? Tedkik.Name : "Tetkik" }}</span></li>
        </ul>
    </div>
</div>

<section class="tedkik-detail">
    <link rel="stylesheet" href="{{ PathOnStart }}css/frontend/tedkik.css">
    <link rel="stylesheet" href="{{ PathOnStart }}css/frontend/content-dates.css">
    <div class="container">
        <div class="row gutter-y-40 align-items-stretch">
            <div class="col-12">
                <div class="tedkik-detail__card">
                    <div class="tedkik-detail__media">
                        <img class="tedkik-detail__image {{ Tedkik.CoverPath == "" ? "is-placeholder" : "" }}" src="{{ Tedkik.CoverPath != "" ? PathOnStart + Tedkik.CoverPath : PathOnStart + "files/defaults/tedkik/tedkik-default.png" }}" alt="{{ Tedkik.CoverAltText != "" ? Tedkik.CoverAltText : Tedkik.Name }}" title="{{ Tedkik.CoverTitle != "" ? Tedkik.CoverTitle : Tedkik.Name }}">
                    </div>
                    <div class="tedkik-detail__content">
                        {{ include "../../components/content-dates" }}
                        {{ if Tedkik.HtmlContent != "" }}
                            {{ if Tedkik.CssContent != "" }}
                                <style>
                                    {{ Tedkik.CssContent | raw }}
                                </style>
                            {{ end }}
                            <div class="tedkik-detail__html-content">
                                {{ Tedkik.HtmlContent | raw }}
                            </div>
                            {{ if Tedkik.JavascriptContent != "" }}
                                <script>
                                    {{ Tedkik.JavascriptContent | raw }}
                                </script>
                            {{ end }}
                        {{ else }}
                            <h1 class="tedkik-detail__title">{{ Tedkik.Name != "" ? Tedkik.Name : "Tetkik" }}</h1>
                            {{ if Tedkik.Description != "" }}
                                <p class="tedkik-detail__desc">{{ Tedkik.Description }}</p>
                            {{ else }}
                                <p class="tedkik-detail__desc">Bu tetkik hakkında yakında detaylı bilgiler eklenecektir.</p>
                            {{ end }}
                        {{ end }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>