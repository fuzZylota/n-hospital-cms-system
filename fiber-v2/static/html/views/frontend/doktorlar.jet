<section class="page-header" style="margin-top: 200px;">
    <div class="container-fluid">
        <div class="page-header__inner">
            <div class="page-header__bg" style="background-image: url({{ PathOnStart }}{{ Options.Options.DefaultPageMediaPath != "" ? Options.Options.DefaultPageMediaPath : "assets/images/backgrounds/institutional-default.jpg" }});"></div><!-- /.page-header__bg -->
            <div class="container">
                <div class="page-header__content">
                    <h2 class="page-header__title">Doktorlarımız</h2>
                    <ul class="mediox-breadcrumb list-unstyled">
                        <li>
                            <span class="mediox-breadcrumb__icon"><i class="icon-home"></i></span>
                            <a href="/">Anasayfa</a>
                        </li>
                        <li><span>Doktorlarımız</span></li>
                    </ul><!-- /.mediox-breadcrumb list-unstyled -->
                </div><!-- /.page-header__content -->
            </div><!-- /.container -->
        </div><!-- /.page-header__inner -->
    </div><!-- /.container-fluid -->
</section><!-- /.page-header -->

<section class="section-space" style="padding-top: 40px; padding-bottom: 0;">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="sec-title text-center">
                    <h3 class="sec-title__title">{{ SubeName.Name }} Şubemizin <span>Doktorları</span></h3>
                    <p class="mt-3" style="max-width: 800px; margin: 10px auto 0; color: #6b7280; font-size: 16px;">
                        Bu şubede görev yapan uzman doktorlarımızı görüntüleyebilir, uzmanlık alanlarını inceleyebilir 
                        ve doktorlarımızın iletişim bilgilerine ulaşabilirsiniz.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="team-page section-space">
    <div class="container">
        {{ if len(Doctors) > 0 }}
            <div class="row gutter-y-30">
                {{ range index, Doctor := Doctors }}
                <div class="col-lg-4 col-md-6">
                    <div class="team-card-three wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='{{ index * 100 }}ms'>
                        <div class="team-card-three__image" style='background-image: url({{ Doctor.PhotoPath != "" ? PathOnStart + Doctor.PhotoPath : PathOnStart + "files/defaults/doktorlar/default-doctor-pic.png" }})'></div><!-- /.team-card-three__image -->
                        <div class="team-card-three__hover">
                            {{ if Options.Options.ShowDoctorSocialMedia }}
                                <div class="social-links">
                                    {{ if Doctor.FacebookUrl != "" }}
                                        <a href="{{ Doctor.FacebookUrl }}" target="_blank" rel="noopener">
                                            <i class="fab fa-facebook-f" aria-hidden="true"></i>
                                            <span class="sr-only">Facebook</span>
                                        </a>
                                    {{ end }}
                                    {{ if Doctor.InstagramUrl != "" }}
                                        <a href="{{ Doctor.InstagramUrl }}" target="_blank" rel="noopener">
                                            <i class="fab fa-instagram" aria-hidden="true"></i>
                                            <span class="sr-only">Instagram</span>
                                        </a>
                                    {{ end }}
                                    {{ if Doctor.XUrl != "" }}
                                        <a href="{{ Doctor.XUrl }}" target="_blank" rel="noopener">
                                            <i class="fab fa-twitter" aria-hidden="true"></i>
                                            <span class="sr-only">Twitter</span>
                                        </a>
                                    {{ end }}
                                    {{ if Doctor.LinkedinUrl != "" }}
                                        <a href="{{ Doctor.LinkedinUrl }}" target="_blank" rel="noopener">
                                            <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                                            <span class="sr-only">Linkedin</span>
                                        </a>
                                    {{ end }}
                                    {{ if Doctor.PersonalUrl != "" }}
                                        <a href="https://{{ Doctor.PersonalUrl }}" target="_blank" rel="noopener">
                                            <i class="fa fa-globe" aria-hidden="true"></i>
                                            <span class="sr-only">Website</span>
                                        </a>
                                    {{ end }}
                                </div><!-- /.social-links -->
                            {{ end }}
                            <div class="team-card-three__identity">
                                <h3 class="team-card-three__name">
                                    <a href="/subelerimiz/{{ Doctor.SubeUrlName }}/doktorlar/{{ Doctor.UrlName }}">{{ Doctor.Title }} {{ Doctor.FirstName }} {{ Doctor.LastName }}</a>
                                </h3><!-- /.team-card-three__name -->
                                <p class="team-card-three__designation">{{ Doctor.BransName }}</p><!-- /.team-card-three__designation -->
                            </div><!-- /.team-card-three__identity -->
                        </div><!-- /.team-card-three__hover -->
                    </div><!-- /.team-card-three -->
                </div><!-- /.col-lg-4 col-md-6 -->
                {{ end }}
            </div><!-- /.row -->
        {{ else }}
            <div class="row">
                <div class="col-12">
                    <div class="text-center" style="padding: 60px 20px;">
                        <div class="empty-state">
                            <div class="empty-state__icon" style="font-size: 64px; color: #6b7280; margin-bottom: 20px;">
                                <i class="fas fa-user-md"></i>
                            </div>
                            <h3 class="empty-state__title" style="color: #374151; font-size: 24px; font-weight: 600; margin-bottom: 12px;">Doktor Bulunamadı</h3>
                            <p class="empty-state__description" style="color: #6b7280; font-size: 16px; margin-bottom: 24px;">Bu şubede henüz doktor bilgisi bulunmamaktadır.</p>
                            <a href="/subelerimiz" class="mediox-btn mediox-btn--normal">
                                <span>Şubelerimizi Görüntüle</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {{ end }}
    </div><!-- /.container -->
</section><!-- /.team-page section-space -->