<link rel="stylesheet" href="{{ PathOnStart }}css/panel/sube-ekle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="icon-building"></i>
                    Yeni Şube Ekle
                </h1>
                <p class="page-subtitle">Hastane şubesi için yeni bir lokasyon oluşturun</p>
            </div>
            <div class="page-actions">
                <a href="/panel/subeler" class="btn btn-secondary">
                    <i class="icon-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <form id="subeForm" class="sube-form" novalidate action="/backend/add-sube" method="post" enctype="multipart/form-data">
            <!-- Basic Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-info-circle"></i>
                        Temel Bilgiler
                    </h2>
                    <p class="section-description">Şubenin temel bilgilerini girin</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name" class="form-label required">Şube Adı</label>
                            <input type="text" id="name" name="name" class="form-input" 
                                   placeholder="örn: Merkez Şube, Kadıköy Şubesi" required>
                            <div class="form-help">Şubenin görüntülenecek adı</div>
                        </div>
                        <div class="form-group">
                            <label for="url_name" class="form-label">URL Adı</label>
                            <input type="text" id="url_name" name="url_name" class="form-input" 
                                   placeholder="merkez-sube, kadikoy-subesi">
                            <div class="form-help">Boş bırakılırsa otomatik oluşturulur</div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="is_main" class="form-label">Ana Şube</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="is_main" name="is_main">
                                <label for="is_main" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Ana Şube</span>
                                </label>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="is_active" class="form-label">Aktif Durumu</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="is_active" name="is_active" checked>
                                <label for="is_active" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Aktif</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="description" class="form-label">Açıklama</label>
                        <textarea id="description" name="description" class="form-textarea" 
                                  rows="3" placeholder="Şube hakkında detaylı açıklama yazın..."></textarea>
                    </div>
                    <div class="form-group">
                        <label for="google_map_iframe" class="form-label">Google Harita Embed Kodu</label>
                        <textarea id="google_map_iframe" name="google_map_iframe" class="form-textarea" 
                                  rows="3" placeholder="Google Harita Embed Kodu..."></textarea>
                    </div>
                    <div class="form-group">
                        <label for="transportation_info" class="form-label">Ulaşım Bilgileri</label>
                        <textarea id="transportation_info" name="transportation_info" class="form-textarea" 
                                  rows="3" placeholder="Ulaşım bilgilerini girin..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Address Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-map-pin"></i>
                        Adres Bilgileri
                    </h2>
                    <p class="section-description">Şubenin konum bilgileri</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="address" class="form-label required">Adres</label>
                        <textarea id="address" name="address" class="form-textarea" 
                                  rows="3" placeholder="Tam adres bilgilerini girin..." required></textarea>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="city" class="form-label required">Şehir</label>
                            <input type="text" id="city" name="city" class="form-input" 
                                   placeholder="İstanbul" required>
                        </div>
                        <div class="form-group">
                            <label for="district" class="form-label">İlçe</label>
                            <input type="text" id="district" name="district" class="form-input" 
                                   placeholder="Kadıköy">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="postal_code" class="form-label">Posta Kodu</label>
                            <input type="text" id="postal_code" name="postal_code" class="form-input" 
                                   placeholder="34000">
                        </div>
                        <div class="form-group">
                            <label for="website" class="form-label">Website</label>
                            <input type="url" id="website" name="website" class="form-input" 
                                   placeholder="https://sube.hastane.com">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-phone"></i>
                        İletişim Bilgileri
                    </h2>
                    <p class="section-description">Şubenin iletişim detayları</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="phone" class="form-label">Telefon</label>
                            <input type="tel" id="phone" name="phone" class="form-input" 
                                   placeholder="+90 212 555 00 00">
                        </div>
                        <div class="form-group">
                            <label for="fax" class="form-label">Faks</label>
                            <input type="tel" id="fax" name="fax" class="form-input" 
                                   placeholder="+90 212 555 00 01">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email" class="form-label">E-posta</label>
                        <input type="email" id="email" name="email" class="form-input" 
                               placeholder="sube@hastane.com">
                    </div>
                </div>
            </div>

            <!-- Location Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-globe"></i>
                        Konum Bilgileri
                    </h2>
                    <p class="section-description">Harita koordinatları ve çalışma saatleri</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="latitude" class="form-label">Enlem (Latitude)</label>
                            <input type="number" id="latitude" name="latitude" class="form-input" 
                                   step="0.000001" placeholder="41.0082">
                            <div class="form-help">Örnek: 41.0082</div>
                        </div>
                        <div class="form-group">
                            <label for="longitude" class="form-label">Boylam (Longitude)</label>
                            <input type="number" id="longitude" name="longitude" class="form-input" 
                                   step="0.000001" placeholder="28.9784">
                            <div class="form-help">Örnek: 28.9784</div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="working_hours" class="form-label">Çalışma Saatleri</label>
                        <textarea id="working_hours" name="working_hours" class="form-textarea" 
                                  rows="3" placeholder='{"pazartesi": "08:00-17:00", "sali": "08:00-17:00", "carsamba": "08:00-17:00", "persembe": "08:00-17:00", "cuma": "08:00-17:00", "cumartesi": "09:00-13:00", "pazar": "kapalı"}'></textarea>
                        <div class="form-help">JSON formatında girin veya serbest metin olarak yazın</div>
                    </div>
                </div>
            </div>

            <!-- Branch Image Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-image"></i>
                        Şube Görseli
                    </h2>
                    <p class="section-description">Şubenin dış görünümü veya iç mekan fotoğrafı</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="mid" class="form-label">Şube Fotoğrafı</label>
                        <div class="file-upload-area" data-target="mid">
                            <div class="file-upload-content">
                                <i class="icon-upload"></i>
                                <p class="file-upload-text">Şube fotoğrafını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                            </div>
                            <input type="file" id="mid" name="mid" 
                                   class="file-input" accept="image/*">
                            <div class="file-preview" style="display: none;">
                                <img class="preview-image" src="" alt="Preview">
                                <button type="button" class="file-remove">
                                    <i class="icon-x"></i>
                                </button>
                            </div>
                        </div>
                        <div class="file-meta-inputs">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="sube_media_alt_text" class="form-label">Görsel Alt Metni</label>
                                    <input type="text" id="sube_media_alt_text" name="sube_media_alt_text" 
                                           class="form-input" placeholder="Şube fotoğrafı için alternatif metin">
                                </div>
                                <div class="form-group">
                                    <label for="sube_media_title" class="form-label">Görsel Başlığı</label>
                                    <input type="text" id="sube_media_title" name="sube_media_title" 
                                           class="form-input" placeholder="Şube fotoğrafı için başlık metni">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                    <i class="icon-x"></i>
                    İptal
                </button>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="icon-check"></i>
                    <span class="btn-text">Şubeyi Kaydet</span>
                    <div class="btn-loader" style="display: none;">
                        <div class="spinner"></div>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="icon-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message">Şube başarıyla oluşturuldu.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script src="{{ PathOnStart }}js/panel/sube-ekle.js"></script>
