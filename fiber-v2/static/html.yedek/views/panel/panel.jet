<link rel="stylesheet" href="{{ PathOnStart }}css/panel/panel.css">

<div class="panel-dashboard">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">Yönetim Paneli</h1>
            <p class="dashboard-subtitle">Tüm sistem istatistiklerini buradan takip edebilirsiniz</p>
        </div>
        <div class="header-actions">
            <button class="refresh-btn" id="refreshStats">
                <i class="fas fa-sync-alt"></i>
                <span>Yenile</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Overview -->
    <div class="quick-stats">
        <div class="stat-card primary">
            <div class="stat-icon">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Bugün Randevular</div>
                <div class="stat-value">{{ Statistics.TodayAppointments }}</div>
            </div>
        </div>
        <div class="stat-card success">
            <div class="stat-icon">
                <i class="fas fa-user-md"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Aktif Doktorlar</div>
                <div class="stat-value">{{ Statistics.ActiveDoctors }}</div>
            </div>
        </div>
        <div class="stat-card warning">
            <div class="stat-icon">
                <i class="fas fa-envelope"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Okunmamış İletişim</div>
                <div class="stat-value">{{ Statistics.UnreadContactRequests }}</div>
            </div>
        </div>
        <div class="stat-card info">
            <div class="stat-icon">
                <i class="fas fa-lira-sign"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Aylık Gelir</div>
                <div class="stat-value">{{ Statistics.MonthRevenue }}₺</div>
            </div>
        </div>
    </div>

    <!-- Main Statistics Sections -->
    <div class="statistics-grid">
        
        <!-- Users Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-users"></i> Kullanıcılar</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalUsers }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveUsers }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveUsers }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Admin</span>
                    <span class="mini-value">{{ Statistics.AdminUsers }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Moderatör</span>
                    <span class="mini-value">{{ Statistics.ModeratorUsers }}</span>
                </div>
            </div>
        </div>

        <!-- Appointments Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-calendar-alt"></i> Randevular</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalAppointments }}</span>
                </div>
                <div class="mini-stat pending">
                    <span class="mini-label">Bekleyen</span>
                    <span class="mini-value">{{ Statistics.PendingAppointments }}</span>
                </div>
                <div class="mini-stat success">
                    <span class="mini-label">Onaylı</span>
                    <span class="mini-value">{{ Statistics.ConfirmedAppointments }}</span>
                </div>
                <div class="mini-stat complete">
                    <span class="mini-label">Tamamlandı</span>
                    <span class="mini-value">{{ Statistics.CompletedAppointments }}</span>
                </div>
                <div class="mini-stat cancelled">
                    <span class="mini-label">İptal</span>
                    <span class="mini-value">{{ Statistics.CancelledAppointments }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Bugün</span>
                    <span class="mini-value">{{ Statistics.TodayAppointments }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Bu Hafta</span>
                    <span class="mini-value">{{ Statistics.WeekAppointments }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Bu Ay</span>
                    <span class="mini-value">{{ Statistics.MonthAppointments }}</span>
                </div>
            </div>
        </div>

        <!-- Doctors Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-user-md"></i> Doktorlar</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalDoctors }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveDoctors }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveDoctors }}</span>
                </div>
                <div class="mini-stat success">
                    <span class="mini-label">Online Randevu</span>
                    <span class="mini-value">{{ Statistics.OnlineAppointmentDoctors }}</span>
                </div>
            </div>
            {{ if len(Statistics.DoctorsByTitle) > 0 }}
            <div class="doctor-titles">
                <h4>Ünvanlara Göre</h4>
                <div class="title-grid">
                    {{ range title, count := Statistics.DoctorsByTitle }}
                    <div class="title-item">
                        <span class="title-name">{{ title }}</span>
                        <span class="title-count">{{ count }}</span>
                    </div>
                    {{ end }}
                </div>
            </div>
            {{ end }}
        </div>

        <!-- Branches Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-building"></i> Şubeler</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalBranches }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveBranches }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveBranches }}</span>
                </div>
                <div class="mini-stat featured">
                    <span class="mini-label">Ana Şube</span>
                    <span class="mini-value">{{ Statistics.MainBranch }}</span>
                </div>
            </div>
        </div>

        <!-- Departments Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-stethoscope"></i> Branşlar</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalDepartments }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveDepartments }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveDepartments }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Başhekimli</span>
                    <span class="mini-value">{{ Statistics.DepartmentsWithHead }}</span>
                </div>
            </div>
        </div>

        <!-- Contact Requests Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-envelope"></i> İletişim İstekleri</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalContactRequests }}</span>
                </div>
                <div class="mini-stat warning">
                    <span class="mini-label">Okunmamış</span>
                    <span class="mini-value">{{ Statistics.UnreadContactRequests }}</span>
                </div>
                <div class="mini-stat success">
                    <span class="mini-label">Cevaplanmış</span>
                    <span class="mini-value">{{ Statistics.RepliedContactRequests }}</span>
                </div>
            </div>
        </div>

        <!-- Job Applications Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-briefcase"></i> İş Başvuruları</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalJobApplications }}</span>
                </div>
                <div class="mini-stat success">
                    <span class="mini-label">Okunmuş</span>
                    <span class="mini-value">{{ Statistics.ReadJobApplications }}</span>
                </div>
                <div class="mini-stat warning">
                    <span class="mini-label">Okunmamış</span>
                    <span class="mini-value">{{ Statistics.UnreadJobApplications }}</span>
                </div>
            </div>
        </div>

        <!-- Appointment Requests Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-clipboard-list"></i> Randevu Talepleri</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalAppointmentRequests }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Bugün</span>
                    <span class="mini-value">{{ Statistics.TodayAppointmentRequests }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Bu Hafta</span>
                    <span class="mini-value">{{ Statistics.WeekAppointmentRequests }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Bu Ay</span>
                    <span class="mini-value">{{ Statistics.MonthAppointmentRequests }}</span>
                </div>
            </div>
        </div>

        <!-- News Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-newspaper"></i> Haberler</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalNews }}</span>
                </div>
                <div class="mini-stat success">
                    <span class="mini-label">Yayında</span>
                    <span class="mini-value">{{ Statistics.PublishedNews }}</span>
                </div>
                <div class="mini-stat warning">
                    <span class="mini-label">Taslak</span>
                    <span class="mini-value">{{ Statistics.DraftNews }}</span>
                </div>
                <div class="mini-stat featured">
                    <span class="mini-label">Öne Çıkan</span>
                    <span class="mini-value">{{ Statistics.FeaturedNews }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Toplam Görüntüleme</span>
                    <span class="mini-value">{{ Statistics.TotalNewsViews }}</span>
                </div>
            </div>
        </div>

        <!-- Contracted Institutions Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-handshake"></i> Anlaşmalı Kurumlar</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalContractedInstitutions }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveContractedInstitutions }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveContractedInstitutions }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Sigorta</span>
                    <span class="mini-value">{{ Statistics.InsuranceInstitutions }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Kurumsal</span>
                    <span class="mini-value">{{ Statistics.CorporateInstitutions }}</span>
                </div>
                <div class="mini-stat danger">
                    <span class="mini-label">Süresi Yakında Bitenler</span>
                    <span class="mini-value">{{ Statistics.ExpiringSoonContracts }}</span>
                </div>
            </div>
        </div>

        <!-- Medical Units Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-hospital"></i> Tıbbi Birimler</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalMedicalUnits }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveMedicalUnits }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveMedicalUnits }}</span>
                </div>
            </div>
        </div>

        <!-- Tests Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-vials"></i> Tedkikler</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalTests }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveTests }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveTests }}</span>
                </div>
            </div>
        </div>

        <!-- Specializations Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-award"></i> Uzmanlıklar</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalSpecializations }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveSpecializations }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveSpecializations }}</span>
                </div>
            </div>
        </div>

        <!-- Doctor Experiences Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-graduation-cap"></i> Doktor Deneyimleri</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalDoctorExperiences }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveDoctorExperiences }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveDoctorExperiences }}</span>
                </div>
            </div>
        </div>

        <!-- Doctor Expertises Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-certificate"></i> Doktor Uzmanlık Alanları</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalDoctorExpertises }}</span>
                </div>
                <div class="mini-stat featured">
                    <span class="mini-label">Birincil</span>
                    <span class="mini-value">{{ Statistics.PrimaryDoctorExpertises }}</span>
                </div>
            </div>
        </div>

        <!-- Header Buttons Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-bars"></i> Header Tuşları</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalHeaderButtons }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveHeaderButtons }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveHeaderButtons }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Ana Menü</span>
                    <span class="mini-value">{{ Statistics.ParentHeaderButtons }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Alt Menü</span>
                    <span class="mini-value">{{ Statistics.ChildHeaderButtons }}</span>
                </div>
            </div>
        </div>

        <!-- Testimonials Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-comments"></i> Yorumlar</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalTestimonials }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveTestimonials }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveTestimonials }}</span>
                </div>
            </div>
        </div>

        <!-- Media Files Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-images"></i> Medya Dosyaları</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalMediaFiles }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Resimler</span>
                    <span class="mini-value">{{ Statistics.ImageFiles }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Videolar</span>
                    <span class="mini-value">{{ Statistics.VideoFiles }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Dökümanlar</span>
                    <span class="mini-value">{{ Statistics.DocumentFiles }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Toplam Boyut</span>
                    <span class="mini-value">{{ (Statistics.TotalMediaSize / 1024 / 1024) }} MB</span>
                </div>
            </div>
        </div>

        <!-- Homepage Contents Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-home"></i> Ana Sayfa İçerikleri</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalHomepageContents }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveHomepageContents }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveHomepageContents }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Popup</span>
                    <span class="mini-value">{{ Statistics.PopupHomepageContents }}</span>
                </div>
            </div>
        </div>

        <!-- Custom Contents Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-file-alt"></i> Özel İçerikler</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalCustomContents }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveCustomContents }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveCustomContents }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Ana Sayfa</span>
                    <span class="mini-value">{{ Statistics.MainPageCustomContents }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Tarihçe</span>
                    <span class="mini-value">{{ Statistics.HistoryCustomContents }}</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Hakkımızda</span>
                    <span class="mini-value">{{ Statistics.AboutUsCustomContents }}</span>
                </div>
            </div>
        </div>

        <!-- Options Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-cog"></i> Seçenekler</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam Set</span>
                    <span class="mini-value">{{ Statistics.TotalOptionSets }}</span>
                </div>
                <div class="mini-stat active">
                    <span class="mini-label">Aktif</span>
                    <span class="mini-value">{{ Statistics.ActiveOptionSets }}</span>
                </div>
                <div class="mini-stat inactive">
                    <span class="mini-label">Pasif</span>
                    <span class="mini-value">{{ Statistics.InactiveOptionSets }}</span>
                </div>
                <div class="mini-stat warning">
                    <span class="mini-label">Test Modunda</span>
                    <span class="mini-value">{{ Statistics.TestingOptionSets }}</span>
                </div>
            </div>
        </div>

        <!-- Notifications Statistics -->
        <div class="stats-section">
            <div class="section-header">
                <h2><i class="fas fa-bell"></i> Bildirimler</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat">
                    <span class="mini-label">Toplam</span>
                    <span class="mini-value">{{ Statistics.TotalNotifications }}</span>
                </div>
                <div class="mini-stat warning">
                    <span class="mini-label">Okunmamış</span>
                    <span class="mini-value">{{ Statistics.UnreadNotifications }}</span>
                </div>
                <div class="mini-stat success">
                    <span class="mini-label">Okunmuş</span>
                    <span class="mini-value">{{ Statistics.ReadNotifications }}</span>
                </div>
            </div>
        </div>

        <!-- Financial Statistics -->
        <div class="stats-section financial">
            <div class="section-header">
                <h2><i class="fas fa-chart-line"></i> Finansal İstatistikler</h2>
            </div>
            <div class="stats-cards">
                <div class="mini-stat success">
                    <span class="mini-label">Toplam Gelir</span>
                    <span class="mini-value">{{ Statistics.TotalRevenue }}₺</span>
                </div>
                <div class="mini-stat info">
                    <span class="mini-label">Bu Ay Gelir</span>
                    <span class="mini-value">{{ Statistics.MonthRevenue }}₺</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Bugün Gelir</span>
                    <span class="mini-value">{{ Statistics.TodayRevenue }}₺</span>
                </div>
                <div class="mini-stat">
                    <span class="mini-label">Ortalama Randevu Ücreti</span>
                    <span class="mini-value">{{ Statistics.AverageAppointmentPrice }}₺</span>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="{{ PathOnStart }}js/panel/panel.js"></script>

