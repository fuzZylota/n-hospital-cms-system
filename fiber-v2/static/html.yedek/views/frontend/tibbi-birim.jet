<div class="compact-page-header">
    <div class="container">
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
                        <li><a href="/tibbi-birimler">Tıbbi Birimler</a>
                        </li>
                        <li><span class="current">{{ TibbiBirim.Name != "" ? TibbiBirim.Name : "Tıbbi Birim" }}</span></li>
        </ul>
    </div>
</div>

<section class="tibbi-birim">
    <link rel="stylesheet" href="{{ PathOnStart }}css/frontend/tibbi-birim.css">
    <link rel="stylesheet" href="{{ PathOnStart }}css/frontend/content-dates.css">
    <div class="container">
        <div class="row gutter-y-40 align-items-stretch">
            <div class="col-12">
                <div class="tibbi-birim__card">
                    {{ if TibbiBirim.VideoPath != "" }}
                        <div class="tibbi-birim__media">
                            <div class="tibbi-birim__video-container">
                                <video class="tibbi-birim__video" controls>
                                    <source src="{{ PathOnStart }}{{ TibbiBirim.VideoPath }}" type="video/mp4">
                                    Tarayıcınız video oynatmayı desteklemiyor.
                                </video>
                            </div>
                        </div>
                    {{ end }}

                    <div class="tibbi-birim__content">
                        {{ include "../../components/content-dates" }}
                        {{ if TibbiBirim.HtmlContent != "" }}
                            {{ if TibbiBirim.CssContent != "" }}
                                <style>
                                    {{ TibbiBirim.CssContent | raw }}
                                </style>
                            {{ end }}

                            <div class="tibbi-birim__html-content">
                                {{ TibbiBirim.HtmlContent | raw }}
                            </div>

                            {{ if TibbiBirim.JavascriptContent != "" }}
                                <script>
                                    {{ TibbiBirim.JavascriptContent | raw }}
                                </script>
                            {{ end }}
                        {{ else }}
                            <h1 class="tibbi-birim__title">{{ TibbiBirim.Name != "" ? TibbiBirim.Name : "Tıbbi Birim" }}</h1>
                            {{ if TibbiBirim.Description != "" }}
                                <p class="tibbi-birim__desc">{{ TibbiBirim.Description }}</p>
                            {{ else }}
                                <p class="tibbi-birim__desc">Bu tıbbi birim hakkında yakında detaylı bilgiler eklenecektir.</p>
                            {{ end }}
                        {{ end }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>