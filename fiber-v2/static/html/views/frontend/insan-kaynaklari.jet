<div class="compact-page-header">
    <div class="container">
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
                        <li><span class="current">Kurumsal</span></li>
                        <li><span class="current">İnsan Kaynakları</span></li>
        </ul>
    </div>
</div>

<link rel="stylesheet" href="{{ PathOnStart }}css/frontend/randevu-modal.css">
{{ range index1, CssContent := CssContents }}
    <style>
        {{ CssContent | raw }}
    </style>
{{ end }}

<link rel="stylesheet" href="{{ PathOnStart }}css/frontend/content-dates.css">
<section class="service-details section-space">
    <div class="container">
        <div class="row gutter-y-50">
            <div class="col-md-12 col-lg-3">
                <div class="service-sidebar">
                    <div class="service-sidebar__info service-sidebar__single">
                        <ul class="list-unstyled service-sidebar__nav wow fadeInLeft" data-wow-duration="1500ms">
                            {{ range index1, HeaderButtons := Options.HeaderButtons }}
                                {{ if HeaderButtons.ButtonType == "kurumsal" && HeaderButtons.ParentId != "" }}
                                    <li class="{{ HeaderButtons.Url == Route ? "current" : "" }}"><a href="{{ HeaderButtons.Url }}" target="{{ HeaderButtons.Target }}">{{ HeaderButtons.Title }}</a></li>
                                {{ end }}
                            {{ end }}
                        </ul><!-- /.list-unstyled service-sidebar__nav -->
                    </div><!-- /.service-sidebar__info service-sidebar__single -->
                </div><!-- /.sidebar -->
            </div><!-- /.col-md-12 col-lg-9 -->
            <div class="col-md-12 col-lg-9">
                <div class="service-details__content">
                    {{ include "../../components/content-dates" }}
                    {{ range index1, HtmlContent := HtmlContents }}
                        {{ HtmlContent | raw }}
                    {{ end }}
  
                    
                    <div class="job-application-form-wrapper wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="200ms">
                        <div class="form-header">
                            <h1 class="form-title">İş Başvuru Formu</h1>
                            <p class="form-description">Kurumumuzda çalışmak için aşağıdaki formu doldurun. Başvurunuz değerlendirildikten sonra sizinle iletişime geçeceğiz.</p>
                        </div>
                        
                        <div id="successMessage" class="form-message form-message--success" style="display:none;">
                            <i class="fas fa-check-circle"></i>
                            <span>Başvurunuz başarıyla alınmıştır. En kısa sürede sizinle iletişime geçeceğiz.</span>
                        </div>
                        <div id="errorMessage" class="form-message form-message--error" style="display:none;">
                            <i class="fas fa-exclamation-circle"></i>
                            <span></span>
                        </div>

                        <form id="jobApplicationForm" class="job-application-form">
                            <div class="form-section">
                                <h2 class="section-title">Kişisel Bilgiler</h2>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="first_name" class="form-label required">Ad</label>
                                        <input type="text" id="first_name" name="first_name" class="form-input" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="last_name" class="form-label required">Soyad</label>
                                        <input type="text" id="last_name" name="last_name" class="form-input" required>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="email" class="form-label required">E-posta</label>
                                        <input type="email" id="email" name="email" class="form-input" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="city" class="form-label required">Şehir</label>
                                        <input type="text" id="city" name="city" class="form-input" required>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <h2 class="section-title">CV ve Ön Yazı</h2>
                                <div class="form-group">
                                    <label for="cv_file" class="form-label required">CV Dosyası</label>
                                    <div class="file-upload-area" data-target="cv_file">
                                        <div class="file-upload-content">
                                            <i class="icon-upload"></i>
                                            <p class="file-upload-text">CV dosyanızı sürükleyin veya <span class="file-browse">göz atın</span></p>
                                            <p class="file-upload-hint">PDF, DOC, DOCX - Max 10MB</p>
                                        </div>
                                        <input type="file" id="cv_file" name="cv_file" class="file-input" accept=".pdf,.doc,.docx" required>
                                        <div class="file-preview" style="display: none;">
                                            <div class="file-info">
                                                <i class="icon-file"></i>
                                                <span class="file-name"></span>
                                                <span class="file-size"></span>
                                            </div>
                                            <button type="button" class="file-remove">
                                                <i class="icon-x"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="cover_letter" class="form-label required">Ön Yazı</label>
                                    <textarea id="cover_letter" name="cover_letter" class="form-textarea" rows="5" placeholder="Neden bu pozisyon için uygun olduğunuzu açıklayın..." required></textarea>
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <h2 class="section-title">Ek Bilgiler</h2>
                                <div class="form-group">
                                    <label for="languages" class="form-label">Diller</label>
                                    <input type="text" id="languages" name="languages" class="form-input" placeholder="Türkçe, İngilizce, Almanca">
                                    <div class="form-help">Bildiğiniz dilleri virgülle ayırarak yazın</div>
                                </div>
                                <div class="form-group">
                                    <label for="work_references" class="form-label">Referanslar</label>
                                    <textarea id="work_references" name="work_references" class="form-textarea" rows="3" placeholder="Önceki işverenleriniz veya referanslarınız hakkında bilgi verin..."></textarea>
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <h2 class="section-title">KVKK Onayı</h2>
                                <div class="form-group">
                                    <label for="kvkk_approval" class="checkbox-label">
                                        <input type="checkbox" id="kvkk_approval" name="kvkk_approval" required>
                                        <span>
                                            <a href="/kurumsal/kvkk" target="_blank" rel="noopener">KVKK aydınlatma metnini</a> okudum ve kişisel verilerimin işlenmesini onaylıyorum.
                                        </span>
                                    </label>
                                </div>
                            </div>
                            {{ if Options.Options.RecaptchaSiteKey != "" }}
                            <div class="form-section">
                                <div class="form-group">
                                    <div class="g-recaptcha" data-sitekey="{{ Options.Options.RecaptchaSiteKey }}" data-callback="onRecaptchaVerifiedJobApplication" data-expired-callback="onRecaptchaExpiredJobApplication"></div>
                                    <input type="hidden" name="recaptcha_token" id="jobApplicationRecaptchaToken">
                                </div>
                            </div>
                            {{ end }}
                            <div class="form-actions">
                                <button type="submit" class="mediox-btn" id="submitBtn">
                                    <span>Başvuruyu Gönder</span>
                                    <span class="mediox-btn__icon"><i class="icon-up-right-arrow"></i></span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{{ range index1, JavascriptContent := JavascriptContents }}
    <script>
        {{ JavascriptContent | raw }}
    </script>
{{ end }}

{{ if Options.Options.RecaptchaSiteKey != "" }}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{{ end }}
<script>
var recaptchaVerifiedJobApplication = false;

function onRecaptchaVerifiedJobApplication(token) {
    var recaptchaWidget = document.querySelector('#jobApplicationForm .g-recaptcha');
    if (!recaptchaWidget) return;
    recaptchaVerifiedJobApplication = true;
    var tokenInput = document.getElementById('jobApplicationRecaptchaToken');
    if (tokenInput) {
        tokenInput.value = token;
    }
    updateJobApplicationSubmitButtonState();
}

function onRecaptchaExpiredJobApplication() {
    var recaptchaWidget = document.querySelector('#jobApplicationForm .g-recaptcha');
    if (!recaptchaWidget) return;
    recaptchaVerifiedJobApplication = false;
    var tokenInput = document.getElementById('jobApplicationRecaptchaToken');
    if (tokenInput) {
        tokenInput.value = '';
    }
    updateJobApplicationSubmitButtonState();
}

function updateJobApplicationSubmitButtonState() {
    var kvkkCheckbox = document.getElementById('kvkk_approval');
    var submitButton = document.getElementById('submitBtn');
    var recaptchaWidget = document.querySelector('#jobApplicationForm .g-recaptcha');
    
    if (kvkkCheckbox && submitButton) {
        var shouldDisable = !kvkkCheckbox.checked;
        if (recaptchaWidget) {
            shouldDisable = shouldDisable || !recaptchaVerifiedJobApplication;
        }
        submitButton.disabled = shouldDisable;
        submitButton.classList.toggle('is-disabled', shouldDisable);
    }
}

document.addEventListener('DOMContentLoaded', function () {
    var kvkkCheckbox = document.getElementById('kvkk_approval');
    var submitButton = document.getElementById('submitBtn');

    if (kvkkCheckbox && submitButton) {
        kvkkCheckbox.addEventListener('change', updateJobApplicationSubmitButtonState);
        updateJobApplicationSubmitButtonState();
    }
});
</script>
<script src="{{ PathOnStart }}js/frontend/insert-job-application.js"></script>
