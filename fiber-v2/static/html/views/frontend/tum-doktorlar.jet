<div class="compact-page-header">
    <div class="container">
        <h1 class="sr-only">Doktorlarımız</h1>
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
                        <li><span class="current">Doktorlarımız</span></li>
        </ul>
    </div>
</div>

<link rel="stylesheet" href="{{ PathOnStart }}css/frontend/doktorlar.css">

<!-- ===========================
     PREMIUM / KURUMSAL KART STİLİ
     =========================== -->


<section class="team-page section-space">
    <div class="container">
        {{ if len(Doctors) > 0 }}
            <div class="row gutter-y-30">
                {{ range index, Doctor := Doctors }}
                <div class="col-lg-4 col-md-6">
                    <div class="team-card-three wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='{{ index * 100 }}ms'>
                        <!-- Kartın tamamı tıklanabilir overlay -->
                        <a class="team-card-three__link-overlay" href="/doktorlarimiz/{{ Doctor.UrlName }}" aria-label="{{ Doctor.Title }} {{ Doctor.FirstName }} {{ Doctor.LastName }}"></a>

                        <div class="team-card-three__image" style='background-image: url("{{ Doctor.PhotoPath != "" ? PathOnStart + Doctor.PhotoPath : PathOnStart + "files/defaults/doktorlar/default-doctor-pic.png" }}")'>
                            <div class="doctor-card-cta" aria-hidden="true">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </div><!-- /.team-card-three__image -->

                        <div class="team-card-three__hover">
                            {{ if Options.Options.ShowDoctorSocialMedia }}
                                <div class="social-links">
                                    {{ if Doctor.FacebookUrl != "" }}
                                        <a href="{{ Doctor.FacebookUrl }}" target="_blank" rel="noopener">
                                            <i class="fab fa-facebook-f" aria-hidden="true"></i>
                                            <span class="sr-only">Facebook</span>
                                        </a>
                                    {{ end }}
                                    {{ if Doctor.InstagramUrl != "" }}
                                        <a href="{{ Doctor.InstagramUrl }}" target="_blank" rel="noopener">
                                            <i class="fab fa-instagram" aria-hidden="true"></i>
                                            <span class="sr-only">Instagram</span>
                                        </a>
                                    {{ end }}
                                    {{ if Doctor.XUrl != "" }}
                                        <a href="{{ Doctor.XUrl }}" target="_blank" rel="noopener">
                                            <i class="fab fa-twitter" aria-hidden="true"></i>
                                            <span class="sr-only">Twitter</span>
                                        </a>
                                    {{ end }}
                                    {{ if Doctor.LinkedinUrl != "" }}
                                        <a href="{{ Doctor.LinkedinUrl }}" target="_blank" rel="noopener">
                                            <i class="fab fa-linkedin-in" aria-hidden="true"></i>
                                            <span class="sr-only">Linkedin</span>
                                        </a>
                                    {{ end }}
                                    {{ if Doctor.PersonalUrl != "" }}
                                        <a href="{{ Doctor.PersonalUrl }}" target="_blank" rel="noopener">
                                            <i class="fa fa-globe" aria-hidden="true"></i>
                                            <span class="sr-only">Website</span>
                                        </a>
                                    {{ end }}
                                </div><!-- /.social-links -->
                            {{ end }}

                            <div class="team-card-three__identity">
                                <h2 class="team-card-three__name">
                                    <!-- ✅ DEĞİŞİKLİK: span yerine tıklanabilir <a> tag'ı -->
                                    <a class="doctor-name-link" href="/doktorlarimiz/{{ Doctor.UrlName }}">
                                        {{ Doctor.Title }} {{ Doctor.FirstName }} {{ Doctor.LastName }}
                                    </a>
                                </h2>
                                <p class="team-card-three__designation">{{ Doctor.BransName }}</p>


                            </div><!-- /.team-card-three__identity -->
                            <a class="doctor-randevu-btn" href="/randevu" onclick="event.stopPropagation()">
                                Hızlı Randevu Al <i class="fas fa-chevron-right"></i>
                            </a>
                        </div><!-- /.team-card-three__hover -->
                    </div><!-- /.team-card-three -->
                </div><!-- /.col-lg-4 col-md-6 -->
                {{ end }}
            </div><!-- /.row -->

            {{ if TotalPages > 1 }}
            <div class="row">
                <div class="col-12">
                    <ul class="post-pagination" style="display: flex; justify-content: center; align-items: center; list-style: none; padding: 0; margin: 40px 0 0;">
                        {{ if Page > 1 }}
                        <li><a href="/doktorlarimiz?page={{ Page - 1 }}">
                                <span class="post-pagination__icon"><i class="icon-arrow-left-2"></i></span>
                            </a>
                        </li>
                        {{ end }}

                        {{ StartPage := Page - 2 }}
                        {{ EndPage := Page + 2 }}

                        {{ if StartPage < 1 }}
                            {{ StartPage = 1 }}
                        {{ end }}

                        {{ if EndPage > TotalPages }}
                            {{ EndPage = TotalPages }}
                        {{ end }}

                        {{ if StartPage > 1 }}
                        <li><a href="/doktorlarimiz?page=1">1</a>
                        </li>
                        {{ if StartPage > 2 }}
                        <li><span style="padding: 0 10px;">...</span>
                        </li>
                        {{ end }}
                        {{ end }}

                        {{ if Page - 2 >= StartPage && Page - 2 >= 1 }}
                        <li><a href="/doktorlarimiz?page={{ Page - 2 }}">{{ Page - 2 }}</a>
                        </li>
                        {{ end }}
                        {{ if Page - 1 >= StartPage && Page - 1 >= 1 }}
                        <li><a href="/doktorlarimiz?page={{ Page - 1 }}">{{ Page - 1 }}</a>
                        </li>
                        {{ end }}

                        <li class="active">
                            <a href="/doktorlarimiz?page={{ Page }}">{{ Page }}</a>
                        </li>

                        {{ if Page + 1 <= EndPage && Page + 1 <= TotalPages }}
                        <li><a href="/doktorlarimiz?page={{ Page + 1 }}">{{ Page + 1 }}</a>
                        </li>
                        {{ end }}
                        {{ if Page + 2 <= EndPage && Page + 2 <= TotalPages }}
                        <li><a href="/doktorlarimiz?page={{ Page + 2 }}">{{ Page + 2 }}</a>
                        </li>
                        {{ end }}

                        {{ if EndPage < TotalPages }}
                        {{ if EndPage < TotalPages - 1 }}
                        <li><span style="padding: 0 10px;">...</span>
                        </li>
                        {{ end }}
                        <li><a href="/doktorlarimiz?page={{ TotalPages }}">{{ TotalPages }}</a>
                        </li>
                        {{ end }}

                        {{ if Page < TotalPages }}
                        <li><a href="/doktorlarimiz?page={{ Page + 1 }}">
                                <span class="post-pagination__icon"><i class="icon-arrow-right-2"></i></span>
                            </a>
                        </li>
                        {{ end }}
                    </ul><!-- /.post-pagination -->
                </div><!-- /.col-12 -->
            </div><!-- /.row -->
            {{ end }}
        {{ else }}
            <div class="row">
                <div class="col-12">
                    <div class="text-center" style="padding: 60px 20px;">
                        <div class="empty-state">
                            <div class="empty-state__icon" style="font-size: 64px; color: #6b7280; margin-bottom: 20px;">
                                <i class="fas fa-user-md"></i>
                            </div>
                            <h2 class="empty-state__title" style="color: #374151; font-size: 24px; font-weight: 600; margin-bottom: 12px;">Doktor Bulunamadı</h2>
                            <p class="empty-state__description" style="color: #6b7280; font-size: 16px; margin-bottom: 24px;">Henüz doktor bilgisi bulunmamaktadır.</p>
                            <a href="/subelerimiz" class="mediox-btn mediox-btn--normal">
                                <span>Merkezlerimizi Görüntüle</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {{ end }}
    </div><!-- /.container -->
</section><!-- /.team-page section-space -->