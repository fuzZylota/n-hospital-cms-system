<div class="compact-page-header">
    <div class="container">
        <h1 class="sr-only">Merkezlerimiz</h1>
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
            <li><span class="current">Merkezlerimiz</span></li>
        </ul>
    </div>
</div>

<link rel="stylesheet" href="{{ PathOnStart }}css/frontend/subeler.css?v=20261003-p2">

<section class="merkezler-page section-space" style="padding-top: 30px;">
    <div class="container">
        {{ if len(Subeler) > 0 }}
            <div class="row gutter-y-30">
                {{ range Subeler }}
                <div class="col-lg-4 col-md-6 col-6">
                    <div class="merkez-card wow fadeInUp" data-wow-duration="1500ms">
                        <a class="merkez-card__link-overlay" href="/merkezlerimiz/{{ .UrlName }}" aria-label="{{ .Name }}"></a>

                        <div class="merkez-card__image" style='background-image: url("{{ .MediaPath != "" ? .MediaPath : PathOnStart + "files/defaults/sube/sube-default.png" }}")'></div>

                        <div class="merkez-card__info">
                            <div class="merkez-card__identity">
                                <h2 class="merkez-card__name">
                                    <a href="/merkezlerimiz/{{ .UrlName }}">{{ .Name }}</a>
                                </h2>
                                {{ if .City != "" }}
                                <p class="merkez-card__location">
                                    <i class="fas fa-map-marker-alt"></i> {{ .City }}{{ if .District != "" }}, {{ .District }}{{ end }}
                                </p>
                                {{ end }}
                            </div>
                            <div class="merkez-card__buttons">
                                <a class="merkez-card__btn" href="/merkezlerimiz/{{ .UrlName }}" onclick="event.stopPropagation()">
                                    Bilgiler <i class="fas fa-chevron-right"></i>
                                </a>
                                <a class="merkez-card__btn merkez-card__btn--secondary" href="/doktorlarimiz" onclick="event.stopPropagation()">
                                    Doktorlar <i class="fas fa-chevron-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                {{ end }}
            </div>
        {{ else }}
            <div class="row">
                <div class="col-12">
                    <div class="text-center" style="padding: 60px 20px;">
                        <div style="font-size: 64px; color: #6b7280; margin-bottom: 20px;">
                            <i class="fas fa-hospital"></i>
                        </div>
                        <h2 style="color: #374151; font-size: 24px; font-weight: 600; margin-bottom: 12px;">Merkez Bulunamadı</h2>
                        <p style="color: #6b7280; font-size: 16px;">Şu anda görüntülenecek merkez bulunamadı.</p>
                    </div>
                </div>
            </div>
        {{ end }}
    </div>
</section>
