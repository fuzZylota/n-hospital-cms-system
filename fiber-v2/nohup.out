SELECT d.drid, d.url_name, d.title, d.first_name, d.last_name, d.facebook_url, d.x_url, d.instagram_url, d.linkedin_url, d.personal_url, b.name as brans_name, b.url_name as brans_url_name, s.url_name as sube_url_name, m.file_path as photo_path, m.alt_text as photo_alt_text, m.title as photo_title FROM doktorlar d LEFT JOIN branslar b ON d.brid = b.brid LEFT JOIN subeler s ON d.sid = s.sid LEFT JOIN medias m ON d.photo_mid = m.mid WHERE s.url_name = $1 AND d.is_active = $2 ORDER BY CASE d.title WHEN 'Prof. Dr.' THEN 1 WHEN 'Doç. Dr.' THEN 2 WHEN 'Op. Dr.' THEN 3 WHEN 'Uzm. Dr.' THEN 4 WHEN 'Dr.' THEN 5 ELSE 6 END, d.drid ASC;
