{{ if PublishedDate != "" }}
<div class="content-dates">
    <span class="content-dates__item">
        <i class="far fa-calendar-alt"></i>
        <span>Yayınlanma: <strong>{{ PublishedDate }}</strong></span>
    </span>
    {{ if ShowUpdated }}
        <span class="content-dates__item content-dates__item--updated">
            <i class="fas fa-rotate"></i>
            <span>Son Güncelleme: <strong>{{ UpdatedDate }}</strong></span>
        </span>
    {{ end }}
</div>
{{ end }}
