<section class="fallback">
    <div class="fallback__bg-shape"></div>
    <div class="fallback__content">
        <div class="fallback__logo">
            {{ if Options.Medias[0].FilePath != "" }}
                <img src="{{ PathOnStart }}{{ Options.Medias[0].FilePath }}" alt="{{ Options.Medias[0].AltText != "" ? Options.Medias[0].AltText : "Nivgöz Logo" }}" title="{{ Options.Medias[0].Title != "" ? Options.Medias[0].Title : "Nivgöz" }}">
            {{ else }}
                <img src="{{ PathOnStart }}files/defaults/logo/n-hospital-logo.png" alt="Nivgöz Logo" title="Nivgöz">
            {{ end }}
        </div>
        <p class="fallback__eyebrow">404</p>
        <h1 class="fallback__title">Sayfa bulunamadı</h1>
        <p class="fallback__text">
            Aradığınız adres geçersiz veya sayfa kaldırılmış olabilir.
            Ana sayfadan aradığınız içeriğe yeniden ulaşabilirsiniz.
        </p>
        <div class="fallback__actions">
            <a class="btn btn-primary" href="/">Ana sayfaya dön</a>
        </div>
    </div>
</section>
