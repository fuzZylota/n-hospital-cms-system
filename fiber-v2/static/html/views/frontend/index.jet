{* Sayfanin tek <h1>'i hero'da (components/home/banner.jet, P2-6).
   P3-3: yerlesik bolumlerin sirasi ve homepage_contents.later_than_which_content
   konumlari (1-3 hizli randevu seridinden sonra, 4 merkezlerden sonra,
   5+ yorumlardan sonra) DEGISMEDI; panel siralamasi aynen calisir.
   Bolumler veri yoksa hic basilmaz (bos baslik kalmaz). *}
{{ include "../../components/home/popup" }}

{{ include "../../components/home/banner" }}
{{ include "../../components/frontend-header-init" }}
{{ include "../../components/frontend-topbar-search" }}
{{ include "../../components/home/hizli-erisim" }}
{{ include "../../components/home/hizli-randevu-strip" }}

{{ range index1, Content := AllHomepageContents }}
    {{ if Content.ContentType == "generic" && Content.LaterThanWhichContent == 1 }}
        <style>
            {{ Content.ContentCss | raw }}
        </style>

        {{ Content.ContentHtml | raw }}

        <script>
            {{ Content.ContentJavascript | raw }}
        </script>
    {{ end }}
{{ end }}



