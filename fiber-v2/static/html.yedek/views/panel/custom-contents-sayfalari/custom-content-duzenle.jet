<link rel="stylesheet" href="{{ PathOnStart }}css/panel/custom-content-duzenle.css">
<!-- CodeMirror CSS for syntax highlighting -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/theme/monokai.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-edit"></i>
                    Özel İçeriği Düzenle
                </h1>
                <p class="page-subtitle">{{ CustomContent.Name }} içeriğinin bilgilerini düzenleyin</p>
            </div>
            <div class="page-actions">
                <a href="/panel/ozel-icerikler/{{ CustomContent.Ccid }}" class="btn btn-secondary">
                    <i class="fas fa-eye"></i>
                    Görüntüle
                </a>
                <a href="/panel/ozel-icerikler" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="forms-container">
            <!-- Single Edit Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Genel Bilgiler
                    </h2>
                    <p class="section-description">İçeriğin temel bilgilerini düzenleyin</p>
                </div>
                <div class="section-content">
                    <form id="customContentEditForm" class="custom-content-form" novalidate enctype="multipart/form-data">
                        <!-- Hidden inputs for old values -->
                        <input type="hidden" name="old_name" value="{{ CustomContent.Name }}">
                        <input type="hidden" name="old_url_name" value="{{ CustomContent.UrlName }}">
                        <input type="hidden" name="old_content_type" value="{{ CustomContent.ContentType }}">
                        <input type="hidden" name="old_sort_order" value="{{ CustomContent.SortOrder }}">
                        <input type="hidden" name="old_route" value="{{ CustomContent.Route }}">
                        <input type="hidden" name="old_is_active" value="{{ CustomContent.IsActive }}">
                        <input type="hidden" name="old_description" value="{{ CustomContent.Description }}">
                        <input type="hidden" name="old_content_html" value="{{ CustomContent.ContentHtml }}">
                        <input type="hidden" name="old_content_javascript" value="{{ CustomContent.ContentJavascript }}">
                        <input type="hidden" name="old_content_css" value="{{ CustomContent.ContentCss }}">

                        <div class="form-group-section">
                            <h3 class="group-title">Temel Bilgiler</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="name" class="form-label required">İçerik Adı</label>
                                    <input type="text" id="name" name="name" class="form-input" value="{{ CustomContent.Name }}" required>
                                </div>
                                <div class="form-group">
                                    <label for="url_name" class="form-label">URL Adı</label>
                                    <input type="text" id="url_name" name="url_name" class="form-input" value="{{ CustomContent.UrlName }}">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="content_type" class="form-label required">İçerik Tipi</label>
                                    <select id="content_type" name="content_type" class="form-select" required>
                                        <option value="">İçerik tipini seçin</option>
                                        <option value="history" {{ if CustomContent.ContentType == "history" }}selected{{ end }}>Tarihçe</option>
                                        <option value="about-us" {{ if CustomContent.ContentType == "about-us" }}selected{{ end }}>Hakkımızda</option>
                                        <option value="privacy-policy" {{ if CustomContent.ContentType == "privacy-policy" }}selected{{ end }}>Gizlilik Politikası</option>
                                        <option value="cookie-policy" {{ if CustomContent.ContentType == "cookie-policy" }}selected{{ end }}>Çerez Politikası</option>
                                        <option value="mission-vision" {{ if CustomContent.ContentType == "mission-vision" }}selected{{ end }}>Misyon-Vizyon</option>
                                        <option value="ulasim" {{ if CustomContent.ContentType == "ulasim" }}selected{{ end }}>Ulaşım</option>
                                        <option value="organizasyon-semasi" {{ if CustomContent.ContentType == "organizasyon-semasi" }}selected{{ end }}>Organizasyon Şeması</option>
                                        <option value="anlasmali-kurumlar" {{ if CustomContent.ContentType == "anlasmali-kurumlar" }}selected{{ end }}>Anlaşmalı Kurumlar</option>
                                        <option value="main-page" {{ if CustomContent.ContentType == "main-page" }}selected{{ end }}>Ana Sayfa</option>
                                        <option value="hr" {{ if CustomContent.ContentType == "hr" }}selected{{ end }}>İnsan Kaynakları</option>
                                        <option value="popup" {{ if CustomContent.ContentType == "popup" }}selected{{ end }}>Popup</option>
                                        <option value="other" {{ if CustomContent.ContentType == "other" }}selected{{ end }}>Diğer</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="sort_order" class="form-label required">Sıralama</label>
                                    <input type="number" id="sort_order" name="sort_order" class="form-input" value="{{ CustomContent.SortOrder }}" min="1" required>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="route" class="form-label">Route</label>
                                    <input type="text" id="route" name="route" class="form-input" value="{{ CustomContent.Route }}">
                                </div>
                                <div class="form-group">
                                    <label for="is_active" class="form-label">Aktif Durumu</label>
                                    <div class="toggle-switch">
                                        <input type="checkbox" id="is_active" name="is_active" {{ if CustomContent.IsActive }}checked{{ end }}>
                                        <label for="is_active" class="toggle-label">
                                            <span class="toggle-slider"></span>
                                            <span class="toggle-text">{{ if CustomContent.IsActive }}Aktif{{ else }}Pasif{{ end }}</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="description" class="form-label">Açıklama</label>
                                <textarea id="description" name="description" class="form-textarea" rows="3">{{ CustomContent.Description }}</textarea>
                            </div>
                        </div>

                        <div class="form-group-section">
                            <h3 class="group-title">HTML İçeriği</h3>
                            <div class="form-group">
                                <label for="content_html" class="form-label">HTML Kodu</label>
                                <textarea id="content_html" name="content_html" class="form-textarea code-editor" rows="10">{{ CustomContent.ContentHtml }}</textarea>
                                <div class="form-help">HTML kodunuzu yazın. Syntax highlighting aktif.</div>
                            </div>
                        </div>

                        <div class="form-group-section">
                            <h3 class="group-title">CSS Stilleri</h3>
                            <div class="form-group">
                                <label for="content_css" class="form-label">CSS Kodu</label>
                                <textarea id="content_css" name="content_css" class="form-textarea code-editor" rows="10">{{ CustomContent.ContentCss }}</textarea>
                                <div class="form-help">CSS kodunuzu yazın. Syntax highlighting aktif.</div>
                            </div>
                        </div>

                        <div class="form-group-section">
                            <h3 class="group-title">JavaScript Kodu</h3>
                            <div class="form-group">
                                <label for="content_javascript" class="form-label">JavaScript Kodu</label>
                                <textarea id="content_javascript" name="content_javascript" class="form-textarea code-editor" rows="10">{{ CustomContent.ContentJavascript }}</textarea>
                                <div class="form-help">JavaScript kodunuzu yazın. Syntax highlighting aktif.</div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="fas fa-save"></i>
                                <span class="btn-text">İçeriği Güncelle</span>
                                <div class="btn-loader" style="display: none;">
                                    <div class="spinner"></div>
                                </div>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">İşlem başarıyla tamamlandı.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script>
    // Pass data to JavaScript
    window.pageData = {
        ccid: "{{ CustomContent.Ccid }}"
    };
</script>
<!-- CodeMirror JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/css/css.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/htmlmixed/htmlmixed.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/xml-hint.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/css-hint.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/javascript-hint.min.js"></script>
<script src="{{ PathOnStart }}js/panel/custom-content-duzenle.js"></script>

