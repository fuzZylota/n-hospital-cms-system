<link rel="stylesheet" href="{{ PathOnStart }}css/panel/secenek-ekle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="icon-settings"></i>
                    Yeni Seçenek Seti Ekle
                </h1>
                <p class="page-subtitle">Sistem ayarları için yeni bir seçenek seti oluşturun</p>
            </div>
            <div class="page-actions">
                <a href="/panel/secenekler" class="btn btn-secondary">
                    <i class="icon-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <form id="optionForm" class="option-form" novalidate action="/backend/add-option" method="post" enctype="multipart/form-data">
            <!-- Basic Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-info-circle"></i>
                        Temel Bilgiler
                    </h2>
                    <p class="section-description">Seçenek setinin temel bilgilerini girin</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="option_set_name" class="form-label required">Seçenek Seti Adı</label>
                            <input type="text" id="option_set_name" name="option_set_name" class="form-input" 
                                   placeholder="örn: varsayılan, özel-ayarlar" required>
                            <div class="form-help">Benzersiz bir seçenek seti adı girin</div>
                        </div>
                        <div class="form-group">
                            <label for="option_set_is_active" class="form-label">Aktif Durumu</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="option_set_is_active" name="option_set_is_active" checked>
                                <label for="option_set_is_active" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Aktif</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="option_set_description" class="form-label">Açıklama</label>
                        <textarea id="option_set_description" name="option_set_description" class="form-textarea" 
                                  rows="3" placeholder="Seçenek seti hakkında açıklama yazın..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Site Configuration Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-globe"></i>
                        Site Yapılandırması
                    </h2>
                    <p class="section-description">Web sitesi genel ayarları</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="site_name" class="form-label required">Site Adı</label>
                            <input type="text" id="site_name" name="site_name" class="form-input" 
                                   value="N-Hospital CMS" placeholder="Site adını girin" required>
                        </div>
                        <div class="form-group">
                            <label for="maintenance_mode" class="form-label">Bakım Modu</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="maintenance_mode" name="maintenance_mode">
                                <label for="maintenance_mode" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Bakım Modu</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="site_description" class="form-label">Site Açıklaması</label>
                        <textarea id="site_description" name="site_description" class="form-textarea" 
                                  rows="3" placeholder="Site hakkında açıklama..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Media Files Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-image"></i>
                        Medya Dosyaları
                    </h2>
                    <p class="section-description">Logo, favicon ve varsayılan sayfa görselleri</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="site_logo_mid" class="form-label">Site Logosu</label>
                            <div class="file-upload-area" data-target="site_logo_mid">
                                <div class="file-upload-content">
                                    <i class="icon-upload"></i>
                                    <p class="file-upload-text">Logo dosyasını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                    <p class="file-upload-hint">PNG, JPG, SVG - Max 2MB</p>
                                </div>
                                <input type="file" id="site_logo_mid" name="site_logo_mid" 
                                       class="file-input" accept="image/*">
                                <div class="file-preview" style="display: none;">
                                    <img class="preview-image" src="" alt="Preview">
                                    <button type="button" class="file-remove">
                                        <i class="icon-x"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="file-meta-inputs">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="site_logo_alt_text" class="form-label">Logo Alt Metni</label>
                                        <input type="text" id="site_logo_alt_text" name="site_logo_alt_text" 
                                               class="form-input" placeholder="Logo için alternatif metin">
                                    </div>
                                    <div class="form-group">
                                        <label for="site_logo_title" class="form-label">Logo Başlığı</label>
                                        <input type="text" id="site_logo_title" name="site_logo_title" 
                                               class="form-input" placeholder="Logo için başlık metni">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="site_light_logo_mid" class="form-label">Açık Tema Logosu</label>
                            <div class="file-upload-area" data-target="site_light_logo_mid">
                                <div class="file-upload-content">
                                    <i class="icon-upload"></i>
                                    <p class="file-upload-text">Açık tema logosunu sürükleyin veya <span class="file-browse">göz atın</span></p>
                                    <p class="file-upload-hint">PNG, JPG, SVG - Max 2MB</p>
                                </div>
                                <input type="file" id="site_light_logo_mid" name="site_light_logo_mid" 
                                       class="file-input" accept="image/*">
                                <div class="file-preview" style="display: none;">
                                    <img class="preview-image" src="" alt="Preview">
                                    <button type="button" class="file-remove">
                                        <i class="icon-x"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="file-meta-inputs">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="site_light_logo_alt_text" class="form-label">Açık Tema Logo Alt Metni</label>
                                        <input type="text" id="site_light_logo_alt_text" name="site_light_logo_alt_text" 
                                               class="form-input" placeholder="Açık tema logosu için alternatif metin">
                                    </div>
                                    <div class="form-group">
                                        <label for="site_light_logo_title" class="form-label">Açık Tema Logo Başlığı</label>
                                        <input type="text" id="site_light_logo_title" name="site_light_logo_title" 
                                               class="form-input" placeholder="Açık tema logosu için başlık metni">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="site_favicon_mid" class="form-label">Favicon</label>
                            <div class="file-upload-area" data-target="site_favicon_mid">
                                <div class="file-upload-content">
                                    <i class="icon-upload"></i>
                                    <p class="file-upload-text">Favicon dosyasını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                    <p class="file-upload-hint">ICO, PNG - Max 1MB</p>
                                </div>
                                <input type="file" id="site_favicon_mid" name="site_favicon_mid" 
                                       class="file-input" accept=".ico,.png">
                                <div class="file-preview" style="display: none;">
                                    <img class="preview-image" src="" alt="Preview">
                                    <button type="button" class="file-remove">
                                        <i class="icon-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="default_page_mid" class="form-label">Varsayılan Sayfa Görseli</label>
                        <div class="file-upload-area" data-target="default_page_mid">
                            <div class="file-upload-content">
                                <i class="icon-upload"></i>
                                <p class="file-upload-text">Varsayılan sayfa görselini sürükleyin veya <span class="file-browse">göz atın</span></p>
                                <p class="file-upload-hint">PNG, JPG, SVG - Max 5MB</p>
                            </div>
                            <input type="file" id="default_page_mid" name="default_page_mid" 
                                   class="file-input" accept="image/*">
                            <div class="file-preview" style="display: none;">
                                <img class="preview-image" src="" alt="Preview">
                                <button type="button" class="file-remove">
                                    <i class="icon-x"></i>
                                </button>
                            </div>
                        </div>
                        <div class="file-meta-inputs">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="default_page_media_alt_text" class="form-label">Görsel Alt Metni</label>
                                    <input type="text" id="default_page_media_alt_text" name="default_page_media_alt_text" 
                                           class="form-input" placeholder="Varsayılan sayfa görseli için alternatif metin">
                                </div>
                                <div class="form-group">
                                    <label for="default_page_media_title" class="form-label">Görsel Başlığı</label>
                                    <input type="text" id="default_page_media_title" name="default_page_media_title" 
                                           class="form-input" placeholder="Varsayılan sayfa görseli için başlık metni">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Email Configuration Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-mail"></i>
                        E-posta Ayarları
                    </h2>
                    <p class="section-description">SMTP sunucu yapılandırması</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="smtp_host" class="form-label">SMTP Sunucusu</label>
                            <input type="text" id="smtp_host" name="smtp_host" class="form-input" 
                                   placeholder="smtp.gmail.com">
                        </div>
                        <div class="form-group">
                            <label for="smtp_port" class="form-label">Port</label>
                            <input type="number" id="smtp_port" name="smtp_port" class="form-input" 
                                   value="587" min="1" max="65535">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="smtp_username" class="form-label">Kullanıcı Adı</label>
                            <input type="text" id="smtp_username" name="smtp_username" class="form-input" 
                                   placeholder="E-posta adresi">
                        </div>
                        <div class="form-group">
                            <label for="smtp_password" class="form-label">Şifre</label>
                            <input type="password" id="smtp_password" name="smtp_password" class="form-input" 
                                   placeholder="E-posta şifresi">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="smtp_encryption" class="form-label">Şifreleme</label>
                        <select id="smtp_encryption" name="smtp_encryption" class="form-select">
                            <option value="tls" selected>TLS</option>
                            <option value="ssl">SSL</option>
                            <option value="none">Şifreleme Yok</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Social Media Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-share-2"></i>
                        Sosyal Medya Bağlantıları
                    </h2>
                    <p class="section-description">Sosyal medya hesap linkleri</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="facebook_url" class="form-label">Facebook URL</label>
                            <input type="url" id="facebook_url" name="facebook_url" class="form-input" 
                                   placeholder="https://facebook.com/hastanename">
                        </div>
                        <div class="form-group">
                            <label for="twitter_url" class="form-label">Twitter URL</label>
                            <input type="url" id="twitter_url" name="twitter_url" class="form-input" 
                                   placeholder="https://twitter.com/hastanename">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="instagram_url" class="form-label">Instagram URL</label>
                            <input type="url" id="instagram_url" name="instagram_url" class="form-input" 
                                   value="https://www.instagram.com/nermefraz" placeholder="https://instagram.com/hastanename">
                        </div>
                        <div class="form-group">
                            <label for="linkedin_url" class="form-label">LinkedIn URL</label>
                            <input type="url" id="linkedin_url" name="linkedin_url" class="form-input" 
                                   value="https://www.linkedin.com/company/107576047" placeholder="https://linkedin.com/company/hastanename">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-phone"></i>
                        İletişim Bilgileri
                    </h2>
                    <p class="section-description">Genel iletişim bilgileri</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="contact_email" class="form-label">İletişim E-postası</label>
                            <input type="email" id="contact_email" name="contact_email" class="form-input" 
                                   value="info@nermefraz.com" placeholder="info@hastane.com">
                        </div>
                        <div class="form-group">
                            <label for="contact_phone" class="form-label">İletişim Telefonu</label>
                            <input type="tel" id="contact_phone" name="contact_phone" class="form-input" 
                                   value="+90 532 123 45 67" placeholder="+90 555 000 00 00">
                        </div>
                    </div>
                </div>
            </div>

            <!-- SEO Settings Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-search"></i>
                        SEO Ayarları
                    </h2>
                    <p class="section-description">Arama motoru optimizasyonu</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="main_page_meta_title" class="form-label">Meta Başlık</label>
                        <input type="text" id="main_page_meta_title" name="main_page_meta_title" class="form-input" 
                               value="N-Hospital CMS, Hastaneler için En Gelişmiş CMS" 
                               placeholder="Ana sayfa meta başlığı">
                        <div class="form-help">Maksimum 60 karakter önerilir</div>
                    </div>
                    <div class="form-group">
                        <label for="main_page_meta_description" class="form-label">Meta Açıklama</label>
                        <textarea id="main_page_meta_description" name="main_page_meta_description" 
                                  class="form-textarea" rows="3" 
                                  placeholder="Ana sayfa meta açıklaması..."></textarea>
                        <div class="form-help">Maksimum 160 karakter önerilir</div>
                    </div>
                    <div class="form-group">
                        <label for="google_analytics" class="form-label">Google Analytics Kodu</label>
                        <textarea id="google_analytics" name="google_analytics" class="form-textarea" 
                                  rows="4" placeholder="Google Analytics tracking kodu..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Design Settings Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-palette"></i>
                        Tasarım Ayarları
                    </h2>
                    <p class="section-description">Site görünümü ve renk ayarları</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="primary_color" class="form-label">Ana Renk</label>
                            <div class="color-input-group">
                                <input type="color" id="primary_color" name="primary_color" 
                                       value="#283b6a" class="color-picker">
                                <input type="text" class="form-input color-text" 
                                       value="rgba(40, 59, 106, 1)" placeholder="rgba(40, 59, 106, 1)">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="secondary_color" class="form-label">İkincil Renk</label>
                            <div class="color-input-group">
                                <input type="color" id="secondary_color" name="secondary_color" 
                                       value="#df0024" class="color-picker">
                                <input type="text" class="form-input color-text" 
                                       value="rgba(223, 0, 36, 1)" placeholder="rgba(223, 0, 36, 1)">
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="accent_color" class="form-label">Vurgu Rengi</label>
                            <div class="color-input-group">
                                <input type="color" id="accent_color" name="accent_color" 
                                       value="#33c1ed" class="color-picker">
                                <input type="text" class="form-input color-text" 
                                       value="rgba(51, 193, 237, 1)" placeholder="rgba(51, 193, 237, 1)">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="font_family" class="form-label">Font Ailesi</label>
                            <select id="font_family" name="font_family" class="form-select">
                                <option value="Poppins" selected>Poppins</option>
                                <option value="Roboto">Roboto</option>
                                <option value="Open Sans">Open Sans</option>
                                <option value="Lato">Lato</option>
                                <option value="Montserrat">Montserrat</option>
                                <option value="Inter">Inter</option>
                                <option value="Oswald">Oswald</option>
                                <option value="Noto Sans">Noto Sans</option>
                                <option value="Raleway">Raleway</option>
                                <option value="Ubuntu">Ubuntu</option>
                                <option value="Playfair Display">Playfair Display</option>
                                <option value="Work Sans">Work Sans</option>
                                <option value="Outfit">Outfit</option>
                                <option value="Manrope">Manrope</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="font_size" class="form-label">Font Boyutu</label>
                        <div class="range-input-group">
                            <input type="range" id="font_size" name="font_size" 
                                   min="12" max="20" value="16" class="range-slider">
                            <span class="range-value">16px</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- System Settings Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-settings"></i>
                        Sistem Ayarları
                    </h2>
                    <p class="section-description">Genel sistem yapılandırması</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="items_per_page" class="form-label">Sayfa Başına Öğe Sayısı</label>
                            <input type="number" id="items_per_page" name="items_per_page" class="form-input" 
                                   value="10" min="5" max="100">
                        </div>
                        <div class="form-group">
                            <label for="max_upload_size" class="form-label">Max. Dosya Boyutu (MB)</label>
                            <input type="number" id="max_upload_size" name="max_upload_size" class="form-input" 
                                   value="5" min="1" max="50">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="timezone" class="form-label">Zaman Dilimi</label>
                            <select id="timezone" name="timezone" class="form-select">
                                <option value="UTC" selected>UTC</option>
                                <option value="Europe/Istanbul">Europe/Istanbul</option>
                                <option value="Europe/London">Europe/London</option>
                                <option value="America/New_York">America/New_York</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="language" class="form-label">Dil</label>
                            <select id="language" name="language" class="form-select">
                                <option value="tr" selected>Türkçe</option>
                                <option value="en">English</option>
                                <option value="de">Deutsch</option>
                                <option value="fr">Français</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" id="require_strong_password" name="require_strong_password">
                                    <span class="checkbox-custom"></span>
                                    Güçlü şifre zorunluluğu
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" id="enable_testimonials" name="enable_testimonials" checked>
                                    <span class="checkbox-custom"></span>
                                    Testimonialları etkinleştir
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" id="enable_our_history" name="enable_our_history" checked>
                                    <span class="checkbox-custom"></span>
                                    Tarihçe bölümünü etkinleştir
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" id="show_doctor_social_media" name="show_doctor_social_media" checked>
                                    <span class="checkbox-custom"></span>
                                    Doktor sosyal medya bağlantılarını göster
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" id="show_doctor_appointment_fee" name="show_doctor_appointment_fee" checked>
                                    <span class="checkbox-custom"></span>
                                    Doktor randevu ücretini göster
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                    <i class="icon-x"></i>
                    İptal
                </button>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="icon-check"></i>
                    <span class="btn-text">Seçenek Setini Kaydet</span>
                    <div class="btn-loader" style="display: none;">
                        <div class="spinner"></div>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="icon-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message">Seçenek seti başarıyla oluşturuldu.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script src="{{ PathOnStart }}js/panel/secenek-ekle.js"></script>

