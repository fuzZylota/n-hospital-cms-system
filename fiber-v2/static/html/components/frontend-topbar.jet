<div class="nv-topbar">
    <div class="nv-topbar__inner">
        <ul class="nv-topbar__info">
            {{ if Options.Options.ContactPhone != "" }}
            <li>
                <a class="nv-topbar__link nv-topbar__call" href="tel:{{ Options.Options.ContactPhone }}">
                    <svg class="nv-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
                    <span class="nv-topbar__call-label"><span class="nv-topbar__call-hemen">Hemen </span>Ara</span>
                    <span class="nv-topbar__call-num">{{ Options.Options.ContactPhone }}</span>
                </a>
            </li>
            {{ end }}
            {{ if Options.Options.ContactEmail != "" }}
            <li class="nv-topbar__wide">
                <a class="nv-topbar__link" href="mailto:{{ Options.Options.ContactEmail }}">
                    <svg class="nv-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M3 5h18v14H3z M3 6l9 7 9-7"/></svg>
                    <span>{{ Options.Options.ContactEmail }}</span>
                </a>
            </li>
            {{ end }}
        </ul>
        <div class="nv-topbar__tools">
            <div class="nv-a11y">
                <button type="button" class="nv-topbar__btn nv-a11y__toggle" id="nvA11yToggle" aria-expanded="false" aria-controls="nvA11yPanel">
                    <svg class="nv-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 1.5a2.25 2.25 0 1 1 0 4.5 2.25 2.25 0 0 1 0-4.5zM3 7.5h18v2.25h-6V22.5h-2.25v-6h-1.5v6H9V9.75H3z"/></svg>
                    <span>Erişilebilirlik</span>
                    <svg class="nv-icon nv-icon--chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="nv-a11y__panel" id="nvA11yPanel" hidden>
                    <p class="nv-a11y__title">Görünüm ayarları</p>
                    <fieldset class="nv-a11y__group">
                        <legend class="nv-a11y__legend">Yüksek kontrast</legend>
                        <div class="nv-a11y__opts">
                            <input class="nv-a11y__input" type="radio" name="nvA11yContrast" id="nvA11yContrastOff" value="normal" checked>
                            <label class="nv-a11y__opt" for="nvA11yContrastOff">Kapalı</label>
                            <input class="nv-a11y__input" type="radio" name="nvA11yContrast" id="nvA11yContrastOn" value="high">
                            <label class="nv-a11y__opt" for="nvA11yContrastOn">Açık</label>
                        </div>
                    </fieldset>
                    <fieldset class="nv-a11y__group">
                        <legend class="nv-a11y__legend">Metin boyutu</legend>
                        <div class="nv-a11y__opts">
                            <input class="nv-a11y__input" type="radio" name="nvA11yText" id="nvA11yTextNormal" value="normal" checked>
                            <label class="nv-a11y__opt" for="nvA11yTextNormal">Normal</label>
                            <input class="nv-a11y__input" type="radio" name="nvA11yText" id="nvA11yTextLarge" value="large">
                            <label class="nv-a11y__opt nv-a11y__opt--lg" for="nvA11yTextLarge">Büyük</label>
                            <input class="nv-a11y__input" type="radio" name="nvA11yText" id="nvA11yTextXlarge" value="xlarge">
                            <label class="nv-a11y__opt nv-a11y__opt--xl" for="nvA11yTextXlarge">Çok büyük</label>
                        </div>
                    </fieldset>
                    <p class="nv-a11y__note">Seçiminiz bu cihazda hatırlanır. Tarayıcınızın yakınlaştırma özelliği de her sayfada çalışır.</p>
                    <button type="button" class="nv-btn nv-btn--secondary nv-btn--block nv-a11y__close">Kapat</button>
                </div>
            </div>

            {{ include "../../components/translator" }}

            <div class="nv-topbar__social nv-topbar__wide">
                {{ if Options.Options.FacebookUrl != "" && Options.Options.FacebookUrl != "#" }}
                <a class="nv-topbar__icon-link" href="{{ Options.Options.FacebookUrl }}" target="_blank" rel="noopener" aria-label="Facebook (yeni sekmede açılır)">
                    <i class="fab fa-facebook-f" aria-hidden="true"></i>
                </a>
                {{ end }}
                {{ if Options.Options.InstagramUrl != "" && Options.Options.InstagramUrl != "#" }}
                <a class="nv-topbar__icon-link" href="{{ Options.Options.InstagramUrl }}" target="_blank" rel="noopener" aria-label="Instagram (yeni sekmede açılır)">
                    <i class="fab fa-instagram" aria-hidden="true"></i>
                </a>
                {{ end }}
                {{ if Options.Options.LinkedinUrl != "" && Options.Options.LinkedinUrl != "#" }}
                    {{ if contains(Options.Options.LinkedinUrl, "youtube") }}
                    <a class="nv-topbar__icon-link" href="{{ Options.Options.LinkedinUrl }}" target="_blank" rel="noopener" aria-label="YouTube (yeni sekmede açılır)">
                        <i class="fab fa-youtube" aria-hidden="true"></i>
                    </a>
                    {{ else }}
                    <a class="nv-topbar__icon-link" href="{{ Options.Options.LinkedinUrl }}" target="_blank" rel="noopener" aria-label="LinkedIn (yeni sekmede açılır)">
                        <i class="fab fa-linkedin" aria-hidden="true"></i>
                    </a>
                    {{ end }}
                {{ end }}
            </div>
        </div>
    </div>
</div>
{{ if Route != "/" }}
    {{ include "../../components/frontend-topbar-search" }}
{{ end }}
