<link rel="stylesheet" href="{{ PathOnStart }}css/panel/randevu-talepleri.css">

<div class="page-container">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-calendar-check"></i>
                    Randevu Talepleri
                </h1>
                <p class="page-subtitle">Kurum randevu taleplerini yönetin</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-secondary" id="refreshBtn">
                    <i class="fas fa-sync-alt"></i>
                    Yenile
                </button>
            </div>
        </div>
    </div>

    <div class="filters-section">
        <div class="filters-content">
            <div class="search-group">
                <form class="search-form" onsubmit="return false;">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="searchInput" class="search-input" 
                               placeholder="Hasta adı, telefon veya e-posta ile ara..." 
                               autocomplete="off" spellcheck="false" value="{{ Query }}">
                        <button class="search-clear" id="searchClear" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </form>
                <button class="search-filter-btn" id="filterBtn" title="Filtrele">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div class="filter-group">
                <select id="statusFilter" class="filter-select">
                    <option value="all"{{if Status == "all" || Status == ""}} selected{{end}}>Tüm Durumlar</option>
                    <option value="yeni"{{if Status == "yeni"}} selected{{end}}>Yeni</option>
                    <option value="randevu-verildi"{{if Status == "randevu-verildi"}} selected{{end}}>Randevu Verildi</option>
                    <option value="randevu-verilemedi"{{if Status == "randevu-verilemedi"}} selected{{end}}>Randevu Verilemedi</option>
                    <option value="ulasilamadi"{{if Status == "ulasilamadi"}} selected{{end}}>Ulaşılamadı</option>
                    <option value="gelmedi"{{if Status == "gelmedi"}} selected{{end}}>Gelmedi</option>
                    <option value="hasta-vazgecti"{{if Status == "hasta-vazgecti"}} selected{{end}}>Hasta Vazgeçti</option>
                    <option value="hasta-arandi"{{if Status == "hasta-arandi"}} selected{{end}}>Hasta Arandı</option>
                </select>
                <select id="sortBy" class="filter-select">
                    <option value="patient_first_name"{{if SortBy == "patient_first_name" || SortBy == ""}} selected{{end}}>Hasta Adı</option>
                    <option value="patient_last_name"{{if SortBy == "patient_last_name"}} selected{{end}}>Hasta Soy Adı</option>
                    <option value="patient_phone"{{if SortBy == "patient_phone"}} selected{{end}}>Hasta Telefon Numarası</option>
                    <option value="patient_email"{{if SortBy == "patient_email"}} selected{{end}}>Hasta E-Posta Adresi</option>
                    <option value="message"{{if SortBy == "message"}} selected{{end}}>Açıklama</option>
                </select>
                <select id="sortOrder" class="filter-select">
                    <option value="ASC"{{if SortOrder == "ASC" || SortOrder == ""}} selected{{end}}>Artan</option>
                    <option value="DESC"{{if SortOrder == "DESC"}} selected{{end}}>Azalan</option>
                </select>
            </div>
        </div>
    </div>

    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="totalCount">{{Count}}</div>
                    <div class="stat-label">Toplam Talep</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon today">
                    <i class="fas fa-calendar-day"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="todayCount">{{ TodayLength }}</div>
                    <div class="stat-label">Bugünkü Talepler</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon week">
                    <i class="fas fa-calendar-week"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="weekCount">{{ WeekLength }}</div>
                    <div class="stat-label">Bu Hafta</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon month">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="monthCount">{{ MonthLength }}</div>
                    <div class="stat-label">Bu Ay</div>
                </div>
            </div>
        </div>
    </div>

    <div class="page-content">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">Randevu Talepleri Listesi</h3>
                <div class="table-actions">
                    <button class="btn btn-sm btn-secondary" id="exportBtn">
                        <i class="fas fa-download"></i>
                        Dışa Aktar
                    </button>
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="table">
                            <i class="fas fa-list"></i>
                        </button>
                        <button class="view-btn" data-view="grid">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="table-wrapper" id="tableView">
                <table class="data-table" id="randevuTalepleriTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-column="patient_first_name">
                                <span>Hasta Adı</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="patient_phone">
                                <span>Telefon</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="created_at">
                                <span>Talep Tarihi</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th>
                                <span>Tercih Edilen Şube</span>
                            </th>
                            <th>
                                <span>Mesaj</span>
                            </th>
                            <th>
                                <span>Durum</span>
                            </th>
                            <th class="actions-column">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{if len(RandevuTalepleri) > 0}}
                            {{range RandevuTalepleri}}
                            <tr data-id="{{ .Rrid }}">
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .PatientFirstName }} {{ .PatientLastName }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .PatientPhone}}
                                        <a href="tel:{{ .PatientPhone }}" class="phone-link">{{ .PatientPhone }}</a>
                                        {{else}}
                                        <span class="text-muted">-</span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ mthrwn(.CreatedAt) }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .SubeName}}
                                        <div class="primary-text">{{ .SubeName }}</div>
                                        {{else}}
                                        <span class="text-muted">Belirtilmemiş</span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .Message}}
                                        <div class="primary-text truncate" title="{{ .Message }}">{{ .Message }}</div>
                                        {{else}}
                                        <span class="text-muted">-</span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="status-inline">
                                            <span class="status-badge status-badge--{{ .Status }}" data-status="{{ .Status }}">
                                                {{ if .Status == "yeni" }}Yeni{{ else if .Status == "randevu-verildi" }}Randevu Verildi{{ else if .Status == "randevu-verilemedi" }}Randevu Verilemedi{{ else if .Status == "ulasilamadi" }}Ulaşılamadı{{ else if .Status == "gelmedi" }}Gelmedi{{ else if .Status == "hasta-vazgecti" }}Hasta Vazgeçti{{ else if .Status == "hasta-arandi" }}Hasta Arandı{{ else }}{{ .Status }}{{ end }}
                                            </span>
                                            <span class="status-datetime" data-raw="{{ mthrwn(.UpdatedAt) }}">{{ mthrwn(.UpdatedAt) }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="actions-wrapper">
                                        <button class="action-trigger" data-id="{{ .Rrid }}">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <div class="action-dropdown">
                                            <a href="/panel/randevu-talepleri/{{ .Rrid }}" class="action-item view">
                                                <i class="fas fa-eye"></i>
                                                <span>Görüntüle</span>
                                            </a>
                                            <div class="action-divider"></div>
                                            <button class="action-item toggle-status" data-id="{{ .Rrid }}" data-status="{{ .Status }}">
                                                <i class="fas fa-sync-alt"></i>
                                                <span>Durumu Değiştir</span>
                                            </button>
                                            <div class="action-divider"></div>
                                            <button class="action-item delete" data-id="{{ .Rrid }}" data-name="{{ .PatientFirstName }} {{ .PatientLastName }}">
                                                <i class="fas fa-trash"></i>
                                                <span>Sil</span>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        {{else}}
                            <tr class="empty-row">
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-calendar-check"></i>
                                        </div>
                                        <div class="empty-title">Henüz randevu talebi bulunmuyor</div>
                                        <div class="empty-description">İlk randevu talebi geldiğinde burada görünecek.</div>
                                    </div>
                                </td>
                            </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>

            <div class="grid-wrapper" id="gridView" style="display: none;">
                <div class="randevu-talepleri-grid">
                    {{if len(RandevuTalepleri) > 0}}
                        {{range RandevuTalepleri}}
                        <div class="randevu-talebi-card" data-id="{{ .Rrid }}">
                            <div class="card-header">
                                <div class="card-title">{{ .PatientFirstName }} {{ .PatientLastName }}</div>
                                <div class="card-actions">
                                    <button class="action-trigger" data-id="{{ .Rrid }}">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="action-dropdown">
                                        <a href="/panel/randevu-talepleri/{{ .Rrid }}" class="action-item view">
                                            <i class="fas fa-eye"></i>
                                            <span>Görüntüle</span>
                                        </a>
                                        <div class="action-divider"></div>
                                        <button class="action-item toggle-status" data-id="{{ .Rrid }}" data-status="{{ .Status }}">
                                            <i class="fas fa-sync-alt"></i>
                                            <span>Durumu Değiştir</span>
                                        </button>
                                        <div class="action-divider"></div>
                                        <button class="action-item delete" data-id="{{ .Rrid }}" data-name="{{ .PatientFirstName }} {{ .PatientLastName }}">
                                            <i class="fas fa-trash"></i>
                                            <span>Sil</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-field">
                                    <div class="field-label">İletişim</div>
                                    <div class="field-value">
                                        {{if .PatientPhone}}
                                        <a href="tel:{{ .PatientPhone }}" class="phone-link">{{ .PatientPhone }}</a>
                                        {{else}}
                                        <span class="text-muted">Telefon yok</span>
                                        {{end}}
                                    </div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">Talep Tarihi</div>
                                    <div class="field-value">
                                        {{ mthrwn(.CreatedAt) }}
                                    </div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">Tercih Edilen Şube</div>
                                    <div class="field-value">
                                        {{if .SubeName}}
                                            {{ .SubeName }}
                                        {{else}}
                                        <span class="text-muted">Belirtilmemiş</span>
                                        {{end}}
                                    </div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">Durum</div>
                                    <div class="field-value">
                                        <div class="status-inline">
                                            <span class="status-badge status-badge--{{ .Status }}" data-status="{{ .Status }}">
                                                {{ if .Status == "yeni" }}Yeni{{ else if .Status == "randevu-verildi" }}Randevu Verildi{{ else if .Status == "randevu-verilemedi" }}Randevu Verilemedi{{ else if .Status == "ulasilamadi" }}Ulaşılamadı{{ else if .Status == "gelmedi" }}Gelmedi{{ else if .Status == "hasta-vazgecti" }}Hasta Vazgeçti{{ else if .Status == "hasta-arandi" }}Hasta Arandı{{ else }}{{ .Status }}{{ end }}
                                            </span>
                                            <span class="status-datetime" data-raw="{{ mthrwn(.UpdatedAt) }}">{{ mthrwn(.UpdatedAt) }}</span>
                                        </div>
                                    </div>
                                </div>
                                {{if .Message}}
                                <div class="card-field">
                                    <div class="field-label">Mesaj</div>
                                    <div class="field-value truncate">{{ .Message }}</div>
                                </div>
                                {{end}}
                            </div>
                            <div class="card-footer">
                                <div class="card-date"></div>
                            </div>
                        </div>
                        {{end}}
                    {{else}}
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <div class="empty-title">Henüz randevu talebi bulunmuyor</div>
                            <div class="empty-description">İlk randevu talebi geldiğinde burada görünecek.</div>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>

    {{if Count > 0}}
    <div class="pagination-section">
        <div class="pagination-info">
            <span>Toplam {{Count}} kayıt gösteriliyor</span>
        </div>
        <div class="pagination-wrapper">
            <nav class="pagination" id="pagination"></nav>
        </div>
        <div class="pagination-controls">
            <select id="perPage" class="per-page-select">
                <option value="10"{{if ItemsPerPage == 10}} selected{{end}}>10 / sayfa</option>
                <option value="25"{{if ItemsPerPage == 25}} selected{{end}}>25 / sayfa</option>
                <option value="50"{{if ItemsPerPage == 50}} selected{{end}}>50 / sayfa</option>
                <option value="100"{{if ItemsPerPage == 100}} selected{{end}}>100 / sayfa</option>
            </select>
        </div>
    </div>
    {{end}}
</div>

<div id="exportModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:12px;width:90%;max-width:520px;box-shadow:0 20px 60px rgba(0,0,0,0.2);position:relative;margin:auto">
        <div class="modal-header">
            <h3><i class="fas fa-file-excel" style="color:#2563eb;margin-right:8px"></i>Dışa Aktar</h3>
            <button onclick="closeExportModal()" style="position:absolute;top:16px;right:16px;width:32px;height:32px;border-radius:50%;border:none;background:#f1f5f9;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#64748b;font-size:14px;transition:all 0.15s" onmouseover="this.style.background='#fee2e2';this.style.color='#ef4444'" onmouseout="this.style.background='#f1f5f9';this.style.color='#64748b'"><i class="fas fa-times"></i></button>
        </div>
        <div class="modal-body" style="padding:24px">
            <div style="margin-bottom:16px">
                <label style="font-weight:600;display:block;margin-bottom:6px">Tarih Aralığı</label>
                <div style="display:flex;gap:10px">
                    <input type="date" id="exportDateStart" class="form-control" style="flex:1">
                    <input type="date" id="exportDateEnd" class="form-control" style="flex:1">
                </div>
            </div>
            <div style="margin-bottom:24px">
                <label style="font-weight:600;display:block;margin-bottom:10px">Randevu Durumu</label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                    <label class="export-status-item"><input type="checkbox" value="yeni" checked> Yeni</label>
                    <label class="export-status-item"><input type="checkbox" value="randevu-verildi" checked> Randevu Verildi</label>
                    <label class="export-status-item"><input type="checkbox" value="randevu-verilemedi" checked> Randevu Verilemedi</label>
                    <label class="export-status-item"><input type="checkbox" value="ulasilamadi" checked> Ulaşılamadı</label>
                    <label class="export-status-item"><input type="checkbox" value="gelmedi" checked> Gelmedi</label>
                    <label class="export-status-item"><input type="checkbox" value="hasta-vazgecti" checked> Hasta Vazgeçti</label>
                    <label class="export-status-item"><input type="checkbox" value="hasta-arandi" checked> Hasta Arandı</label>
                </div>
            </div>
            <div style="display:flex;gap:10px;justify-content:flex-end">
                <button class="btn btn-secondary" onclick="closeExportModal()">İptal</button>
                <button class="btn btn-primary" onclick="doExport()"><i class="fas fa-download"></i> İndir</button>
            </div>
        </div>
    </div>
</div>

<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Randevu Talebini Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı randevu talebini silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="fas fa-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="fas fa-exclamation-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<script>
    window.pageData = {
        randevuTalepleri: [],
        count: parseInt("{{ Count ? Count : 0 }}"),
        currentPage: parseInt("{{ Page ? Page : 1 }}"),
        perPage: parseInt("{{ ItemsPerPage ? ItemsPerPage : 10 }}")
    };

    document.addEventListener('DOMContentLoaded', function() {
        const filterBtn = document.getElementById('filterBtn');
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const sortBy = document.getElementById('sortBy');
        const sortOrder = document.getElementById('sortOrder');

        filterBtn.addEventListener('click', function() {
            const query = searchInput.value.trim();
            const status = statusFilter.value;
            const sortByValue = sortBy.value;
            const sortOrderValue = sortOrder.value;

            const urlParams = new URLSearchParams(window.location.search);
            const currentPerPage = urlParams.get('per_page') || '{{ ItemsPerPage ? ItemsPerPage : 10 }}';

            const params = new URLSearchParams();
            params.append('page', '1');
            params.append('per_page', currentPerPage);

            if (query) params.append('query', query);
            if (status && status !== 'all') params.append('status', status);
            if (sortByValue) params.append('sort_by', sortByValue);
            if (sortOrderValue) params.append('sort_order', sortOrderValue);

            const currentUrl = window.location.pathname;
            const queryString = params.toString();
            const newUrl = queryString ? `${currentUrl}?${queryString}` : currentUrl;

            window.location.href = newUrl;
        });

        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                filterBtn.click();
            }
        });

        searchInput.addEventListener('submit', function(e) {
            e.preventDefault();
        });

        searchInput.setAttribute('autocomplete', 'off');
        searchInput.setAttribute('spellcheck', 'false');

        document.querySelectorAll('.status-datetime').forEach(function (el) {
            var raw = (el.getAttribute('data-raw') || el.textContent || '').trim();
            if (!raw) return;
            var m = raw.match(/^(\d{1,2}:\d{2})\s*,\s*(\d{2})\/(\d{2})\/(\d{4})$/);
            if (m) {
                var time = m[1];
                var dd = m[2];
                var mm = m[3];
                var yyyy = m[4];
                el.textContent = dd + '.' + mm + '.' + yyyy + ' ' + time;
            }
        });
    });
</script>

<script src="{{ PathOnStart }}js/panel/randevu-talepleri.js"></script>