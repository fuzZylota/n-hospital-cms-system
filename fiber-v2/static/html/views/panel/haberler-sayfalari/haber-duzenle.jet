<link rel="stylesheet" href="{{ PathOnStart }}css/panel/haber-duzenle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-edit"></i>
                    Haber Bilgilerini Düzenle
                </h1>
                <p class="page-subtitle">{{ Haber.Title }} haberinin bilgilerini düzenleyin</p>
            </div>
            <div class="page-actions">
                <a href="/panel/haberler/{{ Haber.Hid }}" class="btn btn-secondary">
                    <i class="fas fa-eye"></i>
                    Görüntüle
                </a>
                <a href="/panel/haberler" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div id="inlineNotice" class="inline-notice" style="display:none;" role="status" aria-live="polite"></div>
        <div class="forms-container">
            <!-- General Information Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Genel Bilgiler
                    </h2>
                    <p class="section-description">Haberin temel bilgilerini düzenleyin</p>
                </div>
                <div class="section-content">
                    <form id="generalForm" class="general-form" novalidate>
                        <!-- Hidden inputs for old values -->
                        <input type="hidden" name="old_title" value="{{ Haber.Title }}">
                        <input type="hidden" name="old_url_name" value="{{ Haber.UrlName }}">
                        <input type="hidden" name="old_summary" value="{{ Haber.Summary }}">
                        <input type="hidden" name="old_content" value="{{ Haber.Content }}">
                        <input type="hidden" name="old_category" value="{{ Haber.Category }}">
                        <input type="hidden" name="old_author" value="{{ Haber.Author }}">
                        <input type="hidden" name="old_publish_date" value="{{ ctdli(Haber.PublishDate, User.Timezone) }}">
                        <input type="hidden" name="old_is_featured" value="{{ Haber.IsFeatured }}">
                        <input type="hidden" name="old_is_published" value="{{ Haber.IsPublished }}">
                        <input type="hidden" name="old_seo_title" value="{{ Haber.SeoTitle }}">
                        <input type="hidden" name="old_seo_description" value="{{ Haber.SeoDescription }}">
                        <input type="hidden" name="old_seo_keywords" value="{{ Haber.SeoKeywords }}">

                        <!-- Basic Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">Temel Bilgiler</h3>
                            <div class="form-group">
                                <label for="title" class="form-label required">Haber Başlığı</label>
                                <input type="text" id="title" name="title" class="form-input" 
                                       value="{{ Haber.Title }}" required>
                            </div>
                            <div class="form-group">
                                <label for="url_name" class="form-label">URL Adı</label>
                                <input type="text" id="url_name" name="url_name" class="form-input" 
                                       value="{{ Haber.UrlName }}">
                            </div>
                            <div class="form-group">
                                <label for="summary" class="form-label">Özet</label>
                                <textarea id="summary" name="summary" class="form-textarea" 
                                          rows="3">{{ Haber.Summary }}</textarea>
                            </div>
                            <div class="form-group">
                                <label for="content" class="form-label required">İçerik</label>
                                <textarea id="content" name="content" class="form-textarea" 
                                          rows="8" required>{{ Haber.Content }}</textarea>
                            </div>
                        </div>

                        <!-- Publication Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">Yayın Bilgileri</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="category" class="form-label">Kategori</label>
                                    <input type="text" id="category" name="category" class="form-input" 
                                           value="{{ Haber.Category }}" placeholder="genel">
                                </div>
                                <div class="form-group">
                                    <label for="author" class="form-label">Yazar</label>
                                    <input type="text" id="author" name="author" class="form-input" 
                                           value="{{ Haber.Author }}">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="publish_date" class="form-label">Yayın Tarihi</label>
                                <input type="datetime-local" id="publish_date" name="publish_date" class="form-input" 
                                       value="{{ ctdli(Haber.PublishDate, User.Timezone) }}">
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="is_featured" class="form-label">Öne Çıkan</label>
                                    <div class="toggle-switch">
                                        <input type="checkbox" id="is_featured" name="is_featured" {{ if Haber.IsFeatured }}checked{{ end }}>
                                        <label for="is_featured" class="toggle-label">
                                            <span class="toggle-slider"></span>
                                            <span class="toggle-text">{{ if Haber.IsFeatured }}Öne Çıkan{{ else }}Normal{{ end }}</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="is_published" class="form-label">Yayınlanmış</label>
                                    <div class="toggle-switch">
                                        <input type="checkbox" id="is_published" name="is_published" {{ if Haber.IsPublished }}checked{{ end }}>
                                        <label for="is_published" class="toggle-label">
                                            <span class="toggle-slider"></span>
                                            <span class="toggle-text">{{ if Haber.IsPublished }}Yayınlanmış{{ else }}Taslak{{ end }}</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SEO Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">SEO Bilgileri</h3>
                            <div class="form-group">
                                <label for="seo_title" class="form-label">SEO Başlığı</label>
                                <input type="text" id="seo_title" name="seo_title" class="form-input" 
                                       value="{{ Haber.SeoTitle }}">
                            </div>
                            <div class="form-group">
                                <label for="seo_description" class="form-label">SEO Açıklaması</label>
                                <textarea id="seo_description" name="seo_description" class="form-textarea" 
                                          rows="3">{{ Haber.SeoDescription }}</textarea>
                            </div>
                            <div class="form-group">
                                <label for="seo_keywords" class="form-label">SEO Anahtar Kelimeler</label>
                                <input type="text" id="seo_keywords" name="seo_keywords" class="form-input" 
                                       value="{{ Haber.SeoKeywords }}" placeholder="kelime1, kelime2, kelime3">
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" id="generalSubmitBtn">
                                <i class="fas fa-save"></i>
                                <span class="btn-text">Bilgileri Güncelle</span>
                                <div class="btn-loader" style="display: none;">
                                    <div class="spinner"></div>
                                </div>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Picture Management Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-image"></i>
                        Haber Görseli
                    </h2>
                    <p class="section-description">Haber görselini yönetin</p>
                </div>
                <div class="section-content">
                    <!-- Current Picture Display -->
                    <div class="current-media-section">
                        <h3 class="group-title">Mevcut Görsel</h3>
                        <div class="media-grid">
                            <div class="media-item">
                                <div class="media-header">
                                    <h4 class="media-title">Haber Görseli</h4>
                                    {{ if Haber.CoverPath }}
                                    <button type="button" class="btn-delete-media" data-hid="{{ Haber.Hid }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    {{ end }}
                                </div>
                                <div class="media-preview">
                                    {{ if Haber.CoverPath }}
                                    <img src="{{ PathOnStart }}{{ Haber.CoverPath }}" alt="{{ Haber.CoverAltText }}" 
                                         title="{{ Haber.CoverTitle }}" class="preview-image">
                                    <div class="media-info">
                                        <div class="info-item">
                                            <strong>Alt Text:</strong> {{ Haber.CoverAltText }}
                                        </div>
                                        <div class="info-item">
                                            <strong>Title:</strong> {{ Haber.CoverTitle }}
                                        </div>
                                    </div>
                                    {{ else }}
                                    <div class="no-media">
                                        <i class="fas fa-image"></i>
                                        <span>Haber görseli yüklenmemiş</span>
                                    </div>
                                    {{ end }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Picture Upload Form -->
                    <div class="media-upload-section">
                        <h3 class="group-title">Görseli Güncelle</h3>
                        <form id="pictureForm" class="picture-form" enctype="multipart/form-data" novalidate>
                            <input type="hidden" name="old_haber_media_alt_text" value="{{ Haber.CoverAltText }}">
                            <input type="hidden" name="old_haber_media_title" value="{{ Haber.CoverTitle }}">
                            
                            <div class="form-group">
                                <label for="haber_media_path" class="form-label">Haber Görseli</label>
                                <div class="file-upload-area" data-target="haber_media_path">
                                    <div class="file-upload-content">
                                        <i class="fas fa-upload"></i>
                                        <p class="file-upload-text">Görsel dosyasını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                        <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                                    </div>
                                    <input type="file" id="haber_media_path" name="haber_media_path" 
                                           class="file-input" accept="image/*">
                                    <div class="file-preview" style="display: none;">
                                        <img class="preview-image" src="" alt="Preview">
                                        <button type="button" class="file-remove">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="file-meta-inputs">
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="haber_media_alt_text" class="form-label">Görsel Alt Metni</label>
                                            <input type="text" id="haber_media_alt_text" name="haber_media_alt_text" 
                                                   class="form-input" value="{{ Haber.CoverAltText }}">
                                        </div>
                                        <div class="form-group">
                                            <label for="haber_media_title" class="form-label">Görsel Başlığı</label>
                                            <input type="text" id="haber_media_title" name="haber_media_title" 
                                                   class="form-input" value="{{ Haber.CoverTitle }}">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" id="pictureSubmitBtn">
                                    <i class="fas fa-upload"></i>
                                    <span class="btn-text">Görseli Güncelle</span>
                                    <div class="btn-loader" style="display: none;">
                                        <div class="spinner"></div>
                                    </div>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">İşlem başarıyla tamamlandı.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deletePictureModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Görseli Sil</h3>
        <p class="modal-message">Bu görseli silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeModal('deletePictureModal')">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeletePictureBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<script>
    // Pass data to JavaScript
    window.pageData = {
        hid: "{{ Haber.Hid }}"
    };
</script>
<script src="{{ PathOnStart }}js/panel/haber-duzenle.js"></script>