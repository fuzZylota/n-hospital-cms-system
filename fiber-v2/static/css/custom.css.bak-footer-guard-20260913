.main-footer .footer-widget__logo {
  display: inline-flex;
  align-items: center;
  max-width: 210px;
  min-height: 74px;
  margin: 0 0 18px;
  padding: 13px 16px;
  background: #fff;
  border-radius: 13px;
  box-shadow: 0 12px 30px rgba(0, 8, 24, 0.18);
}

.main-footer .footer-widget__logo img {
  display: block;
  width: auto;
  max-width: 100%;
  max-height: 48px;
  object-fit: contain;
}

.main-footer .footer-widget__about-text {
  margin: 0;
  color: rgba(255, 255, 255, 0.9);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.7;
  letter-spacing: 0.01em;
  text-transform: none;
}

.main-footer .footer-widget__title {
  margin: 2px 0 30px;
  padding-bottom: 14px;
  color: #fff;
  font-size: 18px;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: -0.01em;
  text-transform: none;
}

.main-footer .footer-widget__title::before {
  bottom: 0;
  width: 8px;
  height: 3px;
  background: var(--nv-footer-red);
  border-radius: 99px;
}

.main-footer .footer-widget__title::after {
  bottom: 0;
  left: 12px;
  width: 34px;
  height: 3px;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 99px;
}

.main-footer .footer-widget__links {
  margin: 0;
}

.main-footer .footer-widget__links li,
.main-footer .footer-widget__links li + li {
  margin: 0;
  color: var(--nv-footer-muted);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.45;
  text-transform: none;
}

.main-footer .footer-widget__links li + li {
  margin-top: 7px;
}

.main-footer .footer-widget__links li a {
  position: relative;
  display: inline-flex;
  align-items: flex-start;
  padding: 3px 0 3px 14px;
  color: inherit;
  background: none;
  text-decoration: none;
  transition: color 180ms ease, transform 180ms ease;
}

.main-footer .footer-widget__links li a::before {
  content: "";
  position: absolute;
  top: 12px;
  left: 0;
  width: 5px;
  height: 5px;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  transition: background-color 180ms ease, transform 180ms ease;
}

.main-footer .footer-widget__links li a:hover {
  color: #fff;
  background: none;
  text-shadow: none;
  transform: translateX(3px);
}

.main-footer .footer-widget__links li a:hover::before {
  background: var(--nv-footer-red);
  transform: scale(1.35);
}

.main-footer .footer-widget__description-text {
  margin: 0;
  color: var(--nv-footer-muted);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.85;
  text-transform: none;
}

.main-footer .footer-widget--blog {
  margin-top: 34px;
}

.main-footer .footer-widget--blog .footer-widget__title {
  margin-bottom: 28px;
}

.main-footer .footer-widget__posts__item {
  gap: 14px;
}

.main-footer .footer-widget__posts__item:not(:last-of-type) {
  margin-bottom: 18px;
}

.main-footer .footer-widget__posts__image {
  width: 76px;
}

.main-footer .footer-widget__posts__image img {
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 10px;
}

.main-footer .footer-widget__posts__content {
  width: calc(100% - 90px);
}

.main-footer .footer-widget__posts__meta a {
  color: rgba(255, 255, 255, 0.56);
}

.main-footer .footer-widget__posts__title {
  color: #fff;
  font-size: 14px;
  line-height: 1.55;
  text-transform: none;
}

/* Legal and copyright bar */
.main-footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  margin: 0;
  padding: 25px 0 28px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.main-footer__legal-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 20px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.main-footer__legal-links a,
.main-footer__copyright,
.main-footer__agency {
  color: rgba(255, 255, 255, 0.62);
  font-size: 12px;
  line-height: 1.65;
}

.main-footer__legal-links a {
  position: relative;
  text-decoration: none;
  transition: color 180ms ease;
}

.main-footer__legal-links li + li a::before {
  content: "";
  position: absolute;
  top: 50%;
  left: -11px;
  width: 3px;
  height: 3px;
  background: rgba(255, 255, 255, 0.35);
  border-radius: 50%;
}

.main-footer__legal-links a:hover {
  color: #fff;
}

.main-footer__bottom-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  text-align: right;
}

.main-footer__copyright,
.main-footer__agency {
  margin: 0;
  text-align: right;
  text-transform: none;
}

.main-footer__agency a {
  color: rgba(255, 255, 255, 0.82);
  font-weight: 600;
  text-decoration: none;
  transition: color 180ms ease;
}

.main-footer__agency a:hover {
  color: #fff;
}

.main-footer a:focus-visible {
  outline: 3px solid rgba(255, 255, 255, 0.9);
  outline-offset: 4px;
  border-radius: 4px;
}

@media (max-width: 1199px) {
  .main-footer > .container > .row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 767px) {
  body footer.main-footer.section-space-top {
    padding-top: 46px !important;
  }

  .main-footer__cta {
    align-items: stretch;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 42px;
    padding: 24px 20px;
    border-left-width: 4px;
    border-radius: 16px;
  }

  .main-footer__cta-right {
    align-items: stretch;
    flex-direction: column;
  }

  .main-footer__cta-phone {
    width: 100%;
  }

  .main-footer__cta-social {
    justify-content: flex-start;
  }

  .main-footer > .container > .row {
    grid-template-columns: minmax(0, 1fr);
    gap: 38px;
    padding-bottom: 42px;
  }

  .main-footer .footer-widget--about {
    padding: 20px;
  }

  .main-footer .footer-widget__title {
    margin-bottom: 24px;
  }

  .main-footer__bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
    padding: 22px 0 92px;
  }

  .main-footer__bottom-right {
    align-items: flex-start;
    text-align: left;
  }

  .main-footer__copyright,
  .main-footer__agency {
    text-align: left;
  }
}

@media (min-width: 480px) and (max-width: 767px) {
  .main-footer .footer-widget__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px 18px;
  }

  .main-footer .footer-widget__links li + li {
    margin-top: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .main-footer *,
  .main-footer *::before,
  .main-footer *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

