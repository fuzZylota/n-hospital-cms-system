<!DOCTYPE html>
<html lang="tr">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {{ FontRaw := Options.Options.FontFamily != "" ? Options.Options.FontFamily : "Poppins" }}
    {{ FontSafe := contains("|Poppins|Roboto|Open Sans|Lato|Montserrat|Manrope|Inter|Oswald|Noto Sans|Raleway|Ubuntu|Playfair Display|Work Sans|Outfit|", "|" + FontRaw + "|") ? FontRaw : "Poppins" }}

    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family={{ if FontSafe == "Open Sans" }}Open+Sans{{ else if FontSafe == "Noto Sans" }}Noto+Sans{{ else if FontSafe == "Playfair Display" }}Playfair+Display{{ else if FontSafe == "Work Sans" }}Work+Sans{{ else }}{{ FontSafe }}{{ end }}:wght@400;500;600;700{{ if FontSafe != "Manrope" }}&family=Manrope:wght@200..800{{ end }}&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ if FontSafe == "Open Sans" }}Open+Sans{{ else if FontSafe == "Noto Sans" }}Noto+Sans{{ else if FontSafe == "Playfair Display" }}Playfair+Display{{ else if FontSafe == "Work Sans" }}Work+Sans{{ else }}{{ FontSafe }}{{ end }}:wght@400;500;600;700{{ if FontSafe != "Manrope" }}&family=Manrope:wght@200..800{{ end }}&display=swap">
    <style>
        :root {
            --theme-primary-color: {{ Options ? Options.Options.PrimaryColor : "rgba(40, 59, 106, 1)" }};
            --theme-secondary-color: {{ Options ? Options.Options.SecondaryColor : "rgba(223, 0, 36, 1)" }};
            --theme-accent-color: {{ Options ? Options.Options.AccentColor : "rgba(51, 193, 237, 1)" }};
            --theme-background-color: {{ Options ? Options.Options.BackgroundColor : "rgba(255, 255, 255, 1)" }};
            --theme-text-color: {{ Options ? Options.Options.FontColor : "rgba(51, 51, 51, 1)" }};
            --theme-font-family: {{ Options ? Options.Options.FontFamily : "Poppins, sans-serif" }};
            --theme-header-text-color: {{ Options ? Options.Options.FontColor : "rgba(255,255,255,1)" }};
        }
    </style>
    <meta charset="UTF-8" />
