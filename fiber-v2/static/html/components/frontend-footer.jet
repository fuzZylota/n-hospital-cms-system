<footer class="nv-site-footer">
    <div class="nv-sf__container">
        <div class="nv-sf__top">
            <section class="nv-sf__contact" aria-labelledby="nvSfContactTitle">
                <a href="/" class="nv-sf__logo">
                    {{ if Options.Medias[1].FilePath != "" }}
                        <img src="/{{ PathOnStart }}{{ Options.Medias[1].FilePath }}" alt="{{ Options.Medias[1].AltText ? Options.Medias[1].AltText : Options.Options.SiteName + " ana sayfa" }}" width="1000" height="405" loading="lazy" />
                    {{ else }}
                        <img src="/{{ PathOnStart }}files/defaults/logo/n-hospital-logo-white.png" alt="{{ Options.Options.SiteName }} ana sayfa" width="2001" height="667" loading="lazy" />
                    {{ end }}
                </a>
                <p class="nv-sf__slogan">Gözünüz, Yaşamınızdır.</p>

                <h2 class="nv-sf__title" id="nvSfContactTitle">Randevu ve bilgi</h2>
                {{ if Options.Options.ContactPhone != "" }}
                <a class="nv-sf__phone" href="tel:{{ Options.Options.ContactPhone }}">
                    <svg class="nv-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
                    <span>{{ Options.Options.ContactPhone }}</span>
                </a>
                {{ end }}
                {{ if Options.Options.ContactEmail != "" }}
                <a class="nv-sf__mail" href="mailto:{{ Options.Options.ContactEmail }}">{{ Options.Options.ContactEmail }}</a>
                {{ end }}
                <div class="nv-sf__ctas">
                    <a href="/randevu" class="nv-btn nv-btn--primary nv-btn--lg">Randevu Talebi Oluştur</a>
                    {{ if Options.Options.ContactPhone != "" }}
                    <a href="tel:{{ Options.Options.ContactPhone }}" class="nv-btn nv-btn--secondary nv-btn--lg">Hemen Ara</a>
                    {{ end }}
                </div>
            </section>

            <nav class="nv-sf__group nv-sf__group--centers" aria-labelledby="nvSfCentersTitle">
                <h2 class="nv-sf__title" id="nvSfCentersTitle">Merkezlerimiz</h2>
                <ul class="nv-sf__list nv-sf__list--centers">
                    {{ range index, SubeLink := Options.SubelerLinks }}
                        <li>
                            <a href="/merkezlerimiz/{{ SubeLink.UrlName }}">
                                <span class="nv-sf__center-name">{{ SubeLink.Name }}</span>
                                <span class="nv-sf__center-hint">Adres, telefon ve yol tarifi</span>
                            </a>
                        </li>
                    {{ end }}
                    <li><a href="/merkezlerimiz">Tüm merkezlerimiz</a></li>
                    <li><a href="/ulasim">Ulaşım</a></li>
                </ul>
            </nav>

            <nav class="nv-sf__group" aria-labelledby="nvSfServicesTitle">
                <h2 class="nv-sf__title" id="nvSfServicesTitle">Sağlık hizmetleri</h2>
                <ul class="nv-sf__list">
                    <li><a href="/randevu">Randevu talebi</a></li>
                    <li><a href="/doktorlarimiz">Doktorlarımız</a></li>
                    <li><a href="/tibbi-birimler">Tıbbi birimler</a></li>
                    <li><a href="/tetkikler">Tetkikler</a></li>
                    <li><a href="/kurumsal/anlasmali-kurumlar">Anlaşmalı kurumlar</a></li>
                </ul>
            </nav>

            <nav class="nv-sf__group" aria-labelledby="nvSfCorpTitle">
                <h2 class="nv-sf__title" id="nvSfCorpTitle">Kurumsal</h2>
                <ul class="nv-sf__list">
                    <li><a href="/kurumsal/hakkimizda">Hakkımızda</a></li>
                    <li><a href="/kurumsal/misyon-vizyon">Misyon ve vizyon</a></li>
                    <li><a href="/kurumsal/organizasyon-semasi">Organizasyon şeması</a></li>
                    <li><a href="/kurumsal/insan-kaynaklari">İnsan kaynakları</a></li>
                    <li><a href="/haberler">Güncel haberler</a></li>
                    <li><a href="/foto-galeri">Foto galeri</a></li>
                    <li><a href="/video-galeri">Video galeri</a></li>
                    <li><a href="/iletisim">İletişim</a></li>
                </ul>
            </nav>
        </div>

        <div class="nv-sf__bottom">
            <ul class="nv-sf__legal">
                <li><a href="/kurumsal/kvkk">Kişisel Verilerin Korunması (KVKK)</a></li>
                <li><a href="/cerez-politikasi">Çerez Politikası</a></li>
                <li><button type="button" class="nv-sf__linkbtn" onclick="if (window.nvOpenCookieSettings) nvOpenCookieSettings()">Çerez tercihleri</button></li>
            </ul>

            <ul class="nv-sf__social" aria-label="Sosyal medya">
                {{ if Options.Options.FacebookUrl != "" && Options.Options.FacebookUrl != "#" }}
                <li><a href="{{ Options.Options.FacebookUrl }}" target="_blank" rel="noopener" aria-label="Facebook (yeni sekmede açılır)"><i class="fab fa-facebook-f" aria-hidden="true"></i></a></li>
                {{ end }}
                {{ if Options.Options.InstagramUrl != "" && Options.Options.InstagramUrl != "#" }}
                <li><a href="{{ Options.Options.InstagramUrl }}" target="_blank" rel="noopener" aria-label="Instagram (yeni sekmede açılır)"><i class="fab fa-instagram" aria-hidden="true"></i></a></li>
                {{ end }}
                {{ if Options.Options.LinkedinUrl != "" && Options.Options.LinkedinUrl != "#" }}
                    {{ if contains(Options.Options.LinkedinUrl, "youtube") }}
                    <li><a href="{{ Options.Options.LinkedinUrl }}" target="_blank" rel="noopener" aria-label="YouTube (yeni sekmede açılır)"><i class="fab fa-youtube" aria-hidden="true"></i></a></li>
                    {{ else }}
                    <li><a href="{{ Options.Options.LinkedinUrl }}" target="_blank" rel="noopener" aria-label="LinkedIn (yeni sekmede açılır)"><i class="fab fa-linkedin" aria-hidden="true"></i></a></li>
                    {{ end }}
                {{ end }}
                {{ if Options.Options.TwitterUrl != "" && Options.Options.TwitterUrl != "#" }}
                <li><a href="{{ Options.Options.TwitterUrl }}" target="_blank" rel="noopener" aria-label="X / Twitter (yeni sekmede açılır)"><i class="fab fa-twitter" aria-hidden="true"></i></a></li>
                {{ end }}
            </ul>

            <div class="nv-sf__copy">
                <p>&copy; <span class="dynamic-year"></span> {{ Options.Options.SiteName }}. Tüm hakları saklıdır.</p>
                <p>Web tasarım: <a href="https://www.instagram.com/pixmadedigital" target="_blank" rel="noopener">Pixmade Digital<span class="sr-only"> (yeni sekmede açılır)</span></a></p>
            </div>
        </div>
    </div>
</footer>
