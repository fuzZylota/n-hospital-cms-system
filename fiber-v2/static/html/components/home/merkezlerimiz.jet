<section class="home-merkezlerimiz" style="padding: 40px 0 60px; background: #fff;">
    <div class="container">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:28px;">
            <h3 style="font-size:32px; font-weight:800; color:#111827; margin:0;">Merkezlerimiz</h3>
            <a href="/merkezlerimiz" class="home-all-doctors-btn">Tümünü Gör</a>
        </div>
        <div style="position:relative; padding:0 44px;">
            <button class="team-three__nav-btn team-three__nav-btn--prev" id="merkezPrev"><i class="icon-arrow-left"></i></button>
            <div class="owl-carousel owl-theme mediox-owl__carousel" id="merkezCarousel" data-owl-options='{
                "items": 3,
                "margin": 20,
                "loop": true,
                "smartSpeed": 700,
                "nav": false,
                "dots": false,
                "autoplay": true,
                "autoplayTimeout": 3500,
                "autoplayHoverPause": true,
                "responsive": {
                    "0": {"items": 2, "margin": 10},
                    "768": {"items": 3, "margin": 16},
                    "992": {"items": 3, "margin": 20}
                }
            }'>
                {{ range index3, Sube := Subeler }}
                    <div class="item">
                        <a href="/merkezlerimiz/{{ Sube.UrlName }}" class="home-merkez-card">
                            <div class="home-merkez-card__img">
                                {{ if Sube.MediaPath != "" }}
                                    <img src="{{ Sube.MediaPath }}" alt="{{ Sube.Name }}">
                                {{ else }}
                                    <div class="home-merkez-card__no-img">
                                        <i class="fas fa-hospital"></i>
                                    </div>
                                {{ end }}
                            </div>
                            <div class="home-merkez-card__body">
                                <div class="home-merkez-card__text">
                                    <span class="home-merkez-card__name">{{ Sube.Name }}</span>
                                    {{ if Sube.City != "" }}
                                        <span class="home-merkez-card__location"><i class="fas fa-map-marker-alt"></i> {{ Sube.City }}{{ if Sube.District != "" }}, {{ Sube.District }}{{ end }}</span>
                                    {{ end }}
                                </div>
                                <span class="home-merkez-card__arrow"><i class="fas fa-arrow-right"></i></span>
                            </div>
                        </a>
                    </div>
                {{ end }}
            </div>
            <button class="team-three__nav-btn team-three__nav-btn--next" id="merkezNext"><i class="icon-arrow-right"></i></button>
        </div>
    </div>
</section>
<script>
(function waitOwlMerkez() {
    if (typeof $ === 'undefined' || !$.fn.owlCarousel) { setTimeout(waitOwlMerkez, 200); return; }
    $('#merkezPrev').on('click', function() { $('#merkezCarousel').trigger('prev.owl.carousel'); });
    $('#merkezNext').on('click', function() { $('#merkezCarousel').trigger('next.owl.carousel'); });
})();
</script>
