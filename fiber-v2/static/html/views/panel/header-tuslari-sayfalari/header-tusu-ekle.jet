<link rel="stylesheet" href="{{ PathOnStart }}css/panel/header-tusu-ekle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-plus"></i>
                    Yeni Header Tuşu Ekle
                </h1>
                <p class="page-subtitle">Site header menüsü için yeni bir navigasyon tuşu oluşturun</p>
            </div>
            <div class="page-actions">
                <a href="/panel/header-tuslari" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <form id="headerButtonForm" class="header-button-form" novalidate action="/backend/add-header-button" method="post">
            <!-- Basic Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Temel Bilgiler
                    </h2>
                    <p class="section-description">Header tuşunun temel özelliklerini belirleyin</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="title" class="form-label required">Başlık</label>
                            <input type="text" id="title" name="title" class="form-input" 
                                   placeholder="Örn: Anasayfa, Hakkımızda, İletişim" required maxlength="100">
                            <div class="form-help">Menüde görüntülenecek metin (maksimum 100 karakter)</div>
                        </div>
                        <div class="form-group">
                            <label for="url" class="form-label">URL</label>
                            <input type="url" id="url" name="url" class="form-input" 
                                   placeholder="https://example.com veya /sayfa-adi" maxlength="255">
                            <div class="form-help">Tuşa tıklandığında gidilecek adres (isteğe bağlı)</div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="icon" class="form-label">İkon</label>
                            <input type="text" id="icon" name="icon" class="form-input" 
                                   placeholder="fas fa-home" maxlength="50">
                            <div class="form-help">FontAwesome ikon sınıfı (örn: fas fa-home)</div>
                            <div class="icon-preview" id="iconPreview">
                                <i class="fas fa-link"></i>
                                <span>Önizleme</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="target" class="form-label required">Hedef</label>
                            <select id="target" name="target" class="form-select" required>
                                <option value="_self" selected>Aynı Pencere (_self)</option>
                                <option value="_blank">Yeni Pencere (_blank)</option>
                            </select>
                            <div class="form-help" id="target-help-text">Bağlantının nasıl açılacağını belirler</div>
                        </div>
                        <div class="form-group">
                            <label for="button_type" class="form-label required">Buton Tipi</label>
                            <select id="button_type" name="button_type" class="form-select" required>
                                <option value="kurumsal">kurumsal</option>
                                <option value="anasayfa">anasayfa</option>
                                <option value="diger" selected>diger</option>
                            </select>
                            <div class="form-help">Menü tuşunun kategorisi (veritabanı şeması ile uyumlu)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hierarchy Settings Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-sitemap"></i>
                        Hiyerarşi Ayarları
                    </h2>
                    <p class="section-description">Menü yapısı ve sıralama ayarları</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="parent_id" class="form-label">Ana Menü</label>
                            <select id="parent_id" name="parent_id" class="form-select">
                                <option value="">Ana Menü Öğesi (Üst Seviye)</option>
                                {{if len(ParentButtons) > 0}}
                                    {{range ParentButtons}}
                                    <option value="{{ .Hbid }}">{{ .Title }}</option>
                                    {{end}}
                                {{end}}
                            </select>
                            <div class="form-help">Bu tuş bir alt menü öğesi mi? Eğer öyleyse ana menü öğesini seçin</div>
                        </div>
                        <div class="form-group">
                            <label for="sort_order" class="form-label required">Sıra Numarası</label>
                            <input type="number" id="sort_order" name="sort_order" class="form-input" 
                                   value="1" min="1" max="999" required>
                            <div class="form-help">Menüde görünme sırası (1 = en üst)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Settings Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-toggle-on"></i>
                        Durum Ayarları
                    </h2>
                    <p class="section-description">Header tuşunun görünürlük durumu</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="is_active" class="form-label">Durum</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="is_active" name="is_active" checked>
                                <label for="is_active" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Aktif</span>
                                </label>
                            </div>
                            <div class="form-help">Header tuşu aktif olarak oluşturulsun mu?</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-lightbulb"></i>
                        Ek Bilgiler
                    </h2>
                    <p class="section-description">Header tuşu oluşturma hakkında ipuçları</p>
                </div>
                <div class="section-content">
                    <div class="info-card">
                        <div class="info-icon">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div class="info-content">
                            <h4>Header Tuşu Hakkında</h4>
                            <ul>
                                <li><strong>Başlık:</strong> Menüde görüntülenecek metin. Kısa ve açıklayıcı olmalı</li>
                                <li><strong>URL:</strong> İç sayfalar için "/sayfa-adi", dış linkler için tam URL kullanın</li>
                                <li><strong>İkon:</strong> FontAwesome ikonları desteklenir (fas fa-home, fas fa-phone vb.)</li>
                                <li><strong>Hedef:</strong> _self aynı pencerede, _blank yeni pencerede açar</li>
                                <li><strong>Ana Menü:</strong> Alt menü oluşturmak için ana menü öğesini seçin</li>
                                <li><strong>Sıra:</strong> Küçük sayılar üstte, büyük sayılar altta görünür</li>
                                <li>Tuş oluşturulduktan sonra düzenlenebilir ve silinebilir</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                    <i class="fas fa-times"></i>
                    İptal
                </button>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="fas fa-check"></i>
                    <span class="btn-text">Header Tuşunu Oluştur</span>
                    <div class="btn-loader" style="display: none;">
                        <div class="spinner"></div>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message">Header tuşu başarıyla oluşturuldu.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script src="{{ PathOnStart }}js/panel/header-tusu-ekle.js"></script>
