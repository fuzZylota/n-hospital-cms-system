<link rel="stylesheet" href="{{ PathOnStart }}css/panel/respond-to-contact-request.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/contact-requests" class="breadcrumb-link">
                        <i class="fas fa-envelope"></i>
                        İletişim Talepleri
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">Talep Cevapla</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-reply"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">İletişim Talebine Cevap Ver</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-info-circle"></i>
                                Müşteriye otomatik e-posta gönderilir
                            </span>
                        </div>
                    </div>
                </h1>
            </div>
        </div>
    </div>

    <!-- Content Section -->
    <div class="content-section">
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-edit"></i>
                </div>
                <h3 class="card-title">Cevap Formu</h3>
            </div>
            <div class="card-content">
                <form id="respondToContactRequestForm" class="respond-form" novalidate>
                    <!-- Contact Request Selection -->
                    <div class="form-group">
                        <label for="contact_request_select" class="form-label required">
                            <i class="fas fa-envelope"></i>
                            İletişim Talebi Seçin
                        </label>
                        <select id="contact_request_select" name="crid" required>
                            <option value="">İletişim talebi seçin...</option>
                            {{range ContactRequests}}
                            <option value="{{ .Crid }}" data-subject="{{ .Subject }}" data-is-replied="{{ .IsReplied }}">
                                {{ .Subject }}
                                {{if .IsReplied}}
                                <span class="replied-indicator">(Cevaplanmış)</span>
                                {{end}}
                            </option>
                            {{end}}
                        </select>
                        <div class="form-help">
                            Cevaplanmış talepler tekrar cevaplanabilir
                        </div>
                    </div>

                    <!-- Response Title -->
                    <div class="form-group">
                        <label for="response_title" class="form-label required">
                            <i class="fas fa-heading"></i>
                            Cevap Başlığı
                        </label>
                        <input type="text" id="response_title" name="title" required placeholder="Cevap başlığını girin">
                        <div class="form-help">
                            Müşteriye gönderilecek e-postanın başlığı
                        </div>
                    </div>

                    <!-- Responder Name -->
                    <div class="form-group">
                        <label for="responder_name" class="form-label">
                            <i class="fas fa-user"></i>
                            Cevap Veren Kişi
                        </label>
                        <input type="text" id="responder_name" name="responder_name" placeholder="Adınızı girin (opsiyonel)">
                        <div class="form-help">
                            Cevabı kimin verdiğini belirtin (opsiyonel)
                        </div>
                    </div>

                    <!-- Response Text -->
                    <div class="form-group">
                        <label for="response_text" class="form-label required">
                            <i class="fas fa-comment-dots"></i>
                            Cevap Metni
                        </label>
                        <textarea id="response_text" name="response_text" rows="8" required placeholder="Müşteriye gönderilecek cevap metnini yazın..."></textarea>
                        <div class="form-help">
                            Bu metin müşteriye e-posta olarak gönderilecektir
                        </div>
                    </div>

                    <!-- Selected Contact Request Info -->
                    <div id="selectedRequestInfo" class="selected-request-info" style="display: none;">
                        <div class="info-header">
                            <i class="fas fa-info-circle"></i>
                            <span>Seçilen Talep Bilgileri</span>
                        </div>
                        <div class="info-content">
                            <div class="info-item">
                                <span class="info-label">Konu:</span>
                                <span class="info-value" id="selectedSubject">-</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Durum:</span>
                                <span class="info-value" id="selectedStatus">-</span>
                            </div>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <a href="/backend/iletisim-istegi-cevapla" id="replyAnotherBtn" class="btn btn-secondary" style="display: none;">
                            <i class="fas fa-random"></i>
                            Başka İsteği Cevapla
                        </a>
                        <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                            <i class="fas fa-arrow-left"></i>
                            Geri Dön
                        </button>
                        <button type="submit" class="btn btn-primary" id="submitResponseBtn">
                            <i class="fas fa-paper-plane"></i>
                            <span class="btn-text">Cevabı Gönder</span>
                            <div class="btn-loader" style="display: none;">
                                <div class="spinner"></div>
                            </div>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="icon-check-circle"></i>
    <span class="alert-text">Cevap başarıyla gönderildi.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="icon-alert-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<script>
    // Pass data to JavaScript
    window.respondData = {
        contactRequests: [
            {{range ContactRequests}}
            {
                crid: "{{ .Crid }}",
                subject: "{{ .Subject }}",
                isReplied: {{ .IsReplied }}
            },
            {{end}}
        ]
    };

    // Auto-select by crid query param and reveal helper button
    (function() {
        try {
            var params = new URLSearchParams(window.location.search);
            var crid = params.get('crid');
            if (crid && crid !== '') {
                var select = document.getElementById('contact_request_select');
                if (select) {
                    select.value = crid;
                    // Trigger change so UI reflects the selected item
                    var evt = document.createEvent('HTMLEvents');
                    evt.initEvent('change', true, false);
                    select.dispatchEvent(evt);
                }
                var anotherBtn = document.getElementById('replyAnotherBtn');
                if (anotherBtn) {
                    anotherBtn.style.display = 'inline-flex';
                }
            }
        } catch (e) {
            // no-op
        }
    })();
</script>
<script src="{{ PathOnStart }}js/panel/respond-to-contact-request.js"></script>

