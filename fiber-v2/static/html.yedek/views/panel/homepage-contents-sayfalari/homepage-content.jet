<link rel="stylesheet" href="{{ PathOnStart }}css/panel/homepage-content.css">
<!-- CodeMirror CSS for syntax highlighting -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/theme/monokai.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/anasayfa-icerikleri" class="breadcrumb-link">
                        <i class="fas fa-home"></i>
                        Anasayfa İçerikleri
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">{{ HomepageContent.Name }}</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">{{ HomepageContent.Name }}</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-calendar"></i>
                                {{ mthr(HomepageContent.CreatedAt, User.Timezone) }}
                            </span>
                            <span class="meta-item">
                                <i class="fas fa-clock"></i>
                                Son güncelleme: {{ mthr(HomepageContent.UpdatedAt, User.Timezone) }}
                            </span>
                        </div>
                    </div>
                </h1>
                {{if HomepageContent.Description}}
                <p class="page-subtitle">{{ HomepageContent.Description }}</p>
                {{end}}
            </div>
            <div class="page-actions">
                <div class="status-indicator">
                    {{if HomepageContent.IsActive}}
                    <span class="status-badge active">
                        <i class="fas fa-check-circle"></i>
                        Aktif
                    </span>
                    {{else}}
                    <span class="status-badge inactive">
                        <i class="fas fa-pause-circle"></i>
                        Pasif
                    </span>
                    {{end}}
                </div>
                <div class="action-buttons">
                    <a href="/panel/anasayfa-icerikleri/{{ HomepageContent.Hcid }}/duzenle" class="btn btn-primary">
                        <i class="fas fa-edit"></i>
                        Düzenle
                    </a>
                    <button class="btn btn-danger" id="deleteHomepageContentBtn" data-id="{{ HomepageContent.Hcid }}" data-name="{{ HomepageContent.Name }}">
                        <i class="fas fa-trash"></i>
                        <span class="btn-text">Sil</span>
                        <div class="btn-loader" style="display: none;">
                            <div class="spinner"></div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Sections -->
    <div class="content-grid">
        <!-- Basic Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <h3 class="card-title">Temel Bilgiler</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item">
                        <label class="info-label">İçerik Adı</label>
                        <div class="info-value">{{ HomepageContent.Name }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">URL Adı</label>
                        <div class="info-value">{{ HomepageContent.UrlName }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">İçerik Tipi</label>
                        <div class="info-value">
                            <span class="type-badge {{ HomepageContent.ContentType }}">
                                <i class="fas fa-{{ if HomepageContent.ContentType == "hero" }}home{{ else if HomepageContent.ContentType == "about" }}info-circle{{ else if HomepageContent.ContentType == "services" }}cogs{{ else if HomepageContent.ContentType == "doctors" }}user-md{{ else if HomepageContent.ContentType == "news" }}newspaper{{ else if HomepageContent.ContentType == "contact" }}phone{{ else if HomepageContent.ContentType == "footer" }}window-restore{{ else if HomepageContent.ContentType == "header" }}header{{ else if HomepageContent.ContentType == "sidebar" }}sidebar{{ else if HomepageContent.ContentType == "banner" }}image{{ else if HomepageContent.ContentType == "testimonial" }}quote-left{{ else if HomepageContent.ContentType == "gallery" }}images{{ else }}file{{ end }}"></i>
                                {{ if HomepageContent.ContentType == "hero" }}Hero Section{{ else if HomepageContent.ContentType == "about" }}Hakkımızda{{ else if HomepageContent.ContentType == "services" }}Hizmetler{{ else if HomepageContent.ContentType == "doctors" }}Doktorlar{{ else if HomepageContent.ContentType == "news" }}Haberler{{ else if HomepageContent.ContentType == "contact" }}İletişim{{ else if HomepageContent.ContentType == "footer" }}Footer{{ else if HomepageContent.ContentType == "header" }}Header{{ else if HomepageContent.ContentType == "sidebar" }}Sidebar{{ else if HomepageContent.ContentType == "banner" }}Banner{{ else if HomepageContent.ContentType == "testimonial" }}Referanslar{{ else if HomepageContent.ContentType == "gallery" }}Galeri{{ else }}{{ HomepageContent.ContentType }}{{ end }}
                            </span>
                        </div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Sıralama</label>
                        <div class="info-value">{{ HomepageContent.SortOrder }}</div>
                    </div>
                    {{if HomepageContent.LaterThanWhichContent}}
                    <div class="info-item">
                        <label class="info-label">Hangi İçerikten Sonra</label>
                        <div class="info-value">{{ HomepageContent.LaterThanWhichContent }}</div>
                    </div>
                    {{end}}
                    {{if HomepageContent.Description}}
                    <div class="info-item full-width">
                        <label class="info-label">Açıklama</label>
                        <div class="info-value">{{ HomepageContent.Description }}</div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>

        <!-- HTML Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fab fa-html5"></i>
                </div>
                <h3 class="card-title">HTML İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="code-section">
                    <div class="code-header">
                        <span class="code-title">HTML Kodu</span>
                        <div class="code-actions">
                            <button class="btn-icon copy-btn" onclick="copyToClipboard('htmlContent')" title="Kopyala">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn-icon expand-btn" onclick="toggleCodeExpansion('htmlContent')" title="Genişlet/Daralt">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="code-container">
                        <textarea id="htmlContent" class="code-editor" readonly>{{ if HomepageContent.ContentHtml }}{{ HomepageContent.ContentHtml }}{{ else }}<!-- HTML kodu bulunmuyor -->{{ end }}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- CSS Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fab fa-css3-alt"></i>
                </div>
                <h3 class="card-title">CSS İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="code-section">
                    <div class="code-header">
                        <span class="code-title">CSS Kodu</span>
                        <div class="code-actions">
                            <button class="btn-icon copy-btn" onclick="copyToClipboard('cssContent')" title="Kopyala">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn-icon expand-btn" onclick="toggleCodeExpansion('cssContent')" title="Genişlet/Daralt">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="code-container">
                        <textarea id="cssContent" class="code-editor" readonly>{{ if HomepageContent.ContentCss }}{{ HomepageContent.ContentCss }}{{ else }}/* CSS kodu bulunmuyor */{{ end }}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- JavaScript Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fab fa-js-square"></i>
                </div>
                <h3 class="card-title">JavaScript İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="code-section">
                    <div class="code-header">
                        <span class="code-title">JavaScript Kodu</span>
                        <div class="code-actions">
                            <button class="btn-icon copy-btn" onclick="copyToClipboard('jsContent')" title="Kopyala">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn-icon expand-btn" onclick="toggleCodeExpansion('jsContent')" title="Genişlet/Daralt">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="code-container">
                        <textarea id="jsContent" class="code-editor" readonly>{{ if HomepageContent.ContentJavascript }}{{ HomepageContent.ContentJavascript }}{{ else }}// JavaScript kodu bulunmuyor{{ end }}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Preview Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-eye"></i>
                </div>
                <h3 class="card-title">Önizleme</h3>
            </div>
            <div class="card-content">
                <div class="preview-container">
                    <div class="preview-header">
                        <span class="preview-title">HTML Önizleme</span>
                        <div class="preview-actions">
                            <button class="btn btn-sm btn-secondary" onclick="refreshPreview()">
                                <i class="fas fa-sync-alt"></i>
                                Yenile
                            </button>
                            <button class="btn btn-sm btn-secondary" onclick="openPreviewInNewTab()">
                                <i class="fas fa-external-link-alt"></i>
                                Yeni Sekmede Aç
                            </button>
                        </div>
                    </div>
                    <div class="preview-frame">
                        <iframe id="previewFrame" src="about:blank" sandbox="allow-scripts allow-same-origin"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Anasayfa İçeriğini Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı anasayfa içeriğini silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz ve tüm ilişkili veriler silinecektir.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="icon-trash-2"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="icon-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="icon-alert-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<script>
    // Pass data to JavaScript
    window.homepageContentData = {
        id: parseInt("{{ HomepageContent.Hcid }}"),
        name: "{{ HomepageContent.Name }}",
        htmlContent: `{{ HomepageContent.ContentHtml }}`,
        cssContent: `{{ HomepageContent.ContentCss }}`,
        jsContent: `{{ HomepageContent.ContentJavascript }}`
    };
</script>
<!-- CodeMirror JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/css/css.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.js"></script>
<script src="{{ PathOnStart }}js/panel/homepage-content.js"></script>