<section class="hizli-randevu-strip">
    <div class="container">
        <div class="hizli-randevu-strip__inner">
            <div class="hizli-randevu-strip__form-box">
                <h2 class="hizli-randevu-strip__form-title" id="stripRandevuTitle">
                    <i class="fas fa-calendar-check" aria-hidden="true"></i>
                    Hızlı randevu talebi
                </h2>
                <form id="stripRandevuForm" class="hizli-randevu-strip__form-grid" aria-labelledby="stripRandevuTitle" novalidate>
                    <div class="hp-field" aria-hidden="true"><label>Web sitesi<input type="text" name="website" tabindex="-1" autocomplete="off" value=""></label></div>
                    <div class="nv-field">
                        <label class="nv-label" for="stripFirstName">Adınız <span class="nv-label__req">(zorunlu)</span></label>
                        <input class="nv-input" type="text" name="patient_first_name" id="stripFirstName" autocomplete="given-name" maxlength="100" aria-describedby="stripFirstNameError">
                        <p class="nv-error" id="stripFirstNameError"></p>
                    </div>
                    <div class="nv-field">
                        <label class="nv-label" for="stripLastName">Soyadınız <span class="nv-label__req">(zorunlu)</span></label>
                        <input class="nv-input" type="text" name="patient_last_name" id="stripLastName" autocomplete="family-name" maxlength="100" aria-describedby="stripLastNameError">
                        <p class="nv-error" id="stripLastNameError"></p>
                    </div>
                    <div class="nv-field">
                        <label class="nv-label" for="stripPhone">Telefon <span class="nv-label__req">(zorunlu)</span></label>
                        <input class="nv-input" type="tel" name="patient_phone" id="stripPhone" autocomplete="tel" inputmode="tel" maxlength="20" placeholder="0532 123 45 67" aria-describedby="stripPhoneError">
                        <p class="nv-error" id="stripPhoneError"></p>
                    </div>
                    <div class="nv-field">
                        <label class="nv-label" for="stripBranch">Merkez <span class="nv-label__req">(isteğe bağlı)</span></label>
                        <select class="nv-input" name="sid" id="stripBranch">
                            <option value="">Fark etmez</option>
                            {{ range index2, Sube := AllSubeler }}
                                <option value="{{ Sube.Sid }}">{{ Sube.Name }}</option>
                            {{ end }}
                        </select>
                    </div>
                    <div class="hizli-randevu-strip__kvkk">
                        <label for="stripKVKK" class="nv-check">
                            <input type="checkbox" id="stripKVKK" aria-describedby="stripKVKKError">
                            <span><a href="/kurumsal/kvkk" target="_blank" rel="noopener">KVKK aydınlatma metnini</a> okudum ve onaylıyorum. <span class="nv-label__req">(zorunlu)</span></span>
                        </label>
                        <p class="nv-error" id="stripKVKKError"></p>
                    </div>
                    {{ if Options.Options.RecaptchaSiteKey != "" }}
                    <div class="hizli-randevu-strip__captcha">
                        <div id="stripRecaptchaWidget"></div>
                        <input type="hidden" id="stripRecaptchaToken">
                        <p class="nv-error" id="stripCaptchaError"></p>
                    </div>
                    {{ end }}
                    <div class="hizli-randevu-strip__actions">
                        <button type="submit" class="nv-btn nv-btn--primary hizli-randevu-strip__submit">Talebi Gönder</button>
                        <a href="/randevu">Bölüm ya da doktor seçmek için ayrıntılı form</a>
                    </div>
                </form>
                <div class="hizli-randevu-strip__feedback" id="stripFeedback" role="status" aria-live="polite"></div>
            </div>
            <div class="hizli-randevu-strip__cards">
                <a href="/kurumsal/anlasmali-kurumlar" class="hizli-randevu-strip__card">
                    <div class="hizli-randevu-strip__card-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <div class="hizli-randevu-strip__card-content">
                        <span class="hizli-randevu-strip__card-label">Kurumsal</span>
                        <span class="hizli-randevu-strip__card-value">Anlaşmalı Kurumlar</span>
                    </div>
                    <i class="fas fa-chevron-right hizli-randevu-strip__card-arrow"></i>
                </a>
                <a href="/ulasim" class="hizli-randevu-strip__card">
                    <div class="hizli-randevu-strip__card-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="hizli-randevu-strip__card-content">
                        <span class="hizli-randevu-strip__card-label">Bize Ulaşın</span>
                        <span class="hizli-randevu-strip__card-value">Ulaşım</span>
                    </div>
                    <i class="fas fa-chevron-right hizli-randevu-strip__card-arrow"></i>
                </a>
            </div>
        </div>
    </div>
</section>
{{ if Options.Options.RecaptchaSiteKey != "" }}
<script>
/* Bu form, banner altinda dogrudan gorunur - hizli randevu panelinin
 * aksine kullanici etkilesimine kadar ertelenemez (bkz. fast-randevu.jet
 * / dd38219: recaptcha/api.js artik panel acilana kadar yuklenmiyor).
 * Bu strip formu o script'in yan etkisine (grecaptcha global'inin
 * zaten var olmasi) sessizce bagimliydi; panel hic acilmazsa grecaptcha
 * hicbir zaman tanimlanmiyor ve asagidaki polling sonsuza kadar bekliyordu.
 * window.fastRecaptchaScriptInjected bayragini fast-randevu.jet ile
 * paylasarak script'in iki kez yuklenmesini onluyoruz. */
(function(){
    if (window.fastRecaptchaScriptInjected) return;
    var s = document.createElement('script');
    s.src = 'https://www.google.com/recaptcha/api.js';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
    window.fastRecaptchaScriptInjected = true;
})();
</script>
{{ end }}
<script>
var stripRecaptchaToken = '';
var stripRecaptchaKey = '{{ Options.Options.RecaptchaSiteKey }}';
window.onStripRecaptchaVerified = function(token) {
    stripRecaptchaToken = token;
};
window.onStripRecaptchaExpired = function() {
    stripRecaptchaToken = '';
};
function renderStripRecaptcha() {
    var widget = document.getElementById('stripRecaptchaWidget');
    if (!widget || widget.childElementCount > 0) return;
    try {
        grecaptcha.render('stripRecaptchaWidget', {
            sitekey: '{{ Options.Options.RecaptchaSiteKey }}',
            callback: 'onStripRecaptchaVerified',
            'expired-callback': 'onStripRecaptchaExpired'
        });
    } catch(e) {}
}
document.addEventListener('DOMContentLoaded', function() {
    var checkInterval = setInterval(function() {
        if (typeof grecaptcha !== 'undefined' && typeof grecaptcha.render !== 'undefined') {
            clearInterval(checkInterval);
            setTimeout(renderStripRecaptcha, 300);
        }
    }, 200);

    var form = document.getElementById('stripRandevuForm');
    if (!form || !window.NvTalep) return;
    var T = window.NvTalep;
    var sending = false;
    var hasCaptcha = !!document.getElementById('stripRecaptchaWidget') && stripRecaptchaKey !== '';
    function byId(id) { return document.getElementById(id); }
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (sending) return;
        var fields = [['stripFirstName', 'Adınızı yazın.'], ['stripLastName', 'Soyadınızı yazın.']];
        var firstInvalid = null;
        function fail(input, errId, msg) { T.fieldError(input, byId(errId), msg); if (!firstInvalid) firstInvalid = input; }
        ['stripFirstName', 'stripLastName', 'stripPhone', 'stripKVKK'].forEach(function(id) { T.fieldError(byId(id), byId(id + 'Error'), ''); });
        if (byId('stripCaptchaError')) byId('stripCaptchaError').textContent = '';
        T.render(byId('stripFeedback'), null);
        fields.forEach(function(f) { if (!byId(f[0]).value.trim()) fail(byId(f[0]), f[0] + 'Error', f[1]); });
        var phoneInput = byId('stripPhone');
        var phone = T.normalizePhone(phoneInput.value);
        if (!phoneInput.value.trim()) fail(phoneInput, 'stripPhoneError', 'Telefon numaranızı yazın.');
        else if (!T.isValidPhone(phone)) fail(phoneInput, 'stripPhoneError', 'Telefon numarası eksik görünüyor. Örnek: 0532 123 45 67.');
        if (!byId('stripKVKK').checked) fail(byId('stripKVKK'), 'stripKVKKError', 'Aydınlatma metnini okuduğunuzu onaylayın.');
        if (hasCaptcha && !stripRecaptchaToken) {
            byId('stripCaptchaError').textContent = typeof grecaptcha === 'undefined'
                ? 'Güvenlik doğrulaması yükleniyor. Birkaç saniye bekleyin.'
                : '“Ben robot değilim” kutusunu işaretleyin.';
            if (!firstInvalid) firstInvalid = byId('stripRecaptchaWidget');
        }
        if (firstInvalid) { if (firstInvalid.tagName !== 'DIV') firstInvalid.focus(); return; }

        var btn = form.querySelector('.hizli-randevu-strip__submit');
        sending = true;
        btn.disabled = true;
        btn.textContent = 'Gönderiliyor…';
        T.post({
            patient_first_name: byId('stripFirstName').value.trim(),
            patient_last_name: byId('stripLastName').value.trim(),
            patient_phone: phone,
            sid: byId('stripBranch').value,
            message: '',
            recaptcha_token: stripRecaptchaToken,
            website: (form.querySelector('input[name="website"]') || {}).value || ''
        }).then(function(result) {
            sending = false;
            btn.disabled = false;
            btn.textContent = 'Talebi Gönder';
            T.render(byId('stripFeedback'), result);
            if (result.ok) form.reset();
            if (result.captcha && byId('stripCaptchaError')) byId('stripCaptchaError').textContent = result.text;
            // Jeton tek kullanımlık: her yanıttan sonra sıfırla.
            stripRecaptchaToken = '';
            if (hasCaptcha && typeof grecaptcha !== 'undefined') { try { grecaptcha.reset(); } catch (err) {} }
        });
    });
});
</script>
