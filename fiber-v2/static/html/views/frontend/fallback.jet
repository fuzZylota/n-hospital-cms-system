<link rel="stylesheet" href="{{ PathOnStart }}css/frontend/fallback.css">

<section class="fallback">
    <div class="fallback__bg-shape"></div>
    <div class="fallback__content">
        <div class="fallback__logo">
            {{ if Options.Medias[1].FilePath != "" }}
                <img src="{{ PathOnStart }}{{ Options.Medias[1].FilePath }}" alt="{{ Options.Medias[1].AltText != "" ? Options.Medias[1].AltText : "N-Hospital Logosu" }}" title="{{ Options.Medias[1].Title != "" ? Options.Medias[1].Title : "N-Hospital" }}" onerror="this.src='{{ PathOnStart }}files/defaults/logo/n-hospital-logo-white.png'; this.onerror=function(){this.src='{{ PathOnStart }}files/defaults/logo/n-hospital-logo.png'; this.onerror=function(){this.src='{{ PathOnStart }}files/defaults/logo/n-hospital-logo-white.png';};};">
            {{ else }}
                {{ if Options.Medias[0].FilePath != "" }}
                    <img src="{{ PathOnStart }}{{ Options.Medias[0].FilePath }}" alt="{{ Options.Medias[0].AltText != "" ? Options.Medias[0].AltText : "N-Hospital Logosu" }}" title="{{ Options.Medias[0].Title != "" ? Options.Medias[0].Title : "N-Hospital" }}" onerror="this.src='{{ PathOnStart }}files/defaults/logo/n-hospital-logo-white.png'; this.onerror=function(){this.src='{{ PathOnStart }}files/defaults/logo/n-hospital-logo.png'; this.onerror=function(){this.src='{{ PathOnStart }}files/defaults/logo/n-hospital-logo-white.png';};};">
                {{ else }}
                    <img src="{{ PathOnStart }}files/defaults/logo/n-hospital-logo-white.png" alt="N-Hospital Logosu" title="N-Hospital" onerror="this.src='{{ PathOnStart }}files/defaults/logo/n-hospital-logo.png'; this.onerror=function(){this.src='{{ PathOnStart }}files/defaults/logo/n-hospital-logo-white.png';};">
                {{ end }}
            {{ end }}
        </div>
        <p class="fallback__eyebrow">Üzgünüz, bir şeyler ters gitti</p>
        <h1 class="fallback__title">Aradığınız sayfayı bulamadık</h1>
        <p class="fallback__text">
            Bağlantı değişmiş olabilir ya da kısa süreli bir kesinti yaşıyor olabiliriz.
            Ana sayfaya dönebilir ya da bir önceki sayfaya gidebilirsiniz.
        </p>
        <div class="fallback__actions">
            <a class="btn btn-primary" href="/">Ana sayfaya dön</a>
            <button class="btn btn-secondary" type="button" onclick="window.history.back()">Önceki sayfa</button>
        </div>
    </div>
</section>
