{{ include "../../components/home/popup" }}

{{ include "../../components/home/banner" }}

{{ range index1, Content := AllHomepageContents }}
    {{ if Content.ContentType == "generic" && Content.LaterThanWhichContent == 1 }}
        <style>
            {{ Content.ContentCss | raw }}
        </style>

        {{ Content.ContentHtml | raw }}

        <script>
            {{ Content.ContentJavascript | raw }}
        </script>
    {{ end }}
{{ end }}

