<link rel="stylesheet" href="{{ PathOnStart }}css/panel/tibbi-birim-duzenle.css">

<div class="page-container">
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="icon-edit"></i>
                    Tıbbi Birimi Düzenle
                </h1>
                <p class="page-subtitle">Birim bilgilerini ve kapak görselini güncelleyin</p>
            </div>
            <div class="page-actions">
                <a href="/panel/tibbi-birimler" class="btn btn-secondary">
                    <i class="icon-arrow-left"></i>
                    Listeye Dön
                </a>
                <a href="/panel/tibbi-birimler/{{ TibbiBirim.Tbid }}" class="btn btn-primary">
                    <i class="icon-eye"></i>
                    Görüntüle
                </a>
            </div>
        </div>
    </div>

    <div class="page-content forms-container">
        <!-- General Information Form -->
        <form id="generalForm" class="form-section" novalidate>
            <div class="section-header">
                <h2 class="section-title">
                    <i class="icon-info-circle"></i>
                    Temel Bilgiler
                </h2>
                <p class="section-description">Birim adı, URL adı, açıklama ve aktiflik durumunu güncelleyin</p>
            </div>
            <div class="section-content">
                <!-- Hidden old values for change detection -->
                <input type="hidden" name="tbid" value="{{ TibbiBirim.Tbid }}">
                <input type="hidden" name="old_name" value="{{ TibbiBirim.Name }}">
                <input type="hidden" name="old_url_name" value="{{ TibbiBirim.UrlName }}">
                <input type="hidden" name="old_description" value="{{ TibbiBirim.Description }}">
                <input type="hidden" name="old_is_active" value="{{ TibbiBirim.IsActive }}">

                <div class="form-row">
                    <div class="form-group">
                        <label for="name" class="form-label required">Birim Adı</label>
                        <input type="text" id="name" name="name" class="form-input" value="{{ TibbiBirim.Name }}" required>
                        <div class="form-help">Görünen birim adı</div>
                    </div>
                    <div class="form-group">
                        <label for="url_name" class="form-label">URL Adı</label>
                        <input type="text" id="url_name" name="url_name" class="form-input" value="{{ TibbiBirim.UrlName }}">
                        <div class="form-help">Boş bırakılırsa otomatik oluşturulur</div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="description" class="form-label">Açıklama</label>
                    <textarea id="description" name="description" class="form-textarea" rows="3">{{ TibbiBirim.Description }}</textarea>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="is_active" class="form-label">Aktif Durumu</label>
                        <div class="toggle-switch">
                            <input type="checkbox" id="is_active" name="is_active" {{ TibbiBirim.IsActive ? "checked" : "" }}>
                            <label for="is_active" class="toggle-label">
                                <span class="toggle-slider"></span>
                                <span class="toggle-text">Aktif</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="generalSubmitBtn">
                    <i class="icon-check"></i>
                    <span class="btn-text">Kaydet</span>
                    <div class="btn-loader" style="display: none;"><div class="spinner"></div></div>
                </button>
            </div>
        </form>

        <!-- Picture Update Form -->
        <form id="pictureForm" class="form-section" novalidate enctype="multipart/form-data">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="icon-image"></i>
                    Kapak Görseli
                </h2>
                <p class="section-description">Kapak görselini güncelleyin veya kaldırın</p>
            </div>
            <div class="section-content">
                <!-- Hidden old values for change detection -->
                <input type="hidden" name="old_cover_alt_text" id="old_cover_alt_text" value="{{ TibbiBirim.CoverAltText }}">
                <input type="hidden" name="old_cover_title" id="old_cover_title" value="{{ TibbiBirim.CoverTitle }}">

                <div class="current-media-section">
                    <div class="media-grid">
                        <div class="media-item">
                            <div class="media-header">
                                <h3 class="media-title">Mevcut Kapak Görseli</h3>
                                {{ if TibbiBirim.CoverPath }}
                                <button type="button" class="btn-delete-media" id="deletePictureBtn" data-tbid="{{ TibbiBirim.Tbid }}" title="Görseli Sil">
                                    <i class="icon-trash"></i>
                                </button>
                                {{ end }}
                            </div>
                            <div class="media-preview">
                                {{ if TibbiBirim.CoverPath }}
                                    <img class="preview-image" src="/{{ TibbiBirim.CoverPath }}" alt="{{ TibbiBirim.CoverAltText }}" title="{{ TibbiBirim.CoverTitle }}">
                                    <div class="media-info">
                                        <div class="info-item"><strong>Alt Metin:</strong> {{ TibbiBirim.CoverAltText }}</div>
                                        <div class="info-item"><strong>Başlık:</strong> {{ TibbiBirim.CoverTitle }}</div>
                                    </div>
                                {{ else }}
                                    <div class="no-media">
                                        <i class="icon-image"></i>
                                        <span>Kapak görseli bulunmuyor</span>
                                    </div>
                                {{ end }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="media-upload-section">
                    <div class="form-group-section">
                        <div class="form-group">
                            <label for="cover_mid" class="form-label">Yeni Kapak Fotoğrafı</label>
                            <div class="file-upload-area" data-target="cover_mid">
                                <div class="file-upload-content">
                                    <i class="icon-upload"></i>
                                    <p class="file-upload-text">Görseli sürükleyin veya <span class="file-browse">göz atın</span></p>
                                    <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                                </div>
                                <input type="file" id="cover_mid" name="cover_mid" class="file-input" accept="image/*">
                                <div class="file-preview" style="display: none;">
                                    <img class="preview-image" src="" alt="Preview">
                                    <button type="button" class="file-remove"><i class="icon-x"></i></button>
                                </div>
                            </div>
                        </div>

                        <div class="file-meta-inputs">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="cover_alt_text" class="form-label">Görsel Alt Metni</label>
                                    <input type="text" id="cover_alt_text" name="cover_alt_text" class="form-input" value="{{ TibbiBirim.CoverAltText }}">
                                </div>
                                <div class="form-group">
                                    <label for="cover_title" class="form-label">Görsel Başlığı</label>
                                    <input type="text" id="cover_title" name="cover_title" class="form-input" value="{{ TibbiBirim.CoverTitle }}">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="pictureSubmitBtn">
                    <i class="icon-check"></i>
                    <span class="btn-text">Görseli Güncelle</span>
                    <div class="btn-loader" style="display: none;"><div class="spinner"></div></div>
                </button>
            </div>
        </form>

        <!-- Video Update Form -->
        <form id="videoForm" class="form-section" novalidate enctype="multipart/form-data">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="icon-play-circle"></i>
                    Tanıtım Videosu
                </h2>
                <p class="section-description">Tanıtım videosunu güncelleyin veya kaldırın</p>
            </div>
            <div class="section-content">
                <div class="current-media-section">
                    <div class="media-grid">
                        <div class="media-item">
                            <div class="media-header">
                                <h3 class="media-title">Mevcut Tanıtım Videosu</h3>
                                {{ if TibbiBirim.VideoPath }}
                                <button type="button" class="btn-delete-media" id="deleteVideoBtn" data-tbid="{{ TibbiBirim.Tbid }}" title="Videoyu Sil">
                                    <i class="icon-trash"></i>
                                </button>
                                {{ end }}
                            </div>
                            <div class="media-preview">
                                {{ if TibbiBirim.VideoPath }}
                                    <video class="preview-video" controls>
                                        <source src="/{{ TibbiBirim.VideoPath }}" type="video/mp4">
                                        Tarayıcınız video oynatmayı desteklemiyor.
                                    </video>
                                    <div class="media-info">
                                        <div class="info-item"><strong>Dosya:</strong> {{ TibbiBirim.VideoPath }}</div>
                                    </div>
                                {{ else }}
                                    <div class="no-media">
                                        <i class="icon-play-circle"></i>
                                        <span>Tanıtım videosu bulunmuyor</span>
                                    </div>
                                {{ end }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="media-upload-section">
                    <div class="form-group-section">
                        <div class="form-group">
                            <label for="video_mid" class="form-label">Yeni Tanıtım Videosu</label>
                            <div class="file-upload-area" data-target="video_mid">
                                <div class="file-upload-content">
                                    <i class="icon-upload"></i>
                                    <p class="file-upload-text">Videoyu sürükleyin veya <span class="file-browse">göz atın</span></p>
                                    <p class="file-upload-hint">MP4, WEBM - Max 50MB</p>
                                </div>
                                <input type="file" id="video_mid" name="video_mid" class="file-input" accept="video/*">
                                <div class="file-preview" style="display: none;">
                                    <video class="preview-video" controls>
                                        <source src="" type="video/mp4">
                                    </video>
                                    <button type="button" class="file-remove"><i class="icon-x"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="videoSubmitBtn">
                    <i class="icon-check"></i>
                    <span class="btn-text">Videoyu Güncelle</span>
                    <div class="btn-loader" style="display: none;"><div class="spinner"></div></div>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Picture Modal -->
<div id="deletePictureModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon"><i class="icon-trash"></i></div>
        <h3 class="modal-title">Görseli Sil</h3>
        <p class="modal-message">Bu görseli silmek istediğinize emin misiniz?</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeModal('deletePictureModal')">
                İptal
            </button>
            <button type="button" class="btn btn-danger" id="confirmDeletePictureBtn">
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;"><div class="spinner"></div></div>
            </button>
        </div>
    </div>
</div>

<!-- Delete Video Modal -->
<div id="deleteVideoModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon"><i class="icon-trash"></i></div>
        <h3 class="modal-title">Videoyu Sil</h3>
        <p class="modal-message">Bu videoyu silmek istediğinize emin misiniz?</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeModal('deleteVideoModal')">
                İptal
            </button>
            <button type="button" class="btn btn-danger" id="confirmDeleteVideoBtn">
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;"><div class="spinner"></div></div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon"><i class="icon-check-circle"></i></div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">İşlem başarıyla tamamlandı.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon"><i class="icon-alert-circle"></i></div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script>
    window.pageData = { tbid: "{{ TibbiBirim.Tbid }}" };
    </script>
<script src="{{ PathOnStart }}js/panel/tibbi-birim-duzenle.js"></script>
