<link rel="stylesheet" href="{{ PathOnStart }}css/panel/custom-content.css">
<!-- CodeMirror CSS for syntax highlighting -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/theme/monokai.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/ozel-icerikler" class="breadcrumb-link">
                        <i class="fas fa-file-code"></i>
                        Özel İçerikler
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">{{ CustomContent.Name }}</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">{{ CustomContent.Name }}</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-calendar"></i>
                                {{ mthr(CustomContent.CreatedAt, User.Timezone) }}
                            </span>
                            <span class="meta-item">
                                <i class="fas fa-clock"></i>
                                Son güncelleme: {{ mthr(CustomContent.UpdatedAt, User.Timezone) }}
                            </span>
                        </div>
                    </div>
                </h1>
                {{if CustomContent.Description}}
                <p class="page-subtitle">{{ CustomContent.Description }}</p>
                {{end}}
            </div>
            <div class="page-actions">
                <div class="status-indicator">
                    {{if CustomContent.IsActive}}
                    <span class="status-badge active">
                        <i class="fas fa-check-circle"></i>
                        Aktif
                    </span>
                    {{else}}
                    <span class="status-badge inactive">
                        <i class="fas fa-pause-circle"></i>
                        Pasif
                    </span>
                    {{end}}
                </div>
                <div class="action-buttons">
                    <a href="/panel/ozel-icerikler/{{ CustomContent.Ccid }}/duzenle" class="btn btn-primary">
                        <i class="fas fa-edit"></i>
                        Düzenle
                    </a>
                    <button class="btn btn-danger" id="deleteCustomContentBtn" data-id="{{ CustomContent.Ccid }}" data-name="{{ CustomContent.Name }}">
                        <i class="fas fa-trash"></i>
                        <span class="btn-text">Sil</span>
                        <div class="btn-loader" style="display: none;">
                            <div class="spinner"></div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Sections -->
    <div class="content-grid">
        <!-- Basic Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <h3 class="card-title">Temel Bilgiler</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item">
                        <label class="info-label">İçerik Adı</label>
                        <div class="info-value">{{ CustomContent.Name }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">URL Adı</label>
                        <div class="info-value">{{ CustomContent.UrlName }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">İçerik Tipi</label>
                        <div class="info-value">
                            <span class="type-badge {{ CustomContent.ContentType }}">
                                <i class="fas fa-{{ if CustomContent.ContentType == "history" }}history{{ else if CustomContent.ContentType == "about-us" }}info-circle{{ else if CustomContent.ContentType == "privacy-policy" }}shield-alt{{ else if CustomContent.ContentType == "mission-vision" }}target{{ else if CustomContent.ContentType == "main-page" }}home{{ else if CustomContent.ContentType == "hr" }}users{{ else if CustomContent.ContentType == "popup" }}window-restore{{ else }}file{{ end }}"></i>
                                {{ if CustomContent.ContentType == "history" }}Tarihçe{{ else if CustomContent.ContentType == "about-us" }}Hakkımızda{{ else if CustomContent.ContentType == "privacy-policy" }}Gizlilik{{ else if CustomContent.ContentType == "mission-vision" }}Misyon-Vizyon{{ else if CustomContent.ContentType == "main-page" }}Ana Sayfa{{ else if CustomContent.ContentType == "hr" }}İnsan Kaynakları{{ else if CustomContent.ContentType == "popup" }}Popup{{ else }}{{ CustomContent.ContentType }}{{ end }}
                            </span>
                        </div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Sıralama</label>
                        <div class="info-value">{{ CustomContent.SortOrder }}</div>
                    </div>
                    {{if CustomContent.Route}}
                    <div class="info-item">
                        <label class="info-label">Route</label>
                        <div class="info-value route-text">{{ CustomContent.Route }}</div>
                    </div>
                    {{end}}
                    {{if CustomContent.Description}}
                    <div class="info-item full-width">
                        <label class="info-label">Açıklama</label>
                        <div class="info-value">{{ CustomContent.Description }}</div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>

        <!-- HTML Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fab fa-html5"></i>
                </div>
                <h3 class="card-title">HTML İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="code-section">
                    <div class="code-header">
                        <span class="code-title">HTML Kodu</span>
                        <div class="code-actions">
                            <button class="btn-icon copy-btn" onclick="copyToClipboard('htmlContent')" title="Kopyala">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn-icon expand-btn" onclick="toggleCodeExpansion('htmlContent')" title="Genişlet/Daralt">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="code-container">
                        <textarea id="htmlContent" class="code-editor" readonly>{{ if CustomContent.ContentHtml }}{{ CustomContent.ContentHtml }}{{ else }}<!-- HTML kodu bulunmuyor -->{{ end }}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- CSS Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fab fa-css3-alt"></i>
                </div>
                <h3 class="card-title">CSS İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="code-section">
                    <div class="code-header">
                        <span class="code-title">CSS Kodu</span>
                        <div class="code-actions">
                            <button class="btn-icon copy-btn" onclick="copyToClipboard('cssContent')" title="Kopyala">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn-icon expand-btn" onclick="toggleCodeExpansion('cssContent')" title="Genişlet/Daralt">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="code-container">
                        <textarea id="cssContent" class="code-editor" readonly>{{ if CustomContent.ContentCss }}{{ CustomContent.ContentCss }}{{ else }}/* CSS kodu bulunmuyor */{{ end }}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- JavaScript Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fab fa-js-square"></i>
                </div>
                <h3 class="card-title">JavaScript İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="code-section">
                    <div class="code-header">
                        <span class="code-title">JavaScript Kodu</span>
                        <div class="code-actions">
                            <button class="btn-icon copy-btn" onclick="copyToClipboard('jsContent')" title="Kopyala">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn-icon expand-btn" onclick="toggleCodeExpansion('jsContent')" title="Genişlet/Daralt">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="code-container">
                        <textarea id="jsContent" class="code-editor" readonly>{{ if CustomContent.ContentJavascript }}{{ CustomContent.ContentJavascript }}{{ else }}// JavaScript kodu bulunmuyor{{ end }}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Preview Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-eye"></i>
                </div>
                <h3 class="card-title">Önizleme</h3>
            </div>
            <div class="card-content">
                <div class="preview-container">
                    <div class="preview-header">
                        <span class="preview-title">HTML Önizleme</span>
                        <div class="preview-actions">
                            <button class="btn btn-sm btn-secondary" onclick="refreshPreview()">
                                <i class="fas fa-sync-alt"></i>
                                Yenile
                            </button>
                            <button class="btn btn-sm btn-secondary" onclick="openPreviewInNewTab()">
                                <i class="fas fa-external-link-alt"></i>
                                Yeni Sekmede Aç
                            </button>
                        </div>
                    </div>
                    <div class="preview-frame">
                        <iframe id="previewFrame" src="about:blank" sandbox="allow-scripts allow-same-origin"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Özel İçeriği Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı özel içeriği silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz ve tüm ilişkili veriler silinecektir.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="icon-trash-2"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="icon-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="icon-alert-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<script>
    // Pass data to JavaScript
    window.customContentData = {
        id: parseInt("{{ CustomContent.Ccid }}"),
        name: "{{ CustomContent.Name }}",
        htmlContent: `{{ CustomContent.ContentHtml }}`,
        cssContent: `{{ CustomContent.ContentCss }}`,
        jsContent: `{{ CustomContent.ContentJavascript }}`
    };
</script>
<!-- CodeMirror JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/css/css.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.js"></script>
<script src="{{ PathOnStart }}js/panel/custom-content.js"></script>