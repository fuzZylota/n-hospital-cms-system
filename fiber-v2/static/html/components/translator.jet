<div class="nv-lang">
    <button type="button" class="nv-lang-btn" aria-expanded="false" aria-label="Dil seçimi">
        <span class="nv-lang-label" aria-hidden="true"><img src="{{ PathOnStart }}assets/flags/tr.svg" alt="" class="nv-lang-flag" data-flag></span>
        <i class="fas fa-chevron-down"></i>
    </button>

    <div class="nv-lang-menu" hidden>
        <button type="button" class="nv-lang-item" data-lang="tr" data-label="{{ PathOnStart }}assets/flags/tr.svg" aria-label="Türkçe"><img src="{{ PathOnStart }}assets/flags/tr.svg" alt="Türkçe" class="nv-lang-flag"></button>
        <button type="button" class="nv-lang-item" data-lang="en" data-label="{{ PathOnStart }}assets/flags/gb.svg" aria-label="English"><img src="{{ PathOnStart }}assets/flags/gb.svg" alt="English" class="nv-lang-flag"></button>
        <button type="button" class="nv-lang-item" data-lang="ru" data-label="{{ PathOnStart }}assets/flags/ru.svg" aria-label="Русский"><img src="{{ PathOnStart }}assets/flags/ru.svg" alt="Русский" class="nv-lang-flag"></button>
        <button type="button" class="nv-lang-item" data-lang="az" data-label="{{ PathOnStart }}assets/flags/az.svg" aria-label="Azərbaycan"><img src="{{ PathOnStart }}assets/flags/az.svg" alt="Azərbaycan" class="nv-lang-flag"></button>
        <button type="button" class="nv-lang-item" data-lang="de" data-label="{{ PathOnStart }}assets/flags/de.svg" aria-label="Deutsch"><img src="{{ PathOnStart }}assets/flags/de.svg" alt="Deutsch" class="nv-lang-flag"></button>
    </div>
</div>

<div id="google_translate_element" style="display:none"></div>

<script>
function googleTranslateElementInit() {
    new google.translate.TranslateElement({ pageLanguage: 'tr' }, 'google_translate_element');
}

function nvClearGoogtransCookies() {
    var hostname = window.location.hostname;
    var cookies = [
        "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/",
        "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=" + hostname
    ];

    if (hostname.indexOf('.') !== -1) {
        cookies.push("googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=." + hostname);
    }

    cookies.forEach(function(c) {
        document.cookie = c;
    });
}

function nvSetLang(lang) {
    var hostname = window.location.hostname;
    nvClearGoogtransCookies();

    document.cookie = "googtrans=/tr/" + lang + "; path=/";
    document.cookie = "googtrans=/tr/" + lang + "; path=/; domain=" + hostname;

    if (hostname.indexOf('.') !== -1) {
        document.cookie = "googtrans=/tr/" + lang + "; path=/; domain=." + hostname;
    }

    window.location.reload();
}

(function() {
    function getCurrentLanguage() {
        var cookies = document.cookie.split(';');
        for (var i = 0; i < cookies.length; i++) {
            var parts = cookies[i].trim().split('=');
            if (parts[0] === 'googtrans' && parts[1]) {
                var m = parts[1].match(/\/tr\/([a-z]{2})/);
                if (m) return m[1];
            }
        }
        return 'tr';
    }

    function langToFlagFile(lang) {
        var map = {
            tr: 'tr.svg',
            en: 'gb.svg',
            ru: 'ru.svg',
            az: 'az.svg',
            de: 'de.svg'
        };
        return map[lang] || 'tr.svg';
    }

    function closeAllMenus() {
        document.querySelectorAll('.nv-lang-menu').forEach(function(menu) {
            menu.classList.remove('is-open');
            menu.hidden = true;
            menu.style.top = '-9999px';
            menu.style.left = '-9999px';
        });

        document.querySelectorAll('.nv-lang-btn').forEach(function(btn) {
            btn.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
        });
    }

    function moveMenuToBody(menu) {
        if (!menu) return;
        if (menu.parentElement !== document.body) {
            document.body.appendChild(menu);
        }
    }

    function placeMenu(btn, menu) {
        var rect = btn.getBoundingClientRect();
        var minWidth = Math.max(rect.width, 66);
        var top = rect.bottom + 8;
        var left = rect.right - minWidth;

        if (left < 8) left = 8;

        menu.style.position = 'fixed';
        menu.style.top = top + 'px';
        menu.style.left = left + 'px';
        menu.style.minWidth = minWidth + 'px';
        menu.style.zIndex = '2147483647';
    }

    function syncLabels() {
        var file = langToFlagFile(getCurrentLanguage());
        document.querySelectorAll('.nv-lang-label img.nv-lang-flag').forEach(function(img) {
            var base = img.src.slice(0, img.src.lastIndexOf('/') + 1);
            img.src = base + file;
        });
    }

    function initLangs() {
        document.querySelectorAll('.nv-lang').forEach(function(wrap) {
            if (wrap.dataset.nvInit === '1') return;
            wrap.dataset.nvInit = '1';

            var btn = wrap.querySelector('.nv-lang-btn');
            var menu = wrap.querySelector('.nv-lang-menu');

            if (!btn || !menu) return;

            wrap._nvMenu = menu;
            moveMenuToBody(menu);
        });

        syncLabels();
    }

    document.addEventListener('click', function(e) {
        var item = e.target.closest('.nv-lang-item');
        if (item) {
            e.preventDefault();
            e.stopPropagation();
            nvSetLang(item.getAttribute('data-lang'));
            return;
        }

        var btn = e.target.closest('.nv-lang-btn');
        if (btn) {
            e.preventDefault();
            e.stopPropagation();

            var wrap = btn.closest('.nv-lang');
            if (!wrap) return;

            var menu = wrap._nvMenu || wrap.querySelector('.nv-lang-menu');
            if (!menu) return;

            moveMenuToBody(menu);

            var willOpen = !menu.classList.contains('is-open');
            closeAllMenus();

            if (willOpen) {
                placeMenu(btn, menu);
                menu.hidden = false;
                menu.classList.add('is-open');
                btn.classList.add('is-open');
                btn.setAttribute('aria-expanded', 'true');
            }
            return;
        }

        if (!e.target.closest('.nv-lang-menu')) {
            closeAllMenus();
        }
    }, true);

    window.addEventListener('resize', closeAllMenus);
    window.addEventListener('scroll', closeAllMenus, true);

    document.addEventListener('DOMContentLoaded', initLangs);
    window.addEventListener('load', initLangs);
    setTimeout(initLangs, 400);
    setTimeout(initLangs, 1200);
})();
</script>

<script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

<style>
.nv-lang {
    position: relative;
    display: inline-flex;
    align-items: center;
    z-index: 20;
}

.nv-lang-btn {
    height: 34px;
    padding: 0 12px;
    border: 1px solid rgba(255,255,255,.42);
    border-radius: 999px;
    background: #0b2f63;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    box-shadow: none;
    transition: border-color .2s ease, transform .2s ease;
}

.nv-lang-btn:hover {
    border-color: rgba(255,255,255,.75);
}

.nv-lang-btn i {
    font-size: 12px;
    transition: transform .2s ease;
    pointer-events: none;
}

.nv-lang-btn.is-open i {
    transform: rotate(180deg);
}

.nv-lang-label {
    display: inline-flex;
    align-items: center;
    min-width: 18px;
}

.nv-lang-flag {
    display: block;
    width: 20px;
    height: 14px;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .25);
}

.nv-lang-item .nv-lang-flag {
    margin: 0 auto;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, .12);
}

.nv-lang-menu {
    position: fixed;
    top: -9999px;
    left: -9999px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, .18);
    padding: 6px 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity .18s ease, visibility .18s ease, transform .18s ease;
    overflow: hidden;
}

.nv-lang-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
}

.nv-lang-item {
    width: 100%;
    border: 0;
    background: #fff;
    color: #1f2937;
    padding: 10px 14px;
    text-align: center;
    cursor: pointer;
    font: inherit;
    font-size: 19px;
    font-weight: 600;
    line-height: 1;
    display: block;
}

.nv-lang-item:hover {
    background: #f8fafc;
}

.topbar-one,
.topbar-one__inner,
.topbar-one__right,
.header-four,
.main-header,
.main-header__inner,
.sticky-header,
.sticky-header--cloned {
    overflow: visible !important;
}

@media (max-width: 991px) {
    .nv-lang-btn {
        height: 38px;
        padding: 0 13px;
        font-size: 16px;
    }

    .nv-lang-item {
        padding: 12px 16px;
    }
}
</style>
