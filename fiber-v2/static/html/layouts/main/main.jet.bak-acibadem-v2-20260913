<script>
(function () {
    var STORAGE_KEY = 'nv_cookie_consent_v2';
    var GA_ID = 'G-8VZ7DM0ZTS';

    function getBanner() { return document.getElementById('nvCookieBanner'); }
    function getModal() { return document.getElementById('nvCookieModal'); }
    function getBackdrop() { return document.getElementById('nvCookieBackdrop'); }
    function getToggle() { return document.getElementById('nvAnalyticsToggle'); }
    function getPrefsBtn() { return document.getElementById('nvCookiePrefsBtn'); }

    function safeParse(val) {
        try { return JSON.parse(val); } catch (e) { return null; }
    }

    function readConsent() {
        try {
            return safeParse(localStorage.getItem(STORAGE_KEY));
        } catch (e) {
            return null;
        }
    }

    function writeConsent(data) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        } catch (e) {}
    }

    function hasDecision() {
        var c = readConsent();
        return !!(c && typeof c.analytics === 'boolean');
    }

    function isPreloaderVisible() {
        var preloader = document.getElementById('preloader');
        if (!preloader) return false;
        if (preloader.classList.contains('preloader-hidden')) return false;
        return preloader.parentNode !== null;
    }

    function hideBanner() {
        var el = getBanner();
        if (el) el.style.display = 'none';
    }

    function showBanner() {
        if (isPreloaderVisible()) return;
        var el = getBanner();
        if (el) el.style.display = 'block';
    }

    function syncBannerVisibility() {
        if (hasDecision()) {
            hideBanner();
        } else if (!isPreloaderVisible()) {
            showBanner();
        }
    }

    function openModal() {
        var modal = getModal();
        var backdrop = getBackdrop();
        var toggle = getToggle();
        var consent = readConsent();

        if (toggle) {
            toggle.checked = !!(consent && consent.analytics === true);
        }

        if (modal) modal.style.display = 'block';
        if (backdrop) backdrop.style.display = 'block';
        document.documentElement.classList.add('nv-cookie-modal-open');
        document.body.classList.add('nv-cookie-modal-open');
    }

    function closeModal() {
        var modal = getModal();
        var backdrop = getBackdrop();
        if (modal) modal.style.display = 'none';
        if (backdrop) backdrop.style.display = 'none';
        document.documentElement.classList.remove('nv-cookie-modal-open');
        document.body.classList.remove('nv-cookie-modal-open');
    }

    function loadAnalytics() {
        if (window.__nvAnalyticsLoaded) return;
        window.__nvAnalyticsLoaded = true;

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){dataLayer.push(arguments);};
        gtag('js', new Date());
        gtag('config', GA_ID);

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(s);
    }

    function applyConsent() {
        var consent = readConsent();
        if (consent && consent.analytics === true) {
            loadAnalytics();
        }
    }

    window.nvOpenCookieSettings = function () {
        openModal();
    };

    window.nvCloseCookieSettings = function () {
        closeModal();
    };

    window.nvAcceptAllCookies = function () {
        writeConsent({
            essential: true,
            analytics: true,
            updatedAt: new Date().toISOString(),
            source: 'accept_all'
        });
        hideBanner();
        closeModal();
        loadAnalytics();
    };

    window.nvRejectAllCookies = function () {
        writeConsent({
            essential: true,
            analytics: false,
            updatedAt: new Date().toISOString(),
            source: 'reject_all'
        });
        hideBanner();
        closeModal();
    };

    window.nvSaveCookiePreferences = function () {
        var toggle = getToggle();
        var analytics = !!(toggle && toggle.checked);

        writeConsent({
            essential: true,
            analytics: analytics,
            updatedAt: new Date().toISOString(),
            source: 'preferences'
        });

        hideBanner();
        closeModal();

        if (analytics) {
            loadAnalytics();
        }
    };

    window.nvResetCookieConsent = function () {
        try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
        window.location.reload();
    };

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeModal();
    });

    if (hasDecision()) {
        hideBanner();
    } else {
        hideBanner();
    }

    window.addEventListener('load', function () {
        setTimeout(syncBannerVisibility, 650);
    });

    setTimeout(syncBannerVisibility, 1200);
    setTimeout(syncBannerVisibility, 2500);
    setTimeout(syncBannerVisibility, 5200);

    applyConsent();
})();
</script>





