<section class="page-header" style="margin-top: 200px;">
    <div class="container-fluid">
        <div class="page-header__inner">
            <div class="page-header__bg" style="background-image: url({{ PathOnStart }}{{ Options.Options.DefaultPageMediaPath != "" ? Options.Options.DefaultPageMediaPath : "assets/images/backgrounds/institutional-default.jpg" }});"></div><!-- /.page-header__bg -->
            <div class="container">
                <div class="page-header__content">
                    <h2 class="page-header__title">Haberler</h2>
                    <ul class="mediox-breadcrumb list-unstyled">
                        <li>
                            <span class="mediox-breadcrumb__icon"><i class="icon-home"></i></span>
                            <a href="/">Anasayfa</a>
                        </li>
                        <li><span>Haberler</span></li>
                    </ul><!-- /.mediox-breadcrumb list-unstyled -->
                </div><!-- /.page-header__content -->
            </div><!-- /.container -->
        </div><!-- /.page-header__inner -->
    </div><!-- /.container-fluid -->
</section><!-- /.page-header -->

<style>
/* Force news thumbnails to be visible and static */
.blog-card-two__image { height: 220px; overflow: hidden; }
.blog-card-two__image__item { display: block; width: 100%; height: 100%; }
.blog-card-two__image img { width: 100%; height: 100%; object-fit: cover; display: block; transform: none !important; transition: none !important; }
</style>

<section class="blog-page blog-page--grid blog-page--sidebar section-space">
    <div class="container">
        <div class="row gutter-y-60">
            <div class="col-xl-4 col-lg-5">
                <div class="sidebar">
                    <aside class="widget-area">
                        <div class="sidebar__form sidebar__single">
                            <h4 class="sidebar__title sidebar__form__title">Arama Yap</h4><!-- /.sidebar__title -->
                            <form action="/haberler" class="sidebar__search">
                                <input type="text" placeholder="Arama Yap" />
                                <button type="submit" aria-label="search submit" class="sidebar__search__icon">
                                    <i class="icon-search"></i>
                                </button>
                            </form><!-- /.sidebar__search -->
                        </div><!-- /.sidebar__form sidebar__single -->
                        <div class="sidebar__posts-wrapper sidebar__single">
                            <h4 class="sidebar__title sidebar__posts-title">Son Gönderiler</h4><!-- /.sidebar__title -->
                            <ul class="sidebar__posts list-unstyled">
                                {{ if len(Haberler) > 0 }}
                                    {{ range index, Haber := Haberler }}
                                        <li class="sidebar__posts__item">
                                            <div class="sidebar__posts__image">
                                                <img src="{{ Haber.CoverPath }}" alt="{{ Haber.CoverAltText }}">
                                            </div><!-- /.sidebar__posts__image -->
                                            <div class="sidebar__posts__content">
                                                <div class="sidebar__posts__meta"><a href="/haberler/{{ Haber.UrlName }}">
                                                        <span class="sidebar__posts__meta__icon">
                                                            <i class="icon-user"></i>
                                                        </span><!-- /.sidebar__posts__meta__icon -->
                                                        {{ Haber.Author != "" ? Haber.Author : "Yazar" }}</a></div><!-- /.sidebar__posts__date -->
                                                <h4 class="sidebar__posts__title"><a href="/haberler/{{ Haber.UrlName }}">{{ Haber.Title }}</a></h4><!-- /.sidebar__posts__title -->
                                                        passages of</a></h4><!-- /.sidebar__posts__title -->
                                            </div><!-- /.sidebar__posts__content -->
                                        </li>
                                    {{ end }}
                                {{ else }}
                                    <li><a href="#" class="mediox-btn">Son Gönderiler bulunamadı</a></li>
                                {{ end }}
                            </ul><!-- /.sidebar__posts list-unstyled -->
                        </div><!-- /.sidebar__posts-wrapper sidebar__single -->
                        <div class="sidebar__categories-wrapper sidebar__single">
                            <h4 class="sidebar__title">Kategoriler</h4><!-- /.sidebar__title -->
                            <ul class="sidebar__categories list-unstyled">
                                {{ if len(CategoryCounts) > 0 }}
                                    {{ range index, Category := CategoryCounts }}
                                        <li><a href="/haberler?category={{ Category.Name }}" class="mediox-btn">{{ Category.Name }} <span>({{ Category.Count }})</span></a></li>
                                    {{ end }}
                                {{ else }}
                                    <li><a href="#" class="mediox-btn">Kategoriler bulunamadı</a></li>
                                {{ end }}
                            </ul><!-- /.sidebar__categories list-unstyled -->
                        </div><!-- /.sidebar__categories-wrapper sidebar__single -->
                    </aside><!-- /.widget-area -->
                </div><!-- /.sidebar -->
            </div><!-- /.col-xl-4 col-lg-5 -->
            <div class="col-xl-8 col-lg-7">
                <div class="row gutter-y-30">
                    {{ range index, Haber := Haberler }}
                        <div class="col-xl-6 col-lg-12 col-md-6">
                            <div class="blog-card-two blog-card-two--home3 wow fadeInUp" data-wow-duration='1500ms' data-wow-delay='000ms'>
                                <div class="blog-card-two__image">
                                    <a href="/haberler/{{ Haber.UrlName }}" class="blog-card-two__image__item">
                                        <img src="{{ PathOnStart }}{{ Haber.CoverPath != "" ? Haber.CoverPath : "files/defaults/news/news-default.png" }}" alt="{{ Haber.CoverAltText }}">
                                        <img src="{{ PathOnStart }}{{ Haber.CoverPath != "" ? Haber.CoverPath : "files/defaults/news/news-default.png" }}" alt="cupidatat nonproident, sunt in culpa qui officia deserunt">
                                    </a><!-- /.blog-card-two__image__item -->
                                    <div class="blog-card-two__date">
                                        <span class="blog-card-two__date__day">{{ ctdfd(Haber.PublishDate) }}</span>
                                        <span class="blog-card-two__date__month">
                                            {{ OurMonth := ctdfm(Haber.PublishDate) }}

                                            {{ if OurMonth == "January" }}
                                                Ocak
                                            {{ else if OurMonth == "February" }}
                                                Şubat
                                            {{ else if OurMonth == "March" }}
                                                Mart
                                            {{ else if OurMonth == "April" }}
                                                Nisan
                                            {{ else if OurMonth == "May" }}
                                                Mayıs
                                            {{ else if OurMonth == "June" }}
                                                Haziran
                                            {{ else if OurMonth == "July" }}
                                                Temmuz
                                            {{ else if OurMonth == "August" }}
                                                Ağustos
                                            {{ else if OurMonth == "September" }}
                                                Eylül
                                            {{ else if OurMonth == "October" }}
                                                Ekim
                                            {{ else if OurMonth == "November" }}
                                                Kasım
                                            {{ else if OurMonth == "December" }}
                                                Aralık
                                            {{ end }}

                                        </span>
                                    </div><!-- /.blog-card-two__date -->
                                </div><!-- /.blog-card-two__image -->
                                <div class="blog-card-two__content">
                                    <ul class="list-unstyled blog-card-two__meta">
                                        <li>
                                            <a href="#">
                                                <span class="blog-card-two__meta__icon">
                                                    <i class="icon-user"></i>
                                                </span>
                                                by {{ Haber.Author }}
                                            </a>
                                        </li>
                                    </ul><!-- /.list-unstyled blog-card-two__meta -->
                                    <h3 class="blog-card-two__title"><a href="/haberler/{{ Haber.UrlName }}">{{ Haber.Title }}</a></h3><!-- /.blog-card-two__title -->
                                    <a href="/haberler/{{ Haber.UrlName }}" class="blog-card-two__btn">
                                        <span class="icon-double-arrow"></span>
                                    </a><!-- /.blog-card-two__btn -->
                                </div><!-- /.blog-card-two__content -->
                            </div><!-- /.blog-card-two -->
                        </div><!-- /.col-xl-6 col-lg-12 col-md-6 -->
                    {{ end }}
                    <div class="col-12">
                        {{ if len(Haberler) > Options.Options.ItemsPerPage }}
                            <ul class="post-pagination">
                                <li>
                                    <a href="#"><span class="post-pagination__icon"><i class="icon-arrow-left-2"></i></span></a>
                                </li>
                                <li>
                                    <a href="#">01</a>
                                </li>
                                <li>
                                    <a href="#">02</a>
                                </li>
                                <li>
                                    <a href="#">03</a>
                                </li>
                                <li class="active">
                                    <a href="#"><span class="post-pagination__icon"><i class="icon-arrow-right-2"></i></span></a>
                                </li>
                            </ul><!-- /.post-pagination -->
                        {{ end }}
                    </div><!-- /.col-12 -->
                </div><!-- /.row -->
            </div><!-- /.col-xl-8 col-lg-7 -->
        </div><!-- /.row -->
    </div><!-- /.container -->
</section><!-- /.blog-page blog-page--grid blog-page--sidebar section-space -->

