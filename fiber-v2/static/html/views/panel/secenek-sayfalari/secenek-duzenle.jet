<link rel="stylesheet" href="{{ PathOnStart }}css/panel/secenek-duzenle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-edit"></i>
                    Seçenek Setini Düzenle
                </h1>
                <p class="page-subtitle">{{ Option.OptionSetName }} seçenek setinin ayarlarını düzenleyin</p>
            </div>
            <div class="page-actions">
                <a href="/panel/secenekler/{{ Option.Oid }}" class="btn btn-secondary">
                    <i class="fas fa-eye"></i>
                    Görüntüle
                </a>
                <a href="/panel/secenekler" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="forms-container">
            <!-- General Settings Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-cog"></i>
                        Genel Ayarlar
                    </h2>
                    <p class="section-description">Seçenek setinin genel bilgilerini düzenleyin</p>
                </div>
                <div class="section-content">
                    <form id="generalForm" class="general-form" novalidate>
                        <!-- Hidden inputs for old values -->
                        <input type="hidden" name="old_option_set_name" value="{{ Option.OptionSetName }}">
                        <input type="hidden" name="old_option_set_description" value="{{ Option.OptionSetDescription }}">
                        <input type="hidden" name="old_option_set_is_active" value="{{ Option.OptionSetIsActive }}">
                        <input type="hidden" name="old_option_set_is_testing_now" value="{{ Option.OptionSetIsTestingNow }}">
                        <input type="hidden" name="old_site_name" value="{{ Option.SiteName }}">
                        <input type="hidden" name="old_site_description" value="{{ Option.SiteDescription }}">
                        <input type="hidden" name="old_maintenance_mode" value="{{ Option.MaintenanceMode }}">
                        <input type="hidden" name="old_smtp_host" value="{{ Option.SMTPHost }}">
                        <input type="hidden" name="old_smtp_port" value="{{ Option.SMTPPort }}">
                        <input type="hidden" name="old_smtp_username" value="{{ Option.SMTPUsername }}">
                        <input type="hidden" name="old_smtp_password" value="{{ Option.SMTPPassword }}">
                        <input type="hidden" name="old_smtp_encryption" value="{{ Option.SMTPEncryption }}">
                        <input type="hidden" name="old_facebook_url" value="{{ Option.FacebookUrl }}">
                        <input type="hidden" name="old_twitter_url" value="{{ Option.TwitterUrl }}">
                        <input type="hidden" name="old_instagram_url" value="{{ Option.InstagramUrl }}">
                        <input type="hidden" name="old_linkedin_url" value="{{ Option.LinkedinUrl }}">
                        <input type="hidden" name="old_contact_email" value="{{ Option.ContactEmail }}">
                        <input type="hidden" name="old_contact_phone" value="{{ Option.ContactPhone }}">
                        <input type="hidden" name="old_main_page_meta_title" value="{{ Option.MainPageMetaTitle }}">
                        <input type="hidden" name="old_main_page_meta_description" value="{{ Option.MainPageMetaDescription }}">
                        <input type="hidden" name="old_google_analytics" value="{{ Option.GoogleAnalytics }}">
                        <input type="hidden" name="old_primary_color" value="{{ Option.PrimaryColor }}">
                        <input type="hidden" name="old_secondary_color" value="{{ Option.SecondaryColor }}">
                        <input type="hidden" name="old_accent_color" value="{{ Option.AccentColor }}">
                        <input type="hidden" name="old_background_color" value="{{ Option.BackgroundColor }}">
                        <input type="hidden" name="old_font_color" value="{{ Option.FontColor }}">
                        <input type="hidden" name="old_font_family" value="{{ Option.FontFamily }}">
                        <input type="hidden" name="old_require_strong_password" value="{{ Option.RequireStrongPassword }}">
                        <input type="hidden" name="old_items_per_page" value="{{ Option.ItemsPerPage }}">
                        <input type="hidden" name="old_show_doctors_on_same_city" value="{{ Option.ShowDoctorsOnSameCity }}">
                        <input type="hidden" name="old_show_doctors_on_same_country" value="{{ Option.ShowDoctorsOnSameCountry }}">
                        <input type="hidden" name="old_auto_remove_partners_when_expired" value="{{ Option.AutoRemovePartnersWhenExpired }}">
                        <input type="hidden" name="old_enable_testimonials" value="{{ Option.EnableTestimonials }}">
                        <input type="hidden" name="old_enable_our_history" value="{{ Option.EnableOurHistory }}">
                        <input type="hidden" name="old_maximum_sublinks_on_a_menu_item" value="{{ Option.MaximumSublinksOnAMenuItem }}">
                        <input type="hidden" name="old_show_doctor_social_media" value="{{ Option.ShowDoctorSocialMedia }}">
                        <input type="hidden" name="old_show_doctor_appointment_fee" value="{{ Option.ShowDoctorAppointmentFee }}">
                        <input type="hidden" name="old_max_upload_size" value="{{ Option.MaxUploadSize }}">
                        <input type="hidden" name="old_timezone" value="{{ Option.Timezone }}">
                        <input type="hidden" name="old_language" value="{{ Option.Language }}">
                        <input type="hidden" name="old_is_active" value="{{ Option.IsActive }}">

                        <!-- Basic Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">Temel Bilgiler</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="option_set_name" class="form-label required">Seçenek Seti Adı</label>
                                    <input type="text" id="option_set_name" name="option_set_name" class="form-input" 
                                           value="{{ Option.OptionSetName }}" required>
                                </div>
                                <div class="form-group">
                                    <label for="option_set_is_active" class="form-label">Aktif Durumu</label>
                                    <div class="toggle-switch">
                                        <input type="checkbox" id="option_set_is_active" name="option_set_is_active" {{ if Option.OptionSetIsActive }}checked{{ end }}>
                                        <label for="option_set_is_active" class="toggle-label">
                                            <span class="toggle-slider"></span>
                                            <span class="toggle-text">{{ if Option.OptionSetIsActive }}Aktif{{ else }}Pasif{{ end }}</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="option_set_is_testing_now" class="form-label">Test Modu</label>
                                    <div class="toggle-switch">
                                        <input type="checkbox" id="option_set_is_testing_now" name="option_set_is_testing_now" {{ if Option.OptionSetIsTestingNow }}checked{{ end }}>
                                        <label for="option_set_is_testing_now" class="toggle-label">
                                            <span class="toggle-slider"></span>
                                            <span class="toggle-text">{{ if Option.OptionSetIsTestingNow }}Aktif{{ else }}Pasif{{ end }}</span>
                                        </label>
                                    </div>
                                    <p class="section-description">Seçenek setlerinin aktiflik ve test modu durumlarını aynı anda değiştirmemeniz önerilir.</p>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="option_set_description" class="form-label">Açıklama</label>
                                <textarea id="option_set_description" name="option_set_description" class="form-textarea" 
                                          rows="3">{{ Option.OptionSetDescription }}</textarea>
                            </div>
                        </div>

                        <!-- Site Configuration -->
                        <div class="form-group-section">
                            <h3 class="group-title">Site Yapılandırması</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="site_name" class="form-label required">Site Adı</label>
                                    <input type="text" id="site_name" name="site_name" class="form-input" 
                                           value="{{ Option.SiteName }}" required>
                                </div>
                                <div class="form-group">
                                    <label for="maintenance_mode" class="form-label">Bakım Modu</label>
                                    <div class="toggle-switch">
                                        <input type="checkbox" id="maintenance_mode" name="maintenance_mode" 
                                               {{ if Option.MaintenanceMode }}checked{{ end }}>
                                        <label for="maintenance_mode" class="toggle-label">
                                            <span class="toggle-slider"></span>
                                            <span class="toggle-text">{{ if Option.MaintenanceMode }}Aktif{{ else }}Pasif{{ end }}</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="site_description" class="form-label">Site Açıklaması</label>
                                <textarea id="site_description" name="site_description" class="form-textarea" 
                                          rows="3">{{ Option.SiteDescription }}</textarea>
                            </div>
                        </div>

                        <!-- SMTP Configuration -->
                        <div class="form-group-section">
                            <h3 class="group-title">E-posta Ayarları</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="smtp_host" class="form-label">SMTP Sunucusu</label>
                                    <input type="text" id="smtp_host" name="smtp_host" class="form-input" 
                                           value="{{ Option.SMTPHost }}">
                                </div>
                                <div class="form-group">
                                    <label for="smtp_port" class="form-label">Port</label>
                                    <input type="number" id="smtp_port" name="smtp_port" class="form-input" 
                                           value="{{ Option.SMTPPort }}" min="1" max="65535">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="smtp_username" class="form-label">Kullanıcı Adı</label>
                                    <input type="text" id="smtp_username" name="smtp_username" class="form-input" 
                                           value="{{ Option.SMTPUsername }}">
                                </div>
                                <div class="form-group">
                                    <label for="smtp_password" class="form-label">Şifre</label>
                                    <input type="password" id="smtp_password" name="smtp_password" class="form-input" 
                                           value="{{ Option.SMTPPassword }}">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="smtp_encryption" class="form-label">Şifreleme</label>
                                <select id="smtp_encryption" name="smtp_encryption" class="form-select">
                                    <option value="tls" {{ if Option.SMTPEncryption == "tls" }}selected{{ end }}>TLS</option>
                                    <option value="ssl" {{ if Option.SMTPEncryption == "ssl" }}selected{{ end }}>SSL</option>
                                    <option value="none" {{ if Option.SMTPEncryption == "none" }}selected{{ end }}>Şifreleme Yok</option>
                                </select>
                            </div>
                        </div>

                        <!-- Social Media -->
                        <div class="form-group-section">
                            <h3 class="group-title">Sosyal Medya</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="facebook_url" class="form-label">Facebook URL</label>
                                    <input type="url" id="facebook_url" name="facebook_url" class="form-input" 
                                           value="{{ Option.FacebookUrl }}">
                                </div>
                                <div class="form-group">
                                    <label for="twitter_url" class="form-label">Twitter URL</label>
                                    <input type="url" id="twitter_url" name="twitter_url" class="form-input" 
                                           value="{{ Option.TwitterUrl }}">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="instagram_url" class="form-label">Instagram URL</label>
                                    <input type="url" id="instagram_url" name="instagram_url" class="form-input" 
                                           value="{{ Option.InstagramUrl }}">
                                </div>
                                <div class="form-group">
                                    <label for="linkedin_url" class="form-label">LinkedIn URL</label>
                                    <input type="url" id="linkedin_url" name="linkedin_url" class="form-input" 
                                           value="{{ Option.LinkedinUrl }}">
                                </div>
                            </div>
                        </div>

                        <!-- Contact Information -->
                        <div class="form-group-section">
                            <h3 class="group-title">İletişim Bilgileri</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="contact_email" class="form-label">İletişim E-postası</label>
                                    <input type="email" id="contact_email" name="contact_email" class="form-input" 
                                           value="{{ Option.ContactEmail }}">
                                </div>
                                <div class="form-group">
                                    <label for="contact_phone" class="form-label">İletişim Telefonu</label>
                                    <input type="tel" id="contact_phone" name="contact_phone" class="form-input" 
                                           value="{{ Option.ContactPhone }}">
                                </div>
                            </div>
                        </div>

                        <!-- SEO Settings -->
                        <div class="form-group-section">
                            <h3 class="group-title">SEO Ayarları</h3>
                            <div class="form-group">
                                <label for="main_page_meta_title" class="form-label">Meta Başlık</label>
                                <input type="text" id="main_page_meta_title" name="main_page_meta_title" class="form-input" 
                                       value="{{ Option.MainPageMetaTitle }}">
                            </div>
                            <div class="form-group">
                                <label for="main_page_meta_description" class="form-label">Meta Açıklama</label>
                                <textarea id="main_page_meta_description" name="main_page_meta_description" 
                                          class="form-textarea" rows="3">{{ Option.MainPageMetaDescription }}</textarea>
                            </div>
                            <div class="form-group">
                                <label for="google_analytics" class="form-label">Google Analytics Kodu</label>
                                <textarea id="google_analytics" name="google_analytics" class="form-textarea" 
                                          rows="4">{{ Option.GoogleAnalytics }}</textarea>
                            </div>
                        </div>

                        <!-- Design Settings -->
                        <div class="form-group-section">
                            <h3 class="group-title">Tasarım Ayarları</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="primary_color" class="form-label">Ana Renk</label>
                                    <div class="color-input-group">
                                        <input type="color" id="primary_color" name="primary_color" 
                                               value="{{ Option.PrimaryColor }}" class="color-picker">
                                        <input type="text" class="form-input color-text" 
                                               value="{{ Option.PrimaryColor }}">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="secondary_color" class="form-label">İkincil Renk</label>
                                    <div class="color-input-group">
                                        <input type="color" id="secondary_color" name="secondary_color" 
                                               value="{{ Option.SecondaryColor }}" class="color-picker">
                                        <input type="text" class="form-input color-text" 
                                               value="{{ Option.SecondaryColor }}">
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="accent_color" class="form-label">Vurgu Rengi</label>
                                    <div class="color-input-group">
                                        <input type="color" id="accent_color" name="accent_color" 
                                               value="{{ Option.AccentColor }}" class="color-picker">
                                        <input type="text" class="form-input color-text" 
                                               value="{{ Option.AccentColor }}">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="background_color" class="form-label">Arka Plan Rengi</label>
                                    <div class="color-input-group">
                                        <input type="color" id="background_color" name="background_color" 
                                               value="{{ Option.BackgroundColor }}" class="color-picker">
                                        <input type="text" class="form-input color-text" 
                                               value="{{ Option.BackgroundColor }}">
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="font_color" class="form-label">Font Rengi</label>
                                    <div class="color-input-group">
                                        <input type="color" id="font_color" name="font_color" 
                                               value="{{ Option.FontColor }}" class="color-picker">
                                        <input type="text" class="form-input color-text" 
                                               value="{{ Option.FontColor }}">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="font_family" class="form-label">Font Ailesi</label>
                                    <select id="font_family" name="font_family" class="form-select">
                                        <option value="Poppins" {{ if Option.FontFamily == "Poppins" }}selected{{ end }}>Poppins</option>
                                        <option value="Roboto" {{ if Option.FontFamily == "Roboto" }}selected{{ end }}>Roboto</option>
                                        <option value="Open Sans" {{ if Option.FontFamily == "Open Sans" }}selected{{ end }}>Open Sans</option>
                                        <option value="Lato" {{ if Option.FontFamily == "Lato" }}selected{{ end }}>Lato</option>
                                        <option value="Montserrat" {{ if Option.FontFamily == "Montserrat" }}selected{{ end }}>Montserrat</option>
                                        <option value="Manrope" {{ if Option.FontFamily == "Manrope" }}selected{{ end }}>Manrope</option>
                                        <option value="Inter" {{ if Option.FontFamily == "Inter" }}selected{{ end }}>Inter</option>
                                        <option value="Oswald" {{ if Option.FontFamily == "Oswald" }}selected{{ end }}>Oswald</option>
                                        <option value="Noto Sans" {{ if Option.FontFamily == "Noto Sans" }}selected{{ end }}>Noto Sans</option>
                                        <option value="Raleway" {{ if Option.FontFamily == "Raleway" }}selected{{ end }}>Raleway</option>
                                        <option value="Ubuntu" {{ if Option.FontFamily == "Ubuntu" }}selected{{ end }}>Ubuntu</option>
                                        <option value="Playfair Display" {{ if Option.FontFamily == "Playfair Display" }}selected{{ end }}>Playfair Display</option>
                                        <option value="Work Sans" {{ if Option.FontFamily == "Work Sans" }}selected{{ end }}>Work Sans</option>
                                        <option value="Outfit" {{ if Option.FontFamily == "Outfit" }}selected{{ end }}>Outfit</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- System Settings -->
                        <div class="form-group-section">
                            <h3 class="group-title">Sistem Ayarları</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="items_per_page" class="form-label">Sayfa Başına Öğe Sayısı</label>
                                    <input type="number" id="items_per_page" name="items_per_page" class="form-input" 
                                           value="{{ Option.ItemsPerPage }}" min="5" max="100">
                                </div>
                                <div class="form-group">
                                    <label for="max_upload_size" class="form-label">Max. Dosya Boyutu (B)</label>
                                    <input type="number" id="max_upload_size" name="max_upload_size" class="form-input" 
                                           value="{{ Option.MaxUploadSize }}" min="1" max="500000000000000000">
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="maximum_sublinks_on_a_menu_item" class="form-label">Menü Öğesi Başına Max. Alt Link</label>
                                        <input type="number" id="maximum_sublinks_on_a_menu_item" name="maximum_sublinks_on_a_menu_item" class="form-input" 
                                               value="{{ Option.MaximumSublinksOnAMenuItem }}" min="1" max="20">
                                    </div>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="timezone" class="form-label">Zaman Dilimi</label>
                                    <select id="timezone" name="timezone" class="form-select">
                                        <option value="UTC" {{ if Option.Timezone == "UTC" }}selected{{ end }}>UTC</option>
                                        <option value="Europe/Istanbul" {{ if Option.Timezone == "Europe/Istanbul" }}selected{{ end }}>Europe/Istanbul</option>
                                        <option value="Europe/London" {{ if Option.Timezone == "Europe/London" }}selected{{ end }}>Europe/London</option>
                                        <option value="America/New_York" {{ if Option.Timezone == "America/New_York" }}selected{{ end }}>America/New_York</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="language" class="form-label">Dil</label>
                                    <select id="language" name="language" class="form-select">
                                        <option value="tr" {{ if Option.Language == "tr" }}selected{{ end }}>Türkçe</option>
                                        <option value="en" {{ if Option.Language == "en" }}selected{{ end }}>English</option>
                                        <option value="de" {{ if Option.Language == "de" }}selected{{ end }}>Deutsch</option>
                                        <option value="fr" {{ if Option.Language == "fr" }}selected{{ end }}>Français</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="checkbox-group">
                                    <div class="checkbox-column">
                                        <label class="checkbox-label">
                                            <input type="checkbox" id="require_strong_password" name="require_strong_password" 
                                                   {{ if Option.RequireStrongPassword }}checked{{ end }}>
                                            <span class="checkbox-custom"></span>
                                            Güçlü şifre zorunluluğu
                                        </label>
                                        <label class="checkbox-label">
                                            <input type="checkbox" id="show_doctors_on_same_city" name="show_doctors_on_same_city" 
                                                   {{ if Option.ShowDoctorsOnSameCity }}checked{{ end }}>
                                            <span class="checkbox-custom"></span>
                                            Aynı şehirdeki doktorları göster
                                        </label>
                                        <label class="checkbox-label">
                                            <input type="checkbox" id="auto_remove_partners_when_expired" name="auto_remove_partners_when_expired" 
                                                   {{ if Option.AutoRemovePartnersWhenExpired }}checked{{ end }}>
                                            <span class="checkbox-custom"></span>
                                            Süresi dolan ortakları otomatik kaldır
                                        </label>
                                        <label class="checkbox-label">
                                            <input type="checkbox" id="show_doctor_social_media" name="show_doctor_social_media" 
                                                   {{ if Option.ShowDoctorSocialMedia }}checked{{ end }}>
                                            <span class="checkbox-custom"></span>
                                            Doktor sosyal medya bağlantılarını göster
                                        </label>
                                        <label class="checkbox-label">
                                            <input type="checkbox" id="show_doctor_appointment_fee" name="show_doctor_appointment_fee" 
                                                   {{ if Option.ShowDoctorAppointmentFee }}checked{{ end }}>
                                            <span class="checkbox-custom"></span>
                                            Doktor randevu ücretini göster
                                        </label>
                                    </div>
                                    <div class="checkbox-column">
                                        <label class="checkbox-label">
                                            <input type="checkbox" id="show_doctors_on_same_country" name="show_doctors_on_same_country" 
                                                   {{ if Option.ShowDoctorsOnSameCountry }}checked{{ end }}>
                                            <span class="checkbox-custom"></span>
                                            Aynı ülkedeki doktorları göster
                                        </label>
                                        <label class="checkbox-label">
                                            <input type="checkbox" id="enable_testimonials" name="enable_testimonials" 
                                                   {{ if Option.EnableTestimonials }}checked{{ end }}>
                                            <span class="checkbox-custom"></span>
                                            Testimonialları etkinleştir
                                        </label>
                                        <label class="checkbox-label">
                                            <input type="checkbox" id="enable_our_history" name="enable_our_history" 
                                                   {{ if Option.EnableOurHistory }}checked{{ end }}>
                                            <span class="checkbox-custom"></span>
                                            Tarihçe bölümünü etkinleştir
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" id="generalSubmitBtn">
                                <i class="fas fa-save"></i>
                                <span class="btn-text">Genel Ayarları Kaydet</span>
                                <div class="btn-loader" style="display: none;">
                                    <div class="spinner"></div>
                                </div>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Media Files Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-images"></i>
                        Medya Dosyaları
                    </h2>
                    <p class="section-description">Logo, favicon ve varsayılan sayfa görsellerini yönetin</p>
                </div>
                <div class="section-content">
                    <!-- Current Media Display -->
                    <div class="current-media-section">
                        <h3 class="group-title">Mevcut Medya Dosyaları</h3>
                        <div class="media-grid">
                            <!-- Site Logo -->
                            <div class="media-item">
                                <div class="media-header">
                                    <h4 class="media-title">Site Logosu</h4>
                                    {{ if Option.SiteLogoPath }}
                                    <button type="button" class="btn-delete-media" data-type="site_logo" data-oid="{{ Option.Oid }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    {{ end }}
                                </div>
                                <div class="media-preview">
                                    {{ if Option.SiteLogoPath }}
                                    <img src="{{ PathOnStart }}{{ Option.SiteLogoPath }}" alt="{{ Option.SiteLogoAltText }}" 
                                         title="{{ Option.SiteLogoTitle }}" class="preview-image">
                                    <div class="media-info">
                                        <div class="info-item">
                                            <strong>Alt Text:</strong> {{ Option.SiteLogoAltText }}
                                        </div>
                                        <div class="info-item">
                                            <strong>Title:</strong> {{ Option.SiteLogoTitle }}
                                        </div>
                                    </div>
                                    {{ else }}
                                    <div class="no-media">
                                        <i class="fas fa-image"></i>
                                        <span>Logo yüklenmemiş</span>
                                    </div>
                                    {{ end }}
                                </div>
                            </div>

                            <!-- Site Light Logo -->
                            <div class="media-item">
                                <div class="media-header">
                                    <h4 class="media-title">Açık Tema Logosu</h4>
                                    {{ if Option.SiteLightLogoPath }}
                                    <button type="button" class="btn-delete-media" data-type="site_light_logo" data-oid="{{ Option.Oid }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    {{ end }}
                                </div>
                                <div class="media-preview">
                                    {{ if Option.SiteLightLogoPath }}
                                    <img src="{{ PathOnStart }}{{ Option.SiteLightLogoPath }}" alt="{{ Option.SiteLightLogoAltText }}" 
                                         title="{{ Option.SiteLightLogoTitle }}" class="preview-image">
                                    <div class="media-info">
                                        <div class="info-item">
                                            <strong>Alt Text:</strong> {{ Option.SiteLightLogoAltText }}
                                        </div>
                                        <div class="info-item">
                                            <strong>Title:</strong> {{ Option.SiteLightLogoTitle }}
                                        </div>
                                    </div>
                                    {{ else }}
                                    <div class="no-media">
                                        <i class="fas fa-image"></i>
                                        <span>Açık tema logosu yüklenmemiş</span>
                                    </div>
                                    {{ end }}
                                </div>
                            </div>

                            <!-- Favicon -->
                            <div class="media-item">
                                <div class="media-header">
                                    <h4 class="media-title">Favicon</h4>
                                    {{ if Option.SiteFaviconPath }}
                                    <button type="button" class="btn-delete-media" data-type="site_favicon" data-oid="{{ Option.Oid }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    {{ end }}
                                </div>
                                <div class="media-preview">
                                    {{ if Option.SiteFaviconPath }}
                                    <img src="{{ PathOnStart }}{{ Option.SiteFaviconPath }}" alt="Favicon" class="preview-image">
                                    {{ else }}
                                    <div class="no-media">
                                        <i class="fas fa-image"></i>
                                        <span>Favicon yüklenmemiş</span>
                                    </div>
                                    {{ end }}
                                </div>
                            </div>

                            <!-- Default Page Media -->
                            <div class="media-item">
                                <div class="media-header">
                                    <h4 class="media-title">Varsayılan Sayfa Görseli</h4>
                                    {{ if Option.DefaultPageMediaPath }}
                                    <button type="button" class="btn-delete-media" data-type="default_page_picture" data-oid="{{ Option.Oid }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    {{ end }}
                                </div>
                                <div class="media-preview">
                                    {{ if Option.DefaultPageMediaPath }}
                                    <img src="{{ PathOnStart }}{{ Option.DefaultPageMediaPath }}" alt="{{ Option.DefaultPageMediaAltText }}" 
                                         title="{{ Option.DefaultPageMediaTitle }}" class="preview-image">
                                    <div class="media-info">
                                        <div class="info-item">
                                            <strong>Alt Text:</strong> {{ Option.DefaultPageMediaAltText }}
                                        </div>
                                        <div class="info-item">
                                            <strong>Title:</strong> {{ Option.DefaultPageMediaTitle }}
                                        </div>
                                    </div>
                                    {{ else }}
                                    <div class="no-media">
                                        <i class="fas fa-image"></i>
                                        <span>Varsayılan görsel yüklenmemiş</span>
                                    </div>
                                    {{ end }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Media Upload Form -->
                    <div class="media-upload-section">
                        <h3 class="group-title">Medya Dosyalarını Güncelle</h3>
                        <form id="mediaForm" class="media-form" enctype="multipart/form-data" novalidate>
                            <input type="hidden" name="old_site_logo_alt_text" value="{{ Option.SiteLogoAltText }}">
                            <input type="hidden" name="old_site_logo_title" value="{{ Option.SiteLogoTitle }}">
                            <input type="hidden" name="old_site_light_logo_alt_text" value="{{ Option.SiteLightLogoAltText }}">
                            <input type="hidden" name="old_site_light_logo_title" value="{{ Option.SiteLightLogoTitle }}">
                            <input type="hidden" name="old_default_page_media_alt_text" value="{{ Option.DefaultPageMediaAltText }}">
                            <input type="hidden" name="old_default_page_media_title" value="{{ Option.DefaultPageMediaTitle }}">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="site_logo_path" class="form-label">Site Logosu</label>
                                    <div class="file-upload-area" data-target="site_logo_path">
                                        <div class="file-upload-content">
                                            <i class="fas fa-upload"></i>
                                            <p class="file-upload-text">Logo dosyasını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                            <p class="file-upload-hint">PNG, JPG, SVG - Max 2MB</p>
                                        </div>
                                        <input type="file" id="site_logo_path" name="site_logo_path" 
                                               class="file-input" accept="image/*">
                                        <div class="file-preview" style="display: none;">
                                            <img class="preview-image" src="" alt="Preview">
                                            <button type="button" class="file-remove">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="file-meta-inputs">
                                        <div class="form-row">
                                            <div class="form-group">
                                                <label for="site_logo_alt_text" class="form-label">Logo Alt Metni</label>
                                                <input type="text" id="site_logo_alt_text" name="site_logo_alt_text" 
                                                       class="form-input" value="{{ Option.SiteLogoAltText }}">
                                            </div>
                                            <div class="form-group">
                                                <label for="site_logo_title" class="form-label">Logo Başlığı</label>
                                                <input type="text" id="site_logo_title" name="site_logo_title" 
                                                       class="form-input" value="{{ Option.SiteLogoTitle }}">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="site_light_logo_path" class="form-label">Açık Tema Logosu</label>
                                    <div class="file-upload-area" data-target="site_light_logo_path">
                                        <div class="file-upload-content">
                                            <i class="fas fa-upload"></i>
                                            <p class="file-upload-text">Açık tema logosunu sürükleyin veya <span class="file-browse">göz atın</span></p>
                                            <p class="file-upload-hint">PNG, JPG, SVG - Max 2MB</p>
                                        </div>
                                        <input type="file" id="site_light_logo_path" name="site_light_logo_path" 
                                               class="file-input" accept="image/*">
                                        <div class="file-preview" style="display: none;">
                                            <img class="preview-image" src="" alt="Preview">
                                            <button type="button" class="file-remove">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="file-meta-inputs">
                                        <div class="form-row">
                                            <div class="form-group">
                                                <label for="site_light_logo_alt_text" class="form-label">Açık Tema Logo Alt Metni</label>
                                                <input type="text" id="site_light_logo_alt_text" name="site_light_logo_alt_text" 
                                                       class="form-input" value="{{ Option.SiteLightLogoAltText }}">
                                            </div>
                                            <div class="form-group">
                                                <label for="site_light_logo_title" class="form-label">Açık Tema Logo Başlığı</label>
                                                <input type="text" id="site_light_logo_title" name="site_light_logo_title" 
                                                       class="form-input" value="{{ Option.SiteLightLogoTitle }}">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="site_favicon_path" class="form-label">Favicon</label>
                                    <div class="file-upload-area" data-target="site_favicon_path">
                                        <div class="file-upload-content">
                                            <i class="fas fa-upload"></i>
                                            <p class="file-upload-text">Favicon dosyasını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                            <p class="file-upload-hint">ICO, PNG - Max 1MB</p>
                                        </div>
                                        <input type="file" id="site_favicon_path" name="site_favicon_path" 
                                               class="file-input" accept=".ico,.png">
                                        <div class="file-preview" style="display: none;">
                                            <img class="preview-image" src="" alt="Preview">
                                            <button type="button" class="file-remove">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="default_page_media_path" class="form-label">Varsayılan Sayfa Görseli</label>
                                <div class="file-upload-area" data-target="default_page_media_path">
                                    <div class="file-upload-content">
                                        <i class="fas fa-upload"></i>
                                        <p class="file-upload-text">Varsayılan sayfa görselini sürükleyin veya <span class="file-browse">göz atın</span></p>
                                        <p class="file-upload-hint">PNG, JPG, SVG - Max 5MB</p>
                                    </div>
                                    <input type="file" id="default_page_media_path" name="default_page_media_path" 
                                           class="file-input" accept="image/*">
                                    <div class="file-preview" style="display: none;">
                                        <img class="preview-image" src="" alt="Preview">
                                        <button type="button" class="file-remove">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="file-meta-inputs">
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label for="default_page_media_alt_text" class="form-label">Görsel Alt Metni</label>
                                            <input type="text" id="default_page_media_alt_text" name="default_page_media_alt_text" 
                                                   class="form-input" value="{{ Option.DefaultPageMediaAltText }}">
                                        </div>
                                        <div class="form-group">
                                            <label for="default_page_media_title" class="form-label">Görsel Başlığı</label>
                                            <input type="text" id="default_page_media_title" name="default_page_media_title" 
                                                   class="form-input" value="{{ Option.DefaultPageMediaTitle }}">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary" id="mediaSubmitBtn">
                                    <i class="fas fa-upload"></i>
                                    <span class="btn-text">Medya Dosyalarını Güncelle</span>
                                    <div class="btn-loader" style="display: none;">
                                        <div class="spinner"></div>
                                    </div>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">İşlem başarıyla tamamlandı.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteMediaModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Medya Dosyasını Sil</h3>
        <p class="modal-message">Bu medya dosyasını silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeModal('deleteMediaModal')">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteMediaBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<script>
    // Pass data to JavaScript
    window.pageData = {
        oid: {{ Option.Oid }}
    };
</script>
<script src="{{ PathOnStart }}js/panel/secenek-duzenle.js"></script>
