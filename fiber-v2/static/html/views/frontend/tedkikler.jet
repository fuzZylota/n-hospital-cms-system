<section class="page-header" style="margin-top: 200px;">
    <div class="container-fluid">
        <div class="page-header__inner">
            <div class="page-header__bg" style="background-image: url({{ PathOnStart }}{{ Options.Options.DefaultPageMediaPath != "" ? Options.Options.DefaultPageMediaPath : "assets/images/backgrounds/institutional-default.jpg" }});"></div><!-- /.page-header__bg -->
            <div class="container">
                <div class="page-header__content">
                    <h2 class="page-header__title">Tetkikler</h2>
                    <ul class="mediox-breadcrumb list-unstyled">
                        <li>
                            <span class="mediox-breadcrumb__icon"><i class="icon-home"></i></span>
                            <a href="/">Anasayfa</a>
                        </li>
                        <li><span>Tetkikler</span></li>
                    </ul><!-- /.mediox-breadcrumb list-unstyled -->
                </div><!-- /.page-header__content -->
            </div><!-- /.container -->
        </div><!-- /.page-header__inner -->
    </div><!-- /.container-fluid -->
</section><!-- /.page-header -->

<section class="tetkikler section-space" style="padding-top: 40px;">
    <link rel="stylesheet" href="{{ PathOnStart }}css/frontend/tedkikler.css">
    <div class="container">
        <div class="sec-title text-center">
            <h3 class="sec-title__title">Tüm <span>Tetkikler</span></h3>
            <p class="mt-3" style="max-width: 800px; margin: 10px auto 0; color: #6b7280; font-size: 16px;">
                Kurumumuzda uygulanan tetkikleri görüntüleyebilir ve detaylarını inceleyebilirsiniz.
            </p>
        </div>
        <div class="row gutter-y-30">
            {{ if len(Tetkikler) > 0 }}
                {{ range index, Tetkik := Tetkikler }}
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <a href="/tetkikler/{{ Tetkik.UrlName }}" class="tedkik-card tedkik-card--link wow FadeInUp" data-wow-duration="1500ms" data-wow-delay="{{ index * 50 }}ms">
                        <div class="tedkik-card__media">
                            <img class="tedkik-card__image {{ Tetkik.CoverPath == "" ? "is-placeholder" : "" }}" src="{{ Tetkik.CoverPath != "" ? PathOnStart + Tetkik.CoverPath : PathOnStart + "files/defaults/tedkik/tedkik-default.png" }}" alt="{{ Tetkik.CoverAltText != "" ? Tetkik.CoverAltText : Tetkik.Name }}" title="{{ Tetkik.CoverTitle != "" ? Tetkik.CoverTitle : Tetkik.Name }}">
                        </div>
                        <div class="tedkik-card__content">
                            <h3 class="tedkik-card__title">{{ Tetkik.Name }}</h3>
                            <span class="tedkik-card__link" aria-label="Detay">
                                <i class="icon-up-right-arrow"></i>
                            </span>
                        </div>
                    </a>
                </div>
                {{ end }}
            {{ else }}
                <div class="col-12">
                    <p style="text-align:center; color:#6b7280;">Görüntülenecek tetkik bulunamadı.</p>
                </div>
            {{ end }}
        </div>
    </div>
</section>