<link rel="stylesheet" href="{{ PathOnStart }}css/panel/contact-requests.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-envelope"></i>
                    İletişim Talepleri
                </h1>
                <p class="page-subtitle">Websiteden gelen iletişim taleplerini yönetin</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-secondary" id="refreshBtn">
                    <i class="fas fa-sync-alt"></i>
                    Yenile
                </button>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="filters-section">
        <div class="filters-content">
            <div class="search-group">
                <div class="search-input-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchInput" class="search-input" 
                           placeholder="Ad, soyad, e-posta veya konu ile ara...">
                    <button class="search-clear" id="searchClear" style="display: none;">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <div class="filter-group">
                <select id="statusFilter" class="filter-select">
                    <option value="">Tüm Durumlar</option>
                    <option value="yeni">Yeni</option>
                    <option value="okundu">Okundu</option>
                    <option value="cevaplanmis">Cevaplanmış</option>
                    <option value="kapali">Kapalı</option>
                </select>
                <select id="priorityFilter" class="filter-select">
                    <option value="">Tüm Öncelikler</option>
                    <option value="dusuk">Düşük</option>
                    <option value="normal">Normal</option>
                    <option value="yuksek">Yüksek</option>
                    <option value="acil">Acil</option>
                </select>
                <select id="readFilter" class="filter-select">
                    <option value="">Tüm Okuma Durumları</option>
                    <option value="read">Okunmuş</option>
                    <option value="unread">Okunmamış</option>
                </select>
                <select id="sortBy" class="filter-select">
                    <option value="created_at">Oluşturma Tarihi</option>
                    <option value="first_name">Ad</option>
                    <option value="subject">Konu</option>
                    <option value="priority">Öncelik</option>
                    <option value="updated_at">Güncelleme Tarihi</option>
                </select>
                <select id="sortOrder" class="filter-select">
                    <option value="desc">Azalan</option>
                    <option value="asc">Artan</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-envelope"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number">{{Count}}</div>
                    <div class="stat-label">Toplam Talep</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon new">
                    <i class="fas fa-plus-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="newCount">-</div>
                    <div class="stat-label">Yeni Talepler</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon unread">
                    <i class="fas fa-envelope-open"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="unreadCount">-</div>
                    <div class="stat-label">Okunmamış</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon urgent">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="urgentCount">-</div>
                    <div class="stat-label">Acil</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">İletişim Talepleri Listesi</h3>
                <div class="table-actions">
                    <button class="btn btn-sm btn-secondary" id="exportBtn">
                        <i class="fas fa-download"></i>
                        Dışa Aktar
                    </button>
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="table">
                            <i class="fas fa-list"></i>
                        </button>
                        <button class="view-btn" data-view="grid">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Table View -->
            <div class="table-wrapper" id="tableView">
                <table class="data-table" id="contactRequestsTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-column="first_name">
                                <span>Ad Soyad</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="email">
                                <span>E-posta</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="subject">
                                <span>Konu</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="priority">
                                <span>Öncelik</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="status">
                                <span>Durum</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="is_read">
                                <span>Okuma</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="created_at">
                                <span>Tarih</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="actions-column">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{if len(ContactRequests) > 0}}
                            {{range ContactRequests}}
                            <tr data-id="{{ .Crid }}" class="{{if not .IsRead}}unread-row{{end}}">
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .FirstName }} {{ .LastName }}</div>
                                        {{if .Phone}}
                                        <div class="secondary-text">{{ .Phone }}</div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text truncate">{{ .Subject }}</div>
                                        {{if .Department}}
                                        <div class="secondary-text">{{ .Department }}</div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .Priority == "acil"}}
                                        <span class="priority-badge urgent">
                                            <i class="fas fa-exclamation-triangle"></i>
                                            Acil
                                        </span>
                                        {{else if .Priority == "yuksek"}}
                                        <span class="priority-badge high">
                                            <i class="fas fa-arrow-up"></i>
                                            Yüksek
                                        </span>
                                        {{else if .Priority == "normal"}}
                                        <span class="priority-badge normal">
                                            <i class="fas fa-minus"></i>
                                            Normal
                                        </span>
                                        {{else if .Priority == "dusuk"}}
                                        <span class="priority-badge low">
                                            <i class="fas fa-arrow-down"></i>
                                            Düşük
                                        </span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .Status == "yeni"}}
                                        <span class="status-badge new">
                                            <i class="fas fa-plus-circle"></i>
                                            Yeni
                                        </span>
                                        {{else if .Status == "okundu"}}
                                        <span class="status-badge read">
                                            <i class="fas fa-eye"></i>
                                            Okundu
                                        </span>
                                        {{else if .Status == "cevaplanmis"}}
                                        <span class="status-badge replied">
                                            <i class="fas fa-reply"></i>
                                            Cevaplanmış
                                        </span>
                                        {{else if .Status == "kapali"}}
                                        <span class="status-badge closed">
                                            <i class="fas fa-lock"></i>
                                            Kapalı
                                        </span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .IsRead}}
                                        <span class="read-badge read">
                                            <i class="fas fa-check"></i>
                                            Okundu
                                        </span>
                                        {{else}}
                                        <span class="read-badge unread">
                                            <i class="fas fa-envelope"></i>
                                            Okunmamış
                                        </span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ mthr(.CreatedAt, User.Timezone) }}</div>
                                        {{if .AssignedTo}}
                                        <div class="secondary-text">{{ .AssignedTo }}</div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="actions-wrapper">
                                        <button class="action-trigger" data-id="{{ .Crid }}">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <div class="action-dropdown">
                                            <a href="/panel/iletisim-istekleri/{{ .Crid }}" class="action-item view">
                                                <i class="fas fa-eye"></i>
                                                <span>Görüntüle</span>
                                            </a>
                                            <button class="action-item reply" data-id="{{ .Crid }}">
                                                <i class="fas fa-reply"></i>
                                                <span>Cevapla</span>
                                            </button>
                                            {{if not .IsRead}}
                                            <button class="action-item mark-read" data-id="{{ .Crid }}">
                                                <i class="fas fa-check"></i>
                                                <span>Okundu Olarak İşaretle</span>
                                            </button>
                                            {{else}}
                                            <button class="action-item mark-unread" data-id="{{ .Crid }}">
                                                <i class="fas fa-envelope"></i>
                                                <span>Okunmamış Olarak İşaretle</span>
                                            </button>
                                            {{end}}
                                            <div class="action-divider"></div>
                                            <button class="action-item delete" data-id="{{ .Crid }}" data-name="{{ .FirstName }} {{ .LastName }}">
                                                <i class="fas fa-trash"></i>
                                                <span>Sil</span>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        {{else}}
                            <tr class="empty-row">
                                <td colspan="8">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-envelope"></i>
                                        </div>
                                        <div class="empty-title">Henüz iletişim talebi bulunmuyor</div>
                                        <div class="empty-description">Websiteden gelen iletişim talepleri burada görünecek.</div>
                                    </div>
                                </td>
                            </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>

            <!-- Grid View -->
            <div class="grid-wrapper" id="gridView" style="display: none;">
                <div class="contact-requests-grid">
                    {{if len(ContactRequests) > 0}}
                        {{range ContactRequests}}
                        <div class="contact-request-card" data-id="{{ .Crid }}" class="{{if not .IsRead}}unread-card{{end}}">
                            <div class="card-header">
                                <div class="card-title">{{ .FirstName }} {{ .LastName }}</div>
                                <div class="card-actions">
                                    <button class="action-trigger" data-id="{{ .Crid }}">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="action-dropdown">
                                        <a href="/panel/iletisim-istekleri/{{ .Crid }}" class="action-item view">
                                            <i class="fas fa-eye"></i>
                                            <span>Görüntüle</span>
                                        </a>
                                        <button class="action-item reply" data-id="{{ .Crid }}">
                                            <i class="fas fa-reply"></i>
                                            <span>Cevapla</span>
                                        </button>
                                        {{if not .IsRead}}
                                        <button class="action-item mark-read" data-id="{{ .Crid }}">
                                            <i class="fas fa-check"></i>
                                            <span>Okundu Olarak İşaretle</span>
                                        </button>
                                        {{else}}
                                        <button class="action-item mark-unread" data-id="{{ .Crid }}">
                                            <i class="fas fa-envelope"></i>
                                            <span>Okunmamış Olarak İşaretle</span>
                                        </button>
                                        {{end}}
                                        <div class="action-divider"></div>
                                        <button class="action-item delete" data-id="{{ .Crid }}" data-name="{{ .FirstName }} {{ .LastName }}">
                                            <i class="fas fa-trash"></i>
                                            <span>Sil</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-field">
                                    <div class="field-label">E-posta</div>
                                    <div class="field-value">
                                        <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                    </div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">Konu</div>
                                    <div class="field-value">{{ .Subject }}</div>
                                </div>
                                {{if .Phone}}
                                <div class="card-field">
                                    <div class="field-label">Telefon</div>
                                    <div class="field-value">{{ .Phone }}</div>
                                </div>
                                {{end}}
                                {{if .Department}}
                                <div class="card-field">
                                    <div class="field-label">Departman</div>
                                    <div class="field-value">{{ .Department }}</div>
                                </div>
                                {{end}}
                            </div>
                            <div class="card-footer">
                                <div class="card-status">
                                    {{if .Priority == "acil"}}
                                    <span class="priority-badge urgent">
                                        <i class="fas fa-exclamation-triangle"></i>
                                        Acil
                                    </span>
                                    {{else if .Priority == "yuksek"}}
                                    <span class="priority-badge high">
                                        <i class="fas fa-arrow-up"></i>
                                        Yüksek
                                    </span>
                                    {{else if .Priority == "normal"}}
                                    <span class="priority-badge normal">
                                        <i class="fas fa-minus"></i>
                                        Normal
                                    </span>
                                    {{else if .Priority == "dusuk"}}
                                    <span class="priority-badge low">
                                        <i class="fas fa-arrow-down"></i>
                                        Düşük
                                    </span>
                                    {{end}}
                                    {{if .Status == "yeni"}}
                                    <span class="status-badge new">
                                        <i class="fas fa-plus-circle"></i>
                                        Yeni
                                    </span>
                                    {{else if .Status == "okundu"}}
                                    <span class="status-badge read">
                                        <i class="fas fa-eye"></i>
                                        Okundu
                                    </span>
                                    {{else if .Status == "cevaplanmis"}}
                                    <span class="status-badge replied">
                                        <i class="fas fa-reply"></i>
                                        Cevaplanmış
                                    </span>
                                    {{else if .Status == "kapali"}}
                                    <span class="status-badge closed">
                                        <i class="fas fa-lock"></i>
                                        Kapalı
                                    </span>
                                    {{end}}
                                    {{if .IsRead}}
                                    <span class="read-badge read">
                                        <i class="fas fa-check"></i>
                                        Okundu
                                    </span>
                                    {{else}}
                                    <span class="read-badge unread">
                                        <i class="fas fa-envelope"></i>
                                        Okunmamış
                                    </span>
                                    {{end}}
                                </div>
                                <div class="card-date">{{ mthr(.CreatedAt, User.Timezone) }}</div>
                            </div>
                        </div>
                        {{end}}
                    {{else}}
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="empty-title">Henüz iletişim talebi bulunmuyor</div>
                            <div class="empty-description">Websiteden gelen iletişim talepleri burada görünecek.</div>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    {{if Count > 0}}
    <div class="pagination-section">
        <div class="pagination-info">
            <span>Toplam {{Count}} kayıt gösteriliyor</span>
        </div>
        <div class="pagination-wrapper">
            <nav class="pagination" id="pagination">
                <!-- Pagination will be generated by JavaScript -->
            </nav>
        </div>
        <div class="pagination-controls">
            <select id="perPage" class="per-page-select">
                <option value="10">10 / sayfa</option>
                <option value="25">25 / sayfa</option>
                <option value="50">50 / sayfa</option>
                <option value="100">100 / sayfa</option>
            </select>
        </div>
    </div>
    {{end}}
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">İletişim Talebini Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı iletişim talebini silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="fas fa-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="fas fa-exclamation-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<script>
    function decodeHtmlEntities(encoded) {
        const txt = document.createElement('textarea');
        txt.innerHTML = encoded;
        return txt.value;
    }

    const escaped = '{{stj(ContactRequests)}}';
    const decoded = decodeHtmlEntities(escaped);
    const data = decoded ? JSON.parse(decoded) : [];
    window.pageData = {
        contactRequests: data,
        count: parseInt("{{ Count ? Count : 0 }}"),
        currentPage: parseInt("{{ Page ? Page : 1 }}"),
        perPage: parseInt("{{ 10 }}")
    };
</script>
<script src="{{ PathOnStart }}js/panel/contact-requests.js"></script>