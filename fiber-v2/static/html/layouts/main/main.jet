<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('a[href^="tel:"]').forEach(function (a) {
    a.textContent = a.textContent.replace(/\+/g, '').trim();
  });
});
</script>





<div id="nvCookieBanner" aria-live="polite">
    <div class="nv-ck-wrap">
        <div class="nv-ck-text">
            <div class="nv-ck-title">Çerezleri kullanıyoruz</div>
            <div class="nv-ck-desc">
                Deneyiminizi iyileştirmek için çerez kullanıyoruz. Zorunlu çerezler her zaman aktiftir.
            </div>
        </div>
        <div class="nv-ck-btns">
            <button type="button" class="nv-ck-btn nv-ck-btn--accept" onclick="nvAcceptAllCookies()">Kabul Et</button>
            <button type="button" class="nv-ck-btn nv-ck-btn--reject" onclick="nvRejectAllCookies()">Reddet</button>
        </div>
        <button type="button" class="nv-ck-manage-link" onclick="nvOpenCookieSettings()">Tercihleri yönet</button>
    </div>
</div>

<div id="nvCookieBackdrop" onclick="nvCloseCookieSettings()"></div>

<div id="nvCookieModal" role="dialog" aria-modal="true" aria-labelledby="nvCookieModalTitle">
    <div class="nv-ckm-head">
        <div>
            <div id="nvCookieModalTitle" class="nv-ckm-title">Çerez Tercihleri</div>
            <div class="nv-ckm-subtitle">Zorunlu çerezler her zaman açık kalır. Analitik çerezleri isteğinize göre açıp kapatabilirsiniz.</div>
        </div>
        <button type="button" class="nv-ckm-close" onclick="nvCloseCookieSettings()" aria-label="Kapat">×</button>
    </div>

    <div class="nv-ckm-body">
        <div class="nv-ckm-row">
            <div class="nv-ckm-info">
                <div class="nv-ckm-label">Zorunlu Çerezler</div>
                <div class="nv-ckm-text">Sitenin temel işlevleri için gereklidir. Kapatılamaz.</div>
            </div>
            <label class="nv-switch nv-switch--locked">
                <input type="checkbox" checked disabled>
                <span class="nv-slider"></span>
            </label>
        </div>

        <div class="nv-ckm-row">
            <div class="nv-ckm-info">
                <div class="nv-ckm-label">Analitik Çerezler</div>
                <div class="nv-ckm-text">Google Analytics ile trafik ve kullanım istatistiklerini ölçmemizi sağlar.</div>
            </div>
            <label class="nv-switch">
                <input type="checkbox" id="nvAnalyticsToggle">
                <span class="nv-slider"></span>
            </label>
        </div>

        <div class="nv-ckm-links">
            <a href="/kurumsal/cerez-politikasi">KVKK / Çerez Bilgilendirmesi</a>
        </div>
    </div>

    <div class="nv-ckm-actions">
        <button type="button" class="nv-ck-btn nv-ck-btn--reject" onclick="nvRejectAllCookies()">Reddet</button>
        <button type="button" class="nv-ck-btn nv-ck-btn--manage" onclick="nvSaveCookiePreferences()">Tercihleri Kaydet</button>
        <button type="button" class="nv-ck-btn nv-ck-btn--accept" onclick="nvAcceptAllCookies()">Tümünü Kabul Et</button>
    </div>
</div>

<button type="button" id="nvCookiePrefsBtn" onclick="nvOpenCookieSettings()" aria-label="Çerez tercihleri" title="Çerez tercihleri">
