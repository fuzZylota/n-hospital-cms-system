<div class="compact-page-header">
    <div class="container">
        <ul class="compact-breadcrumb">
            <li><a href="/"><i class="icon-home"></i> Anasayfa</a></li>
            <li><span class="current">Anlaşmalı Kurumlar</span></li>
        </ul>
    </div>
</div>

{{ range index1, CssContent := CssContents }}
<style>{{ CssContent | raw }}</style>
{{ end }}

<style>
  .page-header .page-header__inner.anlasmali-kurumlar-header {
      position: relative !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      min-height: 220px !important;
  }
  .page-header .page-header__inner.anlasmali-kurumlar-header > .container {
      width: 100% !important;
      margin: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
  }
  .page-header .page-header__inner.anlasmali-kurumlar-header .page-header__content {
      margin: 0 !important;
      padding: 0 !important;
      text-align: center !important;
  }
  .page-header .page-header__bg {
      position: absolute;
      inset: 0;
  }
  .service-details.section-space {
      padding-top: 15px !important;
      padding-bottom: 30px !important;
  }
</style>

<link rel="stylesheet" href="{{ PathOnStart }}css/frontend/content-dates.css">
<section class="service-details section-space">
    <div class="container">
        <div class="row gutter-y-50">
            <div class="col-12">
                {{ include "../../components/content-dates" }}
                {{ range index1, HtmlContent := HtmlContents }}
                    {{ HtmlContent | raw }}
                {{ end }}
            </div>
        </div>
    </div>
</section>

{{ range index1, JavascriptContent := JavascriptContents }}
<script>{{ JavascriptContent | raw }}</script>
{{ end }}