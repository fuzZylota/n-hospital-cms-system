<link rel="stylesheet" href="{{ PathOnStart }}css/panel/contact-request.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/contact-requests" class="breadcrumb-link">
                        <i class="fas fa-envelope"></i>
                        İletişim Talepleri
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">{{ ContactRequest.FirstName }} {{ ContactRequest.LastName }}</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">{{ ContactRequest.FirstName }} {{ ContactRequest.LastName }}</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-calendar"></i>
                                {{ mthr(ContactRequest.CreatedAt, User.Timezone) }}
                            </span>
                            <span class="meta-item">
                                <i class="fas fa-clock"></i>
                                Son güncelleme: {{ mthr(ContactRequest.UpdatedAt, User.Timezone) }}
                            </span>
                        </div>
                    </div>
                </h1>
                {{if ContactRequest.Subject}}
                <p class="page-subtitle">{{ ContactRequest.Subject }}</p>
                {{end}}
            </div>
            <div class="page-actions">
                <div class="status-indicator">
                    {{if ContactRequest.Priority == "acil"}}
                    <span class="status-badge urgent">
                        <i class="fas fa-exclamation-triangle"></i>
                        Acil
                    </span>
                    {{else if ContactRequest.Priority == "yuksek"}}
                    <span class="status-badge high">
                        <i class="fas fa-arrow-up"></i>
                        Yüksek
                    </span>
                    {{else if ContactRequest.Priority == "normal"}}
                    <span class="status-badge normal">
                        <i class="fas fa-minus"></i>
                        Normal
                    </span>
                    {{else}}
                    <span class="status-badge low">
                        <i class="fas fa-arrow-down"></i>
                        Düşük
                    </span>
                    {{end}}
                    {{if ContactRequest.Status == "yeni"}}
                    <span class="status-badge new">
                        <i class="fas fa-plus-circle"></i>
                        Yeni
                    </span>
                    {{else if ContactRequest.Status == "okundu"}}
                    <span class="status-badge read">
                        <i class="fas fa-eye"></i>
                        Okundu
                    </span>
                    {{else if ContactRequest.Status == "cevaplanmis"}}
                    <span class="status-badge responded">
                        <i class="fas fa-reply"></i>
                        Cevaplandı
                    </span>
                    {{else}}
                    <span class="status-badge closed">
                        <i class="fas fa-times-circle"></i>
                        Kapalı
                    </span>
                    {{end}}
                    {{if ContactRequest.IsRead}}
                    <span class="status-badge read">
                        <i class="fas fa-eye"></i>
                        Okundu
                    </span>
                    {{else}}
                    <span class="status-badge unread">
                        <i class="fas fa-eye-slash"></i>
                        Okunmadı
                    </span>
                    {{end}}
                </div>
                <div class="action-buttons">
                    <a href="/panel/iletisim-istegi-cevapla?crid={{ ContactRequest.Crid }}" class="btn btn-primary">
                        <i class="fas fa-reply"></i>
                        Cevapla
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" id="contactRequestOptionsDropdown" aria-expanded="false">
                            <i class="fas fa-cog"></i>
                            Talep Seçenekleri
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="contactRequestOptionsDropdown">
                            <li>
                                <button class="dropdown-item" id="toggleReadStatusBtn" data-id="{{ ContactRequest.Crid }}" data-is-read="{{ ContactRequest.IsRead }}">
                                    {{if ContactRequest.IsRead}}
                                    <i class="fas fa-eye-slash"></i>
                                    Okunmadı Olarak İşaretle
                                    {{else}}
                                    <i class="fas fa-eye"></i>
                                    Okundu Olarak İşaretle
                                    {{end}}
                                </button>
                            </li>
                        </ul>
                    </div>
                    <button class="btn btn-danger" id="deleteContactRequestBtn" data-id="{{ ContactRequest.Crid }}" data-name="{{ ContactRequest.FirstName }} {{ ContactRequest.LastName }}">
                        <i class="fas fa-trash"></i>
                        <span class="btn-text">Sil</span>
                        <div class="btn-loader" style="display: none;">
                            <div class="spinner"></div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Sections -->
    <div class="content-grid">
        <!-- Contact Request Basic Info -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-user"></i>
                </div>
                <h3 class="card-title">Talep Bilgileri</h3>
            </div>
            <div class="card-content">
                <div class="contact-request-profile">
                    <div class="contact-request-info">
                        <div class="info-grid">
                            <div class="info-item">
                                <label class="info-label">Ad Soyad</label>
                                <div class="info-value">{{ ContactRequest.FirstName }} {{ ContactRequest.LastName }}</div>
                            </div>
                            {{if ContactRequest.Email}}
                            <div class="info-item">
                                <label class="info-label">E-posta</label>
                                <div class="info-value">
                                    <a href="mailto:{{ ContactRequest.Email }}" class="contact-link">
                                        <i class="fas fa-envelope"></i>
                                        {{ ContactRequest.Email }}
                                    </a>
                                </div>
                            </div>
                            {{end}}
                            {{if ContactRequest.Phone}}
                            <div class="info-item">
                                <label class="info-label">Telefon</label>
                                <div class="info-value">
                                    <a href="tel:{{ ContactRequest.Phone }}" class="contact-link">
                                        <i class="fas fa-phone"></i>
                                        {{ ContactRequest.Phone }}
                                    </a>
                                </div>
                            </div>
                            {{end}}
                            {{if ContactRequest.Department}}
                            <div class="info-item">
                                <label class="info-label">Departman</label>
                                <div class="info-value">{{ ContactRequest.Department }}</div>
                            </div>
                            {{end}}
                            {{if ContactRequest.Source}}
                            <div class="info-item">
                                <label class="info-label">Kaynak</label>
                                <div class="info-value">{{ ContactRequest.Source }}</div>
                            </div>
                            {{end}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Message Content -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-comment"></i>
                </div>
                <h3 class="card-title">Mesaj İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="message-content">
                    <div class="message-subject">
                        <label class="info-label">Konu</label>
                        <div class="info-value">{{ ContactRequest.Subject }}</div>
                    </div>
                    <div class="message-text">
                        <label class="info-label">Mesaj</label>
                        <div class="info-value text-content">{{ ContactRequest.Message }}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Response Information -->
        {{if ContactRequest.Response}}
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-reply"></i>
                </div>
                <h3 class="card-title">Cevaplanma Bilgileri</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    {{if ContactRequest.AssignedTo}}
                    <div class="info-item">
                        <label class="info-label">Atanan Kişi</label>
                        <div class="info-value">{{ ContactRequest.AssignedTo }}</div>
                    </div>
                    {{end}}
                    {{if ContactRequest.ResponseDate}}
                    <div class="info-item">
                        <label class="info-label">Cevaplanma Tarihi</label>
                        <div class="info-value">{{ mthr(ContactRequest.ResponseDate, User.Timezone) }}</div>
                    </div>
                    {{end}}
                    <div class="info-item full-width">
                        <label class="info-label">Cevap</label>
                        <div class="info-value text-content">{{ ContactRequest.Response }}</div>
                    </div>
                </div>
            </div>
        </div>
        {{end}}

        <!-- Technical Information -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <h3 class="card-title">Teknik Bilgiler</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    {{if ContactRequest.IpAddress}}
                    <div class="info-item">
                        <label class="info-label">IP Adresi</label>
                        <div class="info-value">{{ ContactRequest.IpAddress }}</div>
                    </div>
                    {{end}}
                    {{if ContactRequest.UserAgent}}
                    <div class="info-item full-width">
                        <label class="info-label">Tarayıcı Bilgisi</label>
                        <div class="info-value">{{ ContactRequest.UserAgent }}</div>
                    </div>
                    {{end}}
                    <div class="info-item">
                        <label class="info-label">Oluşturulma Tarihi</label>
                        <div class="info-value">{{ mthr(ContactRequest.CreatedAt, User.Timezone) }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Son Güncelleme</label>
                        <div class="info-value">{{ mthr(ContactRequest.UpdatedAt, User.Timezone) }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">İletişim Talebini Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı iletişim talebini silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz ve tüm ilişkili veriler silinecektir.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="icon-trash-2"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="icon-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="icon-alert-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<script>
    // Pass data to JavaScript
    window.contactRequestData = {
        id: parseInt("{{ ContactRequest.Crid }}"),
        name: "{{ ContactRequest.FirstName }} {{ ContactRequest.LastName }}"
    };
</script>
<script src="{{ PathOnStart }}js/panel/contact-request.js"></script>