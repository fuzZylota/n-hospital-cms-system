<header class="admin-header">
    <div class="header-left">
        <div class="header-title">
            Hastane Yönetim Paneli
            <span class="header-subtitle">Hoş geldiniz</span>
        </div>
    </div>
    
    <div class="header-right">
        <div class="header-actions">
            {{ unreadNotifications := 0 }}

            {{ range index1, Notification := Options.Notifications }}
                {{ if !Notification.IsRead }}
                    {{ unreadNotifications = unreadNotifications + 1 }}
                {{ end }}
            {{ end }}

            <!-- Notifications Button -->
            <div style="position: relative;">
                <button class="header-btn {{ if unreadNotifications > 0 }} has-notification {{ end }}" id="notificationBtn" title="Bildirimler">
                    <i class="fas fa-bell"></i>
                </button>
                
                <!-- Notification Dropdown -->
                <div class="notification-dropdown" id="notificationDropdown">
                    <div class="notification-header">
                        <span class="notification-title">Bildirimler</span>
                        <span class="notification-count">{{ unreadNotifications }}</span>
                    </div>
                    
                    <div class="notification-list">
                        {{ if len(Options.Notifications) > 0 }}
                            {{ range index1, Notification := Options.Notifications }}
                                <a href="{{ Notification.Link }}?notification=1"><div class="notification-item {{ if !Notification.IsRead }} unread {{ end }}">
                                    <div class="notification-icon {{ Notification.NotificationType }}" style="cursor: pointer;">
                                        <i class="fas fa-user-plus"></i>
                                    </div>
                                    <div class="notification-content">
                                        <div class="notification-text">{{ Notification.Message }}</div>
                                        <div class="notification-time">{{ ctdi(Notification.CreatedAt, User.Timezone) }}</div>
                                    </div>
                                </div></a>
                            {{ end }}
                        {{ else }}
                            <div class="notification-item">
                                <div class="notification-content">
                                    <div class="notification-text">Henüz bildirim yok</div>
                                </div>
                            </div>
                        {{ end }}
                    </div>
                </div>
            </div>
        </div>
        
        <!-- User Profile -->
        <div class="user-profile" id="userProfile" style="position: relative;">
            <div class="user-avatar">
                {{ if User.Name != "" && User.Surname != "" }}
                    {{ User.Name[0] }}{{ User.Surname[0] }}
                {{ else }}
                    {{ User.Email[0] }}{{ User.Email[1] }}
                {{ end }}
            </div>
            <div class="user-info">
                <div class="user-name">{{ User.Name }} {{ User.Surname }}</div>
                <div class="user-role">{{ User.Role }}</div>
            </div>
            <i class="fas fa-chevron-down" style="margin-left: 8px; font-size: 12px; color: var(--text-muted);"></i>
            
            <!-- User Dropdown -->
            <div class="user-dropdown" id="userDropdown" style="display: none; position: absolute; top: 100%; right: 0; background: white; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); z-index: 1000; min-width: 200px;">
                <div class="dropdown-item">
                    <a href="/panel/kullanicilar/{{ User.Uid }}" style="display: flex; align-items: center; padding: 12px 16px; text-decoration: none; color: #374151; transition: background-color 0.2s;">
                        <i class="fas fa-user" style="margin-right: 8px; width: 16px;"></i>
                        Profil
                    </a>
                </div>
                <div class="dropdown-item">
                    <a href="/backend/logout" style="display: flex; align-items: center; padding: 12px 16px; text-decoration: none; color: #dc2626; transition: background-color 0.2s;">
                        <i class="fas fa-sign-out-alt" style="margin-right: 8px; width: 16px;"></i>
                        Çıkış Yap
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const userProfile = document.getElementById('userProfile');
    const userDropdown = document.getElementById('userDropdown');
    
    if (userProfile && userDropdown) {
        // Toggle dropdown on click
        userProfile.addEventListener('click', function(e) {
            e.stopPropagation();
            if (userDropdown.style.display === 'none' || userDropdown.style.display === '') {
                userDropdown.style.display = 'block';
            } else {
                userDropdown.style.display = 'none';
            }
        });
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!userProfile.contains(e.target)) {
                userDropdown.style.display = 'none';
            }
        });
        
        // Add hover effects for dropdown items
        const dropdownItems = userDropdown.querySelectorAll('.dropdown-item a');
        dropdownItems.forEach(item => {
            item.addEventListener('mouseenter', function() {
                this.style.backgroundColor = '#f3f4f6';
            });
            item.addEventListener('mouseleave', function() {
                this.style.backgroundColor = 'transparent';
            });
        });
    }
});
</script>
