<link rel="stylesheet" href="{{ PathOnStart }}css/panel/randevu-duzenle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/randevular" class="breadcrumb-link">
                        <i class="fas fa-calendar-alt"></i>
                        Randevular
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <a href="/panel/randevular/{{ Randevu.Rid }}" class="breadcrumb-link">
                        <i class="fas fa-eye"></i>
                        Randevu #{{ Randevu.Rid }}
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">Düzenle</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-edit"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">Randevu Düzenle</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-user"></i>
                                {{ Randevu.PatientFirstName }} {{ Randevu.PatientLastName }}
                            </span>
                            <span class="meta-item">
                                <i class="fas fa-calendar"></i>
                                {{ mthr(Randevu.AppointmentDate, User.Timezone) }}
                            </span>
                        </div>
                    </div>
                </h1>
            </div>
            <div class="page-actions">
                <a href="/panel/randevular/{{ Randevu.Rid }}" class="btn btn-secondary">
                    <i class="fas fa-eye"></i>
                    Görüntüle
                </a>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="content-container">
        <form id="randevuEditForm" class="edit-form" novalidate>
        <div class="forms-container">
            <!-- Patient Information Form -->
            <div class="form-group-section">
                <div class="group-title">
                    <i class="fas fa-user"></i>
                    Hasta Bilgileri
                </div>
                <div class="section-content">
                        <input type="hidden" name="rid" value="{{ Randevu.Rid }}">
                        <input type="hidden" name="old_patient_first_name" value="{{ Randevu.PatientFirstName }}">
                        <input type="hidden" name="old_patient_last_name" value="{{ Randevu.PatientLastName }}">
                        <input type="hidden" name="old_patient_phone" value="{{ Randevu.PatientPhone }}">
                        <input type="hidden" name="old_patient_email" value="{{ Randevu.PatientEmail }}">
                        <input type="hidden" name="old_patient_tc_kimlik" value="{{ Randevu.PatientTcKimlik }}">
                        <input type="hidden" name="old_patient_birth_date" value="{{ ctdi(Randevu.PatientBirthDate, User.Timezone) }}">
                        <input type="hidden" name="old_patient_gender" value="{{ Randevu.PatientGender }}">

                        <div class="form-row">
                            <div class="form-group">
                                <label for="patient_first_name" class="form-label">Ad *</label>
                                <input type="text" id="patient_first_name" name="patient_first_name" class="form-input" value="{{ Randevu.PatientFirstName }}" required>
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label for="patient_last_name" class="form-label">Soyad *</label>
                                <input type="text" id="patient_last_name" name="patient_last_name" class="form-input" value="{{ Randevu.PatientLastName }}" required>
                                <div class="field-error"></div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="patient_phone" class="form-label">Telefon *</label>
                                <input type="tel" id="patient_phone" name="patient_phone" class="form-input" value="{{ Randevu.PatientPhone }}" required>
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label for="patient_email" class="form-label">E-posta</label>
                                <input type="email" id="patient_email" name="patient_email" class="form-input" value="{{ Randevu.PatientEmail }}">
                                <div class="field-error"></div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="patient_tc_kimlik" class="form-label">TC Kimlik</label>
                                <input type="text" id="patient_tc_kimlik" name="patient_tc_kimlik" class="form-input" value="{{ Randevu.PatientTcKimlik }}" maxlength="11">
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label for="patient_birth_date" class="form-label">Doğum Tarihi</label>
                                <input type="date" id="patient_birth_date" name="patient_birth_date" class="form-input" value="{{ ctdi(Randevu.PatientBirthDate, User.Timezone) }}">
                                <div class="field-error"></div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="patient_gender" class="form-label">Cinsiyet</label>
                                <select id="patient_gender" name="patient_gender" class="form-input">
                                    <option value="">Seçiniz</option>
                                    <option value="erkek" {{ if Randevu.PatientGender == "erkek" }}selected{{ end }}>Erkek</option>
                                    <option value="kadın" {{ if Randevu.PatientGender == "kadın" }}selected{{ end }}>Kadın</option>
                                    <option value="belirtmek istemiyorum" {{ if Randevu.PatientGender == "belirtmek istemiyorum" }}selected{{ end }}>Belirtmek İstemiyorum</option>
                                </select>
                                <div class="field-error"></div>
                            </div>
                        </div>
                    
                </div>
            </div>

            <!-- Appointment Information Form -->
            <div class="form-group-section">
                <div class="group-title">
                    <i class="fas fa-calendar-alt"></i>
                    Randevu Bilgileri
                </div>
                <div class="section-content">
                        <input type="hidden" name="old_drid" value="{{ Randevu.Drid }}">
                        <input type="hidden" name="old_brid" value="{{ Randevu.Brid }}">
                        <input type="hidden" name="old_sid" value="{{ Randevu.Sid }}">
                        <input type="hidden" name="old_akid" value="{{ Randevu.Akid }}">
                        <input type="hidden" name="old_tid" value="{{ Randevu.Tid }}">
                        <input type="hidden" name="old_tbid" value="{{ Randevu.Tbid }}">
                        <input type="hidden" name="old_appointment_date" value="{{ ctdi(Randevu.AppointmentDate, User.Timezone) }}">
                        <input type="hidden" name="old_appointment_time" value="{{ stti(Randevu.AppointmentTime, User.Timezone) }}">
                        <input type="hidden" name="old_duration" value="{{ Randevu.Duration }}">
                        <input type="hidden" name="old_status" value="{{ Randevu.Status }}">
                        <input type="hidden" name="old_price" value="{{ Randevu.Price }}">
                        <input type="hidden" name="old_payment_status" value="{{ Randevu.PaymentStatus }}">

                        <div class="form-row">
                            <div class="form-group">
                                <label for="appointment_date" class="form-label">Randevu Tarihi *</label>
                                <input type="date" id="appointment_date" name="appointment_date" class="form-input" value="{{ ctdi(Randevu.AppointmentDate, User.Timezone) }}" required>
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label for="appointment_time" class="form-label">Randevu Saati *</label>
                                <div class="time-input-container">
                                    <input type="text" id="appointment_time" name="appointment_time" class="form-input" placeholder="HH:MM" maxlength="5" pattern="^([01]?[0-9]|2[0-3]):[0-5][0-9]$" value="{{ stti(Randevu.AppointmentTime, User.Timezone) }}" required>
                                    <div class="time-format-hint">24 saat formatı (örn: 14:30)</div>
                                </div>
                                <div class="field-error"></div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="duration" class="form-label">Süre (Dakika)</label>
                                <input type="number" id="duration" name="duration" class="form-input" value="{{ Randevu.Duration }}" min="15" max="480" step="15">
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label for="price" class="form-label">Ücret (₺)</label>
                                <input type="number" id="price" name="price" class="form-input" value="{{ Randevu.Price }}" min="0" step="0.01">
                                <div class="field-error"></div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="status" class="form-label">Durum *</label>
                                <select id="status" name="status" class="form-input" required>
                                    <option value="beklemede" {{ if Randevu.Status == "beklemede" }}selected{{ end }}>Beklemede</option>
                                    <option value="onaylandi" {{ if Randevu.Status == "onaylandi" }}selected{{ end }}>Onaylandı</option>
                                    <option value="iptal" {{ if Randevu.Status == "iptal" }}selected{{ end }}>İptal</option>
                                    <option value="tamamlandi" {{ if Randevu.Status == "tamamlandi" }}selected{{ end }}>Tamamlandı</option>
                                    <option value="gelmedi" {{ if Randevu.Status == "gelmedi" }}selected{{ end }}>Gelmedi</option>
                                </select>
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label for="payment_status" class="form-label">Ödeme Durumu *</label>
                                <select id="payment_status" name="payment_status" class="form-input" required>
                                    <option value="odenmedi" {{ if Randevu.PaymentStatus == "odenmedi" }}selected{{ end }}>Ödenmedi</option>
                                    <option value="odendi" {{ if Randevu.PaymentStatus == "odendi" }}selected{{ end }}>Ödendi</option>
                                    <option value="kismen_odendi" {{ if Randevu.PaymentStatus == "kismen_odendi" }}selected{{ end }}>Kısmen Ödendi</option>
                                </select>
                                <div class="field-error"></div>
                            </div>
                        </div>
                    
                </div>
            </div>

            <!-- Medical Information Form -->
            <div class="form-group-section">
                <div class="group-title">
                    <i class="fas fa-stethoscope"></i>
                    Tıbbi Bilgiler
                </div>
                <div class="section-content">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="sid" class="form-label">Şube</label>
                                <select id="sid" name="sid" class="form-input">
                                    <option value="">Şube Seçiniz</option>
                                </select>
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label for="drid" class="form-label">Doktor</label>
                                <select id="drid" name="drid" class="form-input">
                                    <option value="">Doktor Seçiniz</option>
                                </select>
                                <div class="field-error"></div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="brid" class="form-label">Branş</label>
                                <select id="brid" name="brid" class="form-input">
                                    <option value="">Branş Seçiniz</option>
                                </select>
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label for="tbid" class="form-label">Tıbbi Birim</label>
                                <select id="tbid" name="tbid" class="form-input">
                                    <option value="">Tıbbi Birim Seçiniz</option>
                                </select>
                                <div class="field-error"></div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="tid" class="form-label">Tetkik</label>
                                <select id="tid" name="tid" class="form-input">
                                    <option value="">Tetkik Seçiniz</option>
                                </select>
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label for="akid" class="form-label">Anlaşmalı Kurum</label>
                                <select id="akid" name="akid" class="form-input">
                                    <option value="">Anlaşmalı Kurum Seçiniz</option>
                                </select>
                                <div class="field-error"></div>
                            </div>
                        </div>
                    
                </div>
            </div>

            <!-- Additional Information Form -->
            <div class="form-group-section">
                <div class="group-title">
                    <i class="fas fa-clipboard-list"></i>
                    Ek Bilgiler
                </div>
                <div class="section-content">
                        <input type="hidden" name="old_notes" value="{{ Randevu.Notes }}">
                        <input type="hidden" name="old_complaint" value="{{ Randevu.Complaint }}">
                        <input type="hidden" name="old_cancel_reason" value="{{ Randevu.CancelReason }}">
                        <input type="hidden" name="old_reminder_sent" value="{{ Randevu.ReminderSent }}">
                        <input type="hidden" name="old_confirmation_code" value="{{ Randevu.ConfirmationCode }}">

                        <div class="form-group">
                            <label for="complaint" class="form-label">Şikayet</label>
                            <textarea id="complaint" name="complaint" class="form-input" rows="4" placeholder="Hastanın şikayeti">{{ Randevu.Complaint }}</textarea>
                            <div class="field-error"></div>
                        </div>

                        <div class="form-group">
                            <label for="notes" class="form-label">Notlar</label>
                            <textarea id="notes" name="notes" class="form-input" rows="4" placeholder="Ek notlar">{{ Randevu.Notes }}</textarea>
                            <div class="field-error"></div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="confirmation_code" class="form-label">Onay Kodu</label>
                                <input type="text" id="confirmation_code" name="confirmation_code" class="form-input" value="{{ Randevu.ConfirmationCode }}" maxlength="10">
                                <div class="field-error"></div>
                            </div>
                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" id="reminder_sent" name="reminder_sent" {{ if Randevu.ReminderSent }}checked{{ end }}>
                                    <span class="checkmark"></span>
                                    Hatırlatma Gönderildi
                                </label>
                            </div>
                        </div>

                        {{if Randevu.Status == "iptal"}}
                        <div class="form-group">
                            <label for="cancel_reason" class="form-label">İptal Nedeni</label>
                            <textarea id="cancel_reason" name="cancel_reason" class="form-input" rows="3" placeholder="İptal nedeni">{{ Randevu.CancelReason }}</textarea>
                            <div class="field-error"></div>
                        </div>
                        {{end}}
                    
                </div>
            </div>
        </div>
        </form>
        <!-- Form Actions -->
        <div class="form-actions">
            <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                <i class="fas fa-arrow-left"></i>
                Geri
            </button>
            <button type="button" class="btn btn-primary" id="saveRandevuBtn">
                <i class="fas fa-save"></i>
                <span class="btn-text">Kaydet</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">Randevu başarıyla güncellendi.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script>
    // Pass data to JavaScript
    window.randevuData = {
        id: "{{ Randevu.Rid }}",
        sid: "{{ Randevu.Sid }}",
        drid: "{{ Randevu.Drid }}",
        brid: "{{ Randevu.Brid }}",
        tbid: "{{ Randevu.Tbid }}",
        tid: "{{ Randevu.Tid }}",
        akid: "{{ Randevu.Akid }}"
    };
</script>
<script src="{{ PathOnStart }}js/panel/randevu-duzenle.js"></script>