<link rel="stylesheet" href="{{ PathOnStart }}css/panel/anlasmali-kurumlar.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-handshake"></i>
                    Anlaşmalı Kurumlar
                </h1>
                <p class="page-subtitle">Anlaşmalı kurumları ve sözleşmelerini yönetin</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-secondary" id="refreshBtn">
                    <i class="fas fa-sync-alt"></i>
                    Yenile
                </button>
                <a href="/panel/anlasmali-kurumlar/anlasmali-kurumlar-ekle" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Yeni Kurum
                </a>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="filters-section">
        <div class="filters-content">
            <div class="search-group">
                <div class="search-input-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchInput" class="search-input" 
                           placeholder="Kurum adı, tip veya iletişim kişisi ile ara...">
                    <button class="search-clear" id="searchClear" style="display: none;">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <div class="filter-group">
                <select id="statusFilter" class="filter-select">
                    <option value="">Tüm Durumlar</option>
                    <option value="active">Aktif</option>
                    <option value="inactive">Pasif</option>
                </select>
                <select id="typeFilter" class="filter-select">
                    <option value="">Tüm Tipler</option>
                    <option value="sigorta">Sigorta</option>
                    <option value="kurumsal">Kurumsal</option>
                    <option value="universite">Üniversite</option>
                    <option value="devlet">Devlet</option>
                    <option value="ozel">Özel</option>
                </select>
                <select id="sortBy" class="filter-select">
                    <option value="created_at">Oluşturma Tarihi</option>
                    <option value="name">Kurum Adı</option>
                    <option value="type">Tip</option>
                    <option value="contract_end_date">Sözleşme Bitiş</option>
                    <option value="updated_at">Güncelleme Tarihi</option>
                </select>
                <select id="sortOrder" class="filter-select">
                    <option value="desc">Azalan</option>
                    <option value="asc">Artan</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-handshake"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number">{{Count}}</div>
                    <div class="stat-label">Toplam Kurum</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon active">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="activeCount">-</div>
                    <div class="stat-label">Aktif Kurumlar</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon inactive">
                    <i class="fas fa-pause-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="inactiveCount">-</div>
                    <div class="stat-label">Pasif Kurumlar</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon contract">
                    <i class="fas fa-file-contract"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="expiringCount">-</div>
                    <div class="stat-label">Sözleşmesi Biten</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">Anlaşmalı Kurumlar Listesi</h3>
                <div class="table-actions">
                    <button class="btn btn-sm btn-secondary" id="exportBtn">
                        <i class="fas fa-download"></i>
                        Dışa Aktar
                    </button>
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="table">
                            <i class="fas fa-list"></i>
                        </button>
                        <button class="view-btn" data-view="grid">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Table View -->
            <div class="table-wrapper" id="tableView">
                <table class="data-table" id="anlasmaliKurumlarTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-column="name">
                                <span>Kurum Adı</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="type">
                                <span>Tip</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th>
                                <span>İletişim</span>
                            </th>
                            <th>
                                <span>Şube</span>
                            </th>
                            <th class="sortable" data-column="is_active">
                                <span>Durum</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="updated_at">
                                <span>Son Güncelleme</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="actions-column">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{if len(AnlasmaliKurumlar) > 0}}
                            {{range AnlasmaliKurumlar}}
                            <tr data-id="{{ .Akid }}">
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .Name }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <span class="type-badge {{ .Type }}">
                                            {{if .Type == "sigorta"}}
                                                <i class="fas fa-shield-alt"></i>
                                                Sigorta
                                            {{else if .Type == "kurumsal"}}
                                                <i class="fas fa-building"></i>
                                                Kurumsal
                                            {{else if .Type == "universite"}}
                                                <i class="fas fa-graduation-cap"></i>
                                                Üniversite
                                            {{else if .Type == "devlet"}}
                                                <i class="fas fa-landmark"></i>
                                                Devlet
                                            {{else if .Type == "ozel"}}
                                                <i class="fas fa-user-tie"></i>
                                                Özel
                                            {{end}}
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .ContactPerson}}
                                        <div class="primary-text">{{ .ContactPerson }}</div>
                                        {{end}}
                                        {{if .Phone}}
                                        <div class="secondary-text">
                                            <a href="tel:{{ .Phone }}" class="phone-link">{{ .Phone }}</a>
                                        </div>
                                        {{end}}
                                        {{if .Email}}
                                        <div class="secondary-text">
                                            <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                        </div>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .SubeName }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .IsActive}}
                                        <span class="status-badge active">
                                            <i class="fas fa-check-circle"></i>
                                            Aktif
                                        </span>
                                        {{else}}
                                        <span class="status-badge inactive">
                                            <i class="fas fa-pause-circle"></i>
                                            Pasif
                                        </span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ mthr(.UpdatedAt, User.Timezone) }}</div>
                                        <div class="secondary-text">{{ mthr(.CreatedAt, User.Timezone) }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="actions-wrapper">
                                        <button class="action-trigger" data-id="{{ .Akid }}">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <div class="action-dropdown">
                                            <a href="/panel/anlasmali-kurumlar/{{ .Akid }}" class="action-item view">
                                                <i class="fas fa-eye"></i>
                                                <span>Görüntüle</span>
                                            </a>
                                            <a href="/panel/anlasmali-kurumlar/{{ .Akid }}/duzenle" class="action-item edit">
                                                <i class="fas fa-edit"></i>
                                                <span>Düzenle</span>
                                            </a>
                                            <div class="action-divider"></div>
                                            <button class="action-item delete" data-id="{{ .Akid }}" data-name="{{ .Name }}">
                                                <i class="fas fa-trash"></i>
                                                <span>Sil</span>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        {{else}}
                            <tr class="empty-row">
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-handshake"></i>
                                        </div>
                                        <div class="empty-title">Henüz anlaşmalı kurum bulunmuyor</div>
                                        <div class="empty-description">İlk anlaşmalı kurumunuzu oluşturmak için "Yeni Kurum" butonuna tıklayın.</div>
                                        <a href="/panel/anlasmali-kurumlar/anlasmali-kurumlar-ekle" class="btn btn-primary">
                                            <i class="fas fa-plus"></i>
                                            Yeni Kurum Oluştur
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>

            <!-- Grid View -->
            <div class="grid-wrapper" id="gridView" style="display: none;">
                <div class="anlasmali-kurumlar-grid">
                    {{if len(AnlasmaliKurumlar) > 0}}
                        {{range AnlasmaliKurumlar}}
                        <div class="anlasmali-kurum-card" data-id="{{ .Akid }}">
                            <div class="card-header">
                                <div class="card-title">{{ .Name }}</div>
                                <div class="card-actions">
                                    <button class="action-trigger" data-id="{{ .Akid }}">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="action-dropdown">
                                        <a href="/panel/anlasmali-kurumlar/{{ .Akid }}" class="action-item view">
                                            <i class="fas fa-eye"></i>
                                            <span>Görüntüle</span>
                                        </a>
                                        <a href="/panel/anlasmali-kurumlar/{{ .Akid }}/duzenle" class="action-item edit">
                                            <i class="fas fa-edit"></i>
                                            <span>Düzenle</span>
                                        </a>
                                        <div class="action-divider"></div>
                                        <button class="action-item delete" data-id="{{ .Akid }}" data-name="{{ .Name }}">
                                            <i class="fas fa-trash"></i>
                                            <span>Sil</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-field">
                                    <div class="field-label">Tip</div>
                                    <div class="field-value">
                                        <span class="type-badge {{ .Type }}">
                                            {{if .Type == "sigorta"}}
                                                <i class="fas fa-shield-alt"></i>
                                                Sigorta
                                            {{else if .Type == "kurumsal"}}
                                                <i class="fas fa-building"></i>
                                                Kurumsal
                                            {{else if .Type == "universite"}}
                                                <i class="fas fa-graduation-cap"></i>
                                                Üniversite
                                            {{else if .Type == "devlet"}}
                                                <i class="fas fa-landmark"></i>
                                                Devlet
                                            {{else if .Type == "ozel"}}
                                                <i class="fas fa-user-tie"></i>
                                                Özel
                                            {{end}}
                                        </span>
                                    </div>
                                </div>
                                {{if .ContactPerson}}
                                <div class="card-field">
                                    <div class="field-label">İletişim Kişisi</div>
                                    <div class="field-value">{{ .ContactPerson }}</div>
                                </div>
                                {{end}}
                                {{if .Phone}}
                                <div class="card-field">
                                    <div class="field-label">Telefon</div>
                                    <div class="field-value">
                                        <a href="tel:{{ .Phone }}" class="phone-link">{{ .Phone }}</a>
                                    </div>
                                </div>
                                {{end}}
                                {{if .Email}}
                                <div class="card-field">
                                    <div class="field-label">E-posta</div>
                                    <div class="field-value">
                                        <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                    </div>
                                </div>
                                {{end}}
                                <div class="card-field">
                                    <div class="field-label">Şube</div>
                                    <div class="field-value">{{ .SubeName }}</div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="card-status">
                                    {{if .IsActive}}
                                    <span class="status-badge active">
                                        <i class="fas fa-check-circle"></i>
                                        Aktif
                                    </span>
                                    {{else}}
                                    <span class="status-badge inactive">
                                        <i class="fas fa-pause-circle"></i>
                                        Pasif
                                    </span>
                                    {{end}}
                                </div>
                                <div class="card-date">{{ mthr(.UpdatedAt, User.Timezone) }}</div>
                            </div>
                        </div>
                        {{end}}
                    {{else}}
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-handshake"></i>
                            </div>
                            <div class="empty-title">Henüz anlaşmalı kurum bulunmuyor</div>
                            <div class="empty-description">İlk anlaşmalı kurumunuzu oluşturmak için "Yeni Kurum" butonuna tıklayın.</div>
                            <a href="/panel/anlasmali-kurumlar/anlasmali-kurumlar-ekle" class="btn btn-primary">
                                <i class="fas fa-plus"></i>
                                Yeni Kurum Oluştur
                            </a>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    {{if Count > 0}}
    <div class="pagination-section">
        <div class="pagination-info">
            <span>Toplam {{Count}} kayıt gösteriliyor</span>
        </div>
        <div class="pagination-wrapper">
            <nav class="pagination" id="pagination">
                <!-- Pagination will be generated by JavaScript -->
            </nav>
        </div>
        <div class="pagination-controls">
            <select id="perPage" class="per-page-select">
                <option value="10">10 / sayfa</option>
                <option value="25">25 / sayfa</option>
                <option value="50">50 / sayfa</option>
                <option value="100">100 / sayfa</option>
            </select>
        </div>
    </div>
    {{end}}
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Kurumu Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı kurumu silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="fas fa-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="fas fa-exclamation-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<script>
    function decodeHtmlEntities(encoded) {
        const txt = document.createElement('textarea');
        txt.innerHTML = encoded;
        return txt.value;
    }

    const escaped = '{{stj(AnlasmaliKurumlar)}}';
    const decoded = decodeHtmlEntities(escaped);
    const data = decoded ? JSON.parse(decoded) : [];
    window.pageData = {
        anlasmaliKurumlar: data,
        count: parseInt("{{ Count ? Count : 0 }}"),
        currentPage: parseInt("{{ Page ? Page : 1 }}"),
        perPage: parseInt("{{ 10 }}")
    };
</script>
<script src="{{ PathOnStart }}js/panel/anlasmali-kurumlar.js"></script>
