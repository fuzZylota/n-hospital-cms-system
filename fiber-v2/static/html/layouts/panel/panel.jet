<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ PageTitle }}</title>

    <!-- favicons Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="{{ PathOnStart }}files/defaults/favicon/nivgoz-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="{{ PathOnStart }}files/defaults/favicon/nivgoz-icon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="{{ PathOnStart }}files/defaults/favicon/nivgoz-icon.png" />
    <meta name="author" content="Nermefraz Bilişim Teknolojileri, Yazılım ve Danışmanlık. Nermefraz Information Technologies, Software Consulting and Development Company.">
    <meta name="description" content="N-Hospital Gelişmiş Hastane Cms Sistemi'nin İdare Paneli." />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ PathOnStart }}assets/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/bootstrap-select/bootstrap-select.min.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/animate/animate.min.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/jquery-ui/jquery-ui.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/jarallax/jarallax.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/jquery-magnific-popup/jquery.magnific-popup.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/nouislider/nouislider.min.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/nouislider/nouislider.pips.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/tiny-slider/tiny-slider.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/mediox-icons/style.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/owl-carousel/css/owl.carousel.min.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/owl-carousel/css/owl.theme.default.min.css" />
    <link rel="stylesheet" href="{{ PathOnStart }}assets/slick/css/slick.css" />

    <link rel="stylesheet" href="{{ PathOnStart }}css/panel/style.css">
</head>
<body>
    <div class="admin-layout">
        {{ include "../../components/panel-sidebar" }}
        
        {{ include "../../components/panel-header" }}
        
        <main class="admin-content">
            <div style="padding: 24px;">
                {{embed()}}
            </div>
        </main>
    </div>
    
    <!-- JavaScript -->
    <script src="{{ PathOnStart }}js/panel/script.js"></script>
    <script src="{{ PathOnStart }}js/panel/notifications.js"></script>
</body>
</html>