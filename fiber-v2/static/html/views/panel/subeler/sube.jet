<link rel="stylesheet" href="{{ PathOnStart }}css/panel/sube.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/subeler" class="breadcrumb-link">
                        <i class="fas fa-building"></i>
                        Şubeler
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">{{ Sube.Name }}</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">{{ Sube.Name }}</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-calendar"></i>
                                {{ mthr(Sube.CreatedAt, User.Timezone) }}
                            </span>
                            <span class="meta-item">
                                <i class="fas fa-clock"></i>
                                Son güncelleme: {{ mthr(Sube.UpdatedAt, User.Timezone) }}
                            </span>
                        </div>
                    </div>
                </h1>
                {{if Sube.Description}}
                <p class="page-subtitle">{{ Sube.Description }}</p>
                {{end}}
            </div>
            <div class="page-actions">
                <div class="status-indicator">
                    {{if Sube.IsMain}}
                    <span class="status-badge main">
                        <i class="fas fa-star"></i>
                        Ana Şube
                    </span>
                    {{end}}
                    {{if Sube.IsActive}}
                    <span class="status-badge active">
                        <i class="fas fa-check-circle"></i>
                        Aktif
                    </span>
                    {{else}}
                    <span class="status-badge inactive">
                        <i class="fas fa-pause-circle"></i>
                        Pasif
                    </span>
                    {{end}}
                </div>
                <div class="action-buttons">
                    <a href="/panel/subeler/{{ Sube.Sid }}/duzenle" class="btn btn-primary">
                        <i class="fas fa-edit"></i>
                        Düzenle
                    </a>
                    {{if !Sube.IsMain}}
                    <button class="btn btn-secondary" id="setMainSubeBtn" data-id="{{ Sube.Sid }}" data-name="{{ Sube.Name }}">
                        <i class="fas fa-star"></i>
                        <span class="btn-text">Ana Şube Yap</span>
                        <div class="btn-loader" style="display: none;">
                            <div class="spinner"></div>
                        </div>
                    </button>
                    {{end}}
                    <button class="btn btn-danger" id="deleteSubeBtn" data-id="{{ Sube.Sid }}" data-name="{{ Sube.Name }}">
                        <i class="fas fa-trash"></i>
                        <span class="btn-text">Sil</span>
                        <div class="btn-loader" style="display: none;">
                            <div class="spinner"></div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Sections -->
    <div class="content-grid">
        <!-- Basic Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <h3 class="card-title">Temel Bilgiler</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item">
                        <label class="info-label">Şube Adı</label>
                        <div class="info-value">{{ Sube.Name }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">URL Adı</label>
                        <div class="info-value">{{ Sube.UrlName }}</div>
                    </div>
                    {{if Sube.Description}}
                    <div class="info-item full-width">
                        <label class="info-label">Açıklama</label>
                        <div class="info-value">{{ Sube.Description }}</div>
                    </div>
                    {{end}}
                    {{if Sube.SubeMediaPath}}
                    <div class="info-item">
                        <label class="info-label">Şube Görseli</label>
                        <div class="info-value">
                            <div class="image-preview" data-media-id="{{ Sube.Mid }}">
                                <img src="{{ PathOnStart }}{{ Sube.SubeMediaPath }}" alt="{{ Sube.SubeMediaAltText }}" title="{{ Sube.SubeMediaTitle }}" class="preview-image zoomable">
                                <div class="image-overlay">
                                    <i class="icon-maximize"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{end}}
                    <div class="info-item">
                        <label class="info-label">Şube Türü</label>
                        <div class="info-value">
                            {{if Sube.IsMain}}
                            <span class="branch-badge main">
                                <i class="fas fa-star"></i>
                                Ana Şube
                            </span>
                            {{else}}
                            <span class="branch-badge branch">
                                <i class="fas fa-building"></i>
                                Şube
                            </span>
                            {{end}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Location Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <h3 class="card-title">Konum Bilgileri</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item full-width">
                        <label class="info-label">Adres</label>
                        <div class="info-value">{{ Sube.Address }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Şehir</label>
                        <div class="info-value">{{ Sube.City }}</div>
                    </div>
                    {{if Sube.District}}
                    <div class="info-item">
                        <label class="info-label">İlçe</label>
                        <div class="info-value">{{ Sube.District }}</div>
                    </div>
                    {{end}}
                    {{if Sube.PostalCode}}
                    <div class="info-item">
                        <label class="info-label">Posta Kodu</label>
                        <div class="info-value">{{ Sube.PostalCode }}</div>
                    </div>
                    {{end}}
                    {{if Sube.Latitude != 0 && Sube.Longitude != 0}}
                    <div class="info-item">
                        <label class="info-label">Enlem</label>
                        <div class="info-value">{{ Sube.Latitude }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">Boylam</label>
                        <div class="info-value">{{ Sube.Longitude }}</div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>

        <!-- Contact Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-phone"></i>
                </div>
                <h3 class="card-title">İletişim Bilgileri</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    {{if Sube.Phone}}
                    <div class="info-item">
                        <label class="info-label">Telefon</label>
                        <div class="info-value">
                            <a href="tel:{{ Sube.Phone }}" class="contact-link">
                                <i class="icon-phone"></i>
                                {{ Sube.Phone }}
                            </a>
                        </div>
                    </div>
                    {{end}}
                    {{if Sube.Fax}}
                    <div class="info-item">
                        <label class="info-label">Faks</label>
                        <div class="info-value">{{ Sube.Fax }}</div>
                    </div>
                    {{end}}
                    {{if Sube.Email}}
                    <div class="info-item">
                        <label class="info-label">E-posta</label>
                        <div class="info-value">
                            <a href="mailto:{{ Sube.Email }}" class="contact-link">
                                <i class="icon-mail"></i>
                                {{ Sube.Email }}
                            </a>
                        </div>
                    </div>
                    {{end}}
                    {{if Sube.Website}}
                    <div class="info-item">
                        <label class="info-label">Website</label>
                        <div class="info-value">
                            <a href="{{ Sube.Website }}" target="_blank" class="contact-link">
                                <i class="icon-external-link"></i>
                                {{ Sube.Website }}
                            </a>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>

        <!-- Services and Hours Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <h3 class="card-title">Hizmetler ve Çalışma Saatleri</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    {{if Sube.WorkingHours}}
                    <div class="info-item full-width">
                        <label class="info-label">Çalışma Saatleri</label>
                        <div class="info-value">
                            <code class="code-block">{{ Sube.WorkingHours }}</code>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>

        <!-- Related Doctors Section -->
        {{if len(Doktorlar) > 0}}
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-user-md"></i>
                </div>
                <h3 class="card-title">Bu Şubedeki Doktorlar ({{ len(Doktorlar) }})</h3>
            </div>
            <div class="card-content">
                <div class="related-list">
                    {{range Doktorlar}}
                    <div class="related-item">
                        <div class="related-info">
                            <div class="related-title">{{ .Title }} {{ .FirstName }} {{ .LastName }}</div>
                            <div class="related-details">
                                {{if .Phone}}
                                <span class="detail-item">
                                    <i class="fas fa-phone"></i>
                                    {{ .Phone }}
                                </span>
                                {{end}}
                                {{if .Email}}
                                <span class="detail-item">
                                    <i class="fas fa-envelope"></i>
                                    {{ .Email }}
                                </span>
                                {{end}}
                            </div>
                        </div>
                        <div class="related-actions">
                            <a href="/panel/doktorlar/{{ .Drid }}" class="btn btn-sm btn-secondary">
                                <i class="fas fa-eye"></i>
                                Görüntüle
                            </a>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
        {{end}}

        <!-- Related Branches Section -->
        {{if len(Branslar) > 0}}
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-sitemap"></i>
                </div>
                <h3 class="card-title">Bu Şubedeki Branşlar ({{ len(Branslar) }})</h3>
            </div>
            <div class="card-content">
                <div class="related-list">
                    {{range Branslar}}
                    <div class="related-item">
                        <div class="related-info">
                            <div class="related-title">{{ .Name }}</div>
                            <div class="related-details">
                                {{if .Phone}}
                                <span class="detail-item">
                                    <i class="fas fa-phone"></i>
                                    {{ .Phone }}
                                </span>
                                {{end}}
                                {{if .Email}}
                                <span class="detail-item">
                                    <i class="fas fa-envelope"></i>
                                    {{ .Email }}
                                </span>
                                {{end}}
                            </div>
                        </div>
                        <div class="related-actions">
                            <a href="/panel/branslar/{{ .Brid }}" class="btn btn-sm btn-secondary">
                                <i class="fas fa-eye"></i>
                                Görüntüle
                            </a>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
        {{end}}

        <!-- Related Appointments Section -->
        {{if len(Randevular) > 0}}
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <h3 class="card-title">Bu Şubeye Ait Randevular ({{ len(Randevular) }})</h3>
            </div>
            <div class="card-content">
                <div class="related-list">
                    {{range Randevular}}
                    <div class="related-item">
                        <div class="related-info">
                            <div class="related-title">{{ .PatientFirstName }} {{ .PatientLastName }}</div>
                            <div class="related-details">
                                <span class="detail-item">
                                    <i class="fas fa-calendar"></i>
                                    {{ mthr(.AppointmentDate, User.Timezone) }}
                                </span>
                                <span class="detail-item">
                                    <i class="fas fa-phone"></i>
                                    {{ .PatientPhone }}
                                </span>
                                <span class="detail-item status-{{ .Status }}">
                                    <i class="fas fa-info-circle"></i>
                                    {{ .Status }}
                                </span>
                            </div>
                        </div>
                        <div class="related-actions">
                            <a href="/panel/randevular/{{ .Rid }}" class="btn btn-sm btn-secondary">
                                <i class="fas fa-eye"></i>
                                Görüntüle
                            </a>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
        {{end}}

        <!-- Related Contract Partners Section -->
        {{if len(AnlasmaliKurumlar) > 0}}
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-handshake"></i>
                </div>
                <h3 class="card-title">Anlaşmalı Kurumlar ({{ len(AnlasmaliKurumlar) }})</h3>
            </div>
            <div class="card-content">
                <div class="related-list">
                    {{range AnlasmaliKurumlar}}
                    <div class="related-item">
                        <div class="related-info">
                            <div class="related-title">{{ .Name }}</div>
                            <div class="related-details">
                                <span class="detail-item">
                                    <i class="fas fa-tag"></i>
                                    {{if .Type == "sigorta"}}
                                        Sigorta
                                    {{else if .Type == "kurumsal"}}
                                        Kurumsal
                                    {{else if .Type == "universite"}}
                                        Üniversite
                                    {{else if .Type == "devlet"}}
                                        Devlet
                                    {{else if .Type == "ozel"}}
                                        Özel
                                    {{end}}
                                </span>
                                {{if .ContactPerson}}
                                <span class="detail-item">
                                    <i class="fas fa-user"></i>
                                    {{ .ContactPerson }}
                                </span>
                                {{end}}
                                {{if .Phone}}
                                <span class="detail-item">
                                    <i class="fas fa-phone"></i>
                                    {{ .Phone }}
                                </span>
                                {{end}}
                                {{if .Email}}
                                <span class="detail-item">
                                    <i class="fas fa-envelope"></i>
                                    {{ .Email }}
                                </span>
                                {{end}}
                                {{if .DiscountRate}}
                                <span class="detail-item">
                                    <i class="fas fa-percentage"></i>
                                    %{{ .DiscountRate }} İndirim
                                </span>
                                {{end}}
                                <span class="detail-item status-{{ if .IsActive }}active{{ else }}inactive{{ end }}">
                                    <i class="fas fa-{{ if .IsActive }}check-circle{{ else }}pause-circle{{ end }}"></i>
                                    {{ if .IsActive }}Aktif{{ else }}Pasif{{ end }}
                                </span>
                            </div>
                        </div>
                        <div class="related-actions">
                            <a href="/panel/anlasmali-kurumlar/{{ .Akid }}" class="btn btn-sm btn-secondary">
                                <i class="fas fa-eye"></i>
                                Görüntüle
                            </a>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
        {{end}}

        <!-- Documents Section -->
        {{if len(SubeDocuments) > 0}}
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-file-alt"></i>
                </div>
                <h3 class="card-title">Şube Dokümanları ({{ len(SubeDocuments) }})</h3>
            </div>
            <div class="card-content">
                <div class="documents-grid">
                    {{range SubeDocuments}}
                    <div class="document-item" data-mid="{{ .Mid }}">
                        <div class="document-header">
                            <div class="document-icon">
                                {{if contains(.MimeType, "image/")}}
                                    <i class="fas fa-image"></i>
                                {{else if contains(.MimeType, "video/")}}
                                    <i class="fas fa-video"></i>
                                {{else if contains(.MimeType, "audio/")}}
                                    <i class="fas fa-music"></i>
                                {{else if contains(.MimeType, "application/pdf")}}
                                    <i class="fas fa-file-pdf"></i>
                                {{else if contains(.MimeType, "application/msword")}}
                                    <i class="fas fa-file-word"></i>
                                {{else if contains(.MimeType, "application/vnd.openxmlformats-officedocument.wordprocessingml.document")}}
                                    <i class="fas fa-file-word"></i>
                                {{else if contains(.MimeType, "application/vnd.ms-excel")}}
                                    <i class="fas fa-file-excel"></i>
                                {{else if contains(.MimeType, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")}}
                                    <i class="fas fa-file-excel"></i>
                                {{else if contains(.MimeType, "application/vnd.ms-powerpoint")}}
                                    <i class="fas fa-file-powerpoint"></i>
                                {{else if contains(.MimeType, "application/vnd.openxmlformats-officedocument.presentationml.presentation")}}
                                    <i class="fas fa-file-powerpoint"></i>
                                {{else if contains(.MimeType, "text/")}}
                                    <i class="fas fa-file-alt"></i>
                                {{else if contains(.MimeType, "application/zip")}}
                                    <i class="fas fa-file-archive"></i>
                                {{else}}
                                    <i class="fas fa-file"></i>
                                {{end}}
                            </div>
                            <div class="document-info">
                                <h4 class="document-name">{{ .FileName }}</h4>
                                <div class="document-meta">
                                    <span class="document-size">{{ .FileSize }} bytes</span>
                                    <span class="document-date">{{ mthr(.CreatedAt, User.Timezone) }}</span>
                                </div>
                                {{if .Data}}
                                <div class="document-data">
                                    <strong>Ek Bilgi:</strong> {{ .Data }}
                                </div>
                                {{end}}
                            </div>
                        </div>
                        <div class="document-actions">
                            <button type="button" class="btn btn-primary btn-sm btn-preview-document" data-mid="{{ .Mid }}" data-mimetype="{{ .MimeType }}" data-filepath="{{ .FilePath }}">
                                <i class="fas fa-eye"></i>
                                Önizle
                            </button>
                            <a href="{{ PathOnStart }}{{ .FilePath }}" target="_blank" class="btn btn-secondary btn-sm">
                                <i class="fas fa-download"></i>
                                İndir
                            </a>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
        {{end}}
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Şubeyi Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı şubeyi silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz ve tüm ilişkili veriler silinecektir.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="icon-trash-2"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="imageZoomModal" class="modal image-modal" style="display: none;">
    <div class="modal-content image-content">
        <button class="modal-close" onclick="closeImageModal()">
            <i class="icon-x"></i>
        </button>
        <div class="image-container">
            <img id="zoomedImage" src="" alt="Zoomed Image">
        </div>
        <div class="image-info">
            <span id="imageTitle">Görsel</span>
            <div class="image-actions">
                <button class="btn btn-sm btn-secondary" onclick="downloadImage()">
                    <i class="icon-download"></i>
                    İndir
                </button>
                <button class="btn btn-sm btn-secondary" onclick="openImageInNewTab()">
                    <i class="icon-external-link"></i>
                    Yeni Sekmede Aç
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Document Preview Modal -->
<div id="documentPreviewModal" class="modal document-modal" style="display: none;">
    <div class="modal-content document-content">
        <div class="modal-header">
            <h3 class="modal-title" id="documentPreviewTitle">Doküman Önizleme</h3>
            <button class="modal-close" onclick="closeDocumentPreviewModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="document-preview-container" id="documentPreviewContainer">
                <!-- Content will be loaded here based on MIME type -->
            </div>
        </div>
        <div class="modal-footer">
            <div class="document-info">
                <span id="documentPreviewInfo">Dosya bilgileri</span>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="icon-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="icon-alert-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<script>
    // Pass data to JavaScript
    window.subeData = {
        id: parseInt("{{ Sube.Sid }}"),
        name: "{{ Sube.Name }}"
    };
</script>
<script src="{{ PathOnStart }}js/panel/sube.js"></script>
