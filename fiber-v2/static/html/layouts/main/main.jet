    <link rel="stylesheet" href="{{ PathOnStart }}css/style.css?v=20260913c">

        <link rel="stylesheet" href="{{ PathOnStart }}css/custom.css?v=20260913-footer3">
            <style>
/*
 * Header / Topbar - consolidated single source of truth.
 *
 * style.css ve custom.css icinde ayni .header-four / .main-header /
 * .topbar-one / .header-spacer secicileri icin 40'in uzerinde parca parca
 * ve zaman zaman birbirini gecersiz kilan kural birikmisti. Bu dosya,
 * canli sitede olculen NIHAI gorsel sonucu (renk, konum, z-index, icerik
 * bosluklama) TEK yerde tanimlar. Eski parcalar sonraki asamada
 * temizlenecek; bu dosya su an icin en son yuklenerek onlarin uzerine
 * kesin sonucu yazar.
 */

.header-four {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 9999 !important;
}

body.homepage .header-four {
    background-color: #ffffff !important;
}

body:not(.homepage) .header-four {
    background-color: transparent !important;
}

.topbar-one {
    position: relative !important;
    background-color: var(--theme-primary-color, #0A2241) !important;
}

.main-header {
    position: relative !important;
    z-index: 10002 !important;
    background-color: #ffffff !important;
    box-shadow: 0 2px 14px rgba(15, 23, 42, 0.08) !important;
}

body.homepage .main-header {
    box-shadow: none !important;
}

@media (max-width: 991px) {
    body.homepage .main-header {
        background-color: transparent !important;
    }
}

/* NOT: .header-spacer / .homepage-header-spacer buraya bilerek eklenmedi.
   Bu spacer div'leri, ic sayfalarda fixed header'in altindaki icerik
   bosluklamasini saglayan GERCEKTEN AKTIF elemanlar (style.css/custom.css
   icindeki responsive kurallarla yonetiliyor). Ilk analizde "olu kod"
   sanilmisti ama canli testte bunun yanlis oldugu anlasildi - o yüzden
   bu dosyada ellenmiyor, eski kurallari SILMEYIN.
*/

/* NOT: mobilde .header-four (topbar+main-header) fixed ve toplam yuksekligi
   ~126px. Onceki degerde (74px, sadece main-header yuksekligi) slider'in
   ust ~52px'i (topbar kadar) fixed header'in altinda kaliyordu - gercek
   bug buydu, kullanici raporuyla bulundu ve 126px'e duzeltildi. */
.page-wrapper.homepage .main-slider-three,
.page-wrapper.homepage section.main-slider-three,
body > .page-wrapper.homepage .main-slider-three,
body > .page-wrapper.homepage section.main-slider-three {
    margin-top: 126px !important;
}

@media (min-width: 992px) {
    .page-wrapper.homepage .main-slider-three,
    .page-wrapper.homepage section.main-slider-three,
    body > .page-wrapper.homepage .main-slider-three,
    body > .page-wrapper.homepage section.main-slider-three {
        margin-top: 136px !important;
    }
}

/* Mobil menu acildiginda arka plan sayfa icerigiyle karisip amatorce
   gorunuyordu (karartma katmani devre disiydi, panelin net bir alt
   siniri yoktu). Kullanici raporuyla bulundu.
   ONEMLI (deneme-yanilma ile ogrenildi):
   1) .mobile-nav__overlay, .mobile-nav__wrapper'in (overflow:hidden)
      icinde. position:fixed yapmak onu menu panelinin (dropdown
      butonlari dahil) ONUNE geciriyordu - tiklamalari yutuyordu.
      position:absolute yapmak da wrapper'in overflow:hidden'i
      tarafindan kirpiliyor, hic gorunmuyordu.
   2) Bu yuzden karartmayi .mobile-nav__overlay yerine body'ye eklenen
      ayri bir ::after katmaniyla yapiyoruz - wrapper'in disinda,
      header-four ile AYNI (position:fixed) kok seviyesinde, z-index'i
      header-four'dan (9999) DUSUK olacak sekilde - boylece ne
      kirpiliyor ne de menu tiklamalarini engelliyor. */
body.mobile-nav-expanded::after {
    content: "" !important;
    display: block !important;
    position: fixed !important;
    top: 126px !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    background-color: rgba(15, 23, 42, 0.55) !important;
    z-index: 9995 !important;
    pointer-events: none !important;
}

@media (min-width: 992px) {
    body.mobile-nav-expanded::after {
        top: 136px !important;
    }
}

.mobile-nav__content {
    border-bottom: 3px solid var(--theme-primary-color, #0A2241) !important;
    box-shadow: 0 6px 12px rgba(15, 23, 42, 0.12) !important;
}

/* Mobilde iOS Safari'nin dinamik adres cubugu (toolbar) acilip kapanirken
   position:fixed elemanlari gorsel olarak asagi/yukari kaydiriyor (bilinen
   WebKit davranisi - layout viewport fixed elemanlara, toolbar gecisi
   sirasinda visual viewporttan farkli davraniyor). position:sticky ise
   bu gecislerde sabit kaliyor. Kullanici raporuyla bulundu: sayfa asagi
   cekilince (pull-to-refresh) topbar+header da kayiyordu, dunyagoz'de
   kaymiyor. Sadece mobilde sticky'e ceviriyoruz, masaustu (fixed) ayni
   kaliyor - mobil menu/karartma katmani (asagida) fixed pozisyonlu ayri
   bir eleman oldugu icin bundan etkilenmiyor. */
    </style>
    <style>
/* ---- cls-guard.css ---- */
/*
 * cls-guard.css — carousel kurulumundan once yer rezervasyonu
 *
 * Sorun: Owl ve Slick, JS kurulumu bitene kadar sayfa yuksekligini
 * yanlis birakiyor. Kurulum defer'li script'lerle DOMContentLoaded
 * sonrasina dustugu icin bu, ilk boyadan sonra buyuk bir duzen
 * kaymasi (CLS) uretiyor.
 *
 *   Owl  : owl.carousel.min.css icinde .owl-carousel{display:none}
 *          Kurulumda .owl-loaded eklenene kadar yukseklik 0, sonra
 *          birden tam yukseklige aciliyor.
 *   Slick: Kurulumdan once slide'lar sira disi blok eleman; hepsi
 *          alt alta yigiliyor. Kurulumda tek slide'a cokuyor.
 *
 * Cozum: kurulumdan once, kurulum SONRASI duzenin aynisini kur.
 * Boylece rezerve edilen yukseklik de genislik de bastan dogru olur.
 *
 * Kurulum tamamlaninca .owl-loaded / .slick-initialized geliyor ve
 * buradaki kurallar kendiliginden devre disi kaliyor.
 */

/* ---- Owl ---- */

/*
 * Owl'un oge genisligi olcuyle dogrulandi (375 / 800 / 1200 px, uc
 * karusel, iki farkli items degeri):
 *
 *     ogeGenislik = (kapsayici - margin * (items - 1)) / items
 *
 * Bu, gap:margin olan bir flex satirinin matematiginin birebir aynisi.
 * Asagidaki kurallar her kirilimda o duzeni kuruyor, yani kurulumdan
 * once ve sonra ayni genislik ve ayni yukseklik olusuyor.
 *
 * Degerler bilesenlerdeki data-owl-options ile eslesmeli:
 *   doctorCarousel / tibbiCarousel : 0>2/10  768>3/16  992>4/20
 *   merkezCarousel                 : 0>2/10  768>3/16  992>3/20
 */

.owl-carousel:not(.owl-loaded) {
    display: flex;
    overflow: hidden;
}

/* Taninmayan karuseller icin guvenli varsayilan: tek oge, tam genislik. */
.owl-carousel:not(.owl-loaded) > .item {
    flex: 0 0 100%;
}

#doctorCarousel:not(.owl-loaded),
#tibbiCarousel:not(.owl-loaded),
#merkezCarousel:not(.owl-loaded) {
    gap: 10px;
}

#doctorCarousel:not(.owl-loaded) > .item,
#tibbiCarousel:not(.owl-loaded) > .item,
#merkezCarousel:not(.owl-loaded) > .item {
    flex: 0 0 calc((100% - 10px) / 2);
}

@media (min-width: 768px) {
    #doctorCarousel:not(.owl-loaded),
    #tibbiCarousel:not(.owl-loaded),
    #merkezCarousel:not(.owl-loaded) {
        gap: 16px;
    }

    #doctorCarousel:not(.owl-loaded) > .item,
    #tibbiCarousel:not(.owl-loaded) > .item,
    #merkezCarousel:not(.owl-loaded) > .item {
        flex: 0 0 calc((100% - 32px) / 3);
    }
}

@media (min-width: 992px) {
    #doctorCarousel:not(.owl-loaded),
    #tibbiCarousel:not(.owl-loaded),
    #merkezCarousel:not(.owl-loaded) {
        gap: 20px;
    }

    #doctorCarousel:not(.owl-loaded) > .item,
    #tibbiCarousel:not(.owl-loaded) > .item {
        flex: 0 0 calc((100% - 60px) / 4);
    }

    #merkezCarousel:not(.owl-loaded) > .item {
        flex: 0 0 calc((100% - 40px) / 3);
    }
}

/* ---- Slick (anasayfa banner) ---- */

.main-slider-three__carousel:not(.slick-initialized) > .main-slider-three__item:not(:first-child) {
    display: none;
}

/*
 * JS kapaliysa veya kurulum hic olmazsa: Owl kendi display:none'ini
 * geri aldigimiz icin kartlar yatay bir satirda gorunur kalir
 * (overflow:hidden ile kirpilarak), Slick'te ilk slide gorunur kalir.
 * Her iki durumda da sayfa kullanilabilir durumda.
 */
    </style>
    <style>
/* ---- root-gap.css ---- */
/*
 * root-gap.css — main.jet icindeki ROOT_GAP_RUNTIME_FIX script'inin
 * CSS karsiligi.
 *
 * O script ayni duzeni JS ile kuruyordu ve DOMContentLoaded, load,
 * resize'in yani sira 300 / 1000 / 2000 ms'lik setTimeout'larla alti
 * kez tetikleniyordu. Duzeni ilk boyadan sonra degistirdigi icin
 * dogrudan CLS uretiyordu:
 *
 *   - Masaustu: CSS slider'a margin-top:var(--dg-total-h) = 136px
 *     veriyor (style.css:2616 + style.css:1567), JS bunu 122px'e
 *     dusuruyordu. 14px'lik tam genislik kaymasi.
 *   - Mobil: CSS 74px veriyor (style.css:1576), JS sifirliyordu.
 *     74px'lik tam genislik kaymasi. PageSpeed mobil olctugu icin
 *     asil maliyet buydu.
 *
 * Buradaki degerler script'in urettigi son durumun AYNISI. Gorunen
 * duzen degismiyor; yalnizca ilk boyada uygulaniyor.
 *
 * Script'in tek basina yaptigi is Google Translate'in ekledigi
 * body{top:40px} ve banner iframe'ini bastirmakti. style.css:2623
 * bunu zaten yapiyor ama @media (min-width:992px) icine kilitli;
 * burada tum genisliklerde gecerli kiliniyor.
 */

/* ---- Google Translate'in enjekte ettigi bosluk ---- */

html,
body,
body.skiptranslate {
    margin-top: 0 !important;
    padding-top: 0 !important;
    top: 0 !important;
}

iframe.goog-te-banner-frame,
.goog-te-banner-frame,
.goog-te-banner-frame.skiptranslate,
body > iframe.skiptranslate {
    display: none !important;
    height: 0 !important;
    visibility: hidden !important;
}

/* ---- Anasayfa ust bosluk ---- */

body > .page-wrapper {
    margin-top: 0 !important;
}

.page-wrapper.homepage {
    margin-top: 0 !important;
    padding-top: 0 !important;
}

.page-wrapper.homepage > .header-spacer {
    display: none !important;
    height: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
}

/*
 * Slider ust boslugu. Script'teki degerlerin birebir karsiligi:
 * window.innerWidth >= 992 -> 122px, altinda -> 0.
 */
.page-wrapper.homepage .main-slider-three,
.page-wrapper.homepage section.main-slider-three {
    margin-top: 0 !important;
    padding-top: 0 !important;
}

@media (min-width: 992px) {
    .page-wrapper.homepage .main-slider-three,
    .page-wrapper.homepage section.main-slider-three {
        margin-top: 122px !important;
    }
}
    </style>
{{ if false && Options.Options.GoogleAnalytics != "" }}
        {{ Options.Options.GoogleAnalytics | raw }}
    {{ end }}
</head>


<body class="{{ if Route == "/" }}homepage{{ end }}">
    <a href="#anaIcerik" class="skip-to-content">İçeriğe atla</a>
    

    

    {{ if Options.Options.Preloader != "" }}
        {{ Options.Options.Preloader | raw }}
    {{ end }}
    
    

    <a href="#" data-target="html" class="scroll-to-target scroll-to-top">
        <span class="scroll-to-top__text">Yukarı Çık</span>
        <span class="scroll-to-top__wrapper"><span class="scroll-to-top__inner"></span></span>
    </a>

    <div class="header-four">
        {{ include "../../components/frontend-topbar" }}

        {{ include "../../components/frontend-header" }}
    </div>

    <div class="page-wrapper{{ if Route == "/" }} homepage{{ end }}">
        
         <div class="header-spacer" id="nvHeaderSpacer"></div>

         <main id="anaIcerik" tabindex="-1">
         {{ embed() }}
         </main>

         {{ include "../../components/frontend-sidebar" }}
    
         {{ include "../../components/frontend-footer" }}
         {{ if Route != "/randevu" }}{{ include "../../components/fast-randevu" }}{{ end }}
    </div>

    <script defer src="{{ PathOnStart }}js/frontend/fast-randevu.js"></script>
    <script defer src="{{ PathOnStart }}js/frontend/hareket-tercihi.js"></script>

    {{ if Route == "/" }}
        <script defer src="{{ PathOnStart }}js/frontend/not-transparent-when-scrolled-down.js"></script>
        <script defer src="{{ PathOnStart }}js/frontend/insert-randevu-talebi.js"></script>
    {{ end }}
    <script defer src="{{ PathOnStart }}js/frontend/sticky-topbar.js"></script>

    {{ if Route == "/kurumsal/insan-kaynaklari" }}
        <script defer src="{{ PathOnStart }}js/frontend/insan-kaynaklari.js"></script>
    {{ end }}

    {{ if Route == "/iletisim" }}
        <script defer src="{{ PathOnStart }}js/frontend/iletisim.js"></script>
    {{ end }}

    {{ if Route == "/doktorlar/:sube/doktorlar" }}
        <script defer src="{{ PathOnStart }}js/frontend/doktorlar.js"></script>
    {{ end }}

    <script defer src="{{ PathOnStart }}assets/jquery/jquery-3.7.0.min.js"></script>
    <script defer src="{{ PathOnStart }}js/script.js"></script>
    <script defer src="{{ PathOnStart }}assets/bootstrap/js/bootstrap.bundle.min.js"></script>

    {{ if Route == "/randevu" }}
        <script defer src="{{ PathOnStart }}assets/jquery-ui/jquery-ui.js"></script>
        <script defer src="{{ PathOnStart }}assets/bootstrap-select/bootstrap-select.min.js"></script>
    {{ end }}

    {{ if Route == "/randevu" || Route == "/iletisim" }}
        <script defer src="{{ PathOnStart }}assets/jquery-validate/jquery.validate.min.js"></script>
    {{ end }}

    {{ if Route == "/" }}
        <script defer src="{{ PathOnStart }}assets/owl-carousel/js/owl.carousel.min.js"></script>
        <script defer src="{{ PathOnStart }}assets/slick/js/slick.min.js"></script>
    {{ end }}

    <script defer src="{{ PathOnStart }}assets/wow/wow.js"></script>
    <script defer src="{{ PathOnStart }}assets/mediox.js"></script>
    <script defer src="{{ PathOnStart }}assets/mediox-landing.js"></script>


<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('a[href^="tel:"]').forEach(function (a) {
    a.textContent = a.textContent.replace(/\+/g, '').trim();
  });
});
</script>





<div id="nvCookieBanner" aria-live="polite">
    <div class="nv-ck-wrap">
        <div class="nv-ck-text">
            <div class="nv-ck-title">Çerezleri kullanıyoruz</div>
            <div class="nv-ck-desc">
                Deneyiminizi iyileştirmek için çerez kullanıyoruz. Zorunlu çerezler her zaman aktiftir.
            </div>
        </div>
        <div class="nv-ck-btns">
            <button type="button" class="nv-ck-btn nv-ck-btn--accept" onclick="nvAcceptAllCookies()">Kabul Et</button>
            <button type="button" class="nv-ck-btn nv-ck-btn--reject" onclick="nvRejectAllCookies()">Reddet</button>
        </div>
        <button type="button" class="nv-ck-manage-link" onclick="nvOpenCookieSettings()">Tercihleri yönet</button>
    </div>
</div>

<div id="nvCookieBackdrop" onclick="nvCloseCookieSettings()"></div>

<div id="nvCookieModal" role="dialog" aria-modal="true" aria-labelledby="nvCookieModalTitle">
    <div class="nv-ckm-head">
        <div>
            <div id="nvCookieModalTitle" class="nv-ckm-title">Çerez Tercihleri</div>
            <div class="nv-ckm-subtitle">Zorunlu çerezler her zaman açık kalır. Analitik çerezleri isteğinize göre açıp kapatabilirsiniz.</div>
        </div>
        <button type="button" class="nv-ckm-close" onclick="nvCloseCookieSettings()" aria-label="Kapat">×</button>
    </div>

    <div class="nv-ckm-body">
        <div class="nv-ckm-row">
            <div class="nv-ckm-info">
                <div class="nv-ckm-label">Zorunlu Çerezler</div>
                <div class="nv-ckm-text">Sitenin temel işlevleri için gereklidir. Kapatılamaz.</div>
            </div>
            <label class="nv-switch nv-switch--locked">
                <input type="checkbox" checked disabled>
                <span class="nv-slider"></span>
            </label>
        </div>

        <div class="nv-ckm-row">
            <div class="nv-ckm-info">
                <div class="nv-ckm-label">Analitik Çerezler</div>
                <div class="nv-ckm-text">Google Analytics ile trafik ve kullanım istatistiklerini ölçmemizi sağlar.</div>
            </div>
            <label class="nv-switch">
                <input type="checkbox" id="nvAnalyticsToggle">
                <span class="nv-slider"></span>
            </label>
        </div>

        <div class="nv-ckm-links">
            <a href="/kurumsal/cerez-politikasi">KVKK / Çerez Bilgilendirmesi</a>
        </div>
    </div>

    <div class="nv-ckm-actions">
        <button type="button" class="nv-ck-btn nv-ck-btn--reject" onclick="nvRejectAllCookies()">Reddet</button>
        <button type="button" class="nv-ck-btn nv-ck-btn--manage" onclick="nvSaveCookiePreferences()">Tercihleri Kaydet</button>
        <button type="button" class="nv-ck-btn nv-ck-btn--accept" onclick="nvAcceptAllCookies()">Tümünü Kabul Et</button>
    </div>
</div>

<button type="button" id="nvCookiePrefsBtn" onclick="nvOpenCookieSettings()" aria-label="Çerez tercihleri" title="Çerez tercihleri">
    <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path d="m386 256c0 5.523438-4.476562 10-10 10s-10-4.476562-10-10 4.476562-10 10-10 10 4.476562 10 10zm0 0"></path>
        <path d="m286 196c0 5.523438-4.476562 10-10 10s-10-4.476562-10-10 4.476562-10 10-10 10 4.476562 10 10zm0 0"></path>
        <path d="m266 406c0 5.523438-4.476562 10-10 10s-10-4.476562-10-10 4.476562-10 10-10 10 4.476562 10 10zm0 0"></path>
        <path d="m116 226c0 5.523438-4.476562 10-10 10s-10-4.476562-10-10 4.476562-10 10-10 10 4.476562 10 10zm0 0"></path>
