<style>
    {{ range index1, BannerContent := BannerContents }}
        {{ if BannerContent.ContentType == "banner_page" }}
            <style>
            {{ BannerContent.ContentCss | raw }}
            </style>
        {{ end }}
    {{ end }}
</style>

<section class="main-slider-three">
    <div class="main-slider-three__carousel mediox-slick__carousel" data-slick-options='{
        "slidesToShow": 1,
        "slidesToScroll": 1,
        "fade": true,
        "asNavFor": ".main-slider-three__carousel-counter",
        "autoplay": true,
        "autoplaySpeed": 4000,
        "speed": 2000,
        "infinite": true,
        "dots": false,
        "arrows": true,
        "prevArrow": "<button class=\"main-slider-three__slick-button main-slider-three__slick-button--prev\"><i class=\"icon-arrow-left\"></i></button>",
        "nextArrow": "<button class=\"main-slider-three__slick-button main-slider-three__slick-button--next\"><i class=\"icon-arrow-right\"></i></button>"
        }'>
        {{ range index1, BannerContent := BannerContents }}
            {{ if BannerContent.ContentType == "banner_page" }}
                {{ BannerContent.ContentHtml | raw }}
            {{ end }}
        {{ end }}
        
    </div><!-- /.main-slider-three__carousel -->
    <div class="main-slider-three__carousel-counter mediox-slick__carousel" data-slick-options='{
        "asNavFor": ".main-slider-three__carousel",
        "slidesToShow": 3,
        "slidesToScroll": 1,
        "autoplay": true,
        "autoplaySpeed": 4000,
        "infinite": true,
        "focusOnSelect": true,
        "dots": false,
        "arrows": false
        }'>
        {{ range index1, BannerContent := BannerContents }}
            {{ if BannerContent.ContentType == "banner_page" }}
                <div>
                    <span class="main-slider-three__carousel-counter__text">{{ index1 + 1 }}</span>
                </div>
            {{ end }}
        {{ end }}
    </div><!-- /.main-slider-three__carousel-counter -->
</section><!-- /.main-slider-three -->

{{ range index1, BannerContent := BannerContents }}
    {{ if BannerContent.ContentType == "banner_page" }}
        <script>
            {{ BannerContent.ContentJavascript | raw }}
        </script>
    {{ end }}
{{ end }}
