<link rel="stylesheet" href="{{ PathOnStart }}css/panel/homepage-contents.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-home"></i>
                    Anasayfa İçerikleri
                </h1>
                <p class="page-subtitle">Hastane anasayfa içeriklerini ve sayfalarını yönetin</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-secondary" id="refreshBtn">
                    <i class="fas fa-sync-alt"></i>
                    Yenile
                </button>
                <a href="/panel/anasayfa-icerik-ekle" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Yeni İçerik
                </a>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="filters-section">
        <div class="filters-content">
            <div class="search-group">
                <form class="search-form" onsubmit="return false;">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="searchInput" class="search-input" name="query"
                               placeholder="İçerik adı, açıklama veya route ile ara..." 
                               autocomplete="off" spellcheck="false" value="{{ Query }}">
                        <button class="search-clear" id="searchClear" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </form>
                <button class="search-filter-btn" id="filterBtn" title="Filtrele">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div class="filter-group">
                <select id="statusFilter" class="filter-select">
                    <option value="all"{{if Status == "all" || Status == ""}} selected{{end}}>Tüm Durumlar</option>
                    <option value="active"{{if Status == "active"}} selected{{end}}>Aktif</option>
                    <option value="inactive"{{if Status == "inactive"}} selected{{end}}>Pasif</option>
                </select>
                <select id="typeFilter" class="filter-select">
                    <option value="all"{{if ContentType == "all" || ContentType == ""}} selected{{end}}>Tüm Tipler</option>
                    <option value="generic"{{if ContentType == "generic"}} selected{{end}}>Genel</option>
                    <option value="popup"{{if ContentType == "popup"}} selected{{end}}>Popup</option>
                    <option value="banner_page"{{if ContentType == "banner_page"}} selected{{end}}>Banner Sayfası</option>
                </select>
                <select id="sortBy" class="filter-select">
                    <option value="name"{{if SortBy == "name" || SortBy == ""}} selected{{end}}>İçerik Adı</option>
                    <option value="description"{{if SortBy == "description"}} selected{{end}}>Açıklama</option>
                </select>
                <select id="sortOrder" class="filter-select">
                    <option value="ASC"{{if SortOrder == "ASC" || SortOrder == ""}} selected{{end}}>Artan</option>
                    <option value="DESC"{{if SortOrder == "DESC"}} selected{{end}}>Azalan</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-home"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number">{{Count}}</div>
                    <div class="stat-label">Toplam İçerik</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon active">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="activeCount">-</div>
                    <div class="stat-label">Aktif İçerikler</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon inactive">
                    <i class="fas fa-pause-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="inactiveCount">-</div>
                    <div class="stat-label">Pasif İçerikler</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon main">
                    <i class="fas fa-star"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="popupCount">-</div>
                    <div class="stat-label">Popup İçerikleri</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">Anasayfa İçerikleri Listesi</h3>
                <div class="table-actions">
                    <button class="btn btn-sm btn-secondary" id="exportBtn">
                        <i class="fas fa-download"></i>
                        Dışa Aktar
                    </button>
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="table">
                            <i class="fas fa-list"></i>
                        </button>
                        <!--<button class="view-btn" data-view="grid">
                            <i class="fas fa-th"></i>
                        </button>-->
                    </div>
                </div>
            </div>

            <!-- Table View -->
            <div class="table-wrapper" id="tableView">
                <table class="data-table" id="homepageContentsTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-column="name">
                                <span>İçerik Adı</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="content_type">
                                <span>Tip</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th>
                                <span>Açıklama</span>
                            </th>
                            <th class="sortable" data-column="sort_order">
                                <span>Sıra</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="is_active">
                                <span>Durum</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="updated_at">
                                <span>Son Güncelleme</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="actions-column">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{if len(HomepageContents) > 0}}
                            {{range HomepageContents}}
                            <tr data-id="{{ .Hcid }}">
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ .Name }}</div>
                                        <div class="secondary-text">{{ .UrlName }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <span class="type-badge {{ .ContentType }}">
                                            <i class="fas fa-{{ if .ContentType == "generic" }}file{{ else if .ContentType == "popup" }}window-restore{{ else if .ContentType == "banner_page" }}image{{ else }}file{{ end }}"></i>
                                            {{ if .ContentType == "generic" }}Genel{{ else if .ContentType == "popup" }}Popup{{ else if .ContentType == "banner_page" }}Banner Sayfası{{ else }}{{ .ContentType }}{{ end }}
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text truncate">{{ .Description }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <span class="sort-order-badge">#{{ .SortOrder }}</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .IsActive}}
                                        <span class="status-badge active">
                                            <i class="fas fa-check-circle"></i>
                                            Aktif
                                        </span>
                                        {{else}}
                                        <span class="status-badge inactive">
                                            <i class="fas fa-pause-circle"></i>
                                            Pasif
                                        </span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ mthr(.UpdatedAt, User.Timezone) }}</div>
                                        <div class="secondary-text">{{ mthr(.CreatedAt, User.Timezone) }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="actions-wrapper">
                                        <button class="action-trigger" data-id="{{ .Hcid }}">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <div class="action-dropdown">
                                            <a href="/panel/anasayfa-icerikleri/{{ .Hcid }}" class="action-item view">
                                                <i class="fas fa-eye"></i>
                                                <span>Görüntüle</span>
                                            </a>
                                            <a href="/panel/anasayfa-icerikleri/{{ .Hcid }}/duzenle" class="action-item edit">
                                                <i class="fas fa-edit"></i>
                                                <span>Düzenle</span>
                                            </a>
                                            <div class="action-divider"></div>
                                            <button class="action-item delete" data-id="{{ .Hcid }}" data-name="{{ .Name }}">
                                                <i class="fas fa-trash"></i>
                                                <span>Sil</span>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        {{else}}
                            <tr class="empty-row">
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-home"></i>
                                        </div>
                                        <div class="empty-title">Henüz anasayfa içeriği bulunmuyor</div>
                                        <div class="empty-description">İlk anasayfa içeriğinizi oluşturmak için "Yeni İçerik" butonuna tıklayın.</div>
                                        <a href="/panel/anasayfa-icerik-ekle" class="btn btn-primary">
                                            <i class="fas fa-plus"></i>
                                            Yeni İçerik Oluştur
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>

            <!-- Grid View -->
            <div class="grid-wrapper" id="gridView" style="display: none;">
                <div class="homepage-contents-grid">
                    {{if len(HomepageContents) > 0}}
                        {{range HomepageContents}}
                        <div class="homepage-content-card" data-id="{{ .Hcid }}">
                            <div class="card-header">
                                <div class="card-title">{{ .Name }}</div>
                                <div class="card-actions">
                                    <button class="action-trigger" data-id="{{ .Hcid }}">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="action-dropdown">
                                        <a href="/panel/anasayfa-icerikleri/{{ .Hcid }}" class="action-item view">
                                            <i class="fas fa-eye"></i>
                                            <span>Görüntüle</span>
                                        </a>
                                        <a href="/panel/anasayfa-icerikleri/{{ .Hcid }}/duzenle" class="action-item edit">
                                            <i class="fas fa-edit"></i>
                                            <span>Düzenle</span>
                                        </a>
                                        <div class="action-divider"></div>
                                        <button class="action-item delete" data-id="{{ .Hcid }}" data-name="{{ .Name }}">
                                            <i class="fas fa-trash"></i>
                                            <span>Sil</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-field">
                                    <div class="field-label">Tip</div>
                                    <div class="field-value">
                                        <span class="type-badge {{ .ContentType }}">
                                            <i class="fas fa-{{ if .ContentType == "generic" }}file{{ else if .ContentType == "popup" }}window-restore{{ else if .ContentType == "banner_page" }}image{{ else }}file{{ end }}"></i>
                                            {{ if .ContentType == "generic" }}Genel{{ else if .ContentType == "popup" }}Popup{{ else if .ContentType == "banner_page" }}Banner Sayfası{{ else }}{{ .ContentType }}{{ end }}
                                        </span>
                                    </div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">Açıklama</div>
                                    <div class="field-value truncate">{{ .Description }}</div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">Sıra</div>
                                    <div class="field-value">
                                        <span class="sort-order-badge">#{{ .SortOrder }}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="card-status">
                                    {{if .IsActive}}
                                    <span class="status-badge active">
                                        <i class="fas fa-check-circle"></i>
                                        Aktif
                                    </span>
                                    {{else}}
                                    <span class="status-badge inactive">
                                        <i class="fas fa-pause-circle"></i>
                                        Pasif
                                    </span>
                                    {{end}}
                                </div>
                                <div class="card-date">{{ mthr(.UpdatedAt, User.Timezone) }}</div>
                            </div>
                        </div>
                        {{end}}
                    {{else}}
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-home"></i>
                            </div>
                            <div class="empty-title">Henüz anasayfa içeriği bulunmuyor</div>
                            <div class="empty-description">İlk anasayfa içeriğinizi oluşturmak için "Yeni İçerik" butonuna tıklayın.</div>
                            <a href="/panel/anasayfa-icerik-ekle" class="btn btn-primary">
                                <i class="fas fa-plus"></i>
                                Yeni İçerik Oluştur
                            </a>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    {{if Count > 0}}
    <div class="pagination-section">
        <div class="pagination-info">
            <span>Toplam {{Count}} kayıt gösteriliyor</span>
        </div>
        <div class="pagination-wrapper">
            <nav class="pagination" id="pagination">
                <!-- Pagination will be generated by JavaScript -->
            </nav>
        </div>
        <div class="pagination-controls">
            <select id="perPage" class="per-page-select">
                <option value="10">10 / sayfa</option>
                <option value="25">25 / sayfa</option>
                <option value="50">50 / sayfa</option>
                <option value="100">100 / sayfa</option>
            </select>
        </div>
    </div>
    {{end}}
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Anasayfa İçeriğini Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı anasayfa içeriğini silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="fas fa-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="fas fa-exclamation-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<script>

    
    // Filter functionality
    document.addEventListener('DOMContentLoaded', function() {
        const filterBtn = document.getElementById('filterBtn');
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const typeFilter = document.getElementById('typeFilter');
        const sortBy = document.getElementById('sortBy');
        const sortOrder = document.getElementById('sortOrder');
        
        filterBtn.addEventListener('click', function() {
            const query = searchInput.value.trim();
            const status = statusFilter.value;
            const contentType = typeFilter.value;
            const sortByValue = sortBy.value;
            const sortOrderValue = sortOrder.value;
            
            // Build query parameters
            const params = new URLSearchParams();
            
            if (query) {
                params.append('query', query);
            }
            if (status && status !== 'all') {
                params.append('status', status);
            }
            if (contentType && contentType !== 'all') {
                params.append('content_type', contentType);
            }
            if (sortByValue) {
                params.append('sort_by', sortByValue);
            }
            if (sortOrderValue) {
                params.append('sort_order', sortOrderValue);
            }
            
            // Redirect to same page with query parameters
            const currentUrl = window.location.pathname;
            const queryString = params.toString();
            const newUrl = queryString ? `${currentUrl}?${queryString}` : currentUrl;
            
            window.location.href = newUrl;
        });
        
        // Prevent form submission on Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                filterBtn.click();
            }
        });
        
        // Prevent any automatic form submission
        searchInput.addEventListener('submit', function(e) {
            e.preventDefault();
        });
        
        // Ensure no automatic submission
        searchInput.setAttribute('autocomplete', 'off');
        searchInput.setAttribute('spellcheck', 'false');
    });
</script>
<script src="{{ PathOnStart }}js/panel/homepage-contents.js"></script>