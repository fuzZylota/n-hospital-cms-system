<link rel="stylesheet" href="{{ PathOnStart }}css/panel/homepage-content-duzenle.css">
<!-- CodeMirror CSS for syntax highlighting -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/theme/monokai.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-edit"></i>
                    Anasayfa İçeriğini Düzenle
                </h1>
                <p class="page-subtitle">{{ HomepageContent.Name }} içeriğinin bilgilerini düzenleyin</p>
            </div>
            <div class="page-actions">
                <a href="/panel/anasayfa-icerikleri/{{ HomepageContent.Hcid }}" class="btn btn-secondary">
                    <i class="fas fa-eye"></i>
                    Görüntüle
                </a>
                <a href="/panel/anasayfa-icerikleri" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="forms-container">
            <!-- Single Edit Form -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Genel Bilgiler
                    </h2>
                    <p class="section-description">İçeriğin temel bilgilerini düzenleyin</p>
                </div>
                <div class="section-content">
                    <form id="homepageContentEditForm" class="homepage-content-form" novalidate enctype="multipart/form-data">
                        <!-- Hidden inputs for old values -->
                        <input type="hidden" name="old_name" value="{{ HomepageContent.Name }}">
                        <input type="hidden" name="old_url_name" value="{{ HomepageContent.UrlName }}">
                        <input type="hidden" name="old_content_type" value="{{ HomepageContent.ContentType }}">
                        <input type="hidden" name="old_sort_order" value="{{ HomepageContent.SortOrder }}">
                        <input type="hidden" name="old_later_than_which_content" value="{{ HomepageContent.LaterThanWhichContent }}">
                        <input type="hidden" name="old_is_active" value="{{ HomepageContent.IsActive }}">
                        <input type="hidden" name="old_description" value="{{ HomepageContent.Description }}">

                        <div class="form-group-section">
                            <h3 class="group-title">Temel Bilgiler</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="name" class="form-label required">İçerik Adı</label>
                                    <input type="text" id="name" name="name" class="form-input" value="{{ HomepageContent.Name }}" required>
                                </div>
                                <div class="form-group">
                                    <label for="url_name" class="form-label">URL Adı</label>
                                    <input type="text" id="url_name" name="url_name" class="form-input" value="{{ HomepageContent.UrlName }}">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="content_type" class="form-label required">İçerik Tipi</label>
                                    <select id="content_type" name="content_type" class="form-select" required>
                                        <option value="">İçerik tipini seçin</option>
                                        <option value="generic" {{ if HomepageContent.ContentType == "generic" }}selected{{ end }}>Genel</option>
                                        <option value="popup" {{ if HomepageContent.ContentType == "popup" }}selected{{ end }}>Popup</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="sort_order" class="form-label required">Sıralama</label>
                                    <input type="number" id="sort_order" name="sort_order" class="form-input" value="{{ HomepageContent.SortOrder }}" min="1" required>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="later_than_which_content" class="form-label">Hangi İçerikten Sonra</label>
                                    <input type="text" id="later_than_which_content" name="later_than_which_content" class="form-input" value="{{ HomepageContent.LaterThanWhichContent }}">
                                </div>
                                <div class="form-group">
                                    <label for="is_active" class="form-label">Aktif Durumu</label>
                                    <div class="toggle-switch">
                                        <input type="checkbox" id="is_active" name="is_active" {{ if HomepageContent.IsActive }}checked{{ end }}>
                                        <label for="is_active" class="toggle-label">
                                            <span class="toggle-slider"></span>
                                            <span class="toggle-text">{{ if HomepageContent.IsActive }}Aktif{{ else }}Pasif{{ end }}</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="description" class="form-label">Açıklama</label>
                                <textarea id="description" name="description" class="form-textarea" rows="3">{{ HomepageContent.Description }}</textarea>
                            </div>
                        </div>

                        <div class="form-group-section">
                            <h3 class="group-title">HTML İçeriği</h3>
                            <div class="form-group">
                                <label for="content_html" class="form-label">HTML Kodu</label>
                                <textarea id="content_html" name="content_html" class="form-textarea code-editor" rows="10">{{ HomepageContent.ContentHtml }}</textarea>
                                <div class="form-help">HTML kodunuzu yazın. Syntax highlighting aktif.</div>
                            </div>
                        </div>

                        <div class="form-group-section">
                            <h3 class="group-title">CSS Stilleri</h3>
                            <div class="form-group">
                                <label for="content_css" class="form-label">CSS Kodu</label>
                                <textarea id="content_css" name="content_css" class="form-textarea code-editor" rows="10">{{ HomepageContent.ContentCss }}</textarea>
                                <div class="form-help">CSS kodunuzu yazın. Syntax highlighting aktif.</div>
                            </div>
                        </div>

                        <div class="form-group-section">
                            <h3 class="group-title">JavaScript Kodu</h3>
                            <div class="form-group">
                                <label for="content_javascript" class="form-label">JavaScript Kodu</label>
                                <textarea id="content_javascript" name="content_javascript" class="form-textarea code-editor" rows="10">{{ HomepageContent.ContentJavascript }}</textarea>
                                <div class="form-help">JavaScript kodunuzu yazın. Syntax highlighting aktif.</div>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="fas fa-save"></i>
                                <span class="btn-text">İçeriği Güncelle</span>
                                <div class="btn-loader" style="display: none;">
                                    <div class="spinner"></div>
                                </div>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message" id="successMessage">İşlem başarıyla tamamlandı.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script>
    // Pass data to JavaScript
    window.pageData = {
        hcid: "{{ HomepageContent.Hcid }}"
    };
</script>
<!-- CodeMirror JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/css/css.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/htmlmixed/htmlmixed.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/xml-hint.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/css-hint.min.js"></script>
<script src="{{ PathOnStart }}js/panel/homepage-content-duzenle.js"></script>