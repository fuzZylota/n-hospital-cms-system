</section><!-- /.page-header -->

<section class="service-details section-space">
    <div class="container">
        <div class="row gutter-y-50">
            <div class="col-md-12 col-lg-4">
                <div class="service-sidebar">
                    <div class="service-sidebar__info service-sidebar__single">
                        <ul class="list-unstyled service-sidebar__nav wow fadeInLeft" data-wow-duration="1500ms">
                            {{ range index1, HeaderButtons := Options.HeaderButtons }}
                                {{ if HeaderButtons.ButtonType == "kurumsal" && HeaderButtons.ParentId != "" }}
                                    <li><a href="{{ HeaderButtons.Url }}" target="{{ HeaderButtons.Target }}">{{ HeaderButtons.Title }}</a></li>
                                {{ end }}
                            {{ end }}
                        </ul><!-- /.list-unstyled service-sidebar__nav -->
                        <div class="service-sidebar__contact wow fadeInLeft" data-wow-duration="1500ms" data-wow-delay="100ms" style="background-image: url('assets/images/services/service-sidebar-contact-bg.jpg');">
                            <div class="service-sidebar__contact__bg">
                                <div class="service-sidebar__contact__bg__inner" style="background-image: url('assets/images/shapes/service-sidebar-contact-bg-2.png');"></div><!-- /.service-sidebar__contact__bg__inner -->
                            </div><!-- /.service-sidebar__contact__bg -->
                            <div class="service-sidebar__contact__inner">
                                <div class="service-sidebar__contact__icon">
                                    <i class="icon-telephone"></i>
                                </div><!-- /.service-sidebar__contact__icon -->
                                <div class="service-sidebar__contact__content">
                                    <h4 class="service-sidebar__contact__number">
                                        <a href="tel:+{{ Options.Options.ContactPhone }}">{{ Options.Options.ContactPhone }}</a>
                                    </h4><!-- /.service-sidebar__contact__number -->
                                </div><!-- /.service-sidebar__contact__content -->
                            </div><!-- /.service-sidebar__contact__inner -->
                        </div><!-- /.service-sidebar__contact -->
                    </div><!-- /.service-sidebar__info service-sidebar__single -->
                    <div class="service-sidebar__single wow fadeInLeft" data-wow-duration="1500ms" data-wow-delay="200ms">
                        <div class="service-sidebar__company">
                            <a href="contact.php" class="service-sidebar__company__btn">
                                <i class="icon-download"></i>
                            </a><!-- /.service-sidebar__company__btn -->
                            <h4 class="service-sidebar__company__title">Şirket Profili</h4><!-- /.service-sidebar__company__title -->
                        </div><!-- /.service-sidebar__company -->
                        <div class="service-sidebar__company">
                            <a href="contact.php" class="service-sidebar__company__btn">
                                <i class="icon-download"></i>
                            </a><!-- /.service-sidebar__company__btn -->
                            <h4 class="service-sidebar__company__title">Şirket Broşürü</h4><!-- /.service-sidebar__company__title -->
                        </div><!-- /.service-sidebar__company -->
                    </div><!-- /.service-sidebar__single -->
                </div><!-- /.sidebar -->
            </div><!-- /.col-md-12 col-lg-8 -->
            <div class="col-md-12 col-lg-8">
                <div class="service-details__content html-eval">
                    <div class="service-details__inner">
                        <div class="service-details__content__box wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="00ms">
                            <h3 class="service-details__title">İnsan Kaynakları</h3>
                            <p class="service-details__text">Hastanemizde kaliteli sağlık hizmetleri sunmak için yetenekli ve deneyimli profesyonellerle çalışıyoruz. İnsan kaynakları departmanımız, hastanemizin değerlerine uygun, hasta odaklı ve sürekli gelişim anlayışına sahip çalışanlar bulmak için çalışmaktadır.</p>
                        </div>
                    </div>
                    
                    <div class="service-details__inner-two wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="00ms">
                        <h3 class="service-details__sub-title">Kariyer Fırsatları</h3>
                        <p class="service-details__text">Hastanemizde doktor, hemşire, teknisyen, idari personel ve diğer sağlık profesyonelleri için çeşitli kariyer fırsatları sunuyoruz. Sürekli eğitim ve gelişim programları ile çalışanlarımızın mesleki gelişimlerini destekliyoruz.</p>
                    </div>
                    
                    <div class="service-details__info">
                        <div class="row gutter-y-30">
                            <div class="col-xl-6 col-lg-12 col-md-6 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="00ms">
                                <ul class="list-unstyled service-details__info__list">
                                    <li>
                                        <span class="service-details__list__icon"><i class="icon-check"></i></span>
                                        Rekabetçi maaş paketleri
                                    </li>
                                    <li>
                                        <span class="service-details__list__icon"><i class="icon-check"></i></span>
                                        Sağlık sigortası
                                    </li>
                                    <li>
                                        <span class="service-details__list__icon"><i class="icon-check"></i></span>
                                        Sürekli eğitim imkanları
                                    </li>
                                    <li>
                                        <span class="service-details__list__icon"><i class="icon-check"></i></span>
                                        Kariyer gelişim desteği
                                    </li>
                                </ul>
                            </div>
                            <div class="col-xl-6 col-lg-12 col-md-6 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="100ms">
                                <img src="{{ PathOnStart }}files/defaults/other/hospital-reception-1.jpg" alt="{{ Options.Options.SiteDescription }}" class="service-details__info__image">
                            </div>
                        </div>
                    </div>
                    
                    <div class="job-application-form-wrapper wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="200ms">
                        <div class="form-header">
                            <h3 class="form-title">İş Başvuru Formu</h3>
                            <p class="form-description">Hastanemizde çalışmak için aşağıdaki formu doldurun. Başvurunuz değerlendirildikten sonra sizinle iletişime geçeceğiz.</p>
                        </div>
                        
                        <form id="jobApplicationForm" class="job-application-form">
                            <div class="form-section">
                                <h4 class="section-title">Kişisel Bilgiler</h4>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="first_name" class="form-label required">Ad</label>
                                        <input type="text" id="first_name" name="first_name" class="form-input" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="last_name" class="form-label required">Soyad</label>
                                        <input type="text" id="last_name" name="last_name" class="form-input" required>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="email" class="form-label required">E-posta</label>
                                        <input type="email" id="email" name="email" class="form-input" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="city" class="form-label required">Şehir</label>
                                        <input type="text" id="city" name="city" class="form-input" required>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <h4 class="section-title">CV ve Ön Yazı</h4>
                                <div class="form-group">
                                    <label for="cv_file" class="form-label required">CV Dosyası</label>
                                    <div class="file-upload-area" data-target="cv_file">
                                        <div class="file-upload-content">
                                            <i class="icon-upload"></i>
                                            <p class="file-upload-text">CV dosyanızı sürükleyin veya <span class="file-browse">göz atın</span></p>
                                            <p class="file-upload-hint">PDF, DOC, DOCX - Max 10MB</p>
                                        </div>
                                        <input type="file" id="cv_file" name="cv_file" class="file-input" accept=".pdf,.doc,.docx" required>
                                        <div class="file-preview" style="display: none;">
                                            <div class="file-info">
                                                <i class="icon-file"></i>
                                                <span class="file-name"></span>
                                                <span class="file-size"></span>
                                            </div>
                                            <button type="button" class="file-remove">
                                                <i class="icon-x"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="cover_letter" class="form-label required">Ön Yazı</label>
                                    <textarea id="cover_letter" name="cover_letter" class="form-textarea" rows="5" placeholder="Neden bu pozisyon için uygun olduğunuzu açıklayın..." required></textarea>
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <h4 class="section-title">Ek Bilgiler</h4>
                                <div class="form-group">
                                    <label for="languages" class="form-label">Diller</label>
                                    <input type="text" id="languages" name="languages" class="form-input" placeholder="Türkçe, İngilizce, Almanca">
                                    <div class="form-help">Bildiğiniz dilleri virgülle ayırarak yazın</div>
                                </div>
                                <div class="form-group">
                                    <label for="work_references" class="form-label">Referanslar</label>
                                    <textarea id="work_references" name="work_references" class="form-textarea" rows="3" placeholder="Önceki işverenleriniz veya referanslarınız hakkında bilgi verin..."></textarea>
                                </div>
                            </div>
                            
                            <div class="form-section">
                                <h4 class="section-title">KVKK Onayı</h4>
                                <div class="form-group">
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="kvkk_approval" name="kvkk_approval" class="form-checkbox" required>
                                        <label for="kvkk_approval" class="checkbox-label">
                                            <a href="/kurumsal/kvkk" target="_blank" class="kvkk-link">Kişisel Verilerin Korunması Kanunu (KVKK)</a> kapsamında kişisel verilerimin işlenmesini kabul ediyorum.
                                        </label>
                                    </div>
                                    <div class="form-help">Bu onay olmadan başvuru gönderilemez.</div>
                                </div>
                            </div>
                            
                            <div class="form-actions">
                                <button type="submit" class="mediox-btn" id="submitBtn">
                                    <span>Başvuruyu Gönder</span>
                                    <span class="mediox-btn__icon"><i class="icon-up-right-arrow"></i></span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="{{ PathOnStart }}js/frontend/html-eval.js"></script>
<script src="{{ PathOnStart }}js/frontend/js-eval.js"></script>
<script src="{{ PathOnStart }}js/frontend/css-eval.js"></script>
