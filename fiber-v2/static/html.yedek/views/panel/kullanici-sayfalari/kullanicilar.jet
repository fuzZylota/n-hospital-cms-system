<link rel="stylesheet" href="{{ PathOnStart }}css/panel/kullanicilar.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="fas fa-users"></i>
                    Kullanıcılar
                </h1>
                <p class="page-subtitle">Sistem kullanıcılarını ve yetkililerini yönetin</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-secondary" id="refreshBtn">
                    <i class="fas fa-sync-alt"></i>
                    Yenile
                </button>
                <a href="/panel/kullanici-ekle" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Yeni Kullanıcı
                </a>
            </div>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="filters-section">
        <div class="filters-content">
            <div class="search-group">
                <form class="search-form" onsubmit="return false;">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="searchInput" class="search-input" 
                               placeholder="Ad, soyad, e-posta veya telefon ile ara..."
                               autocomplete="off" spellcheck="false" value="{{ Query }}">
                        <button class="search-clear" id="searchClear" style="display: none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </form>
                <button class="search-filter-btn" id="filterBtn" title="Filtrele">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            <div class="filter-group">
                <select id="roleFilter" class="filter-select">
                    <option value="all"{{if Role == "all" || Role == ""}} selected{{end}}>Tüm Roller</option>
                    <option value="admin"{{if Role == "admin"}} selected{{end}}>Admin</option>
                    <option value="moderator"{{if Role == "moderator"}} selected{{end}}>Moderatör</option>
                </select>
                <select id="statusFilter" class="filter-select">
                    <option value="all"{{if Status == "all" || Status == ""}} selected{{end}}>Tüm Durumlar</option>
                    <option value="active"{{if Status == "active"}} selected{{end}}>Aktif</option>
                    <option value="inactive"{{if Status == "inactive"}} selected{{end}}>Pasif</option>
                </select>
                <select id="sortBy" class="filter-select">
                    <option value="name"{{if SortBy == "name" || SortBy == ""}} selected{{end}}>Ad</option>
                    <option value="surname"{{if SortBy == "surname"}} selected{{end}}>Soyad</option>
                    <option value="email"{{if SortBy == "email"}} selected{{end}}>E-posta</option>
                    <option value="phone"{{if SortBy == "phone"}} selected{{end}}>Telefon</option>
                    <option value="last_login"{{if SortBy == "last_login"}} selected{{end}}>Son Giriş</option>
                </select>
                <select id="sortOrder" class="filter-select">
                    <option value="ASC"{{if SortOrder == "ASC" || SortOrder == ""}} selected{{end}}>Artan</option>
                    <option value="DESC"{{if SortOrder == "DESC"}} selected{{end}}>Azalan</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number">{{Count}}</div>
                    <div class="stat-label">Toplam Kullanıcı</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon active">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="activeCount">-</div>
                    <div class="stat-label">Aktif Kullanıcılar</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon inactive">
                    <i class="fas fa-pause-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="inactiveCount">-</div>
                    <div class="stat-label">Pasif Kullanıcılar</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon admin">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-number" id="adminCount">-</div>
                    <div class="stat-label">Adminler</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">Kullanıcılar Listesi</h3>
                <div class="table-actions">
                    <button class="btn btn-sm btn-secondary" id="exportBtn">
                        <i class="fas fa-download"></i>
                        Dışa Aktar
                    </button>
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="table">
                            <i class="fas fa-list"></i>
                        </button>
                        <!--<button class="view-btn" data-view="grid">
                            <i class="fas fa-th"></i>
                        </button>-->
                    </div>
                </div>
            </div>

            <!-- Table View -->
            <div class="table-wrapper" id="tableView">
                <table class="data-table" id="usersTable">
                    <thead>
                        <tr>
                            <th class="sortable" data-column="name">
                                <span>Ad Soyad</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="email">
                                <span>E-posta</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th>
                                <span>Şube</span>
                            </th>
                            <th class="sortable" data-column="role">
                                <span>Rol</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="is_active">
                                <span>Durum</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="sortable" data-column="last_login">
                                <span>Son Giriş</span>
                                <i class="fas fa-sort sort-icon"></i>
                            </th>
                            <th class="actions-column">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{if len(Users) > 0}}
                            {{range Users}}
                            <tr data-id="{{ .Uid }}">
                                <td>
                                    <div class="cell-content">
                                        <div class="user-info">
                                            <div class="user-avatar">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div class="user-details">
                                                <div class="primary-text">{{ .Name }} {{ .Surname }}</div>
                                                <div class="secondary-text">ID: {{ .Uid }}</div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .SubeName}}
                                        <a href="/panel/subeler/{{ .Sid }}" class="link">{{ .SubeName }}</a>
                                        {{else}}
                                        <span class="text-muted">-</span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <span class="role-badge {{ .Role }}">
                                            {{if .Role == "admin"}}
                                            <i class="fas fa-user-shield"></i>
                                            Admin
                                            {{else if .Role == "moderator"}}
                                            <i class="fas fa-user-cog"></i>
                                            Moderatör
                                            {{else if .Role == "santral"}}
                                            <i class="fas fa-phone"></i>
                                            Santral
                                            {{else if .Role == "ik"}}
                                            <i class="fas fa-briefcase"></i>
                                            İnsan Kaynakları
                                            {{end}}
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        {{if .IsActive}}
                                        <span class="status-badge active">
                                            <i class="fas fa-check-circle"></i>
                                            Aktif
                                        </span>
                                        {{else}}
                                        <span class="status-badge inactive">
                                            <i class="fas fa-pause-circle"></i>
                                            Pasif
                                        </span>
                                        {{end}}
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-content">
                                        <div class="primary-text">{{ mthr(.LastLogin, User.Timezone) }}</div>
                                        <div class="secondary-text">{{ mthr(.LastLogin, User.Timezone) }}</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="actions-wrapper">
                                        <button class="action-trigger" data-id="{{ .Uid }}">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <div class="action-dropdown">
                                            <a href="/panel/kullanicilar/{{ .Uid }}" class="action-item view">
                                                <i class="fas fa-eye"></i>
                                                <span>Görüntüle</span>
                                            </a>
                                            <a href="/panel/kullanicilar/{{ .Uid }}/duzenle" class="action-item edit">
                                                <i class="fas fa-edit"></i>
                                                <span>Düzenle</span>
                                            </a>
                                            <div class="action-divider"></div>
                                            {{if .IsActive}}
                                            <button class="action-item deactivate" data-id="{{ .Uid }}" data-name="{{ .Name }} {{ .Surname }}">
                                                <i class="fas fa-pause"></i>
                                                <span>Pasifleştir</span>
                                            </button>
                                            {{else}}
                                            <button class="action-item activate" data-id="{{ .Uid }}" data-name="{{ .Name }} {{ .Surname }}">
                                                <i class="fas fa-play"></i>
                                                <span>Aktifleştir</span>
                                            </button>
                                            {{end}}
                                            <button class="action-item delete" data-id="{{ .Uid }}" data-name="{{ .Name }} {{ .Surname }}">
                                                <i class="fas fa-trash"></i>
                                                <span>Sil</span>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        {{else}}
                            <tr class="empty-row">
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="fas fa-users"></i>
                                        </div>
                                        <div class="empty-title">Henüz kullanıcı bulunmuyor</div>
                                        <div class="empty-description">İlk kullanıcıyı oluşturmak için "Yeni Kullanıcı" butonuna tıklayın.</div>
                                        <a href="/panel/kullanici-ekle" class="btn btn-primary">
                                            <i class="fas fa-plus"></i>
                                            Yeni Kullanıcı Oluştur
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>

            <!-- Grid View -->
            <div class="grid-wrapper" id="gridView" style="display: none;">
                <div class="users-grid">
                    {{if len(Users) > 0}}
                        {{range Users}}
                        <div class="user-card" data-id="{{ .Uid }}">
                            <div class="card-header">
                                <div class="user-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="card-title">{{ .Name }} {{ .Surname }}</div>
                                <div class="card-actions">
                                    <button class="action-trigger" data-id="{{ .Uid }}">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="action-dropdown">
                                        <a href="/panel/kullanicilar/{{ .Uid }}" class="action-item view">
                                            <i class="fas fa-eye"></i>
                                            <span>Görüntüle</span>
                                        </a>
                                        <a href="/panel/kullanicilar/{{ .Uid }}/duzenle" class="action-item edit">
                                            <i class="fas fa-edit"></i>
                                            <span>Düzenle</span>
                                        </a>
                                        <div class="action-divider"></div>
                                        {{if .IsActive}}
                                        <button class="action-item deactivate" data-id="{{ .Uid }}" data-name="{{ .Name }} {{ .Surname }}">
                                            <i class="fas fa-pause"></i>
                                            <span>Pasifleştir</span>
                                        </button>
                                        {{else}}
                                        <button class="action-item activate" data-id="{{ .Uid }}" data-name="{{ .Name }} {{ .Surname }}">
                                            <i class="fas fa-play"></i>
                                            <span>Aktifleştir</span>
                                        </button>
                                        {{end}}
                                        <button class="action-item delete" data-id="{{ .Uid }}" data-name="{{ .Name }} {{ .Surname }}">
                                            <i class="fas fa-trash"></i>
                                            <span>Sil</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="card-field">
                                    <div class="field-label">E-posta</div>
                                    <div class="field-value">
                                        <a href="mailto:{{ .Email }}" class="email-link">{{ .Email }}</a>
                                    </div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">Şube</div>
                                    <div class="field-value">
                                        {{if .SubeName}}
                                        <a href="/panel/subeler/{{ .Sid }}" class="link">{{ .SubeName }}</a>
                                        {{else}}
                                        <span class="text-muted">-</span>
                                        {{end}}
                                    </div>
                                </div>
                                <div class="card-field">
                                    <div class="field-label">Rol</div>
                                    <div class="field-value">
                                        <span class="role-badge {{ .Role }}">
                                            {{if .Role == "admin"}}
                                            <i class="fas fa-user-shield"></i>
                                            Admin
                                            {{else if .Role == "moderator"}}
                                            <i class="fas fa-user-cog"></i>
                                            Moderatör
                                            {{else if .Role == "santral"}}
                                            <i class="fas fa-phone"></i>
                                            Santral
                                            {{else if .Role == "ik"}}
                                            <i class="fas fa-briefcase"></i>
                                            İnsan Kaynakları
                                            {{end}}
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="card-status">
                                    {{if .IsActive}}
                                    <span class="status-badge active">
                                        <i class="fas fa-check-circle"></i>
                                        Aktif
                                    </span>
                                    {{else}}
                                    <span class="status-badge inactive">
                                        <i class="fas fa-pause-circle"></i>
                                        Pasif
                                    </span>
                                    {{end}}
                                </div>
                                <div class="card-date">{{ .LastLogin }}</div>
                            </div>
                        </div>
                        {{end}}
                    {{else}}
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="empty-title">Henüz kullanıcı bulunmuyor</div>
                            <div class="empty-description">İlk kullanıcıyı oluşturmak için "Yeni Kullanıcı" butonuna tıklayın.</div>
                            <a href="/panel/kullanici-ekle" class="btn btn-primary">
                                <i class="fas fa-plus"></i>
                                Yeni Kullanıcı Oluştur
                            </a>
                        </div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    {{if Count > 0}}
    <div class="pagination-section">
        <div class="pagination-info">
            <span>Toplam {{Count}} kayıt gösteriliyor</span>
        </div>
        <div class="pagination-wrapper">
            <nav class="pagination" id="pagination">
                <!-- Pagination will be generated by JavaScript -->
            </nav>
        </div>
        <div class="pagination-controls">
            <select id="perPage" class="per-page-select">
                <option value="10">10 / sayfa</option>
                <option value="25">25 / sayfa</option>
                <option value="50">50 / sayfa</option>
                <option value="100">100 / sayfa</option>
            </select>
        </div>
    </div>
    {{end}}
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="modal-title">Kullanıcıyı Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı kullanıcıyı silmek istediğinizden emin misiniz? 
            Bu işlem geri alınamaz.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Status Change Confirmation Modal -->
<div id="statusModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-icon">
            <i class="fas fa-question-circle"></i>
        </div>
        <h3 class="modal-title" id="statusModalTitle">Kullanıcı Durumunu Değiştir</h3>
        <p class="modal-message" id="statusModalMessage">
            Bu kullanıcının durumunu değiştirmek istediğinizden emin misiniz?
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeStatusModal()">İptal</button>
            <button type="button" class="btn btn-primary" id="confirmStatusBtn">
                <i class="fas fa-check"></i>
                <span class="btn-text">Onayla</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="fas fa-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="fas fa-exclamation-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="fas fa-times"></i>
    </button>
</div>

<script>
        function decodeHtmlEntities(encoded) {
        const txt = document.createElement('textarea');
        txt.innerHTML = encoded;
        return txt.value;
    }

      const escaped = '{{stj(Users)}}'; // şablondan gelen escaped string
        const decoded = decodeHtmlEntities(escaped);
        const data = JSON.parse(decoded);
    // Pass data to JavaScript
    window.pageData = {
        users: data,
        count: {{Count}},
        currentPage: {{Page ? Page : 1}},
        perPage: {{ 10 }}
    };
    
    // Filter functionality
    document.addEventListener('DOMContentLoaded', function() {
        const filterBtn = document.getElementById('filterBtn');
        const searchInput = document.getElementById('searchInput');
        const roleFilter = document.getElementById('roleFilter');
        const statusFilter = document.getElementById('statusFilter');
        const sortBy = document.getElementById('sortBy');
        const sortOrder = document.getElementById('sortOrder');
        
        filterBtn.addEventListener('click', function() {
            const query = searchInput.value.trim();
            const role = roleFilter.value;
            const status = statusFilter.value;
            const sortByValue = sortBy.value;
            const sortOrderValue = sortOrder.value;
            
            // Build query parameters
            const params = new URLSearchParams();
            
            if (query) {
                params.append('query', query);
            }
            if (role && role !== 'all') {
                params.append('role', role);
            }
            if (status && status !== 'all') {
                params.append('status', status);
            }
            if (sortByValue) {
                params.append('sort_by', sortByValue);
            }
            if (sortOrderValue) {
                params.append('sort_order', sortOrderValue);
            }
            
            // Redirect to same page with query parameters
            const currentUrl = window.location.pathname;
            const queryString = params.toString();
            const newUrl = queryString ? `${currentUrl}?${queryString}` : currentUrl;
            
            window.location.href = newUrl;
        });
        
        // Prevent form submission on Enter key
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                filterBtn.click();
            }
        });
        
        // Prevent any automatic form submission
        searchInput.addEventListener('submit', function(e) {
            e.preventDefault();
        });
        
        // Ensure no automatic submission
        searchInput.setAttribute('autocomplete', 'off');
        searchInput.setAttribute('spellcheck', 'false');
    });
</script>
<script src="{{ PathOnStart }}js/panel/kullanicilar.js"></script>
