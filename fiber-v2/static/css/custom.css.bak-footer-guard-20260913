/* ============================================================
   Nivgoz footer refresh
   Scoped to .main-footer so the rest of the site is unaffected.
   ============================================================ */
body footer.main-footer.section-space-top {
  --nv-footer-navy: var(--theme-primary-color, #0a2241);
  --nv-footer-navy-light: #123a68;
  --nv-footer-red: #df0024;
  --nv-footer-ink: #ffffff;
  --nv-footer-muted: rgba(255, 255, 255, 0.72);
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding: clamp(64px, 7vw, 96px) 0 0 !important;
  background:
    radial-gradient(circle at 8% 14%, rgba(51, 193, 237, 0.13), transparent 31%),
    radial-gradient(circle at 91% 82%, rgba(223, 0, 36, 0.12), transparent 27%),
    linear-gradient(145deg, #071a32 0%, var(--nv-footer-navy) 52%, #0d2e55 100%) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

body footer.main-footer.section-space-top::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 0;
  pointer-events: none;
  opacity: 0.28;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
  background-size: 44px 44px;
  -webkit-mask-image: linear-gradient(to bottom, #000, transparent 72%);
  mask-image: linear-gradient(to bottom, #000, transparent 72%);
}

.main-footer .container {
  position: relative;
  z-index: 1;
}

/* Top contact card */
.main-footer__cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  margin-bottom: clamp(48px, 6vw, 72px);
  padding: 28px 32px;
  color: var(--nv-footer-navy);
  background: rgba(255, 255, 255, 0.97);
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-left: 5px solid var(--nv-footer-red);
  border-radius: 20px;
  box-shadow: 0 24px 55px rgba(0, 8, 24, 0.28);
}

.main-footer__cta-text h3 {
  margin: 0 0 6px;
  color: var(--nv-footer-navy);
  font-size: clamp(22px, 2.3vw, 30px);
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.main-footer__cta-text > a {
  display: inline-flex;
  align-items: center;
  color: #54677e;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: color 180ms ease;
}

.main-footer__cta-text > a::after {
  content: "\2192";
  margin-left: 8px;
  color: var(--nv-footer-red);
  font-size: 18px;
  transition: transform 180ms ease;
}

.main-footer__cta-text > a:hover {
  color: var(--nv-footer-red);
}

.main-footer__cta-text > a:hover::after {
  transform: translateX(4px);
}

.main-footer__cta-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14px;
  flex-shrink: 0;
}

.main-footer__cta-phone {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 50px;
  padding: 11px 22px;
  color: #fff !important;
  background: linear-gradient(135deg, var(--nv-footer-red), #b9001e);
  border-radius: 999px;
  font-size: 16px;
  font-weight: 800;
  line-height: 1;
  text-decoration: none;
  white-space: nowrap;
  box-shadow: 0 10px 24px rgba(223, 0, 36, 0.22);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.main-footer__cta-phone:hover {
  color: #fff !important;
  transform: translateY(-2px);
  box-shadow: 0 14px 28px rgba(223, 0, 36, 0.3);
}

.main-footer__cta-phone i {
  font-size: 14px;
}

.main-footer__cta-social {
  display: flex;
  align-items: center;
  gap: 8px;
}

.main-footer__cta-social a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  color: var(--nv-footer-navy) !important;
  background: #f1f5f9;
  border: 1px solid #dbe4ee;
  border-radius: 50%;
  text-decoration: none;
  transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
}

.main-footer__cta-social a:hover {
  color: #fff !important;
  background: var(--nv-footer-navy);
  transform: translateY(-2px);
