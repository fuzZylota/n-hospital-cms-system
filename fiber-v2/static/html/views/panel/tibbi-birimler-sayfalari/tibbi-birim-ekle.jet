<link rel="stylesheet" href="{{ PathOnStart }}css/panel/tibbi-birim-ekle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="icon-layers"></i>
                    Yeni Tıbbi Birim Ekle
                </h1>
                <p class="page-subtitle">Hastane için yeni bir tıbbi birim oluşturun</p>
            </div>
            <div class="page-actions">
                <a href="/panel/tibbi-birimler" class="btn btn-secondary">
                    <i class="icon-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <form id="tibbiBirimForm" class="tibbi-birim-form" novalidate action="/backend/add-tibbi-birim" method="post" enctype="multipart/form-data">
            <!-- Basic Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-info-circle"></i>
                        Temel Bilgiler
                    </h2>
                    <p class="section-description">Tıbbi birimin temel bilgilerini girin</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name" class="form-label required">Birim Adı</label>
                            <input type="text" id="name" name="name" class="form-input" placeholder="örn: Göz Hastalıkları" required>
                            <div class="form-help">Birim için görünen ad</div>
                        </div>
                        <div class="form-group">
                            <label for="url_name" class="form-label">URL Adı</label>
                            <input type="text" id="url_name" name="url_name" class="form-input" placeholder="goz-hastaliklari">
                            <div class="form-help">Boş bırakılırsa otomatik oluşturulur</div>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="is_active" class="form-label">Aktif Durumu</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="is_active" name="is_active" checked>
                                <label for="is_active" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Aktif</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="description" class="form-label">Açıklama</label>
                        <textarea id="description" name="description" class="form-textarea" rows="3" placeholder="Birim hakkında açıklama yazın..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Cover Image Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-image"></i>
                        Kapak Görseli
                    </h2>
                    <p class="section-description">Birim için bir kapak görseli yükleyin</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="cover_mid" class="form-label">Kapak Fotoğrafı</label>
                        <div class="file-upload-area" data-target="cover_mid">
                            <div class="file-upload-content">
                                <i class="icon-upload"></i>
                                <p class="file-upload-text">Görseli sürükleyin veya <span class="file-browse">göz atın</span></p>
                                <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                            </div>
                            <input type="file" id="cover_mid" name="cover_mid" class="file-input" accept="image/*">
                            <div class="file-preview" style="display: none;">
                                <img class="preview-image" src="" alt="Preview">
                                <button type="button" class="file-remove">
                                    <i class="icon-x"></i>
                                </button>
                            </div>
                        </div>
                        <div class="file-meta-inputs">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="cover_alt_text" class="form-label">Görsel Alt Metni</label>
                                    <input type="text" id="cover_alt_text" name="cover_alt_text" class="form-input" placeholder="Kapak fotoğrafı için alternatif metin">
                                </div>
                                <div class="form-group">
                                    <label for="cover_title" class="form-label">Görsel Başlığı</label>
                                    <input type="text" id="cover_title" name="cover_title" class="form-input" placeholder="Kapak fotoğrafı için başlık metni">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Video Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-play-circle"></i>
                        Video
                    </h2>
                    <p class="section-description">Birim için bir tanıtım videosu yükleyin</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="video_mid" class="form-label">Video</label>
                        <div class="file-upload-area" data-target="video_mid">
                            <div class="file-upload-content">
                                <i class="icon-upload"></i>
                                <p class="file-upload-text">Videoyu sürükleyin veya <span class="file-browse">göz atın</span></p>
                                <p class="file-upload-hint">MP4, WEBM</p>
                            </div>
                            <input type="file" id="video_mid" name="video_mid" class="file-input" accept="video/*">
                            <div class="file-preview" style="display: none;">
                                <img class="preview-image" src="" alt="Preview">
                                <button type="button" class="file-remove">
                                    <i class="icon-x"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                    <i class="icon-x"></i>
                    İptal
                </button>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="icon-check"></i>
                    <span class="btn-text">Tıbbi Birimi Kaydet</span>
                    <div class="btn-loader" style="display: none;">
                        <div class="spinner"></div>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="icon-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message">Tıbbi birim başarıyla oluşturuldu.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>
<script>
    let maxUploadSize = {{ Options.Options.MaxUploadSize }};
</script>

<script src="{{ PathOnStart }}js/panel/tibbi-birim-ekle.js"></script>
