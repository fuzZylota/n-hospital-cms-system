{* P3-3 — Anasayfa tıbbi birimler: taranabilir ızgara (carousel yok).
   Ad, kısa açıklama ve kapak görseli DB'den (tibbi_birimler.description,
   medias). Açıklama boşsa yalnız ad basılır; metin uydurulmaz. Görselin
   alt'ı boş: birimin adı yanındaki h3'te. *}
{{ if len(TibbiBirimler) > 0 }}
<section class="nv-home-sec nv-home-sec--alt" aria-labelledby="nvHomeUnitsTitle">
    <div class="nv-home__container">
        <div class="nv-home-sec__head">
            <h2 class="nv-home-sec__title" id="nvHomeUnitsTitle">Tıbbi birimlerimiz</h2>
            <a class="nv-home-sec__more" href="/tibbi-birimler">Tüm tıbbi birimler</a>
        </div>
        <ul class="nv-home-grid nv-home-grid--units" role="list">
            {{ range index2, TibbiBirim := TibbiBirimler }}
            <li class="nv-card nv-unit-card">
                {{ if TibbiBirim.CoverPath != "" }}
                <img class="nv-unit-card__img" src="{{ TibbiBirim.CoverPath }}" alt="" width="500" height="289" loading="lazy" decoding="async">
                {{ else }}
                <span class="nv-unit-card__img nv-unit-card__img--empty" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/></svg>
                </span>
                {{ end }}
                <div class="nv-card__body">
                    <h3 class="nv-card__title"><a class="nv-card__link" href="/tibbi-birimler/{{ TibbiBirim.UrlName }}">{{ TibbiBirim.Name }}</a></h3>
                    {{ if TibbiBirim.Description != "" }}<p class="nv-card__meta nv-unit-card__desc">{{ TibbiBirim.Description }}</p>{{ end }}
                </div>
            </li>
            {{ end }}
        </ul>
    </div>
</section>
{{ end }}
