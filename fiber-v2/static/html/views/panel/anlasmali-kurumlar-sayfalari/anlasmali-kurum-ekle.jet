<link rel="stylesheet" href="{{ PathOnStart }}css/panel/anlasmali-kurum-ekle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="icon-handshake"></i>
                    Yeni Anlaşmalı Kurum Ekle
                </h1>
                <p class="page-subtitle">Hastane için yeni bir anlaşmalı kurum oluşturun</p>
            </div>
            <div class="page-actions">
                <a href="/panel/anlasmali-kurumlar" class="btn btn-secondary">
                    <i class="icon-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <form id="anlasmaliKurumForm" class="anlasmali-kurum-form" novalidate action="/backend/add-anlasmali-kurum" method="post" enctype="multipart/form-data">
            <!-- Basic Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-info-circle"></i>
                        Temel Bilgiler
                    </h2>
                    <p class="section-description">Kurumun temel bilgilerini girin</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name" class="form-label required">Kurum Adı</label>
                            <input type="text" id="name" name="name" class="form-input" 
                                   placeholder="örn: Acıbadem Sigorta, SGK" required>
                            <div class="form-help">Kurumun görüntülenecek adı</div>
                        </div>
                        <div class="form-group">
                            <label for="url_name" class="form-label">URL Adı</label>
                            <input type="text" id="url_name" name="url_name" class="form-input" 
                                   placeholder="acibadem-sigorta, sgk">
                            <div class="form-help">Boş bırakılırsa otomatik oluşturulur</div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="type" class="form-label required">Kurum Tipi</label>
                            <select id="type" name="type" class="form-select" required>
                                <option value="">Kurum tipini seçin</option>
                                <option value="sigorta">Sigorta</option>
                                <option value="kurumsal">Kurumsal</option>
                                <option value="universite">Üniversite</option>
                                <option value="devlet">Devlet</option>
                                <option value="ozel">Özel</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="sube_sid" class="form-label required">Bağlı Şube</label>
                            <select id="sube_sid" name="sid" class="form-select" required>
                                <option value="">Şube seçin</option>
                                {{range Subeler}}
                                <option value="{{ .Sid }}">{{ .Name }}</option>
                                {{end}}
                            </select>
                            <div class="form-help">Bu kurumun bağlı olacağı şube</div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="is_active" class="form-label">Aktif Durumu</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="is_active" name="is_active" checked>
                                <label for="is_active" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Aktif</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="description" class="form-label">Açıklama</label>
                        <textarea id="description" name="description" class="form-textarea" 
                                  rows="3" placeholder="Kurum hakkında detaylı açıklama yazın..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-phone"></i>
                        İletişim Bilgileri
                    </h2>
                    <p class="section-description">Kurumun iletişim detayları</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="contact_person" class="form-label">İletişim Kişisi</label>
                            <input type="text" id="contact_person" name="contact_person" class="form-input" 
                                   placeholder="Ahmet Yılmaz">
                        </div>
                        <div class="form-group">
                            <label for="phone" class="form-label">Telefon</label>
                            <input type="tel" id="phone" name="phone" class="form-input" 
                                   placeholder="+90 212 555 00 00">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email" class="form-label">E-posta</label>
                        <input type="email" id="email" name="email" class="form-input" 
                               placeholder="info@kurum.com">
                    </div>
                    <div class="form-group">
                        <label for="address" class="form-label">Adres</label>
                        <textarea id="address" name="address" class="form-textarea" 
                                  rows="3" placeholder="Kurumun tam adres bilgilerini girin..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Contract Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-file-text"></i>
                        Sözleşme Bilgileri
                    </h2>
                    <p class="section-description">Sözleşme detayları ve indirim oranları</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="contract_start_date" class="form-label">Sözleşme Başlangıç</label>
                            <input type="date" id="contract_start_date" name="contract_start_date" class="form-input">
                        </div>
                        <div class="form-group">
                            <label for="contract_end_date" class="form-label">Sözleşme Bitiş</label>
                            <input type="date" id="contract_end_date" name="contract_end_date" class="form-input">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="discount_rate" class="form-label">İndirim Oranı (%)</label>
                            <input type="number" id="discount_rate" name="discount_rate" class="form-input" 
                                   step="0.01" min="0" max="100" placeholder="15.50">
                            <div class="form-help">Örnek: 15.50</div>
                        </div>
                        <div class="form-group">
                            <label for="payment_terms" class="form-label">Ödeme Koşulları</label>
                            <input type="text" id="payment_terms" name="payment_terms" class="form-input" 
                                   placeholder="30 gün vadeli">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="notes" class="form-label">Notlar</label>
                        <textarea id="notes" name="notes" class="form-textarea" 
                                  rows="3" placeholder="Sözleşme ile ilgili özel notlar..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Logo Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-image"></i>
                        Kurum Logosu
                    </h2>
                    <p class="section-description">Kurumun logosu veya görseli</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="logo_mid" class="form-label">Kurum Logosu</label>
                        <div class="file-upload-area" data-target="logo_mid">
                            <div class="file-upload-content">
                                <i class="icon-upload"></i>
                                <p class="file-upload-text">Kurum logosunu sürükleyin veya <span class="file-browse">göz atın</span></p>
                                <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                            </div>
                            <input type="file" id="logo_mid" name="logo_mid" 
                                   class="file-input" accept="image/*">
                            <div class="file-preview" style="display: none;">
                                <img class="preview-image" src="" alt="Preview">
                                <button type="button" class="file-remove">
                                    <i class="icon-x"></i>
                                </button>
                            </div>
                        </div>
                        <div class="file-meta-inputs">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="logo_alt_text" class="form-label">Görsel Alt Metni</label>
                                    <input type="text" id="logo_alt_text" name="logo_alt_text" 
                                           class="form-input" placeholder="Kurum logosu için alternatif metin">
                                </div>
                                <div class="form-group">
                                    <label for="logo_title" class="form-label">Görsel Başlığı</label>
                                    <input type="text" id="logo_title" name="logo_title" 
                                           class="form-input" placeholder="Kurum logosu için başlık metni">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                    <i class="icon-x"></i>
                    İptal
                </button>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="icon-check"></i>
                    <span class="btn-text">Kurumu Kaydet</span>
                    <div class="btn-loader" style="display: none;">
                        <div class="spinner"></div>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="icon-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message">Anlaşmalı kurum başarıyla oluşturuldu.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script src="{{ PathOnStart }}js/panel/anlasmali-kurum-ekle.js"></script>
