{{ AtLeastOnePopup := false }}

{{ range index1, Content := AllHomepageContents }}
    {{ if Content.ContentType == "popup" }}
        {{ AtLeastOnePopup = true }}
    {{ end }}
{{ end }}

{{ if AtLeastOnePopup }}
    <style>
        /* P3-3: yalnızca --nv-* token'ları (css/frontend/tokens.css). Hareket yalnızca
           kısa bir opaklık geçişi; backdrop-filter / dönme / yaylanma yok. */
        .popup-overlay {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--nv-space-3);
            background: color-mix(in srgb, var(--nv-navy-950) 72%, transparent);
            z-index: calc(var(--nv-z-skip) + 100); /* üstbilgi (10060) ve menülerin üstünde, çerez bandının altında */
            opacity: 0;
            visibility: hidden;
            transition: opacity var(--nv-dur) linear, visibility 0s linear var(--nv-dur);
        }
        .popup-overlay.popup-active {
            opacity: 1;
            visibility: visible;
            transition: opacity var(--nv-dur) linear, visibility 0s;
        }

        .popup-container {
            position: relative;
            box-sizing: border-box;
            width: 92vw;
            max-width: 92vw;
            max-height: 90vh;
            max-height: 90dvh;
            overflow-x: hidden;
            overflow-y: auto;
            overscroll-behavior: contain;
            background: var(--nv-surface);
            color: var(--nv-text);
            font-family: var(--nv-font-sans);
            font-size: var(--nv-text-body);
            line-height: var(--nv-leading-body);
            border: var(--nv-border-width) solid var(--nv-border-subtle);
            border-radius: var(--nv-radius-lg);
            box-shadow: var(--nv-shadow);
        }
        @media (min-width: 768px) {
            .popup-container { width: min(560px, 92vw); }
        }

        /* Kapat çubuğu: kaydırırken de görünür kalır */
        .popup-bar {
            position: sticky;
            top: 0;
            z-index: var(--nv-z-base);
            display: flex;
            justify-content: flex-end;
            padding: var(--nv-space-2);
            background: var(--nv-surface);
            border-bottom: var(--nv-border-width) solid var(--nv-border-subtle);
        }
        .popup-close-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--nv-space-2);
            min-width: var(--nv-target-min);
            min-height: var(--nv-target-min);
            padding: 0 var(--nv-space-4);
            background: var(--nv-paper);
            color: var(--nv-navy-900);
            border: var(--nv-field-border-width) solid var(--nv-navy-900);
            border-radius: var(--nv-radius-md);
            font: inherit;
            font-size: var(--nv-text-sm);
            font-weight: var(--nv-weight-bold);
            line-height: 1;
            cursor: pointer;
        }
        .popup-close-btn:hover { background: var(--nv-navy-900); color: var(--nv-paper); }
        .popup-close-btn:focus-visible {
            outline: var(--nv-focus-outline);
            outline-offset: var(--nv-focus-offset);
            box-shadow: var(--nv-focus-shadow);
        }
        .popup-close-btn .popup-close-x { font-size: 1.5em; line-height: 1; }
        :root[data-contrast="high"] .popup-close-btn { color: #000; border-color: #000; }
        :root[data-contrast="high"] .popup-close-btn:hover { background: #000; color: var(--nv-paper); }

        /* Panelden gelen içerik (DB CSS'i) eski renk/hareket/boyutlarla gelir;
           burada token'lara ve sakin harekete çekilir. */
        .popup-container .popup-body { max-height: none; overflow: visible; padding: var(--nv-space-5); }
        .popup-container .popup-header { max-width: 100%; }
        .popup-container .popup-header img, .popup-container img { max-width: 100%; height: auto; }
        .popup-container .popup-header-image { height: 100%; width: 100%; }
        .popup-container .popup-content-item { animation: none; margin-bottom: var(--nv-space-5); }
        .popup-container .popup-content-label { color: var(--nv-heading); font-size: var(--nv-text-h5); margin: 0 0 var(--nv-space-2); }
        .popup-container .popup-content-value { color: var(--nv-text); font-size: var(--nv-text-sm); line-height: var(--nv-leading-body); }
        .popup-container .popup-footer { background: var(--nv-bg-alt); border-top: var(--nv-border-width) solid var(--nv-border-subtle); padding: var(--nv-space-4) var(--nv-space-5); flex-wrap: wrap; }
        .popup-container .popup-btn {
            min-height: var(--nv-target-min); border-radius: var(--nv-radius-md); transition: none; font-size: var(--nv-text-sm);
        }
        .popup-container .popup-btn:hover { transform: none; box-shadow: none; }
        .popup-container .popup-btn:focus-visible { outline: var(--nv-focus-outline); outline-offset: var(--nv-focus-offset); box-shadow: var(--nv-focus-shadow); }
        .popup-container .popup-btn-primary { background: var(--nv-cta-bg); color: var(--nv-cta-fg); }
        .popup-container .popup-btn-secondary { background: var(--nv-paper); color: var(--nv-navy-900); border: var(--nv-field-border-width) solid var(--nv-navy-900); }

        @media (prefers-reduced-motion: reduce) {
            .popup-overlay, .popup-overlay.popup-active, .popup-container, .popup-container * {
                transition: none !important;
                animation: none !important;
            }
        }
    </style>

    {* P3-3: role=dialog, aria-modal, odak tuzağı, Esc, dış tık, odak dönüşü.
       Açılış: çerez bandı karar bekliyorsa karar verildikten sonra; oturum başına bir kez. *}
    <div class="popup-overlay" id="popupOverlay">
        <div class="popup-container" role="dialog" aria-modal="true" aria-label="Duyuru" id="popupDialog">
            <div class="popup-bar">
                <button type="button" class="popup-close-btn" id="closePopupBtn" aria-label="Duyuruyu kapat">
                    <span>Kapat</span><span class="popup-close-x" aria-hidden="true">×</span>
                </button>
            </div>

            {{ range index1, Content := AllHomepageContents }}
                {{ if Content.ContentType == "popup" }}
                    <style>
                        {{ Content.ContentCss | raw }}
                    </style>
                    
                    {{ Content.ContentHtml | raw }}

                    <script>
                        {{ Content.ContentJavascript | raw }}
                    </script>
                {{ end }}
            {{ end }}
        </div>
    </div>

    <script>
        (function() {
            var popupOverlay = document.getElementById('popupOverlay');
            var dialog = document.getElementById('popupDialog');
            var closePopupBtn = document.getElementById('closePopupBtn');
            var openPopupBtn = document.getElementById('openPopupBtn');
            var SEEN_KEY = 'nv_popup_seen';
            var lastFocus = null;

            // Başlık öğesi varsa iletişim kutusunun adı o olur, yoksa aria-label kalır
            var title = dialog.querySelector('.popup-title, [data-popup-title], h1, h2, h3');
            if (title && title.textContent.trim() && getComputedStyle(title).display !== 'none') {
                if (!title.id) title.id = 'popupTitle';
                dialog.setAttribute('aria-labelledby', title.id);
                dialog.removeAttribute('aria-label');
            }

            function isOpen() { return popupOverlay.classList.contains('popup-active'); }

            function openPopup() {
                if (isOpen()) return;
                lastFocus = document.activeElement;
                popupOverlay.classList.add('popup-active');
                document.body.style.overflow = 'hidden';
                closePopupBtn.focus({ preventScroll: true });
            }

            function closePopup() {
                popupOverlay.classList.remove('popup-active');
                document.body.style.overflow = '';
                if (lastFocus && typeof lastFocus.focus === 'function' && document.contains(lastFocus)) lastFocus.focus({ preventScroll: true });
            }

            popupOverlay.addEventListener('keydown', function (e) {
                if (e.key !== 'Tab' || !isOpen()) return;
                var f = Array.prototype.filter.call(
                    popupOverlay.querySelectorAll('a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])'),
                    function (el) { return el.offsetParent !== null || el === document.activeElement; });
                if (!f.length) return;
                var first = f[0], last = f[f.length - 1];
                if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
                else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
            });

            if (openPopupBtn) openPopupBtn.addEventListener('click', openPopup);
            closePopupBtn.addEventListener('click', closePopup);
            popupOverlay.addEventListener('click', function(e) { if (e.target === popupOverlay) closePopup(); });
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && isOpen()) closePopup();
            });

            // Oturum başına en fazla bir otomatik açılış (depolama yoksa da çalışır)
            function seen() { try { return sessionStorage.getItem(SEEN_KEY) === '1'; } catch (e) { return false; } }
            function markSeen() { try { sessionStorage.setItem(SEEN_KEY, '1'); } catch (e) {} }

            function autoOpen() {
                if (seen() || isOpen()) return;
                markSeen();
                openPopup();
            }

            // Çerez bandı karar bekliyorsa (window.nvCookieHasDecision, main.jet) karar sonrası aç
            var started = false;
            function start() {
                if (started) return;
                started = true;
                setTimeout(autoOpen, 400);
            }
            function init() {
                if (seen()) return;
                if (typeof window.nvCookieHasDecision !== 'function' || window.nvCookieHasDecision()) {
                    setTimeout(start, 1200);
                } else {
                    document.addEventListener('nv:cookie-decision', start, { once: true });
                }
            }
            if (document.readyState === 'complete') init();
            else window.addEventListener('load', init);
        })();
    </script>
{{ end }}
