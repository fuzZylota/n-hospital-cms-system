<link rel="stylesheet" href="{{ PathOnStart }}css/panel/tibbi-birim.css">
<!-- CodeMirror CSS for syntax highlighting -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/theme/monokai.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <div class="breadcrumb">
                    <a href="/panel/tibbi-birimler" class="breadcrumb-link">
                        <i class="fas fa-stethoscope"></i>
                        Tıbbi Birimler
                    </a>
                    <i class="icon-chevron-right breadcrumb-separator"></i>
                    <span class="breadcrumb-current">{{ TibbiBirim.Name }}</span>
                </div>
                <h1 class="page-title">
                    <div class="title-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="title-content">
                        <div class="title-main">{{ TibbiBirim.Name }}</div>
                        <div class="title-meta">
                            <span class="meta-item">
                                <i class="fas fa-calendar"></i>
                                {{ mthr(TibbiBirim.CreatedAt, User.Timezone) }}
                            </span>
                            <span class="meta-item">
                                <i class="fas fa-clock"></i>
                                Son güncelleme: {{ mthr(TibbiBirim.UpdatedAt, User.Timezone) }}
                            </span>
                        </div>
                    </div>
                </h1>
                {{if TibbiBirim.Description}}
                <p class="page-subtitle">{{ TibbiBirim.Description }}</p>
                {{end}}
            </div>
            <div class="page-actions">
                <div class="status-indicator">
                    {{if TibbiBirim.IsActive}}
                    <span class="status-badge active">
                        <i class="fas fa-check-circle"></i>
                        Aktif
                    </span>
                    {{else}}
                    <span class="status-badge inactive">
                        <i class="fas fa-pause-circle"></i>
                        Pasif
                    </span>
                    {{end}}
                </div>
                <div class="action-buttons">
                    <a href="/panel/tibbi-birimler/{{ TibbiBirim.Tbid }}/duzenle" class="btn btn-primary">
                        <i class="fas fa-edit"></i>
                        Düzenle
                    </a>
                    <button class="btn btn-danger" id="deleteTibbiBirimBtn" data-id="{{ TibbiBirim.Tbid }}" data-name="{{ TibbiBirim.Name }}">
                        <i class="fas fa-trash"></i>
                        <span class="btn-text">Sil</span>
                        <div class="btn-loader" style="display: none;">
                            <div class="spinner"></div>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Sections -->
    <div class="content-grid">
        <!-- Basic Information Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <h3 class="card-title">Temel Bilgiler</h3>
            </div>
            <div class="card-content">
                <div class="info-grid">
                    <div class="info-item">
                        <label class="info-label">Birim Adı</label>
                        <div class="info-value">{{ TibbiBirim.Name }}</div>
                    </div>
                    <div class="info-item">
                        <label class="info-label">URL Adı</label>
                        <div class="info-value">{{ TibbiBirim.UrlName }}</div>
                    </div>

                    {{if TibbiBirim.Description}}
                    <div class="info-item full-width">
                        <label class="info-label">Açıklama</label>
                        <div class="info-value">{{ TibbiBirim.Description }}</div>
                    </div>
                    {{end}}

                    {{if TibbiBirim.CoverPath}}
                    <div class="info-item">
                        <label class="info-label">Kapak Görseli</label>
                        <div class="info-value">
                            <div class="image-preview" data-media-id="{{ TibbiBirim.CoverMid }}">
                                <img src="{{ PathOnStart }}{{ TibbiBirim.CoverPath }}"
                                     alt="{{ TibbiBirim.CoverAltText != "" ? TibbiBirim.CoverAltText : TibbiBirim.Name }}"
                                     title="{{ TibbiBirim.CoverTitle != "" ? TibbiBirim.CoverTitle : TibbiBirim.Name }}"
                                     class="preview-image zoomable">
                                <div class="image-overlay">
                                    <i class="icon-maximize"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{end}}

                    {{if TibbiBirim.VideoPath}}
                    <div class="info-item">
                        <label class="info-label">Tanıtım Videosu</label>
                        <div class="info-value">
                            <div class="video-preview">
                                <video controls class="preview-video">
                                    <source src="{{ PathOnStart }}{{ TibbiBirim.VideoPath }}" type="video/mp4">
                                    Tarayıcınız video oynatmayı desteklemiyor.
                                </video>
                                <div class="video-actions">
                                    <a href="{{ PathOnStart }}{{ TibbiBirim.VideoPath }}" target="_blank" class="btn btn-sm btn-secondary">
                                        <i class="fas fa-external-link-alt"></i>
                                        Yeni Sekmede Aç
                                    </a>
                                    <a href="{{ PathOnStart }}{{ TibbiBirim.VideoPath }}" download class="btn btn-sm btn-secondary">
                                        <i class="fas fa-download"></i>
                                        İndir
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>

        <!-- Related Doctors Section -->
        {{if len(Doktorlar) > 0}}
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-user-md"></i>
                </div>
                <h3 class="card-title">Bu Birimdeki Doktorlar ({{ len(Doktorlar) }})</h3>
            </div>
            <div class="card-content">
                <div class="related-list">
                    {{range Doktorlar}}
                    <div class="related-item">
                        <div class="related-info">
                            <div class="related-title">{{ .Title }} {{ .FirstName }} {{ .LastName }}</div>
                            <div class="related-details">
                                {{if .Phone}}
                                <span class="detail-item">
                                    <i class="fas fa-phone"></i>
                                    {{ .Phone }}
                                </span>
                                {{end}}
                                {{if .Email}}
                                <span class="detail-item">
                                    <i class="fas fa-envelope"></i>
                                    {{ .Email }}
                                </span>
                                {{end}}
                            </div>
                        </div>
                        <div class="related-actions">
                            <a href="/panel/doktorlar/{{ .Drid }}" class="btn btn-sm btn-secondary">
                                <i class="fas fa-eye"></i>
                                Görüntüle
                            </a>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
        {{end}}

        <!-- Related Appointments Section -->
        {{if len(Randevular) > 0}}
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <h3 class="card-title">Bu Birime Ait Randevular ({{ len(Randevular) }})</h3>
            </div>
            <div class="card-content">
                <div class="related-list">
                    {{range Randevular}}
                    <div class="related-item">
                        <div class="related-info">
                            <div class="related-title">{{ .PatientFirstName }} {{ .PatientLastName }}</div>
                            <div class="related-details">
                                <span class="detail-item">
                                    <i class="fas fa-calendar"></i>
                                    {{ mthr(.AppointmentDate, User.Timezone) }}
                                </span>
                                <span class="detail-item">
                                    <i class="fas fa-phone"></i>
                                    {{ .PatientPhone }}
                                </span>
                                <span class="detail-item status-{{ .Status }}">
                                    <i class="fas fa-info-circle"></i>
                                    {{ .Status }}
                                </span>
                            </div>
                        </div>
                        <div class="related-actions">
                            <a href="/panel/randevular/{{ .Rid }}" class="btn btn-sm btn-secondary">
                                <i class="fas fa-eye"></i>
                                Görüntüle
                            </a>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
        </div>
        {{end}}

        <!-- HTML Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fab fa-html5"></i>
                </div>
                <h3 class="card-title">HTML İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="code-section">
                    <div class="code-header">
                        <span class="code-title">HTML Kodu</span>
                        <div class="code-actions">
                            <button class="btn-icon copy-btn" onclick="copyToClipboard('htmlContent')" title="Kopyala">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn-icon expand-btn" onclick="toggleCodeExpansion('htmlContent')" title="Genişlet/Daralt">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="code-container">
                        <textarea id="htmlContent" class="code-editor" readonly>{{ if TibbiBirim.HtmlContent }}{{ TibbiBirim.HtmlContent }}{{ else }}<!-- HTML kodu bulunmuyor -->{{ end }}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- CSS Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fab fa-css3-alt"></i>
                </div>
                <h3 class="card-title">CSS İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="code-section">
                    <div class="code-header">
                        <span class="code-title">CSS Kodu</span>
                        <div class="code-actions">
                            <button class="btn-icon copy-btn" onclick="copyToClipboard('cssContent')" title="Kopyala">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn-icon expand-btn" onclick="toggleCodeExpansion('cssContent')" title="Genişlet/Daralt">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="code-container">
                        <textarea id="cssContent" class="code-editor" readonly>{{ if TibbiBirim.CssContent }}{{ TibbiBirim.CssContent }}{{ else }}/* CSS kodu bulunmuyor */{{ end }}</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- JavaScript Content Section -->
        <div class="content-card">
            <div class="card-header">
                <div class="card-icon">
                    <i class="fab fa-js-square"></i>
                </div>
                <h3 class="card-title">JavaScript İçeriği</h3>
            </div>
            <div class="card-content">
                <div class="code-section">
                    <div class="code-header">
                        <span class="code-title">JavaScript Kodu</span>
                        <div class="code-actions">
                            <button class="btn-icon copy-btn" onclick="copyToClipboard('jsContent')" title="Kopyala">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn-icon expand-btn" onclick="toggleCodeExpansion('jsContent')" title="Genişlet/Daralt">
                                <i class="fas fa-expand-arrows-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="code-container">
                        <textarea id="jsContent" class="code-editor" readonly>{{ if TibbiBirim.JavascriptContent }}{{ TibbiBirim.JavascriptContent }}{{ else }}// JavaScript kodu bulunmuyor{{ end }}</textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal" style="display: none;">
    <div class="modal-content danger">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Tıbbi Birimi Sil</h3>
        <p class="modal-message">
            "<span id="deleteItemName"></span>" adlı tıbbi birimi silmek istediğinizden emin misiniz?
            Bu işlem geri alınamaz ve tüm ilişkili veriler silinecektir.
        </p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">İptal</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                <i class="icon-trash-2"></i>
                <span class="btn-text">Sil</span>
                <div class="btn-loader" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </button>
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="imageZoomModal" class="modal image-modal" style="display: none;">
    <div class="modal-content image-content">
        <button class="modal-close" onclick="closeImageModal()">
            <i class="icon-x"></i>
        </button>
        <div class="image-container">
            <img id="zoomedImage" src="" alt="Zoomed Image">
        </div>
        <div class="image-info">
            <span id="imageTitle">Görsel</span>
            <div class="image-actions">
                <button class="btn btn-sm btn-secondary" onclick="downloadImage()">
                    <i class="icon-download"></i>
                    İndir
                </button>
                <button class="btn btn-sm btn-secondary" onclick="openImageInNewTab()">
                    <i class="icon-external-link"></i>
                    Yeni Sekmede Aç
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Success/Error Messages -->
<div id="successMessage" class="alert alert-success" style="display: none;">
    <i class="icon-check-circle"></i>
    <span class="alert-text">İşlem başarıyla tamamlandı.</span>
    <button class="alert-close" onclick="closeAlert('successMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<div id="errorMessage" class="alert alert-error" style="display: none;">
    <i class="icon-alert-circle"></i>
    <span class="alert-text">Bir hata oluştu. Lütfen tekrar deneyin.</span>
    <button class="alert-close" onclick="closeAlert('errorMessage')">
        <i class="icon-x"></i>
    </button>
</div>

<script>
    // Pass data to JavaScript
    window.tibbiBirimData = {
        id: parseInt("{{ TibbiBirim.Tbid }}"),
        name: "{{ TibbiBirim.Name }}",
        htmlContent: `{{ TibbiBirim.HtmlContent }}`,
        cssContent: `{{ TibbiBirim.CssContent }}`,
        jsContent: `{{ TibbiBirim.JavascriptContent }}`
    };
</script>
<!-- CodeMirror JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/css/css.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/htmlmixed/htmlmixed.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/addon/hint/show-hint.min.js"></script>
<script src="{{ PathOnStart }}js/panel/tibbi-birim.js"></script>