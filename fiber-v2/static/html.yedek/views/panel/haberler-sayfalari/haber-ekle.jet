<link rel="stylesheet" href="{{ PathOnStart }}css/panel/haber-ekle.css">

<div class="page-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-title-section">
                <h1 class="page-title">
                    <i class="icon-edit"></i>
                    Yeni Haber Ekle
                </h1>
                <p class="page-subtitle">Hastane için yeni bir haber oluşturun</p>
            </div>
            <div class="page-actions">
                <a href="/panel/haberler" class="btn btn-secondary">
                    <i class="icon-arrow-left"></i>
                    Geri Dön
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="page-content">
        <form id="haberForm" class="haber-form" novalidate action="/backend/add-news" method="post" enctype="multipart/form-data">
            <!-- Basic Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-info-circle"></i>
                        Temel Bilgiler
                    </h2>
                    <p class="section-description">Haberin temel bilgilerini girin</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="title" class="form-label required">Haber Başlığı</label>
                            <input type="text" id="title" name="title" class="form-input" 
                                   placeholder="örn: Hastane Yeni Teknoloji Yatırımı" required>
                            <div class="form-help">Haberin görüntülenecek başlığı</div>
                        </div>
                        <div class="form-group">
                            <label for="url_name" class="form-label">URL Adı</label>
                            <input type="text" id="url_name" name="url_name" class="form-input" 
                                   placeholder="hastane-yeni-teknoloji-yatirimi">
                            <div class="form-help">Boş bırakılırsa otomatik oluşturulur</div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="category" class="form-label">Kategori</label>
                            <input type="text" id="category" name="category" class="form-input" 
                                   placeholder="genel" value="genel">
                            <div class="form-help">Haber kategorisi</div>
                        </div>
                        <div class="form-group">
                            <label for="author" class="form-label">Yazar</label>
                            <input type="text" id="author" name="author" class="form-input" 
                                   placeholder="Haber yazarının adı">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="summary" class="form-label">Özet</label>
                        <textarea id="summary" name="summary" class="form-textarea" 
                                  rows="3" placeholder="Haber hakkında kısa özet yazın..."></textarea>
                        <div class="form-help">Haberin kısa özeti (opsiyonel)</div>
                    </div>
                    <div class="form-group">
                        <label for="content" class="form-label required">İçerik</label>
                        <textarea id="content" name="content" class="form-textarea" 
                                  rows="8" placeholder="Haberin detaylı içeriğini yazın..." required></textarea>
                        <div class="form-help">Haberin tam içeriği</div>
                    </div>
                </div>
            </div>

            <!-- Publication Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-calendar"></i>
                        Yayın Bilgileri
                    </h2>
                    <p class="section-description">Haberin yayın ayarları</p>
                </div>
                <div class="section-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="publish_date" class="form-label">Yayın Tarihi</label>
                            <input type="datetime-local" id="publish_date" name="publish_date" class="form-input">
                            <div class="form-help">Haberin yayınlanacağı tarih ve saat</div>
                        </div>
                        <div class="form-group">
                            <label for="tags" class="form-label">Etiketler</label>
                            <input type="text" id="tags" name="tags" class="form-input" 
                                   placeholder="teknoloji, hastane, yatırım">
                            <div class="form-help">Virgülle ayırarak etiketler ekleyin</div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="is_featured" class="form-label">Öne Çıkan Haber</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="is_featured" name="is_featured">
                                <label for="is_featured" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Öne Çıkan</span>
                                </label>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="is_published" class="form-label">Yayınlanmış</label>
                            <div class="toggle-switch">
                                <input type="checkbox" id="is_published" name="is_published">
                                <label for="is_published" class="toggle-label">
                                    <span class="toggle-slider"></span>
                                    <span class="toggle-text">Yayınlanmış</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SEO Information Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-search"></i>
                        SEO Bilgileri
                    </h2>
                    <p class="section-description">Arama motoru optimizasyonu</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="seo_title" class="form-label">SEO Başlığı</label>
                        <input type="text" id="seo_title" name="seo_title" class="form-input" 
                               placeholder="SEO için özel başlık">
                        <div class="form-help">Arama motorları için özel başlık (opsiyonel)</div>
                    </div>
                    <div class="form-group">
                        <label for="seo_description" class="form-label">SEO Açıklaması</label>
                        <textarea id="seo_description" name="seo_description" class="form-textarea" 
                                  rows="3" placeholder="Arama motorları için açıklama"></textarea>
                        <div class="form-help">Arama motorları için açıklama (opsiyonel)</div>
                    </div>
                    <div class="form-group">
                        <label for="seo_keywords" class="form-label">SEO Anahtar Kelimeler</label>
                        <input type="text" id="seo_keywords" name="seo_keywords" class="form-input" 
                               placeholder="hastane, teknoloji, sağlık, yatırım">
                        <div class="form-help">Virgülle ayırarak anahtar kelimeler ekleyin</div>
                    </div>
                </div>
            </div>

            <!-- News Image Section -->
            <div class="form-section">
                <div class="section-header">
                    <h2 class="section-title">
                        <i class="icon-image"></i>
                        Haber Görseli
                    </h2>
                    <p class="section-description">Haberin kapak fotoğrafı</p>
                </div>
                <div class="section-content">
                    <div class="form-group">
                        <label for="cover_mid" class="form-label">Haber Fotoğrafı</label>
                        <div class="file-upload-area" data-target="cover_mid">
                            <div class="file-upload-content">
                                <i class="icon-upload"></i>
                                <p class="file-upload-text">Haber fotoğrafını sürükleyin veya <span class="file-browse">göz atın</span></p>
                                <p class="file-upload-hint">PNG, JPG, WEBP - Max 5MB</p>
                            </div>
                            <input type="file" id="cover_mid" name="cover_mid" 
                                   class="file-input" accept="image/*">
                            <div class="file-preview" style="display: none;">
                                <img class="preview-image" src="" alt="Preview">
                                <button type="button" class="file-remove">
                                    <i class="icon-x"></i>
                                </button>
                            </div>
                        </div>
                        <div class="file-meta-inputs">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="cover_alt_text" class="form-label">Görsel Alt Metni</label>
                                    <input type="text" id="cover_alt_text" name="cover_alt_text" 
                                           class="form-input" placeholder="Haber fotoğrafı için alternatif metin">
                                </div>
                                <div class="form-group">
                                    <label for="cover_title" class="form-label">Görsel Başlığı</label>
                                    <input type="text" id="cover_title" name="cover_title" 
                                           class="form-input" placeholder="Haber fotoğrafı için başlık metni">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                    <i class="icon-x"></i>
                    İptal
                </button>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <i class="icon-check"></i>
                    <span class="btn-text">Haberi Kaydet</span>
                    <div class="btn-loader" style="display: none;">
                        <div class="spinner"></div>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success/Error Modals -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content success">
        <div class="modal-icon">
            <i class="icon-check-circle"></i>
        </div>
        <h3 class="modal-title">Başarılı!</h3>
        <p class="modal-message">Haber başarıyla oluşturuldu.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" onclick="closeModal('successModal')">Tamam</button>
        </div>
    </div>
</div>

<div id="errorModal" class="modal" style="display: none;">
    <div class="modal-content error">
        <div class="modal-icon">
            <i class="icon-alert-circle"></i>
        </div>
        <h3 class="modal-title">Hata!</h3>
        <p class="modal-message" id="errorMessage">Bir hata oluştu. Lütfen tekrar deneyin.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-danger" onclick="closeModal('errorModal')">Tamam</button>
        </div>
    </div>
</div>

<script src="{{ PathOnStart }}js/panel/haber-ekle.js"></script>