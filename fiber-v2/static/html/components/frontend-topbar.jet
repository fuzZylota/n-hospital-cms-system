<div class="topbar-one transparent-bg-on-homepage-topbar">
    <div class="container-fluid">
        <div class="topbar-one__inner">
            <ul class="list-unstyled topbar-one__info">
                <li>
                    <span class="topbar-one__info__icon topbar-one__info__icon--email">
                        <i class="icon-email"></i>
                    </span>
                    <a href="mailto:{{ Options.Options.ContactEmail }}">{{ Options.Options.ContactEmail ? Options.Options.ContactEmail : "info@nermefraz.com" }}</a>
                </li>
                <li>
                    <span class="topbar-one__info__icon">
                        <i class="icon-telephone"></i>
                    </span>
                    <a href="tel:{{ Options.Options.ContactPhone }}">{{ Options.Options.ContactPhone ? Options.Options.ContactPhone : "532 123 45 67" }}</a>
                </li>
            </ul>
            <div class="topbar-one__right">
                {{ include "../../components/translator" }}
                <div id="nvTopbarSearch" style="display:flex;align-items:center;margin-right:12px;position:relative;">
                    <div id="nvSearchBox" style="display:flex;align-items:center;background:rgba(255,255,255,0.15);border-radius:999px;overflow:hidden;max-width:0;transition:max-width 0.4s ease;white-space:nowrap;">
                        <form action="/arama" method="get" style="display:flex;align-items:center;">
                            <input id="nvSearchInput" type="text" name="q" aria-label="Sitede ara" placeholder="Ara..." style="background:transparent;border:none;color:#fff;padding:4px 12px;font-size:16px;width:180px;">
                            <button type="submit" style="background:transparent;border:none;color:#fff;cursor:pointer;padding:4px 10px 4px 0;display:flex;align-items:center;" title="Ara" aria-label="Ara">
                                <i class="icon-search" style="font-size:14px;"></i>
                            </button>
                        </form>
                    </div>
                    <div id="nvSearchToggle" style="cursor:pointer;padding:4px 8px;color:#fff;display:flex;align-items:center;" title="Ara">
                        <i class="icon-search" style="font-size:16px;"></i>
                    </div>
                </div>

                <div class="social-links">
                    <a href="{{ Options.Options.FacebookUrl != "" ? Options.Options.FacebookUrl : "#" }}" aria-label="Facebook">
                        <i class="fab fa-facebook-f" aria-hidden="true"></i>
                        <span class="sr-only">Facebook</span>
                    </a>
                    <a href="{{ Options.Options.InstagramUrl != "" ? Options.Options.InstagramUrl : "#" }}" aria-label="Instagram">
                        <i class="fab fa-instagram" aria-hidden="true"></i>
                        <span class="sr-only">Instagram</span>
                    </a>
                    <a href="{{ Options.Options.LinkedinUrl != "" ? Options.Options.LinkedinUrl : "#" }}" aria-label="Linkedin">
                        <i class="fab fa-linkedin" aria-hidden="true"></i>
                        <span class="sr-only">Linkedin</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div><script>
(function(){
    var toggle = document.getElementById('nvSearchToggle');
    var box = document.getElementById('nvSearchBox');
    var input = document.getElementById('nvSearchInput');
    var open = false;
    if(toggle && box){
        toggle.addEventListener('click', function(){
            if(!open){
                box.style.maxWidth = '240px';
                setTimeout(function(){ if(input) input.focus(); }, 300);
                open = true;
            } else {
                box.style.maxWidth = '0';
                open = false;
            }
        });
        document.addEventListener('click', function(e){
            if(!document.getElementById('nvTopbarSearch').contains(e.target)){
                box.style.maxWidth = '0';
                open = false;
            }
        });
    }
})();
</script>
